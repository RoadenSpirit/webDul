---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  hideFooter?: boolean;
}

const { 
  title, 
  description = "Dulcería El Líder — Cakes artesanales y dulces finos por encargo en Camagüey, Cuba. Calidad gourmet para celebraciones únicas. ¡Pide hoy!",
  hideFooter = false
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title} | Dulcería El Líder</title>
    <meta name="title" content={`${title} | Dulcería El Líder`} />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Dulcería El Líder`} />
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Dulcería El Líder`} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <!-- Sin barra superior de navegación: el Hero y el botón flotante del carrito protagonizan la pantalla -->
    <main class="main-content">
      <slot />
    </main>

    <!-- Footer Minimalista y Limpio (oculto en /admin) -->
    {!hideFooter && (
    <footer id="contacto" class="main-footer">
      <div class="footer-inner">

        <!-- Logo grande -->
        <div class="footer-logo-block">
          <div class="footer-logo-ring">
            <img src="/logo-correcto.png" alt="Dulcería El Líder" class="footer-logo-img" />
          </div>
          <h3 class="footer-brand-name">El Líder</h3>
          <p class="footer-brand-tagline">Dulcería Artesanal · Camagüey, Cuba</p>
        </div>

        <!-- Mensaje de calidad -->
        <div class="footer-message-block">
          <p class="footer-headline">
            🎂 Dulces finos y cakes por encargo
          </p>
          <p class="footer-description">
            Elaboramos cada pedido de forma artesanal para tus momentos más especiales. 
            Contáctanos directamente para coordinar los detalles de tu encargo.
          </p>
        </div>

        <!-- Contacto directo por WhatsApp -->
        <div class="footer-contact">
          <span class="footer-contact-label">📱 Atención directa por WhatsApp:</span>
          <a href="https://wa.me/5351394921" target="_blank" rel="noopener noreferrer" class="footer-phone">+53 5139 4921</a>
        </div>

      </div>

      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} Dulcería El Líder · Camagüey, Cuba. Todos los derechos reservados.</p>
      </div>
    </footer>
    )}
  </body>
</html>

<style>
  /* ============================================================
     MAIN CONTENT
     ============================================================ */
  .main-content {
    flex: 1;
    min-height: 100vh;
    overflow-x: hidden;
    width: 100%;
  }

  /* ============================================================
     FOOTER MINIMALISTA
     ============================================================ */
  .main-footer {
    background: linear-gradient(160deg, #3D1A24 0%, #2A0A14 100%);
    color: #FFF8F0;
    padding: 3.5rem 1.5rem 0;
    border-top: 2px solid transparent;
    border-image: linear-gradient(90deg, #E8196C, #FF6B35) 1;
  }

  .footer-inner {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
  }

  /* Logo del footer */
  .footer-logo-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
  }

  .footer-logo-ring {
    position: relative;
    width: 90px;
    height: 90px;
  }

  .footer-logo-ring::before {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: linear-gradient(135deg, #E8196C, #FF6B35);
    z-index: 0;
  }

  .footer-logo-img {
    position: relative;
    z-index: 1;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid rgba(255,255,255,0.25);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.45);
  }

  .footer-brand-name {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0;
    letter-spacing: 0.5px;
    line-height: 1;
  }

  .footer-brand-tagline {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: rgba(255, 200, 180, 0.85);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 600;
  }

  /* Mensaje */
  .footer-message-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 480px;
  }

  .footer-headline {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.3;
  }

  .footer-description {
    font-size: 0.95rem;
    color: var(--neutral-cream);
    line-height: 1.6;
    opacity: 0.9;
  }

  /* Contacto */
  .footer-contact {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    background: rgba(232, 25, 108, 0.12);
    border: 1px solid rgba(255, 107, 53, 0.3);
    padding: 0.75rem 1.5rem;
    border-radius: 50px;
  }

  .footer-contact-label {
    color: rgba(255, 248, 240, 0.9);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .footer-phone {
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--accent-light);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--transition-fast);
  }

  .footer-phone:hover {
    color: var(--accent-pale);
  }

  .footer-bottom {
    max-width: var(--max-width);
    margin: 2.5rem auto 0;
    padding: 1.25rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
    font-size: 0.8rem;
    color: rgba(255, 248, 240, 0.5);
    font-family: var(--font-sans);
  }
</style>
