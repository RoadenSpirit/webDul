---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  hideFooter?: boolean;
}

const { 
  title, 
  description = "Dulcería El Líder — Cakes artesanales y dulces finos por encargo en Camagüey, Cuba. Calidad gourmet para celebraciones únicas. ¡Pide hoy!",
  hideFooter = false
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title} | Dulcería El Líder</title>
    <meta name="title" content={`${title} | Dulcería El Líder`} />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Dulcería El Líder`} />
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Dulcería El Líder`} />
    <meta name="twitter:description" content={description} />
    <link rel="prefetch" href="/pedido" />
  </head>
  <body>
    <!-- Sin barra superior de navegación: el Hero y el botón flotante del carrito protagonizan la pantalla -->
    <main class="main-content">
      <slot />
    </main>

    <!-- Footer Minimalista y Limpio (oculto en /admin) -->
    {!hideFooter && (
    <footer id="contacto" class="main-footer">
      <div class="footer-inner">

        <!-- Logo grande -->
        <div class="footer-logo-block">
          <div class="footer-logo-ring">
            <img src="/logo-correcto.png" alt="Dulcería El Líder" class="footer-logo-img" />
          </div>
          <h3 class="footer-brand-name">El Líder</h3>
          <p class="footer-brand-tagline">Dulcería El Líder · Camagüey, Cuba</p>
        </div>

        <!-- Mensaje de calidad -->
        <div class="footer-message-block">
          <p class="footer-headline">
            Dulces y cakes por encargo
          </p>
          <p class="footer-description">
            Elaboramos cada encargo con la mejor calidad para tus celebraciones. Contáctanos directamente para coordinar tu encargo.
          </p>
        </div>

        <!-- Contacto directo por WhatsApp -->
        <div class="footer-contact">
           <span class="footer-contact-label">Encargos por WhatsApp:</span>
           <a href="https://wa.me/5353721945" target="_blank" rel="noopener noreferrer" class="footer-wa-chip">
             <span class="wa-chip-icon">
               <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                 <path d="M12.031 2C6.495 2 2 6.502 2 12.046c0 1.956.562 3.824 1.625 5.438L2.062 22l4.674-1.523a10.01 10.01 0 0 0 5.295 1.508c5.536 0 10.031-4.502 10.031-10.046C22.062 6.502 17.567 2 12.031 2zm0 18.25c-1.688 0-3.328-.469-4.75-1.344l-.344-.203-3.14.938.938-3.047-.234-.375c-.969-1.531-1.484-3.328-1.484-5.172 0-4.594 3.734-8.328 8.328-8.328 4.594 0 8.328 3.734 8.328 8.328 0 4.594-3.734 8.328-8.328 8.328zm4.563-6.234c-.25-.125-1.469-.734-1.688-.828-.234-.094-.406-.141-.578.141s-.672.828-.828 1c-.156.172-.313.188-.563.063-.25-.125-1.063-.391-2.031-1.25-.75-.672-1.266-1.5-1.422-1.75-.156-.25-.016-.391.109-.516.109-.109.25-.281.375-.422.125-.141.172-.25.25-.422.078-.172.031-.328-.016-.453-.063-.125-.578-1.406-.797-1.922-.219-.516-.438-.438-.609-.438h-.516c-.172 0-.453.063-.688.328s-.906.875-.906 2.141c0 1.266.922 2.484 1.047 2.656.125.172 1.813 2.781 4.391 3.891.609.266 1.094.422 1.469.547.625.203 1.188.172 1.641.109.5-.078 1.469-.609 1.672-1.203.203-.594.203-1.094.141-1.203-.063-.094-.219-.156-.469-.281z"/>
               </svg>
             </span>
             <span class="wa-chip-phone">+53 5372 1945</span>
           </a>
        </div>

      </div>

      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} Dulcería El Líder · Camagüey, Cuba. Todos los derechos reservados.</p>
      </div>
    </footer>
    )}
  </body>
</html>

<style>
  /* ============================================================
     MAIN CONTENT
     ============================================================ */
  .main-content {
    flex: 1;
    min-height: 100vh;
    overflow-x: hidden;
    width: 100%;
  }

  /* ============================================================
     FOOTER MINIMALISTA
     ============================================================ */
  .main-footer {
    background: linear-gradient(160deg, #3D1A24 0%, #2A0A14 100%);
    color: #FFF8F0;
    padding: 3.5rem 1.5rem 0;
    border-top: 2px solid transparent;
    border-image: linear-gradient(90deg, #E8196C, #FF6B35) 1;
  }

  .footer-inner {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
  }

  /* Logo del footer */
  .footer-logo-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
  }

  .footer-logo-ring {
    position: relative;
    width: 90px;
    height: 90px;
  }

  .footer-logo-ring::before {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: linear-gradient(135deg, #E8196C, #FF6B35);
    z-index: 0;
  }

  .footer-logo-img {
    position: relative;
    z-index: 1;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid rgba(255,255,255,0.25);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.45);
  }

  .footer-brand-name {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0;
    letter-spacing: 0.5px;
    line-height: 1;
  }

  .footer-brand-tagline {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: rgba(255, 200, 180, 0.85);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 600;
  }

  /* Mensaje */
  .footer-message-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 480px;
  }

  .footer-headline {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.3;
  }

  .footer-description {
    font-size: 0.95rem;
    color: var(--neutral-cream);
    line-height: 1.6;
    opacity: 0.9;
  }

  /* Contacto */
  .footer-contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-contact-label {
    color: var(--neutral-cream);
    font-weight: 600;
    font-size: 0.85rem;
    opacity: 0.9;
  }

  .footer-wa-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(37, 211, 102, 0.12);
    border: 1.5px solid rgba(37, 211, 102, 0.4);
    padding: 0.45rem 1.1rem;
    border-radius: 50px;
    text-decoration: none;
    transition: all var(--transition-fast);
    box-shadow: 0 4px 15px rgba(37, 211, 102, 0.15);
  }

  .footer-wa-chip:hover {
    background: rgba(37, 211, 102, 0.22);
    border-color: #25D366;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.3);
  }

  .wa-chip-icon {
    color: #25D366;
    display: flex;
    align-items: center;
  }

  .wa-chip-phone {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.5px;
    color: #FFFFFF;
  }

  .wa-chip-status {
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: #25D366;
    color: #0B2512;
    padding: 0.15rem 0.45rem;
    border-radius: 50px;
  }

  .footer-bottom {
    max-width: var(--max-width);
    margin: 2.5rem auto 0;
    padding: 1.25rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
    font-size: 0.8rem;
    color: rgba(255, 248, 240, 0.5);
    font-family: var(--font-sans);
  }
</style>
