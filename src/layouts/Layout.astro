---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Dulcería El Líder - Dulces finos y decoraciones personalizadas por encargo en Camagüey, Cuba. Cakes, cupcakes, bocaditos y más con calidad premium." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title} | Dulcería El Líder</title>
    <meta name="title" content={`${title} | Dulcería El Líder`} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Dulcería El Líder`} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Dulcería El Líder`} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <header class="main-header">
      <div class="header-container">
        <div class="flex-1 flex justify-start">
          <a href="/" class="logo-area">
            <img src="/logo-correcto.png" alt="Dulcería El Líder Logo" class="logo-img" style="border-radius: 50%; object-fit: cover; aspect-ratio: 1/1; border: 2px solid rgba(255,255,255,0.4);" />
            <div class="logo-text-wrapper">
              <span class="logo-title">El Líder</span>
              <span class="logo-subtitle">DULCERÍA ARTESANAL</span>
            </div>
          </a>
        </div>
        <nav class="main-nav">
          <a href="/#catalogo" class="nav-link">Nuestra Carta</a>
          <a href="/#decoraciones" class="nav-link">Decoraciones</a>
          <a href="/#como-pedir" class="nav-link">¿Cómo pedir?</a>
          <a href="/pedido" class="nav-link" id="nav-order-link" style="display: none; align-items: center; gap: 0.25rem;">
            Mi Orden <span class="order-badge" id="nav-order-badge">0</span>
          </a>
        </nav>
        <div class="flex-1 flex justify-end">
          <!-- Espaciador para centrado perfecto -->
        </div>
      </div>
    </header>

    <main class="main-content">
      <slot />
    </main>

    <!-- Premium Footer -->
    <footer id="contacto" class="main-footer">
      <div class="footer-inner">
        <div class="footer-logo-block">
          <img src="/logo-correcto.png" alt="Dulcería El Líder Logo" class="footer-logo-img" />
          <h3 class="footer-brand-name">El Líder</h3>
        </div>
        <p class="footer-description">
          Somos una <strong>dulcería camagüeyana</strong>. Solo aceptamos pedidos para entrega o recogida en la provincia de <strong>Camagüey, Cuba</strong>.
        </p>
        <div class="footer-contact">
          <span class="footer-contact-label">📱 WhatsApp de Contacto:</span>
          <a href="https://wa.me/5351394921" class="footer-phone">+53 5139 4921</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} Dulcería El Líder. Todos los derechos reservados.</p>
      </div>
    </footer>

    <script is:inline>
      function updateGlobalOrderNav() {
        const orderLink = document.getElementById('nav-order-link');
        const orderBadge = document.getElementById('nav-order-badge');
        if (!orderLink || !orderBadge) return;
        
        try {
          const cartData = JSON.parse(localStorage.getItem('el_lider_cart') || '[]');
          const count = cartData.reduce((sum, item) => sum + item.quantity, 0);
          if (count > 0) {
            orderLink.style.display = 'inline-flex';
            orderBadge.textContent = count;
          } else {
            orderLink.style.display = 'none';
          }
        } catch (e) {
          orderLink.style.display = 'none';
        }
      }
      
      updateGlobalOrderNav();
      setInterval(updateGlobalOrderNav, 1000);
    </script>
  </body>
</html>

<style>
  /* ============================================================
     HEADER
     ============================================================ */
  .main-header {
    background: rgba(42, 10, 20, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 2px solid transparent;
    border-image: linear-gradient(90deg, #E8196C, #FF6B35) 1;
    position: sticky;
    top: 0;
    z-index: 100;
    transition: all var(--transition-fast);
  }

  .header-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.85rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo-area {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .logo-img {
    height: 44px;
    width: 44px;
    object-fit: cover;
  }

  .logo-text-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .logo-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 900;
    background: linear-gradient(135deg, #FFFFFF, #F5E6C8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: 1px;
    line-height: 1;
  }

  .logo-subtitle {
    font-size: 0.6rem;
    letter-spacing: 3px;
    color: rgba(245, 230, 200, 0.7);
    font-weight: 700;
    margin-top: 2px;
    text-transform: uppercase;
  }

  .main-nav {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .nav-link {
    font-weight: 700;
    font-size: 0.9rem;
    color: rgba(245, 230, 200, 0.85);
    letter-spacing: 0.5px;
    position: relative;
    padding: 0.5rem 0;
    transition: color var(--transition-fast);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--gradient-brand);
    transition: width var(--transition-fast);
    border-radius: 2px;
  }

  .nav-link:hover {
    color: #FFFFFF;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .order-badge {
    background: var(--gradient-brand);
    color: #fff;
    font-size: 0.7rem;
    padding: 1px 6px;
    border-radius: 10px;
    font-weight: bold;
  }

  /* ============================================================
     MAIN CONTENT
     ============================================================ */
  .main-content {
    flex: 1;
  }

  /* ============================================================
     FOOTER
     ============================================================ */
  .main-footer {
    background: linear-gradient(180deg, #A01050 0%, #7A0038 100%);
    color: var(--text-white);
    padding: 3.5rem 2rem 0;
    border-top: 3px solid transparent;
    border-image: linear-gradient(90deg, #E8196C, #FF6B35) 1;
  }

  .footer-inner {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
  }

  .footer-logo-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .footer-logo-img {
    height: 80px;
    width: 80px;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.35);
    box-shadow: 0 0 24px rgba(232, 25, 108, 0.4);
  }

  .footer-brand-name {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 900;
    color: #FFF8F0;
    margin: 0;
    letter-spacing: 1px;
  }

  .footer-description {
    font-size: 1.05rem;
    color: rgba(255, 248, 240, 0.9);
    line-height: 1.7;
    max-width: 440px;
  }

  .footer-description strong {
    color: #FFF8F0;
    font-weight: 800;
  }

  .footer-contact {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer-contact-label {
    color: rgba(255, 248, 240, 0.8);
  }

  .footer-phone {
    font-weight: 800;
    font-size: 1.1rem;
    color: #FF8C42;
    text-decoration: underline;
    transition: color var(--transition-fast);
  }

  .footer-phone:hover {
    color: #FFA07A;
  }

  .footer-bottom {
    max-width: var(--max-width);
    margin: 2.5rem auto 0;
    padding: 1.25rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    text-align: center;
    font-size: 0.82rem;
    color: rgba(255, 248, 240, 0.45);
  }

  /* ============================================================
     RESPONSIVE
     ============================================================ */
  @media (max-width: 768px) {
    .header-container {
      flex-direction: column;
      gap: 0.75rem;
      padding: 0.75rem 1.25rem;
    }
    .main-nav {
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: center;
    }
    .main-footer {
      padding: 3rem 1.25rem 0;
    }
  }
</style>
