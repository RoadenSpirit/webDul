---
import Layout from '../layouts/Layout.astro';
import { PRODUCTS } from '../data/products';

const cakes = PRODUCTS.filter(p => p.category === 'cakes' || p.category === 'minicakes');
const buffetItems = PRODUCTS.filter(p => p.category === 'reposteria' || p.category === 'salados');
---

<Layout title="Inicio - Dulcería por Encargo">
  <!-- Hero Section -->
  <section class="relative h-[80vh] min-h-[500px] flex items-center justify-center bg-cover bg-center text-center px-8" style="background-image: url('https://images.unsplash.com/photo-1578985545062-69928b1d9587?q=80&w=1600&auto=format&fit=crop');">
    <div class="absolute inset-0 bg-gradient-to-br from-[#58000a]/85 to-[#0c0c0c]/70 z-10"></div>
    <div class="relative z-20 max-w-3xl space-y-6">
      <div class="flex justify-center mb-2">
        <img src="/logo-correcto.png" alt="Dulcería El Líder Logo" class="h-24 w-24 sm:h-28 sm:w-28 object-cover rounded-full shadow-lg border-2 border-[var(--accent-color)]" style="aspect-ratio: 1/1;" />
      </div>
      <span class="inline-block bg-[#D4AF37] text-[#1C1917] px-5 py-1.5 font-bold text-xs uppercase tracking-[2px] rounded-full shadow-sm">Artesanal & Premium</span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-serif font-extrabold text-white leading-tight drop-shadow-md">El Arte de la Dulcería Fina</h1>
      <p class="text-lg sm:text-xl font-light text-white/95 max-w-2xl mx-auto leading-relaxed">Cakes exclusivos y dulces de alta calidad elaborados totalmente por encargo para hacer de tu celebración un momento inolvidable.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center pt-2">
        <a href="#catalogo" class="px-8 py-4 bg-gradient-to-r from-[#D4AF37] to-[#aa7c11] hover:from-[#aa7c11] hover:to-[#D4AF37] active:scale-[0.98] text-[#1C1917] font-bold text-base rounded-xl transition-all shadow-lg">Ver la Carta</a>
        <a href="#como-pedir" class="px-8 py-4 bg-transparent border-2 border-white hover:bg-white hover:text-[#1C1917] active:scale-[0.98] text-white font-bold text-base rounded-xl transition-all">¿Cómo pedir?</a>
      </div>
    </div>
  </section>

  <!-- Cakes Catalog Section -->
  <section id="catalogo" class="catalog-section">
    <div class="section-header">
      <span class="subtitle">Exquisiteces</span>
      <h2>¿Qué tipo de cake deseas para tu celebración?</h2>
      <div class="divider"></div>
      
      <!-- Subcategory filters (Pills) -->
      <div class="carousel-subcategories">
        <button class="subcategory-pill active" data-filter="all">Todos los Cakes</button>
        <button class="subcategory-pill" data-filter="minicakes">Mini Cakes</button>
        <button class="subcategory-pill" data-filter="redondos">Cakes Redondos</button>
        <button class="subcategory-pill" data-filter="bandeja">Cakes de Bandeja</button>
        <button class="subcategory-pill" data-filter="pisos">Cakes de Varios Pisos</button>
      </div>
    </div>

    <!-- Carousel Container (Large Cards) -->
    <div class="carousel-outer-wrapper">
      <button class="carousel-control prev" id="carousel-prev-btn" aria-label="Anterior">&lt;</button>
      <div class="carousel-viewport" id="carousel-viewport">
        <div class="carousel-track" id="carousel-track">
          {cakes.map(product => {
            // Determine subcategory filter type
            let filterType = 'all';
            if (product.id === 'minicake') filterType = 'minicakes';
            else if (product.id === 'cake-redondo') filterType = 'redondos';
            else if (product.id === 'cake-bandeja') filterType = 'bandeja';
            else if (product.id === 'cake-varios-pisos') filterType = 'pisos';

            return (
              <div class="product-card carousel-slide" data-filter-type={filterType} data-id={product.id}>
                <div class="product-image-container">
                  <img src={product.image} alt={product.name} class="product-image" loading="lazy" />
                  <span class="product-badge">{product.category === 'minicakes' ? 'MiniCake' : 'Cake'}</span>
                </div>
                <div class="product-info">
                  <h3>{product.name}</h3>
                  <p class="product-description">{product.description}</p>
                  <div class="product-meta">
                    <span class="product-price">
                      ${product.price} <span class="currency">CUP</span>
                      {product.priceNote && <span class="price-note">({product.priceNote})</span>}
                    </span>
                    <button 
                      class="add-to-cart-btn" 
                      data-id={product.id}
                      data-name={product.name}
                      data-price={product.price}
                      data-category={product.category}
                      data-customizable={product.customizable ? "true" : "false"}
                    >
                      + Agregar
                    </button>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
      <button class="carousel-control next" id="carousel-next-btn" aria-label="Siguiente">&gt;</button>
    </div>
  </section>

  <!-- Buffet & Dessert Offers Section -->
  <section id="buffet" class="buffet-section">
    <div class="section-header">
      <span class="subtitle">Ofertas Adicionales</span>
      <h2>Acompaña tu Fiesta (Buffet y Postres)</h2>
      <div class="divider"></div>
      <p class="section-desc">Exquisitos salados y dulces tradicionales para complementar tu celebración de manera perfecta.</p>
    </div>
    
    <div class="buffet-grid">
      {buffetItems.map(product => (
        <div class="buffet-card">
          <div class="buffet-image-container">
            <img src={product.image} alt={product.name} class="buffet-image" loading="lazy" />
          </div>
          <div class="buffet-info">
            <h3>{product.name}</h3>
            <p class="buffet-description">{product.description}</p>
            <div class="buffet-meta">
              <span class="buffet-price">${product.price} CUP c/u</span>
              <button 
                class="add-to-cart-btn" 
                data-id={product.id}
                data-name={product.name}
                data-price={product.price}
                data-category={product.category}
                data-customizable={product.customizable ? "true" : "false"}
              >
                + Añadir
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Gallery of Custom Decorations Section -->
  <section id="decoraciones" class="decorations-section">
    <div class="section-header">
      <span class="subtitle">Inspiración</span>
      <h2>Nuestras Decoraciones Personalizadas</h2>
      <div class="divider"></div>
      <p class="section-desc">Diseños artísticos elaborados a mano. Cada pastel es personalizado a tu gusto y temática de celebración.</p>
    </div>

    <div class="decorations-carousel-container">
      <button class="dec-carousel-control prev" id="dec-prev-btn" aria-label="Anterior">&lt;</button>
      <div class="decorations-viewport" id="dec-viewport">
        <div class="decorations-track" id="dec-track">
          <div class="decoration-slide">
            <img src="https://images.unsplash.com/photo-1535254973040-607b474cb50d?q=80&w=600&auto=format&fit=crop" alt="Decoración Infantil Dinosaurios" />
            <div class="decoration-overlay-info">
              <h4>Temática Infantil / Dinosaurios</h4>
              <p>Modelado artístico 2D y 3D en merengue fino.</p>
            </div>
          </div>
          <div class="decoration-slide">
            <img src="https://images.unsplash.com/photo-1557925923-cd4648e21187?q=80&w=600&auto=format&fit=crop" alt="Decoración Elegante Floral" />
            <div class="decoration-overlay-info">
              <h4>Diseño Elegante Floral</h4>
              <p>Detalles florales perfectos para bodas y aniversarios.</p>
            </div>
          </div>
          <div class="decoration-slide">
            <img src="https://images.unsplash.com/photo-1519869325930-281384150729?q=80&w=600&auto=format&fit=crop" alt="Decoración de Chocolate Premium" />
            <div class="decoration-overlay-info">
              <h4>Glaseado de Chocolate y Drips</h4>
              <p>Drips de chocolate gourmet y trufas seleccionadas.</p>
            </div>
          </div>
          <div class="decoration-slide">
            <img src="https://images.unsplash.com/photo-1588195538326-c5b1e9f80a1b?q=80&w=600&auto=format&fit=crop" alt="Fantasía Rosa y Sprinkles" />
            <div class="decoration-overlay-info">
              <h4>Fantasía en Rosa y Merengue</h4>
              <p>Tonos pasteles y chispas de colores para cumpleaños alegres.</p>
            </div>
          </div>
        </div>
      </div>
      <button class="dec-carousel-control next" id="dec-next-btn" aria-label="Siguiente">&gt;</button>
    </div>


  </section>

  <!-- Info Section / Como Pedir -->
  <section id="como-pedir" class="info-section">
    <div class="section-header">
      <span class="subtitle">Paso a Paso</span>
      <h2>¿Cómo funciona nuestro servicio por encargo?</h2>
      <div class="divider"></div>
    </div>
    
    <div class="steps-grid">
      <div class="step-card">
        <div class="step-icon">1</div>
        <h3>Selecciona tus Dulces</h3>
        <p>Explora nuestra carta exclusiva y elige tus cakes o bocaditos favoritos agregándolos al carrito de compras.</p>
      </div>
      <div class="step-card">
        <div class="step-icon">2</div>
        <h3>Personaliza tu Cake</h3>
        <p>En el carrito, define los colores, la temática o añade una <strong>Impresión Comestible</strong> subiendo tu propia imagen.</p>
      </div>
      <div class="step-card">
        <div class="step-icon">3</div>
        <h3>Envía por WhatsApp</h3>
        <p>Tu pedido se procesará automáticamente en un mensaje detallado para finalizar la cotización y agendar la fecha por WhatsApp.</p>
      </div>
    </div>
  </section>

  <!-- Interactive Customizer Section -->
  <section id="personalizador" class="customizer-section">
    <div class="section-header">
      <span class="subtitle">Creación a Medida</span>
      <h2>🎂 Diseña tu Cake Personalizado</h2>
      <div class="divider"></div>
      <p class="section-desc">Crea el pastel perfecto para tu fiesta y míralo dibujado al instante con nuestro ilustrador interactivo.</p>
    </div>

    <div class="customizer-grid">
      <!-- Visualizer Canvas -->
      <div class="customizer-visualizer">
        <canvas id="cake-canvas" width="300" height="300"></canvas>
      </div>

      <!-- Controls Panel -->
      <div class="customizer-controls">
        <div class="control-group">
          <label for="custom-size">📏 Selecciona la Categoría de Cake:</label>
          <select id="custom-size" class="customizer-select">
            <option value="minicake" data-price="2500" selected>Mini Cakes — $2500 CUP</option>
            <option value="cake-redondo" data-price="3500">Cakes Redondos (Base 20 cm) — $3500 CUP</option>
            <option value="cake-bandeja" data-price="5300">Cakes de Bandeja (Base Media Bandeja) — $5300 CUP</option>
            <option value="cake-varios-pisos" data-price="16500">Cakes de Varios Pisos — $16500 CUP</option>
          </select>
        </div>

        <div class="control-group" id="custom-dough-wrapper">
          <label for="custom-dough">🌾 Tipo de Masa:</label>
          <select id="custom-dough" class="customizer-select">
            <option value="trigo" selected>Harina de Trigo (Por defecto)</option>
            <option value="maicena">Maicena (Almidón de maíz)</option>
            <option value="capuchino">Capuchino</option>
          </select>
        </div>

        <div class="control-group">
          <label>🎨 Color de Cobertura:</label>
          <div class="color-picker-row">
            <input type="color" id="custom-color-picker" value="#FDFBF7" class="native-color-picker" title="Elige cualquier color personalizado" />
            <div class="color-swatches">
              <button class="color-swatch-btn active" data-color="#FDFBF7" data-name="Blanco Crema" style="background-color: #FDFBF7;"></button>
              <button class="color-swatch-btn" data-color="#FBCFE8" data-name="Rosa Pastel" style="background-color: #FBCFE8;"></button>
              <button class="color-swatch-btn" data-color="#BAE6FD" data-name="Azul Celeste" style="background-color: #BAE6FD;"></button>
              <button class="color-swatch-btn" data-color="#FEF08A" data-name="Amarillo Sol" style="background-color: #FEF08A;"></button>
              <button class="color-swatch-btn" data-color="#A7F3D0" data-name="Verde Menta" style="background-color: #A7F3D0;"></button>
              <button class="color-swatch-btn" data-color="#E9D5FF" data-name="Lila" style="background-color: #E9D5FF;"></button>
              <button class="color-swatch-btn" data-color="#D97706" data-name="Dorado Oro" style="background-color: #D97706;"></button>
              <button class="color-swatch-btn" data-color="#78350F" data-name="Chocolate" style="background-color: #78350F;"></button>
            </div>
          </div>
          <span class="selected-color-label">Color seleccionado: <strong id="color-name-display">Blanco Crema</strong></span>
        </div>

        <div class="control-group">
          <label for="custom-theme">✍️ Temática / Decoración (Opcional):</label>
          <input type="text" id="custom-theme" class="customizer-input" placeholder="Ej: Cumpleaños infantil, dinosaurios, feliz 30..." />
        </div>

        <div class="control-group">
          <label class="edible-print-option">
            <input type="checkbox" id="custom-print" />
            Añadir Impresión Comestible
          </label>
        </div>

        <div class="price-display-box">
          <span>Precio Estimado:</span>
          <span id="customizer-price-display" class="price-value">$2500 CUP</span>
        </div>

        <button id="add-custom-cake-btn" class="btn btn-primary btn-block">
          🛒 Añadir Cake Diseñado al Carrito
        </button>
      </div>
    </div>
  </section>

  <!-- Floating Cart Button -->
  <button id="floating-cart-btn" class="floating-cart">
    <span class="cart-icon">🛒</span>
    <span class="cart-count">0</span>
  </button>

  <!-- Cart Drawer/Sidebar -->
  <div id="cart-drawer" class="cart-drawer">
    <div class="cart-drawer-overlay"></div>
    <div class="cart-drawer-content">
      <div class="cart-header">
        <h2>Tu Encargo</h2>
        <button id="close-cart-btn" class="close-btn">&times;</button>
      </div>
      
      <div id="cart-items-container" class="cart-items-container">
        <!-- Rendered dynamically by JS -->
        <div class="empty-cart-message">
          <p>Tu carrito está vacío</p>
          <a href="#catalogo" id="explore-btn" class="btn btn-outline btn-sm">Explorar la Carta</a>
        </div>
      </div>

      <div class="cart-footer">
        <div class="cart-summary-row total-row">
          <span>Total Estimado</span>
          <span id="cart-total">$0 CUP</span>
        </div>
        <button id="go-to-checkout-btn" class="btn btn-primary btn-block" style="margin-top: 1rem;">
          Continuar con el Encargo ➔
        </button>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* General Components */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 2rem;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: var(--border-radius-md);
    cursor: pointer;
    transition: all var(--transition-fast);
    border: none;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--accent-color), var(--accent-dark));
    color: #0D0D0D;
    box-shadow: var(--shadow-md);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-gold);
    background: linear-gradient(135deg, #f7d25b, var(--accent-color));
  }

  .btn-outline {
    background-color: transparent;
    color: var(--text-white);
    border: 2px solid var(--text-white);
  }

  .btn-outline:hover {
    background-color: var(--text-white);
    color: var(--primary-dark);
  }

  .btn-block {
    width: 100%;
  }

  .btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
  }

  /* Sections general */
  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-header .subtitle {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--accent-dark);
    font-weight: 700;
    display: block;
    margin-bottom: 0.5rem;
  }

  .section-header h2 {
    font-size: 2.5rem;
    color: var(--accent-color);
  }

  .divider {
    width: 60px;
    height: 3px;
    background-color: var(--accent-color);
    margin: 1rem auto 0;
  }

  /* Info Section / Cómo Pedir */
  .info-section {
    padding: 6rem 2rem;
    background-color: var(--bg-secondary);
  }

  .steps-grid {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 3rem;
  }

  .step-card {
    background-color: var(--bg-card);
    padding: 3rem 2rem;
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-sm);
    text-align: center;
    border: 1px solid var(--border-color);
    position: relative;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .step-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent-color);
  }

  .step-icon {
    width: 50px;
    height: 50px;
    background-color: var(--primary-color);
    color: var(--text-white);
    font-size: 1.5rem;
    font-weight: 700;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    border: 2px solid var(--accent-color);
  }

  .step-card h3 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    color: var(--accent-color);
  }

  .step-card p {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  /* Catalog / Products Section */
  .catalog-section {
    padding: 6rem 2rem;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .category-filters {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    padding: 0.6rem 1.5rem;
    border-radius: 50px;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }

  .filter-btn:hover, .filter-btn.active {
    background-color: var(--primary-color);
    color: var(--text-white);
    border-color: var(--primary-color);
    box-shadow: var(--shadow-sm);
  }

  /* Products Grid */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2.5rem;
  }

  .product-card {
    background-color: var(--bg-card);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-color);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    display: flex;
    flex-direction: column;
  }

  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }

  .product-image-container {
    height: 240px;
    position: relative;
    overflow: hidden;
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .product-card:hover .product-image {
    transform: scale(1.05);
  }

  .product-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background-color: rgba(140, 13, 27, 0.9);
    color: var(--text-white);
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    border-radius: 50px;
    border: 1px solid var(--accent-color);
  }

  .product-info {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-info h3 {
    font-size: 1.35rem;
    margin-bottom: 0.75rem;
    color: var(--accent-color);
  }

  .product-description {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .product-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
  }

  .product-price {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-light);
  }

  .product-price .currency {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .price-note {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-light);
    display: block;
  }

  .add-to-cart-btn {
    background-color: var(--primary-color);
    border: none;
    color: var(--text-white);
    padding: 0.6rem 1.4rem;
    border-radius: var(--border-radius-md);
    cursor: pointer;
    font-weight: 700;
    font-size: 0.85rem;
    transition: all var(--transition-fast);
  }

  .add-to-cart-btn:hover {
    background-color: var(--primary-light);
    transform: translateY(-1px);
  }

  /* Floating Cart Button */
  .floating-cart {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
    color: var(--text-white);
    width: 65px;
    height: 65px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(140, 13, 27, 0.4);
    cursor: pointer;
    z-index: 99;
    border: 2px solid var(--accent-color);
    transition: transform var(--transition-fast);
  }

  .floating-cart:hover {
    transform: scale(1.05);
  }

  .cart-icon {
    font-size: 1.5rem;
  }

  .cart-count {
    position: absolute;
    top: -5px;
    right: -5px;
    background-color: var(--accent-color);
    color: var(--text-primary);
    width: 25px;
    height: 25px;
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--primary-dark);
  }

  /* Cart Drawer/Sidebar */
  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    visibility: hidden;
    transition: visibility var(--transition-normal);
  }

  .cart-drawer.open {
    visibility: visible;
  }

  .cart-drawer-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(10, 5, 6, 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .cart-drawer.open .cart-drawer-overlay {
    opacity: 1;
  }

  .cart-drawer-content {
    position: absolute;
    top: 0;
    right: -100%;
    width: 100%;
    max-width: 480px;
    height: 100%;
    background-color: var(--bg-primary);
    border-left: 2px solid var(--accent-color);
    box-shadow: -10px 0 40px rgba(0, 0, 0, 0.15);
    transition: right var(--transition-normal);
    display: flex;
    flex-direction: column;
  }

  .cart-drawer.open .cart-drawer-content {
    right: 0;
  }

  .cart-header {
    padding: 1.5rem;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--bg-secondary);
  }

  .cart-header h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--accent-color);
    letter-spacing: 0.5px;
  }

  .close-btn {
    background: none;
    border: none;
    font-size: 2.2rem;
    line-height: 1;
    cursor: pointer;
    color: var(--text-secondary);
    transition: transform var(--transition-normal), color var(--transition-normal);
  }

  .close-btn:hover {
    color: var(--accent-color);
    transform: rotate(90deg);
  }

  .cart-items-container {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
    scrollbar-width: thin;
    scrollbar-color: var(--accent-color) var(--bg-card);
  }

  .empty-cart-message {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--text-secondary);
  }

  .empty-cart-message p {
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
  }

  /* Cart Item Card */
  .cart-item {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-md);
    padding: 1rem;
    margin-bottom: 1.25rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    transition: transform var(--transition-fast);
  }

  .cart-item:hover {
    border-color: var(--accent-color);
  }

  .cart-item-row {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .cart-item-thumbnail-container {
    width: 72px;
    height: 72px;
    border-radius: var(--border-radius-sm);
    overflow: hidden;
    border: 2px solid var(--border-color);
    flex-shrink: 0;
    background-color: var(--bg-primary);
  }

  .cart-item-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-item-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .cart-item-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.75rem;
  }

  .cart-item-title {
    flex: 1;
    margin-right: 1.25rem;
  }

  .cart-item-title h4 {
    font-family: var(--font-sans);
    font-weight: 700;
    color: var(--text-primary);
    font-size: 1.05rem;
    word-break: break-word;
  }

  .cart-item-price {
    font-weight: 700;
    color: var(--accent-light);
    font-size: 1rem;
  }

  .cart-item-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .quantity-controller {
    display: flex;
    align-items: center;
    border: 1.5px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    overflow: hidden;
    background-color: var(--bg-card);
  }

  .qty-btn {
    background-color: var(--bg-secondary);
    border: none;
    width: 28px;
    height: 28px;
    font-size: 1.1rem;
    font-weight: bold;
    cursor: pointer;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--transition-fast);
  }

  .qty-btn:hover {
    background-color: var(--accent-light);
  }

  .qty-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .qty-value {
    width: 36px;
    text-align: center;
    font-weight: 600;
  }

  .remove-item-btn {
    background: none;
    border: none;
    color: #b81d24;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 600;
  }

  /* Customization block inside cart item */
  .cart-item-customization {
    background-color: var(--bg-secondary);
    padding: 0.85rem;
    border-radius: var(--border-radius-sm);
    border-left: 3px solid var(--accent-color);
    margin-top: 0.75rem;
  }

  .customization-title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
    display: block;
  }

  .custom-note-textarea {
    width: 100%;
    height: 60px;
    padding: 0.5rem;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    resize: none;
    margin-bottom: 0.75rem;
  }

  .custom-note-textarea::placeholder {
    color: var(--text-light);
  }

  .edible-print-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    margin-bottom: 0.5rem;
  }

  .edible-print-option input {
    accent-color: var(--primary-color);
    width: 16px;
    height: 16px;
  }

  .upload-area {
    margin-top: 0.5rem;
    border: 1px dashed var(--accent-dark);
    padding: 0.5rem;
    border-radius: var(--border-radius-sm);
    text-align: center;
    background-color: var(--bg-card);
    position: relative;
    cursor: pointer;
  }

  .upload-label {
    font-size: 0.75rem;
    color: var(--text-secondary);
    display: block;
  }

  .upload-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  .file-preview {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    color: var(--accent-light);
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
  }

  .file-preview img {
    width: 30px;
    height: 30px;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid var(--border-color);
  }

  /* Cart Footer */
  .cart-footer {
    background-color: var(--bg-card);
    border-top: 1px solid var(--border-color);
    padding: 1.5rem;
  }

  .cart-date-picker {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .cart-date-picker label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .cart-date-picker input[type="date"],
  .cart-date-picker input[type="time"] {
    padding: 0.6rem;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    outline: none;
    color: var(--text-primary);
    background-color: var(--bg-primary);
  }

  .cart-date-picker input[type="date"]:focus,
  .cart-date-picker input[type="time"]:focus {
    border-color: var(--accent-color);
    box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.2);
  }

  .dough-selector-container {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .dough-select {
    padding: 0.4rem;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    font-size: 0.85rem;
    background-color: var(--bg-primary);
    color: var(--text-primary);
    outline: none;
  }

  .dough-select:focus {
    border-color: var(--accent-color);
  }

  .dough-warning-banner {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--accent-color);
    padding: 0.5rem;
    font-size: 0.75rem;
    border-radius: var(--border-radius-sm);
    margin-top: 0.25rem;
    line-height: 1.3;
  }

  .cart-summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
    color: var(--text-secondary);
  }

  .total-row {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--accent-color);
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 2px double var(--border-color);
  }

  .cart-note-warning {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--accent-color);
    padding: 0.75rem;
    font-size: 0.8rem;
    border-radius: var(--border-radius-sm);
    margin: 1rem 0;
    line-height: 1.4;
  }

  /* Interactive Customizer */
  .customizer-section {
    padding: 4rem 1.5rem;
    background-color: var(--bg-primary);
  }

  .customizer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto;
    background-color: var(--bg-card);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 1.5rem;
    border: 1px solid var(--border-color);
  }

  @media (min-width: 768px) {
    .customizer-grid {
      grid-template-columns: 1fr 1.2fr;
      padding: 2.5rem;
      gap: 3rem;
    }
  }

  .customizer-visualizer {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle, #2a1518, #0e0507);
    border-radius: var(--border-radius-md);
    border: 2px solid var(--accent-color);
    box-shadow: var(--shadow-inner);
    padding: 1rem;
    min-height: 320px;
  }

  #cake-canvas {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .customizer-controls {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .control-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .control-group label {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .customizer-select,
  .customizer-input {
    padding: 0.7rem;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    background-color: var(--bg-primary);
    color: var(--text-primary);
    outline: none;
    width: 100%;
  }

  .customizer-select:focus,
  .customizer-input:focus {
    border-color: var(--accent-color);
  }

  .color-picker-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .native-color-picker {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    width: 56px;
    height: 56px;
    border: 3px solid var(--accent-color);
    border-radius: 50%;
    background: none;
    cursor: pointer;
    padding: 0;
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-fast);
  }

  .native-color-picker:hover {
    transform: scale(1.08);
  }

  .native-color-picker::-webkit-color-swatch-wrapper {
    padding: 0;
  }

  .native-color-picker::-webkit-color-swatch {
    border: none;
    border-radius: 50%;
  }

  .color-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    flex: 1;
  }

  .color-swatch-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid var(--border-color);
    cursor: pointer;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .color-swatch-btn:hover {
    transform: scale(1.1);
  }

  .color-swatch-btn.active {
    border-color: var(--accent-color);
    transform: scale(1.15);
    box-shadow: 0 0 0 2px var(--bg-card), 0 0 0 4px var(--accent-color);
  }

  .selected-color-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .price-display-box {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--bg-primary);
    padding: 0.9rem;
    border-radius: var(--border-radius-sm);
    border-left: 4px solid var(--accent-color);
  }

  .price-display-box span {
    font-weight: 700;
    color: var(--text-secondary);
  }

  .price-display-box .price-value {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--accent-light);
  }

  /* Catalog & Carousel */
  .catalog-section {
    padding: 4rem 1.5rem;
    background-color: var(--bg-primary);
  }

  .carousel-subcategories {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    padding-bottom: 0.75rem;
    margin-top: 1.5rem;
    justify-content: flex-start;
    scrollbar-width: none; /* Firefox */
  }

  .carousel-subcategories::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  @media (min-width: 768px) {
    .carousel-subcategories {
      justify-content: center;
    }
  }

  .subcategory-pill {
    padding: 0.5rem 1.25rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    white-space: nowrap;
    transition: all var(--transition-fast);
  }

  .subcategory-pill:hover,
  .subcategory-pill.active {
    background: linear-gradient(135deg, var(--accent-color), var(--accent-dark));
    color: var(--text-primary);
    border-color: var(--accent-color);
    box-shadow: var(--shadow-sm);
  }

  .carousel-outer-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 1200px;
    margin: 2rem auto 0 auto;
    padding: 0 0.5rem;
  }

  .carousel-viewport {
    overflow: hidden;
    width: 100%;
  }

  .carousel-track {
    display: flex;
    gap: 1.5rem;
    transition: transform 0.4s ease-in-out;
  }

  .carousel-slide {
    flex: 0 0 100%;
    max-width: 100%;
    box-sizing: border-box;
    transition: opacity 0.3s ease;
  }

  /* Large Card Sizes */
  @media (min-width: 600px) {
    .carousel-slide {
      flex: 0 0 calc(50% - 0.75rem);
      max-width: calc(50% - 0.75rem);
    }
  }

  @media (min-width: 992px) {
    .carousel-slide {
      flex: 0 0 calc(33.333% - 1rem);
      max-width: calc(33.333% - 1rem);
    }
  }

  .carousel-control {
    background-color: var(--primary-dark);
    color: var(--accent-color);
    border: 2px solid var(--accent-color);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-size: 1.25rem;
    font-weight: bold;
    cursor: pointer;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-md);
    transition: all var(--transition-fast);
  }

  .carousel-control:hover {
    background-color: var(--accent-color);
    color: var(--primary-dark);
    transform: translateY(-50%) scale(1.1);
  }

  .carousel-control.prev {
    left: -22px;
  }

  .carousel-control.next {
    right: -22px;
  }

  @media (max-width: 600px) {
    .carousel-control {
      width: 38px;
      height: 38px;
      font-size: 1rem;
      background-color: rgba(10, 5, 6, 0.85);
    }
    .carousel-control.prev {
      left: 8px;
    }
    .carousel-control.next {
      right: 8px;
    }
  }

  .product-card {
    min-height: 460px;
    display: flex;
    flex-direction: column;
  }

  .product-image-container {
    height: 250px;
  }

  .product-image {
    height: 100%;
  }

  /* Buffet Section Grid */
  .buffet-section {
    padding: 4rem 1.5rem;
    background-color: var(--bg-card);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .buffet-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 2.5rem auto 0 auto;
  }

  .buffet-card {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .buffet-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .buffet-image-container {
    height: 200px;
    overflow: hidden;
  }

  .buffet-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .buffet-info {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .buffet-info h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.15rem;
    color: var(--accent-color);
  }

  .buffet-description {
    margin: 0 0 1.5rem 0;
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.5;
    flex: 1;
  }

  .buffet-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .buffet-price {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--primary-color);
  }

  #checkout-whatsapp-btn {
    background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
    border: none;
    color: #FFFFFF;
    font-weight: 700;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3);
    animation: whatsappPulse 2.5s infinite;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  #checkout-whatsapp-btn:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.45);
    background: linear-gradient(135deg, #2ae772 0%, #16a090 100%);
  }

  @keyframes whatsappPulse {
    0% {
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.6);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(37, 211, 102, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0);
    }
  }

  /* Decorations Gallery Section */
  .decorations-section {
    padding: 5rem 2rem;
    background-color: var(--bg-primary);
    border-top: 1px solid var(--border-color);
  }

  .decorations-carousel-container {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 1000px;
    margin: 2rem auto 0 auto;
    padding: 0 0.5rem;
  }

  .decorations-viewport {
    overflow: hidden;
    width: 100%;
    border-radius: var(--border-radius-md);
    box-shadow: var(--shadow-lg);
  }

  .decorations-track {
    display: flex;
    transition: transform 0.4s ease-in-out;
  }

  .decoration-slide {
    flex: 0 0 100%;
    max-width: 100%;
    position: relative;
    height: 400px;
  }

  .decoration-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .decoration-overlay-info {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background: linear-gradient(to top, rgba(10, 5, 6, 0.9) 0%, rgba(10, 5, 6, 0.4) 70%, transparent 100%);
    padding: 2rem 1.5rem 1.5rem 1.5rem;
    color: var(--text-white);
  }

  .decoration-overlay-info h4 {
    font-size: 1.3rem;
    color: var(--accent-color);
    margin-bottom: 0.5rem;
    font-weight: 800;
  }

  .decoration-overlay-info p {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .dec-carousel-control {
    background-color: var(--primary-dark);
    color: var(--accent-color);
    border: 2px solid var(--accent-color);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-size: 1.25rem;
    font-weight: bold;
    cursor: pointer;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-md);
    transition: all var(--transition-fast);
  }

  .dec-carousel-control:hover {
    background-color: var(--accent-color);
    color: var(--primary-dark);
    transform: translateY(-50%) scale(1.1);
  }

  .dec-carousel-control.prev {
    left: -22px;
  }

  .dec-carousel-control.next {
    right: -22px;
  }

  .decorations-warning-banner {
    max-width: 1000px;
    margin: 2rem auto 0 auto;
    background-color: #fffbeb;
    border: 1px solid #fef3c7;
    color: #b45309;
    padding: 1rem;
    border-radius: var(--border-radius-sm);
    font-size: 0.9rem;
    line-height: 1.4;
    text-align: center;
    box-shadow: var(--shadow-sm);
  }

  @media (max-width: 768px) {
    .decoration-slide {
      height: 300px;
    }
    .dec-carousel-control {
      width: 36px;
      height: 36px;
      font-size: 1rem;
    }
    .dec-carousel-control.prev {
      left: 5px;
    }
    .dec-carousel-control.next {
      right: 5px;
    }
  }

  /* Responsive styling */
  @media (max-width: 480px) {
    .btn {
      width: 100%;
    }
    .cart-drawer-content {
      max-width: 100%;
    }
    .cart-items-container {
      padding: 1rem;
    }
    .cart-footer {
      padding: 1rem;
    }
    .cart-item {
      padding: 1rem;
      margin-bottom: 1rem;
    }
    .total-row {
      font-size: 1.15rem;
    }
    #checkout-whatsapp-btn {
      padding: 0.85rem;
      font-size: 0.95rem;
    }
  }
</style>

<script>
  // DOM Elements
  const addToCartButtons = document.querySelectorAll('.add-to-cart-btn');
  const floatingCartBtn = document.getElementById('floating-cart-btn');
  const closeCartBtn = document.getElementById('close-cart-btn');
  const cartDrawer = document.getElementById('cart-drawer');
  const cartOverlay = document.querySelector('.cart-drawer-overlay');
  const cartItemsContainer = document.getElementById('cart-items-container');
  const cartTotalEl = document.getElementById('cart-total');
  const goToCheckoutBtn = document.getElementById('go-to-checkout-btn');
  const cartCountEl = document.querySelector('.cart-count');

  // Carousel DOM Elements
  const carouselTrack = document.getElementById('carousel-track');
  const carouselPrevBtn = document.getElementById('carousel-prev-btn');
  const carouselNextBtn = document.getElementById('carousel-next-btn');
  const carouselViewport = document.getElementById('carousel-viewport');

  // Decorations Carousel DOM Elements
  const decTrack = document.getElementById('dec-track');
  const decPrevBtn = document.getElementById('dec-prev-btn');
  const decNextBtn = document.getElementById('dec-next-btn');

  // Customizer DOM Elements
  const cakeCanvas = document.getElementById('cake-canvas') as HTMLCanvasElement | null;
  const customSizeSelect = document.getElementById('custom-size') as HTMLSelectElement | null;
  const customDoughSelect = document.getElementById('custom-dough') as HTMLSelectElement | null;
  const colorSwatches = document.querySelectorAll('.color-swatch-btn');
  const customColorPicker = document.getElementById('custom-color-picker') as HTMLInputElement | null;
  const colorNameDisplay = document.getElementById('color-name-display');
  const customThemeInput = document.getElementById('custom-theme') as HTMLInputElement | null;
  const customPrintCheckbox = document.getElementById('custom-print') as HTMLInputElement | null;
  const customPriceDisplay = document.getElementById('customizer-price-display');
  const addCustomCakeBtn = document.getElementById('add-custom-cake-btn');
  let cart = [];

  // 1. Cakes Carousel Autoplay, Filtering and Controls
  let carouselIndex = 0;
  let autoplayInterval;
  let currentFilter = 'all';

  // Subcategory filter click logic
  const subcategoryPills = document.querySelectorAll('.subcategory-pill');
  subcategoryPills.forEach(pill => {
    pill.addEventListener('click', () => {
      stopAutoplay();
      subcategoryPills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      
      currentFilter = pill.getAttribute('data-filter') || 'all';
      carouselIndex = 0; // Reset index
      
      filterCarouselSlides();
      updateCarousel();
    });
  });

  function filterCarouselSlides() {
    if (!carouselTrack) return;
    const slides = carouselTrack.querySelectorAll('.carousel-slide');
    slides.forEach(slide => {
      const type = slide.getAttribute('data-filter-type');
      if (currentFilter === 'all' || type === currentFilter) {
        (slide as HTMLElement).style.display = 'flex';
      } else {
        (slide as HTMLElement).style.display = 'none';
      }
    });
  }

  function getVisibleSlides() {
    if (!carouselTrack) return [];
    return Array.from(carouselTrack.querySelectorAll('.carousel-slide')).filter(
      slide => (slide as HTMLElement).style.display !== 'none'
    );
  }

  function updateCarousel() {
    if (!carouselTrack) return;
    const visibleSlides = getVisibleSlides();
    if (visibleSlides.length === 0) return;

    // Determine how many items are visible (1 on mobile, 2 on tablet, 3 on desktop)
    let itemsVisible = 1;
    if (window.innerWidth >= 992) {
      itemsVisible = 3;
    } else if (window.innerWidth >= 600) {
      itemsVisible = 2;
    }

    const maxIndex = Math.max(0, visibleSlides.length - itemsVisible);
    if (carouselIndex > maxIndex) carouselIndex = 0;
    if (carouselIndex < 0) carouselIndex = maxIndex;

    const slideWidth = (visibleSlides[0] as HTMLElement).getBoundingClientRect().width;
    
    // Calculate gap dynamically from CSS
    const trackStyle = window.getComputedStyle(carouselTrack);
    const gap = parseFloat(trackStyle.gap) || 24;
    const offset = -carouselIndex * (slideWidth + gap);
    
    carouselTrack.style.transform = `translateX(${offset}px)`;
  }

  function startAutoplay() {
    if (autoplayInterval) clearInterval(autoplayInterval);
    autoplayInterval = setInterval(() => {
      const visibleSlides = getVisibleSlides();
      let itemsVisible = 1;
      if (window.innerWidth >= 992) itemsVisible = 3;
      else if (window.innerWidth >= 600) itemsVisible = 2;

      const maxIndex = Math.max(0, visibleSlides.length - itemsVisible);
      
      if (carouselIndex >= maxIndex) {
        carouselIndex = 0;
      } else {
        carouselIndex++;
      }
      updateCarousel();
    }, 4000);
  }

  function stopAutoplay() {
    if (autoplayInterval) {
      clearInterval(autoplayInterval);
      autoplayInterval = null;
    }
  }

  // Stop autoplay on click anywhere in the carousel area
  const carouselWrapper = document.querySelector('.carousel-outer-wrapper');
  carouselWrapper?.addEventListener('click', stopAutoplay);
  carouselWrapper?.addEventListener('touchstart', stopAutoplay);

  if (carouselPrevBtn && carouselNextBtn) {
    carouselPrevBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      stopAutoplay();
      carouselIndex--;
      updateCarousel();
    });

    carouselNextBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      stopAutoplay();
      carouselIndex++;
      updateCarousel();
    });

    // Initial setup
    window.addEventListener('resize', () => {
      filterCarouselSlides();
      updateCarousel();
    });
    
    filterCarouselSlides();
    updateCarousel();
    startAutoplay();
  }

  // Decorations Carousel Navigation
  let decIndex = 0;
  if (decPrevBtn && decNextBtn && decTrack) {
    const decSlides = decTrack.children;
    const maxDecIndex = decSlides.length - 1;

    const updateDecCarousel = () => {
      if (decIndex < 0) decIndex = maxDecIndex;
      if (decIndex > maxDecIndex) decIndex = 0;
      decTrack.style.transform = `translateX(-${decIndex * 100}%)`;
    };

    decPrevBtn.addEventListener('click', () => {
      decIndex--;
      updateDecCarousel();
    });

    decNextBtn.addEventListener('click', () => {
      decIndex++;
      updateDecCarousel();
    });
  }

  // 2. Interactive Cake Customizer (Canvas Game Style Drawing)
  let activeColor = '#FDFBF7';
  let activeColorName = 'Blanco Crema';

  // Seed-based random number generator to eliminate drawing parpadeo (jitter)
  function seedRandom(seed) {
    const x = Math.sin(seed) * 10000;
    return x - Math.floor(x);
  }

  function drawCake() {
    if (!cakeCanvas) return;
    const ctx = cakeCanvas.getContext('2d');
    if (!ctx) return;

    // High-DPI screen adjustments (sharp vector rendering on retina displays)
    const dpr = window.devicePixelRatio || 1;
    cakeCanvas.width = 300 * dpr;
    cakeCanvas.height = 300 * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    ctx.clearRect(0, 0, 300, 300);

    const sizeVal = customSizeSelect?.value || 'minicake-15';
    const selectedOption = customSizeSelect?.options[customSizeSelect.selectedIndex];
    const cakeType = selectedOption?.getAttribute('data-type') || 'minicake';

    const cx = 150;
    const cy = 175;

    // Draw Board (Plate/Base)
    ctx.beginPath();
    ctx.ellipse(cx, cy + 35, 120, 20, 0, 0, 2 * Math.PI);
    ctx.fillStyle = '#E5E7EB';
    ctx.fill();
    ctx.strokeStyle = '#2d181b';
    ctx.lineWidth = 4;
    ctx.stroke();

    // Golden Rim
    ctx.beginPath();
    ctx.ellipse(cx, cy + 35, 110, 15, 0, 0, 2 * Math.PI);
    ctx.fillStyle = '#F59E0B';
    ctx.fill();

    // Scale mapping for visualizer sizes
    let radius = 70;
    let height = 70;

    if (cakeType === '2pisos') {
      // Bottom Tier
      drawCartoonCylinder(ctx, cx, cy + 25, 80, 50, activeColor);
      // Top Tier
      drawCartoonCylinder(ctx, cx, cy - 25, 55, 42, activeColor);
      
      // Cream layers
      drawWavyFrostingLine(ctx, cx, cy + 25, 80);
      drawWavyFrostingLine(ctx, cx, cy - 25, 55);
      
      // Sprinkles on top
      drawSprinkles(ctx, cx, cy - 67, 50);
      // Top decoration (Cherry)
      drawCherry(ctx, cx, cy - 73);
    } else if (cakeType === 'bandeja' || cakeType === 'mediobandeja') {
      // Rectangular box
      let width = cakeType === 'bandeja' ? 180 : 130;
      let depth = cakeType === 'bandeja' ? 110 : 80;
      drawCartoonRectangular(ctx, cx, cy + 15, width, depth, 55, activeColor);
    } else {
      // Cylinder sizes based on real types
      if (cakeType === 'minicake') {
        radius = 50;
        height = 55;
      } else if (cakeType === 'estandar') {
        radius = 68;
        height = 68;
      } else if (cakeType === 'mediano') {
        radius = 76;
        height = 74;
      } else if (cakeType === 'grande') {
        radius = 86;
        height = 80;
      } else if (cakeType === 'gigante') {
        radius = 96;
        height = 86;
      }

      drawCartoonCylinder(ctx, cx, cy + 20, radius, height, activeColor);
      drawWavyFrostingLine(ctx, cx, cy + 20, radius);
      
      // Sprinkles on top
      drawSprinkles(ctx, cx, cy + 20 - height, radius);
      
      // Candles or Cherry on top
      if (cakeType === 'minicake') {
        drawCherry(ctx, cx, cy + 20 - height - 5);
      } else {
        drawCandles(ctx, cx, cy + 20 - height, radius);
      }
    }
  }

  // Illustrates a cylinder with clean outlines and cartoon highlights
  function drawCartoonCylinder(ctx, x, y, r, h, color) {
    const strokeStyle = '#2d181b';
    const lineWidth = 4;

    // Cylinder body outline & fill
    ctx.beginPath();
    ctx.moveTo(x - r, y);
    ctx.lineTo(x - r, y - h);
    ctx.ellipse(x, y - h, r, r * 0.3, 0, Math.PI, 2 * Math.PI);
    ctx.lineTo(x + r, y);
    ctx.ellipse(x, y, r, r * 0.3, 0, 0, Math.PI);
    ctx.closePath();
    ctx.fillStyle = color;
    ctx.fill();
    ctx.strokeStyle = strokeStyle;
    ctx.lineWidth = lineWidth;
    ctx.stroke();

    // 3D Shadow styling (shading on right)
    ctx.save();
    ctx.clip();
    const grad = ctx.createLinearGradient(x - r, y, x + r, y);
    grad.addColorStop(0, 'rgba(0,0,0,0.15)');
    grad.addColorStop(0.3, 'rgba(0,0,0,0.0)');
    grad.addColorStop(0.7, 'rgba(255,255,255,0.15)');
    grad.addColorStop(1, 'rgba(0,0,0,0.25)');
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.rect(x - r, y - h - 10, r * 2, h + 20);
    ctx.fill();
    ctx.restore();

    // Top ellipse outline & fill
    ctx.beginPath();
    ctx.ellipse(x, y - h, r, r * 0.3, 0, 0, 2 * Math.PI);
    ctx.fillStyle = color;
    ctx.fill();
    ctx.strokeStyle = strokeStyle;
    ctx.lineWidth = lineWidth;
    ctx.stroke();

    // Frosting drips on sides (cartoon aesthetic)
    ctx.fillStyle = '#FFFFFF';
    ctx.beginPath();
    ctx.ellipse(x, y - h, r, r * 0.3, 0, 0, 2 * Math.PI);
    ctx.fill();
    
    // Wave drips on sides
    ctx.beginPath();
    ctx.moveTo(x - r, y - h);
    // Drips using bezier/arcs
    const numDrips = 6;
    for (let i = 0; i <= numDrips; i++) {
      const angle = Math.PI + (i / numDrips) * Math.PI;
      const dx = x + Math.cos(angle) * r;
      const dy = y - h + Math.sin(angle) * r * 0.3;
      
      const dripHeight = 10 + Math.sin(i * 1.5) * 6;
      ctx.lineTo(dx, dy + dripHeight);
    }
    ctx.ellipse(x, y - h, r, r * 0.3, 0, 0, Math.PI, true);
    ctx.closePath();
    ctx.fill();
  }

  function drawWavyFrostingLine(ctx, x, y, r) {
    ctx.fillStyle = '#FFFFFF';
    ctx.strokeStyle = '#2d181b';
    ctx.lineWidth = 3.5;
    ctx.beginPath();
    
    const steps = 36;
    for (let i = 0; i <= steps; i++) {
      const angle = (i / steps) * Math.PI * 2;
      const wave = Math.sin(angle * 14) * 3.5;
      const dx = x + Math.cos(angle) * (r + wave);
      const dy = y + Math.sin(angle) * (r * 0.3 + wave * 0.3);
      if (i === 0) {
        ctx.moveTo(dx, dy);
      } else {
        ctx.lineTo(dx, dy);
      }
    }
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
  }

  function drawSprinkles(ctx, x, y, r) {
    const colors = ['#EF4444', '#3B82F6', '#10B981', '#F59E0B', '#EC4899', '#8B5CF6'];
    for (let i = 0; i < 20; i++) {
      const seedAngle = seedRandom(i + r + 1);
      const seedDist = seedRandom(i + r + 2);
      const angle = seedAngle * Math.PI * 2;
      const dist = seedDist * r * 0.8;
      const sx = x + Math.cos(angle) * dist;
      const sy = y + Math.sin(angle) * dist * 0.3;
      
      ctx.fillStyle = colors[i % colors.length];
      ctx.fillRect(sx, sy, 4, 2);
    }
  }

  function drawCherry(ctx, x, y) {
    // Stem
    ctx.beginPath();
    ctx.moveTo(x, y - 8);
    ctx.quadraticCurveTo(x + 10, y - 20, x + 5, y - 25);
    ctx.strokeStyle = '#10B981';
    ctx.lineWidth = 3;
    ctx.stroke();

    // Cherry ball
    ctx.beginPath();
    ctx.arc(x, y - 4, 8, 0, 2 * Math.PI);
    ctx.fillStyle = '#DC2626';
    ctx.fill();
    ctx.strokeStyle = '#2d181b';
    ctx.lineWidth = 3;
    ctx.stroke();

    // Shine Highlight
    ctx.beginPath();
    ctx.arc(x - 3, y - 7, 2, 0, 2 * Math.PI);
    ctx.fillStyle = '#FFFFFF';
    ctx.fill();
  }

  function drawCandles(ctx, x, y, r) {
    const numCandles = r > 70 ? 3 : 2;
    const offsets = numCandles === 3 ? [-20, 0, 20] : [-15, 15];

    offsets.forEach(offset => {
      const cx = x + offset;
      const cy = y + Math.sin(offset * 0.05) * 10;
      
      // Candle stick
      ctx.fillStyle = '#3B82F6';
      ctx.fillRect(cx - 3, cy - 22, 6, 22);
      ctx.strokeStyle = '#2d181b';
      ctx.lineWidth = 3;
      ctx.strokeRect(cx - 3, cy - 22, 6, 22);

      // Flame
      ctx.beginPath();
      ctx.moveTo(cx, cy - 23);
      ctx.quadraticCurveTo(cx - 5, cy - 29, cx, cy - 35);
      ctx.quadraticCurveTo(cx + 5, cy - 29, cx, cy - 23);
      ctx.fillStyle = '#F59E0B';
      ctx.fill();
    });
  }

  function drawCartoonRectangular(ctx, x, y, w, d, h, color) {
    const strokeStyle = '#2d181b';
    const lineWidth = 4;
    const hh = h;

    const pt1 = { x: x - w/2, y: y };
    const pt2 = { x: x, y: y + d/4 };
    const pt3 = { x: x + w/2, y: y };
    const pt4 = { x: x, y: y - d/4 };

    // Fill & Draw body
    // Left Face
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(pt1.x, pt1.y);
    ctx.lineTo(pt2.x, pt2.y);
    ctx.lineTo(pt2.x, pt2.y - hh);
    ctx.lineTo(pt1.x, pt1.y - hh);
    ctx.closePath();
    ctx.fill();
    ctx.strokeStyle = strokeStyle;
    ctx.lineWidth = lineWidth;
    ctx.stroke();

    // Highlight/Shade Left Face
    ctx.fillStyle = 'rgba(0,0,0,0.12)';
    ctx.fill();

    // Right Face
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(pt2.x, pt2.y);
    ctx.lineTo(pt3.x, pt3.y);
    ctx.lineTo(pt3.x, pt3.y - hh);
    ctx.lineTo(pt2.x, pt2.y - hh);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();

    // Highlight/Shade Right Face
    ctx.fillStyle = 'rgba(0,0,0,0.22)';
    ctx.fill();

    // Top Face
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(pt1.x, pt1.y - hh);
    ctx.lineTo(pt2.x, pt2.y - hh);
    ctx.lineTo(pt3.x, pt3.y - hh);
    ctx.lineTo(pt4.x, pt4.y - hh);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();

    // Top frosting drips
    ctx.fillStyle = '#FFFFFF';
    ctx.beginPath();
    ctx.moveTo(pt1.x, pt1.y - hh);
    ctx.lineTo(pt2.x, pt2.y - hh);
    ctx.lineTo(pt3.x, pt3.y - hh);
    ctx.lineTo(pt4.x, pt4.y - hh);
    ctx.closePath();
    ctx.fill();

    // Wave drips along bottom edges
    ctx.fillStyle = '#FFFFFF';
    ctx.beginPath();
    ctx.moveTo(pt1.x, pt1.y - hh);
    ctx.lineTo(pt2.x, pt2.y - hh);
    ctx.lineTo(pt2.x, pt2.y - hh + 10);
    ctx.lineTo(pt1.x, pt1.y - hh + 10);
    ctx.closePath();
    ctx.fill();

    // Add Candles
    drawCandles(ctx, x, y - hh, w * 0.4);
  }

  // Handle native color picker input
  customColorPicker?.addEventListener('input', () => {
    activeColor = customColorPicker.value;
    activeColorName = 'Personalizado';
    if (colorNameDisplay) colorNameDisplay.textContent = activeColorName;
    
    // remove active class from predefined swatches
    colorSwatches.forEach(s => s.classList.remove('active'));
    drawCake();
  });

  // Handle predefined color buttons
  colorSwatches.forEach(swatch => {
    swatch.addEventListener('click', () => {
      colorSwatches.forEach(s => s.classList.remove('active'));
      swatch.classList.add('active');
      activeColor = swatch.getAttribute('data-color') || '#FDFBF7';
      activeColorName = swatch.getAttribute('data-name') || 'Blanco Crema';
      if (colorNameDisplay) colorNameDisplay.textContent = activeColorName;
      if (customColorPicker) customColorPicker.value = activeColor;
      drawCake();
    });
  });

  // Handle Size Selection
  customSizeSelect?.addEventListener('change', () => {
    const selectedOption = customSizeSelect.options[customSizeSelect.selectedIndex];
    const price = selectedOption.getAttribute('data-price');
    const val = customSizeSelect.value;

    if (customPriceDisplay) {
      customPriceDisplay.textContent = `$${price} CUP`;
    }

    // 2 floors option restriction: hides dough selector since it's wheat only
    const doughWrapper = document.getElementById('custom-dough-wrapper');
    if (val === 'cake-varios-pisos') {
      if (doughWrapper) doughWrapper.style.display = 'none';
      if (customDoughSelect) customDoughSelect.value = 'trigo';
    } else {
      if (doughWrapper) doughWrapper.style.display = 'flex';
    }

    drawCake();
  });

  // Initial draw
  if (cakeCanvas) {
    drawCake();
  }

  // Custom Cake Add to Cart action
  addCustomCakeBtn?.addEventListener('click', () => {
    if (!customSizeSelect) return;
    const selectedOption = customSizeSelect.options[customSizeSelect.selectedIndex];
    const id = selectedOption.value;
    const sizeLabel = selectedOption.textContent?.split('—')[0].trim() || 'Cake';
    const price = parseFloat(selectedOption.getAttribute('data-price') || '0');
    const dough = customDoughSelect?.value || 'trigo';
    const theme = customThemeInput?.value || '';
    const ediblePrint = customPrintCheckbox?.checked || false;

    // Convert current canvas state to image for thumbnail
    const imageSrc = cakeCanvas ? (cakeCanvas as HTMLCanvasElement).toDataURL('image/png') : '';

    const existingItem = cart.find(item => item.id === id);
    if (existingItem) {
      existingItem.quantity += 1;
    } else {
      cart.push({
        id: id,
        name: sizeLabel,
        price: price,
        quantity: 1,
        customizable: true,
        category: id === 'minicake' ? 'minicakes' : 'cakes',
        imageSrc,
        dough: dough,
        note: `Color: ${activeColorName}.${theme ? ' Temática: ' + theme : ''}`,
        ediblePrint: ediblePrint,
        fileName: '',
        size: id === 'cake-redondo' ? '20' : (id === 'cake-bandeja' ? 'media' : ''),
        doubleHeight: false
      });
    }

    // Reset input fields and customizer state
    if (customThemeInput) customThemeInput.value = '';
    if (customPrintCheckbox) customPrintCheckbox.checked = false;

    // Reset selectors
    if (customSizeSelect) {
      customSizeSelect.selectedIndex = 0;
      const price = customSizeSelect.options[0].getAttribute('data-price');
      if (customPriceDisplay) customPriceDisplay.textContent = `$${price} CUP`;
    }
    if (customDoughSelect) customDoughSelect.value = 'trigo';
    
    const doughWrapper = document.getElementById('custom-dough-wrapper');
    if (doughWrapper) doughWrapper.style.display = 'flex';
    if (customDoughWarning) customDoughWarning.style.display = 'none';

    // Reset Color Picker
    activeColor = '#FDFBF7';
    activeColorName = 'Blanco Crema';
    if (colorNameDisplay) colorNameDisplay.textContent = 'Blanco Crema';
    if (customColorPicker) customColorPicker.value = '#FDFBF7';

    // Reset swatches active state
    colorSwatches.forEach(s => s.classList.remove('active'));
    const defaultSwatch = document.querySelector('.color-swatch-btn[data-color="#FDFBF7"]');
    if (defaultSwatch) defaultSwatch.classList.add('active');

    // Redraw Canvas
    drawCake();

    updateCart();
    openCart();
  });

  // 2. Open/Close Cart Drawer
  const openCart = () => {
    cartDrawer?.classList.add('open');
    document.body.style.overflow = 'hidden'; // Prevent scrolling background
  };

  const closeCart = () => {
    cartDrawer?.classList.remove('open');
    document.body.style.overflow = '';
  };

  floatingCartBtn?.addEventListener('click', openCart);
  closeCartBtn?.addEventListener('click', closeCart);
  cartOverlay?.addEventListener('click', closeCart);

  // 3. Add to Cart Handler
  addToCartButtons.forEach(button => {
    button.addEventListener('click', () => {
      const id = button.getAttribute('data-id');
      const name = button.getAttribute('data-name');
      const price = parseFloat(button.getAttribute('data-price') || '0');
      const customizable = button.getAttribute('data-customizable') === 'true';
      const category = button.getAttribute('data-category') || '';

      // Fetch the product image from DOM
      const card = button.closest('.product-card') || button.closest('.buffet-card');
      const img = card ? card.querySelector('img') : null;
      const imageSrc = img ? img.getAttribute('src') : 'https://images.unsplash.com/photo-1578985545062-69928b1d9587?q=80&w=800&auto=format&fit=crop';

      const existingItem = cart.find(item => item.id === id);

      if (existingItem) {
        existingItem.quantity += 1;
      } else {
        cart.push({
          id,
          name,
          price,
          quantity: 1,
          customizable,
          category,
          imageSrc,
          dough: (category === 'cakes' || category === 'minicakes') ? 'trigo' : undefined,
          note: '',
          ediblePrint: false,
          fileName: ''
        });
      }

      updateCart();
      openCart();
    });
  });

  // 4. Update Cart State & UI
  function updateCart() {
    // Save to LocalStorage
    localStorage.setItem('el_lider_cart', JSON.stringify(cart));
    
    // Update Badge Count
    const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
    if (cartCountEl) cartCountEl.textContent = totalItems.toString();

    // Render Items
    renderCartItems();

    // Calculate Prices
    calculateTotal();
  }

  const getProductIcon = (item) => {
    const nameLower = item.name.toLowerCase();
    const idLower = item.id.toLowerCase();
    
    if (idLower.includes('minicake') || nameLower.includes('minicake') || idLower.includes('cupcake') || nameLower.includes('cupcake')) {
      return { icon: '🧁', color: '#FBCFE8', label: 'Mini Cake / Cupcake' };
    }
    if (idLower.includes('bandeja') || nameLower.includes('bandeja')) {
      return { icon: '🍰', color: '#EEDBCE', label: 'Bandeja' };
    }
    if (item.category === 'reposteria' || item.category === 'salados') {
      return { icon: '🍪', color: '#A7F3D0', label: 'Buffet/Postre' };
    }
    return { icon: '🎂', color: '#FEF08A', label: 'Cake Simple' };
  };

  function renderCartItems() {
    if (!cartItemsContainer) return;

    if (cart.length === 0) {
      cartItemsContainer.innerHTML = `
        <div class="empty-cart-message">
          <p>Tu carrito está vacío</p>
          <button id="explore-btn-inline" class="btn btn-outline btn-sm" style="color:var(--primary-color); border-color:var(--primary-color)">Explorar la Carta</button>
        </div>
      `;
      
      document.getElementById('explore-btn-inline')?.addEventListener('click', () => {
        closeCart();
        window.location.hash = '#catalogo';
      });
      return;
    }

    let html = '';
    cart.forEach((item, index) => {
      const metaInfo = getProductIcon(item);
      html += `
        <div class="cart-item" data-index="${index}">
          <div class="cart-item-row" style="align-items: center;">
            <div class="category-icon-badge" style="background-color: ${metaInfo.color}; font-size: 1.4rem; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; border-radius: 50%; flex-shrink: 0;" title="${metaInfo.label}">
              ${metaInfo.icon}
            </div>
            <div class="cart-item-details">
              <div class="cart-item-header">
                <div class="cart-item-title">
                  <h4 style="font-size: 0.95rem; font-weight: 700; margin: 0;">${item.name}</h4>
                </div>
                <span class="cart-item-price" style="font-size: 0.95rem; font-weight: bold; color: var(--accent-light);">$${item.price * item.quantity} CUP</span>
              </div>
              
              <div class="cart-item-actions" style="margin-top: 0.4rem; display: flex; justify-content: space-between; align-items: center;">
                <div class="quantity-controller">
                  <button class="qty-btn minus" data-index="${index}" ${item.quantity <= 1 ? 'disabled' : ''}>-</button>
                  <span class="qty-value" style="width: 24px; font-size: 0.85rem; font-weight: bold; text-align: center;">${item.quantity}</span>
                  <button class="qty-btn plus" data-index="${index}">+</button>
                </div>
                <button class="remove-item-btn" data-index="${index}" style="font-size: 0.8rem; color: #ef4444; background: none; border: none; cursor: pointer; font-weight: bold;">
                  Eliminar
                </button>
              </div>
            </div>
          </div>
        </div>
      `;
    });

    cartItemsContainer.innerHTML = html;

    // Attach Event Listeners to Dynamically Rendered Cart Elements
    attachCartEvents();
  }

  function attachCartEvents() {
    // Quantity Plus
    document.querySelectorAll('.qty-btn.plus').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const index = parseInt((e.target as HTMLElement).getAttribute('data-index') || '0');
        cart[index].quantity += 1;
        updateCart();
      });
    });

    // Quantity Minus
    document.querySelectorAll('.qty-btn.minus').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const index = parseInt((e.target as HTMLElement).getAttribute('data-index') || '0');
        if (cart[index].quantity > 1) {
          cart[index].quantity -= 1;
          updateCart();
        }
      });
    });

    // Remove Item
    document.querySelectorAll('.remove-item-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const index = parseInt((e.target as HTMLElement).getAttribute('data-index') || '0');
        cart.splice(index, 1);
        updateCart();
      });
    });
  }

  function calculateTotal() {
    let subtotal = 0;
    let addonsTotal = 0;

    cart.forEach(item => {
      subtotal += item.price * item.quantity;
      if (item.ediblePrint) {
        addonsTotal += 650 * item.quantity;
      }
    });

    const total = subtotal + addonsTotal;

    if (cartTotalEl) cartTotalEl.textContent = `$${total} CUP`;
  }

  // 5. Redirection to Checkout Page
  goToCheckoutBtn?.addEventListener('click', () => {
    if (cart.length === 0) {
      alert('Tu carrito está vacío. Agrega algunos dulces antes de realizar tu encargo.');
      return;
    }
    // Redirect to the dedicated checkout page
    window.location.href = '/pedido';
  });

  // Initialize cart from localStorage if exists
  const savedCart = localStorage.getItem('el_lider_cart');
  if (savedCart) {
    try {
      cart = JSON.parse(savedCart);
      updateCart();
    } catch (e) {
      cart = [];
    }
  }
</script>
