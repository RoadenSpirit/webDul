</style>

<script>
  // DOM Elements
  const addToCartButtons = document.querySelectorAll('.add-to-cart-btn');
  const floatingCartBtn = document.getElementById('floating-cart-btn');
  const closeCartBtn = document.getElementById('close-cart-btn');
  const cartDrawer = document.getElementById('cart-drawer');
  const cartOverlay = document.querySelector('.cart-drawer-overlay');
  const cartItemsContainer = document.getElementById('cart-items-container');
  const cartSubtotalEl = document.getElementById('cart-subtotal');
  const cartAddonsEl = document.getElementById('cart-addons');
  const cartTotalEl = document.getElementById('cart-total');
  const checkoutWhatsappBtn = document.getElementById('checkout-whatsapp-btn');
  const cartCountEl = document.querySelector('.cart-count');
  const orderDateEl = document.getElementById('order-date') as HTMLInputElement | null;
  const orderTimeEl = document.getElementById('order-time') as HTMLInputElement | null;

  // Carousel DOM Elements
  const carouselTrack = document.getElementById('carousel-track');
  const carouselPrevBtn = document.getElementById('carousel-prev-btn');
  const carouselNextBtn = document.getElementById('carousel-next-btn');
  const carouselViewport = document.getElementById('carousel-viewport');

  // Customizer DOM Elements
  const cakeCanvas = document.getElementById('cake-canvas') as HTMLCanvasElement | null;
  const customSizeSelect = document.getElementById('custom-size') as HTMLSelectElement | null;
  const customDoughSelect = document.getElementById('custom-dough') as HTMLSelectElement | null;
  const customDoughWarning = document.getElementById('customizer-dough-warning');
  const colorSwatches = document.querySelectorAll('.color-swatch');
  const colorNameDisplay = document.getElementById('color-name-display');
  const customThemeInput = document.getElementById('custom-theme') as HTMLInputElement | null;
  const customPrintCheckbox = document.getElementById('custom-print') as HTMLInputElement | null;
  const customPriceDisplay = document.getElementById('customizer-price-display');
  const addCustomCakeBtn = document.getElementById('add-custom-cake-btn');

  // Restore and persist saved date
  if (orderDateEl) {
    const savedDate = localStorage.getItem('el_lider_order_date');
    if (savedDate) {
      orderDateEl.value = savedDate;
    }
    orderDateEl.addEventListener('change', () => {
      localStorage.setItem('el_lider_order_date', orderDateEl.value);
    });
  }

  // Restore and persist saved time
  if (orderTimeEl) {
    const savedTime = localStorage.getItem('el_lider_order_time');
    if (savedTime) {
      orderTimeEl.value = savedTime;
    }
    orderTimeEl.addEventListener('change', () => {
      localStorage.setItem('el_lider_order_time', orderTimeEl.value);
    });
  }

  // State
  let cart = [];

  // 1. Cakes Carousel Autoplay and Controls
  let carouselIndex = 0;
  let autoplayInterval;

  function updateCarousel() {
    if (!carouselTrack) return;
    const slides = carouselTrack.querySelectorAll('.carousel-slide');
    if (slides.length === 0) return;

    // Determine how many items are visible (1 on mobile, 2 on desktop)
    const itemsVisible = window.innerWidth <= 992 ? 1 : 2;
    const maxIndex = slides.length - itemsVisible;

    if (carouselIndex > maxIndex) carouselIndex = 0;
    if (carouselIndex < 0) carouselIndex = maxIndex;

    const slideWidth = (slides[0] as HTMLElement).getBoundingClientRect().width;
    const gap = 24; // matching css gap (1.5rem = 24px)
    const offset = -carouselIndex * (slideWidth + gap);
    
    carouselTrack.style.transform = `translateX(${offset}px)`;
  }

  function startAutoplay() {
    autoplayInterval = setInterval(() => {
      carouselIndex++;
      updateCarousel();
    }, 4000);
  }

  function stopAutoplay() {
    clearInterval(autoplayInterval);
  }

  if (carouselPrevBtn && carouselNextBtn) {
    carouselPrevBtn.addEventListener('click', () => {
      stopAutoplay();
      carouselIndex--;
      updateCarousel();
      startAutoplay();
    });

    carouselNextBtn.addEventListener('click', () => {
      stopAutoplay();
      carouselIndex++;
      updateCarousel();
      startAutoplay();
    });

    // Pause on hover
    carouselViewport?.addEventListener('mouseenter', stopAutoplay);
    carouselViewport?.addEventListener('mouseleave', startAutoplay);

    // Initial setup
    window.addEventListener('resize', updateCarousel);
    updateCarousel();
    startAutoplay();
  }

  // 2. Interactive Cake Customizer (Canvas JS drawing)
  let activeColor = '#FDFBF7';
  let activeColorName = 'Blanco Crema';

  function drawCake() {
    if (!cakeCanvas) return;
    const ctx = cakeCanvas.getContext('2d');
    if (!ctx) return;

    ctx.clearRect(0, 0, cakeCanvas.width, cakeCanvas.height);

    const sizeVal = customSizeSelect?.value || 'minicake-15';
    const selectedOption = customSizeSelect?.options[customSizeSelect.selectedIndex];
    const cakeType = selectedOption?.getAttribute('data-type') || '1piso';

    const cx = cakeCanvas.width / 2;
    const cy = cakeCanvas.height / 2 + 30;

    // Draw Golden Base Board
    ctx.beginPath();
    ctx.ellipse(cx, cy + 30, 110, 35, 0, 0, 2 * Math.PI);
    ctx.fillStyle = '#D4AF37'; // Gold
    ctx.fill();
    ctx.lineWidth = 3;
    ctx.strokeStyle = '#AA7C11';
    ctx.stroke();

    if (cakeType === '2pisos') {
      // Bottom Tier
      drawCylinder(ctx, cx, cy + 15, 85, 55, activeColor);
      // Top Tier
      drawCylinder(ctx, cx, cy - 35, 55, 45, activeColor);
      
      // Cream piping
      drawCreamBorder(ctx, cx, cy + 15, 85);
      drawCreamBorder(ctx, cx, cy - 35, 55);
      drawCreamBorder(ctx, cx, cy - 75, 40, true);
    } else if (cakeType === 'bandeja') {
      // Isometric Rectangular Cake
      drawRectangularCake(ctx, cx, cy + 15, 170, 95, 50, activeColor);
    } else {
      // Standard Single Cylinder
      let radius = 80;
      let height = 65;
      if (sizeVal === 'minicake-15') {
        radius = 60;
        height = 50;
      } else if (sizeVal === 'cake-redondo-36') {
        radius = 95;
        height = 75;
      }
      
      drawCylinder(ctx, cx, cy + 15, radius, height, activeColor);
      drawCreamBorder(ctx, cx, cy + 15, radius);
      drawCreamBorder(ctx, cx, cy + 15 - height, radius, true);
    }
  }

  function drawCylinder(ctx, x, y, r, h, color) {
    // Bottom Ellipse
    ctx.beginPath();
    ctx.ellipse(x, y, r, r * 0.35, 0, 0, Math.PI);
    ctx.fillStyle = color;
    ctx.fill();

    // Side Walls
    ctx.beginPath();
    ctx.moveTo(x - r, y);
    ctx.lineTo(x - r, y - h);
    ctx.ellipse(x, y - h, r, r * 0.35, 0, Math.PI, 2 * Math.PI);
    ctx.lineTo(x + r, y);
    ctx.ellipse(x, y, r, r * 0.35, 0, 0, Math.PI, true);
    ctx.closePath();
    ctx.fillStyle = color;
    ctx.fill();

    // Sombreado 3D
    const grad = ctx.createLinearGradient(x - r, y, x + r, y);
    grad.addColorStop(0, 'rgba(0,0,0,0.22)');
    grad.addColorStop(0.25, 'rgba(0,0,0,0.04)');
    grad.addColorStop(0.7, 'rgba(255,255,255,0.15)');
    grad.addColorStop(1, 'rgba(0,0,0,0.28)');
    ctx.fillStyle = grad;
    ctx.fill();

    // Top Ellipse
    ctx.beginPath();
    ctx.ellipse(x, y - h, r, r * 0.35, 0, 0, 2 * Math.PI);
    ctx.fillStyle = color;
    ctx.fill();
    ctx.lineWidth = 1;
    ctx.strokeStyle = 'rgba(0,0,0,0.1)';
    ctx.stroke();
  }

  function drawCreamBorder(ctx, x, y, r, isTop = false) {
    ctx.fillStyle = '#FFFFFF';
    const numDots = Math.floor(r / 3);
    for (let i = 0; i < numDots; i++) {
      const angle = (i / numDots) * Math.PI * 2;
      const dx = x + Math.cos(angle) * r;
      const dy = y + Math.sin(angle) * r * 0.35;
      
      ctx.beginPath();
      ctx.arc(dx, dy, 4.5, 0, 2 * Math.PI);
      ctx.fill();
    }

    if (isTop) {
      drawCandle(ctx, x - 15, y - 10);
      drawCandle(ctx, x, y - 12);
      drawCandle(ctx, x + 15, y - 10);
    }
  }

  function drawCandle(ctx, x, y) {
    // Stick
    ctx.fillStyle = '#3B82F6';
    ctx.fillRect(x - 2, y - 20, 4, 20);
    // Wick
    ctx.strokeStyle = '#000';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(x, y - 20);
    ctx.lineTo(x, y - 22);
    ctx.stroke();
    // Flame
    ctx.fillStyle = '#F59E0B';
    ctx.beginPath();
    ctx.arc(x, y - 24, 3, 0, 2 * Math.PI);
    ctx.fill();
  }

  function drawRectangularCake(ctx, x, y, w, d, h, color) {
    const hh = h;
    const pt1 = { x: x - 90, y: y };
    const pt2 = { x: x, y: y + 25 };
    const pt3 = { x: x + 90, y: y };
    const pt4 = { x: x, y: y - 25 };

    // Left Side Wall
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(pt1.x, pt1.y);
    ctx.lineTo(pt2.x, pt2.y);
    ctx.lineTo(pt2.x, pt2.y - hh);
    ctx.lineTo(pt1.x, pt1.y - hh);
    ctx.closePath();
    ctx.fill();
    ctx.fillStyle = 'rgba(0,0,0,0.12)';
    ctx.fill();

    // Right Side Wall
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(pt2.x, pt2.y);
    ctx.lineTo(pt3.x, pt3.y);
    ctx.lineTo(pt3.x, pt3.y - hh);
    ctx.lineTo(pt2.x, pt2.y - hh);
    ctx.closePath();
    ctx.fill();
    ctx.fillStyle = 'rgba(0,0,0,0.22)';
    ctx.fill();

    // Top Face
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(pt1.x, pt1.y - hh);
    ctx.lineTo(pt2.x, pt2.y - hh);
    ctx.lineTo(pt3.x, pt3.y - hh);
    ctx.lineTo(pt4.x, pt4.y - hh);
    ctx.closePath();
    ctx.fill();
    ctx.fillStyle = 'rgba(255,255,255,0.08)';
    ctx.fill();

    // Cream borders
    ctx.fillStyle = '#FFFFFF';
    const borderPoints = [pt1, pt2, pt3, pt4, pt1];
    borderPoints.forEach((pt, idx) => {
      if (idx === borderPoints.length - 1) return;
      const nextPt = borderPoints[idx + 1];
      const steps = 10;
      for (let i = 0; i <= steps; i++) {
        const t = i / steps;
        const px = pt.x + (nextPt.x - pt.x) * t;
        const py = pt.y - hh + (nextPt.y - pt.y) * t;
        ctx.beginPath();
        ctx.arc(px, py, 4.5, 0, 2 * Math.PI);
        ctx.fill();
      }
    });

    drawCandle(ctx, x - 10, y - hh - 5);
    drawCandle(ctx, x + 10, y - hh - 5);
  }

  // Customizer Controls & Event Listeners
  if (cakeCanvas) {
    // Colors
    colorSwatches.forEach(swatch => {
      swatch.addEventListener('click', () => {
        colorSwatches.forEach(s => s.classList.remove('active'));
        swatch.classList.add('active');
        activeColor = swatch.getAttribute('data-color') || '#FDFBF7';
        activeColorName = swatch.getAttribute('data-name') || 'Blanco Crema';
        if (colorNameDisplay) colorNameDisplay.textContent = activeColorName;
        drawCake();
      });
    });

    // Size Selection
    customSizeSelect?.addEventListener('change', () => {
      const selectedOption = customSizeSelect.options[customSizeSelect.selectedIndex];
      const price = selectedOption.getAttribute('data-price');
      const val = customSizeSelect.value;

      if (customPriceDisplay) {
        customPriceDisplay.textContent = `$${price} CUP`;
      }

      // 2 floors option restriction: hides dough selector since it's wheat only
      const doughWrapper = document.getElementById('custom-dough-wrapper');
      if (val === 'cake-2-pisos') {
        if (doughWrapper) doughWrapper.style.display = 'none';
        if (customDoughSelect) customDoughSelect.value = 'trigo';
        if (customDoughWarning) customDoughWarning.style.display = 'none';
      } else {
        if (doughWrapper) doughWrapper.style.display = 'flex';
      }

      drawCake();
    });

    // Dough Selection warning banner trigger
    customDoughSelect?.addEventListener('change', () => {
      const isCustomDough = customDoughSelect.value !== 'trigo';
      if (customDoughWarning) {
        customDoughWarning.style.display = isCustomDough ? 'block' : 'none';
      }
    });

    // Initial render
    drawCake();
  }

  // Custom Cake Add to Cart action
  addCustomCakeBtn?.addEventListener('click', () => {
    if (!customSizeSelect) return;
    const selectedOption = customSizeSelect.options[customSizeSelect.selectedIndex];
    const id = selectedOption.value;
    const sizeLabel = selectedOption.textContent?.split('—')[0].trim() || 'Cake';
    const price = parseFloat(selectedOption.getAttribute('data-price') || '0');
    const dough = customDoughSelect?.value || 'trigo';
    const theme = customThemeInput?.value || '';
    const ediblePrint = customPrintCheckbox?.checked || false;

    // Push custom cake item to cart
    cart.push({
      id: `custom-${id}-${Date.now()}`,
      name: `Cake Personalizado (${sizeLabel})`,
      price: price,
      quantity: 1,
      customizable: true,
      category: 'cakes',
      dough: dough,
      note: `Color: ${activeColorName}.${theme ? ' Temática: ' + theme : ''}`,
      ediblePrint: ediblePrint,
      fileName: ''
    });

    // Reset input fields
    if (customThemeInput) customThemeInput.value = '';
    if (customPrintCheckbox) customPrintCheckbox.checked = false;

    updateCart();
    openCart();
  });

  // 2. Open/Close Cart Drawer
  const openCart = () => {
    cartDrawer?.classList.add('open');
    document.body.style.overflow = 'hidden'; // Prevent scrolling background
  };

  const closeCart = () => {
    cartDrawer?.classList.remove('open');
    document.body.style.overflow = '';
  };

  floatingCartBtn?.addEventListener('click', openCart);
  closeCartBtn?.addEventListener('click', closeCart);
  cartOverlay?.addEventListener('click', closeCart);

  // 3. Add to Cart Handler
  addToCartButtons.forEach(button => {
    button.addEventListener('click', () => {
      const id = button.getAttribute('data-id');
      const name = button.getAttribute('data-name');
      const price = parseFloat(button.getAttribute('data-price') || '0');
      const customizable = button.getAttribute('data-customizable') === 'true';
      const category = button.getAttribute('data-category') || '';

      const existingItem = cart.find(item => item.id === id);

      if (existingItem) {
        existingItem.quantity += 1;
      } else {
        cart.push({
          id,
          name,
          price,
          quantity: 1,
          customizable,
          category,
          dough: (category === 'cakes' || category === 'minicakes') ? 'trigo' : undefined,
          note: '',
          ediblePrint: false,
          fileName: ''
        });
      }

      updateCart();
      openCart();
    });
  });

  // 4. Update Cart State & UI
  function updateCart() {
    // Save to LocalStorage
    localStorage.setItem('el_lider_cart', JSON.stringify(cart));
    
    // Update Badge Count
    const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
    if (cartCountEl) cartCountEl.textContent = totalItems.toString();

    // Render Items
    renderCartItems();

    // Calculate Prices
    calculateTotal();
  }

  function renderCartItems() {
    if (!cartItemsContainer) return;

    if (cart.length === 0) {
      cartItemsContainer.innerHTML = `
        <div class="empty-cart-message">
          <p>Tu carrito está vacío</p>
          <button id="explore-btn-inline" class="btn btn-outline btn-sm" style="color:var(--primary-color); border-color:var(--primary-color)">Explorar la Carta</button>
        </div>
      `;
      
      document.getElementById('explore-btn-inline')?.addEventListener('click', () => {
        closeCart();
        window.location.hash = '#catalogo';
      });
      return;
    }

    let html = '';
    cart.forEach((item, index) => {
      html += `
        <div class="cart-item" data-index="${index}">
          <div class="cart-item-header">
            <div class="cart-item-title">
              <h4>${item.name}</h4>
            </div>
            <span class="cart-item-price">$${item.price * item.quantity} CUP</span>
          </div>
          
          <div class="cart-item-actions">
            <div class="quantity-controller">
              <button class="qty-btn minus" data-index="${index}">-</button>
              <span class="qty-value">${item.quantity}</span>
              <button class="qty-btn plus" data-index="${index}">+</button>
            </div>
            <button class="remove-item-btn" data-index="${index}">Eliminar</button>
          </div>
          
          ${item.customizable ? `
            <div class="cart-item-customization">
              <span class="customization-title">Personalización del Cake:</span>
              <textarea 
                class="custom-note-textarea" 
                data-index="${index}" 
                placeholder="Especifica aquí colores, nombre/edad, diseño, decoración o temática que te gustaría..."
              >${item.note || ''}</textarea>

              ${(item.category === 'cakes' || item.category === 'minicakes') && item.id !== 'cake-2-pisos' ? `
                <div class="dough-selector-container">
                  <label class="customization-title">Tipo de Masa:</label>
                  <select class="dough-select" data-index="${index}">
                    <option value="trigo" ${item.dough === 'trigo' || !item.dough ? 'selected' : ''}>Harina de trigo (Por defecto)</option>
                    <option value="maicena" ${item.dough === 'maicena' ? 'selected' : ''}>Maicena</option>
                    <option value="capuchino" ${item.dough === 'capuchino' ? 'selected' : ''}>Capuchino</option>
                  </select>
                  <div class="dough-warning-banner" id="dough-warning-${index}" style="display: ${item.dough && item.dough !== 'trigo' ? 'block' : 'none'};">
                    ⚠️ Cambiar el tipo de masa a Maicena o Capuchino incrementa el precio final del cake. El ajuste se acordará por WhatsApp.
                  </div>
                </div>
              ` : ''}
              
              <label class="edible-print-option">
                <input 
                  type="checkbox" 
                  class="edible-print-checkbox" 
                  data-index="${index}" 
                  ${item.ediblePrint ? 'checked' : ''}
                />
                Añadir Impresión Comestible (+650 CUP)
              </label>

              ${item.ediblePrint ? `
                <div class="upload-area">
                  <span class="upload-label">${item.fileName ? '✓ Imagen Cargada' : 'Subir imagen para impresión'}</span>
                  <input type="file" class="upload-input" data-index="${index}" accept="image/*" />
                  ${item.fileName ? `<div class="file-preview"><span>📁 ${item.fileName}</span></div>` : ''}
                </div>
              ` : ''}
            </div>
          ` : ''}
        </div>
      `;
    });

    cartItemsContainer.innerHTML = html;

    // Attach Event Listeners to Dynamically Rendered Cart Elements
    attachCartEvents();
  }

  function attachCartEvents() {
    // Quantity Plus
    document.querySelectorAll('.qty-btn.plus').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const index = parseInt((e.target as HTMLElement).getAttribute('data-index') || '0');
        cart[index].quantity += 1;
        updateCart();
      });
    });

    // Quantity Minus
    document.querySelectorAll('.qty-btn.minus').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const index = parseInt((e.target as HTMLElement).getAttribute('data-index') || '0');
        if (cart[index].quantity > 1) {
          cart[index].quantity -= 1;
        } else {
          cart.splice(index, 1);
        }
        updateCart();
      });
    });

    // Remove Item
    document.querySelectorAll('.remove-item-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const index = parseInt((e.target as HTMLElement).getAttribute('data-index') || '0');
        cart.splice(index, 1);
        updateCart();
      });
    });

    // Custom note typing
    document.querySelectorAll('.custom-note-textarea').forEach(textarea => {
      textarea.addEventListener('input', (e) => {
        const index = parseInt((e.target as HTMLElement).getAttribute('data-index') || '0');
        cart[index].note = (e.target as HTMLTextAreaElement).value;
        // Save to localStorage quietly without re-rendering to keep keyboard focus
        localStorage.setItem('el_lider_cart', JSON.stringify(cart));
      });
    });

    // Edible print checkbox toggle
    document.querySelectorAll('.edible-print-checkbox').forEach(checkbox => {
      checkbox.addEventListener('change', (e) => {
        const index = parseInt((e.target as HTMLElement).getAttribute('data-index') || '0');
        cart[index].ediblePrint = (e.target as HTMLInputElement).checked;
        if (!cart[index].ediblePrint) {
          cart[index].fileName = '';
        }
        updateCart();
      });
    });

    // Image File Upload Action
    document.querySelectorAll('.upload-input').forEach(input => {
      input.addEventListener('change', (e) => {
        const index = parseInt((e.target as HTMLElement).getAttribute('data-index') || '0');
        const file = (e.target as HTMLInputElement).files?.[0];
        if (file) {
          cart[index].fileName = file.name;
          updateCart();
        }
      });
    });

    // Dough select change
    document.querySelectorAll('.dough-select').forEach(select => {
      select.addEventListener('change', (e) => {
        const index = parseInt((e.target as HTMLElement).getAttribute('data-index') || '0');
        const selectedDough = (e.target as HTMLSelectElement).value;
        cart[index].dough = selectedDough;
        updateCart();
      });
    });
  }

  function calculateTotal() {
    let subtotal = 0;
    let addonsTotal = 0;

    cart.forEach(item => {
      subtotal += item.price * item.quantity;
      if (item.ediblePrint) {
        addonsTotal += 650 * item.quantity; // 650 CUP per item that has print option enabled
      }
    });

    const total = subtotal + addonsTotal;

    if (cartSubtotalEl) cartSubtotalEl.textContent = `$${subtotal} CUP`;
    if (cartAddonsEl) cartAddonsEl.textContent = `$${addonsTotal} CUP`;
    if (cartTotalEl) cartTotalEl.textContent = `$${total} CUP`;
  }

  // 5. Checkout via WhatsApp
  checkoutWhatsappBtn?.addEventListener('click', () => {
    if (cart.length === 0) {
      alert('Tu carrito está vacío. Agrega algunos dulces antes de realizar tu encargo.');
      return;
    }

    const orderDate = orderDateEl?.value;
    if (!orderDate) {
      alert('Por favor, selecciona la fecha requerida para la entrega o recogida de tu encargo.');
      orderDateEl?.focus();
      return;
    }

    const orderTime = orderTimeEl?.value || 'Sin hora específica';
    const phoneNumber = '5350000000'; // Target phone number (Dulcería El Líder)
    
    // Format date nicely
    const dateParts = orderDate.split('-');
    const formattedDate = `${dateParts[2]}/${dateParts[1]}/${dateParts[0]}`;

    let message = '🍰 *NUEVO ENCARGO - DULCERÍA EL LÍDER* 🍰\n\n';
    message += `📅 *FECHA REQUERIDA:* ${formattedDate} - *Hora:* ${orderTime}\n\n`;
    message += 'Hola, me gustaría encargar los siguientes dulces:\n\n';

    let total = 0;
    cart.forEach((item, index) => {
      const itemSubtotal = item.price * item.quantity;
      let addonText = '';
      let itemTotal = itemSubtotal;
      
      if (item.ediblePrint) {
        addonText = ' (Con Impresión Comestible: +$650 CUP)';
        itemTotal += 650 * item.quantity;
      }
      
      total += itemTotal;

      message += `*${index + 1}. ${item.name}* (x${item.quantity})\n`;
      message += `   - Precio base: $${item.price} CUP c/u\n`;
      
      if (item.dough) {
        const doughLabel = item.dough === 'trigo' ? 'Harina de trigo' : item.dough === 'maicena' ? 'Maicena' : 'Capuchino';
        message += `   - Masa: ${doughLabel}\n`;
      }

      if (item.customizable) {
        const noteText = item.note.trim() ? `"${item.note.trim()}"` : 'Que la dulcería escoja la decoración';
        message += `   - Decoración: _${noteText}_\n`;
      }
      
      if (item.ediblePrint) {
        message += `   - Adicional: Impresión Comestible [Enviaré las imágenes por este chat]${addonText}\n`;
      }
      message += `   - Subtotal artículo: *$${itemTotal} CUP*\n\n`;
    });

    message += `----------------------------------\n`;
    message += `💵 *TOTAL ESTIMADO: $${total} CUP*\n\n`;
    message += `⚠️ _Entiendo que el precio final y la decoración final se concretarán y confirmarán en este chat._\n\n`;
    message += `📍 Por favor, confírmenme disponibilidad para agendar la fecha. ¡Muchas gracias!`;

    const encodedMessage = encodeURIComponent(message);
    const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodedMessage}`;

    // Open WhatsApp
    window.open(whatsappUrl, '_blank');
  });

  // Initialize cart from localStorage if exists
  const savedCart = localStorage.getItem('el_lider_cart');
  if (savedCart) {
    try {
      cart = JSON.parse(savedCart);
      updateCart();
    } catch (e) {
      cart = [];
    }
  }
</script>
