---
import Layout from '../layouts/Layout.astro';
import { PRODUCTS } from '../data/products';

const cakes = PRODUCTS.filter(p => p.category === 'cakes' || p.category === 'minicakes');
const buffetItems = PRODUCTS.filter(p => p.category === 'reposteria' || p.category === 'salados');
---

<Layout title="Inicio - Dulcería por Encargo">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-overlay"></div>

    <!-- SVG Decorativos flotantes -->
    <div class="hero-svgs" aria-hidden="true">
      <!-- Cake 8 (Todos/Whole cake) -->
      <div class="hero-svg hero-svg--cake">
        <img src="/icons/cake8.svg" alt="" style="width: 100%; height: 100%; opacity: 0.25;" />
      </div>

      <!-- Cupcake (Cake 5) -->
      <div class="hero-svg hero-svg--cupcake">
        <img src="/icons/cake5.svg" alt="" style="width: 100%; height: 100%; opacity: 0.25;" />
      </div>

      <!-- Estrella / sprinkle 1 (Cake 7 - Dona) -->
      <div class="hero-svg hero-svg--star1">
        <img src="/icons/cake7.svg" alt="" style="width: 100%; height: 100%; opacity: 0.25;" />
      </div>

      <!-- Estrella / sprinkle 2 (Cake 6) -->
      <div class="hero-svg hero-svg--star2">
        <img src="/icons/cake6.svg" alt="" style="width: 100%; height: 100%; opacity: 0.25;" />
      </div>

      <!-- Corazón (Cake 1) -->
      <div class="hero-svg hero-svg--heart">
        <img src="/icons/cake1.svg" alt="" style="width: 100%; height: 100%; opacity: 0.25;" />
      </div>

      <!-- Dona (Cake 2) -->
      <div class="hero-svg hero-svg--donut">
        <img src="/icons/cake2.svg" alt="" style="width: 100%; height: 100%; opacity: 0.25;" />
      </div>
    </div>

    <div class="hero-content">
      <div class="hero-logo-wrap">
        <img src="/logo-correcto.png" alt="Dulcería El Líder Logo" class="hero-logo" />
      </div>
      <span class="hero-badge">✨ Artesanal &amp; Premium</span>
      <h1 class="hero-title">El Arte de la Dulcería Fina</h1>
      <p class="hero-subtitle">Cakes exclusivos y dulces de alta calidad elaborados totalmente por encargo para hacer de tu celebración un momento inolvidable.</p>
      <div class="hero-actions">
        <a href="#catalogo" class="hero-btn-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
          </svg>
          Ver la Carta
        </a>
        <a href="#como-pedir" class="hero-btn-secondary">¿Cómo pedir?</a>
      </div>
    </div>
  </section>

  <!-- Cakes Catalog Section -->
  <section id="catalogo" class="catalog-section">
    <div class="section-deco section-deco--catalog" aria-hidden="true">
      <div class="sdeco sdeco--cupcake-l">
        <img src="/icons/cake5.svg" alt="" style="width: 100%; height: 100%; opacity: 0.15;" />
      </div>
      <div class="sdeco sdeco--star-r">
        <img src="/icons/cake7.svg" alt="" style="width: 100%; height: 100%; opacity: 0.15;" />
      </div>
      <div class="sdeco sdeco--heart-tl">
        <img src="/icons/cake1.svg" alt="" style="width: 100%; height: 100%; opacity: 0.15;" />
      </div>
    </div>
    <div class="section-header">
      <span class="subtitle">Exquisiteces</span>
      <h2>¿Qué tipo de cake deseas para tu celebración?</h2>
      <div class="divider"></div>
      
      <!-- Subcategory filters (Pills) -->
      <div class="carousel-subcategories">
        <button class="subcategory-pill active" data-filter="all">
          <img src="/icons/cake8.svg" class="pill-icon-img" alt="Todos" width="22" height="22" />
          Todos
        </button>
        <button class="subcategory-pill" data-filter="minicakes">
          <img src="/icons/cake1.svg" class="pill-icon-img" alt="Mini Cakes" width="22" height="22" />
          Mini Cakes
        </button>
        <button class="subcategory-pill" data-filter="redondos">
          <img src="/icons/cake2.svg" class="pill-icon-img" alt="Cakes Redondos" width="22" height="22" />
          Cakes Redondos
        </button>
        <button class="subcategory-pill" data-filter="bandeja">
          <img src="/icons/cake4.svg" class="pill-icon-img" alt="Cakes de Bandeja" width="22" height="22" />
          De Bandeja
        </button>
        <button class="subcategory-pill" data-filter="pisos">
          <img src="/icons/cake3.svg" class="pill-icon-img" alt="Cakes de Varios Pisos" width="22" height="22" />
          Varios Pisos
        </button>
      </div>
    </div>

    <!-- Carousel Container (Large Cards) -->
    <div class="carousel-outer-wrapper">
      <button class="carousel-control prev" id="carousel-prev-btn" aria-label="Anterior">&lt;</button>
      <div class="carousel-viewport" id="carousel-viewport">
        <div class="carousel-track" id="carousel-track">
          {cakes.map(product => {
            // Determine subcategory filter type
            let filterType = 'all';
            if (product.id === 'minicake') filterType = 'minicakes';
            else if (product.id === 'cake-redondo') filterType = 'redondos';
            else if (product.id === 'cake-bandeja') filterType = 'bandeja';
            else if (product.id === 'cake-varios-pisos') filterType = 'pisos';

            return (
              <div class="product-card carousel-slide" data-filter-type={filterType} data-id={product.id}>
                <div class="product-image-container">
                  <img src={product.image} alt={product.name} class="product-image" loading="lazy" />
                  <span class="product-badge">{product.category === 'minicakes' ? 'MiniCake' : 'Cake'}</span>
                </div>
                <div class="product-info">
                  <h3>{product.name}</h3>
                  <p class="product-description">{product.description}</p>
                  <div class="product-meta">
                    <span class="product-price">
                      ${product.price} <span class="currency">CUP</span>
                      {product.priceNote && <span class="price-note">({product.priceNote})</span>}
                    </span>
                    <button 
                      class="add-to-cart-btn" 
                      data-id={product.id}
                      data-name={product.name}
                      data-price={product.price}
                      data-category={product.category}
                      data-customizable={product.customizable ? "true" : "false"}
                    >
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="15" height="15" style="display: inline-block;">
                        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                      </svg>
                      Agregar
                    </button>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
      <button class="carousel-control next" id="carousel-next-btn" aria-label="Siguiente">&gt;</button>
    </div>
  </section>

  <!-- Buffet & Dessert Offers Section -->
  <section id="buffet" class="buffet-section">
    <div class="section-deco section-deco--buffet" aria-hidden="true">
      <div class="sdeco sdeco--star-big">
        <img src="/icons/cake7.svg" alt="" style="width: 100%; height: 100%; opacity: 0.12;" />
      </div>
      <div class="sdeco sdeco--cupcake-r2">
        <img src="/icons/cake5.svg" alt="" style="width: 100%; height: 100%; opacity: 0.12;" />
      </div>
    </div>
    <div class="section-header">
      <span class="subtitle">Ofertas Adicionales</span>
      <h2>Acompaña tu Fiesta (Buffet y Postres)</h2>
      <div class="divider"></div>
      <p class="section-desc">Exquisitos salados y dulces tradicionales para complementar tu celebración de manera perfecta.</p>
    </div>
    
    <div class="buffet-grid">
      {buffetItems.map(product => (
        <div class="buffet-card">
          <div class="buffet-image-container">
            <img src={product.image} alt={product.name} class="buffet-image" loading="lazy" />
          </div>
          <div class="buffet-info">
            <h3>{product.name}</h3>
            <p class="buffet-description">{product.description}</p>
            <div class="buffet-meta">
              <span class="buffet-price">${product.price} CUP c/u</span>
              <button 
                class="add-to-cart-btn" 
                data-id={product.id}
                data-name={product.name}
                data-price={product.price}
                data-category={product.category}
                data-customizable={product.customizable ? "true" : "false"}
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="15" height="15" style="display: inline-block;">
                  <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                </svg>
                Añadir
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Gallery of Custom Decorations Section -->
  <section id="decoraciones" class="decorations-section">
    <div class="section-deco section-deco--decorations" aria-hidden="true">
      <div class="sdeco sdeco--heart-r" style="width: 60px; right: 2%; bottom: 15%; animation: heroPulse 4s ease-in-out infinite;">
        <img src="/icons/cake1.svg" alt="" style="width: 100%; height: 100%; opacity: 0.15;" />
      </div>
      <div class="sdeco sdeco--star-l" style="width: 50px; left: 2%; top: 12%; animation: heroSpin 10s linear infinite;">
        <img src="/icons/cake7.svg" alt="" style="width: 100%; height: 100%; opacity: 0.15;" />
      </div>
    </div>
    <div class="section-header">
      <span class="subtitle">Inspiración</span>
      <h2>Nuestras Decoraciones Personalizadas</h2>
      <div class="divider"></div>
      <p class="section-desc">Diseños artísticos elaborados a mano. Cada pastel es personalizado a tu gusto y temática de celebración.</p>
    </div>

    <div class="decorations-carousel-container">
      <button class="dec-carousel-control prev" id="dec-prev-btn" aria-label="Anterior">&lt;</button>
      <div class="decorations-viewport" id="dec-viewport">
        <div class="decorations-track" id="dec-track">
          <div class="decoration-slide">
            <img src="https://images.unsplash.com/photo-1535254973040-607b474cb50d?q=80&w=600&auto=format&fit=crop" alt="Decoración Infantil Dinosaurios" />
            <div class="decoration-overlay-info">
              <h4>Temática Infantil / Dinosaurios</h4>
              <p>Modelado artístico 2D y 3D en merengue fino.</p>
            </div>
          </div>
          <div class="decoration-slide">
            <img src="https://images.unsplash.com/photo-1557925923-cd4648e21187?q=80&w=600&auto=format&fit=crop" alt="Decoración Elegante Floral" />
            <div class="decoration-overlay-info">
              <h4>Diseño Elegante Floral</h4>
              <p>Detalles florales perfectos para bodas y aniversarios.</p>
            </div>
          </div>
          <div class="decoration-slide">
            <img src="https://images.unsplash.com/photo-1519869325930-281384150729?q=80&w=600&auto=format&fit=crop" alt="Decoración de Chocolate Premium" />
            <div class="decoration-overlay-info">
              <h4>Glaseado de Chocolate y Drips</h4>
              <p>Drips de chocolate gourmet y trufas seleccionadas.</p>
            </div>
          </div>
          <div class="decoration-slide">
            <img src="https://images.unsplash.com/photo-1588195538326-c5b1e9f80a1b?q=80&w=600&auto=format&fit=crop" alt="Fantasía Rosa y Sprinkles" />
            <div class="decoration-overlay-info">
              <h4>Fantasía en Rosa y Merengue</h4>
              <p>Tonos pasteles y chispas de colores para cumpleaños alegres.</p>
            </div>
          </div>
        </div>
      </div>
      <button class="dec-carousel-control next" id="dec-next-btn" aria-label="Siguiente">&gt;</button>
    </div>


  </section>

  <!-- Info Section / Como Pedir -->
  <section id="como-pedir" class="info-section">
    <div class="section-deco section-deco--info" aria-hidden="true">
      <div class="sdeco sdeco--cake-big">
        <img src="/icons/cake3.svg" alt="" style="width: 100%; height: 100%; opacity: 0.12;" />
      </div>
      <div class="sdeco sdeco--donut-r">
        <img src="/icons/cake7.svg" alt="" style="width: 100%; height: 100%; opacity: 0.12;" />
      </div>
    </div>
    <div class="section-header">
      <span class="subtitle">Paso a Paso</span>
      <h2>¿Cómo funciona nuestro servicio por encargo?</h2>
      <div class="divider"></div>
    </div>
    
    <div class="steps-grid">
      <div class="step-card">
        <div class="step-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="22" height="22">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
          </svg>
        </div>
        <h3>Selecciona tus Dulces</h3>
        <p>Explora nuestra carta exclusiva y elige tus dulces favoritos agregándolos al carrito de compras.</p>
      </div>
      <div class="step-card">
        <div class="step-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="22" height="22">
            <path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>
          </svg>
        </div>
        <h3>Personaliza tu Cake</h3>
        <p>En el carrito, define los colores, la temática o añade una <strong>Impresión Comestible</strong> subiendo tu propia imagen.</p>
      </div>
      <div class="step-card">
        <div class="step-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="22" height="22">
            <path d="M22 2L11 13M22 2l-7 20-4-9-9-4Z"/>
          </svg>
        </div>
        <h3>Envía por WhatsApp</h3>
        <p>Tu pedido se procesará automáticamente en un mensaje detallado para finalizar la cotización y agendar la fecha por WhatsApp.</p>
      </div>
    </div>
  </section>

  <!-- Floating Cart Button -->
  <button id="floating-cart-btn" class="floating-cart">
    <span class="cart-icon">🛒</span>
    <span class="cart-count">0</span>
  </button>

  <!-- Cart Drawer/Sidebar -->
  <div id="cart-drawer" class="cart-drawer">
    <div class="cart-drawer-overlay"></div>
    <div class="cart-drawer-content">
      <div class="cart-header">
        <h2>Tu Encargo</h2>
        <button id="close-cart-btn" class="close-btn">&times;</button>
      </div>
      
      <div id="cart-items-container" class="cart-items-container">
        <!-- Rendered dynamically by JS -->
        <div class="empty-cart-message">
          <p>Tu carrito está vacío</p>
          <a href="#catalogo" id="explore-btn" class="btn btn-outline btn-sm">Explorar la Carta</a>
        </div>
      </div>

      <div class="cart-footer">
        <!-- SVG decorativo inferior del carrito -->
        <div class="cart-sweet-deco" aria-hidden="true">
          <svg viewBox="0 0 320 48" fill="none" xmlns="http://www.w3.org/2000/svg" class="cart-deco-svg">
            <!-- Cake pequeño izq -->
            <rect x="8" y="18" width="28" height="16" rx="4" fill="rgba(232,25,108,0.25)"/>
            <ellipse cx="22" cy="18" rx="14" ry="4" fill="rgba(232,25,108,0.35)"/>
            <line x1="22" y1="8" x2="22" y2="17" stroke="rgba(255,200,100,0.9)" stroke-width="2" stroke-linecap="round"/>
            <circle cx="22" cy="7" r="2.5" fill="rgba(255,107,53,0.8)"/>
            <!-- Corazón centro -->
            <path d="M155 22 C155 22 148 16 148 12 C148 9.5 150 8 152 8 C153.5 8 154.5 9 155 10.5 C155.5 9 156.5 8 158 8 C160 8 162 9.5 162 12 C162 16 155 22 155 22Z" fill="rgba(232,25,108,0.5)"/>
            <!-- Estrella der -->
            <polygon points="290,10 292,17 299,17 294,21 296,28 290,24 284,28 286,21 281,17 288,17" fill="rgba(255,200,100,0.45)"/>
            <!-- Cupcake der -->
            <path d="M300 34 L304 44 H318 L322 34 Z" fill="rgba(255,255,255,0.12)"/>
            <path d="M298 33 Q311 22 324 33" fill="rgba(255,200,180,0.2)"/>
            <circle cx="311" cy="22" r="3" fill="rgba(232,25,108,0.6)"/>
            <!-- Sprinkles -->
            <circle cx="60" cy="30" r="3" fill="rgba(255,107,53,0.35)"/>
            <circle cx="80" cy="20" r="2" fill="rgba(232,25,108,0.3)"/>
            <circle cx="110" cy="35" r="2.5" fill="rgba(255,200,100,0.35)"/>
            <circle cx="200" cy="28" r="2" fill="rgba(255,107,53,0.3)"/>
            <circle cx="240" cy="38" r="3" fill="rgba(232,25,108,0.25)"/>
            <circle cx="130" cy="15" r="2" fill="rgba(255,255,255,0.2)"/>
          </svg>
        </div>

        <div class="cart-summary-row total-row">
          <span>Total Estimado</span>
          <span id="cart-total">$0 CUP</span>
        </div>
        <button id="go-to-checkout-btn" class="btn btn-primary btn-block cart-checkout-btn">
          <span>Continuar con el Encargo</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 12H19M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* ============================================================
     HERO SECTION
     ============================================================ */
  .hero-section {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #E8196C 0%, #FF6B35 100%);
    text-align: center;
    padding: 4rem 2rem;
    overflow: hidden;
  }

  .hero-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('https://images.unsplash.com/photo-1578985545062-69928b1d9587?q=80&w=1600&auto=format&fit=crop') center/cover no-repeat;
    opacity: 0.38;
    z-index: 0;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(232,25,108,0.52) 0%, rgba(255,107,53,0.48) 100%);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 760px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .hero-logo-wrap {
    margin-bottom: 0.5rem;
  }

  .hero-logo {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid rgba(255,255,255,0.5);
    box-shadow: 0 0 40px rgba(255,255,255,0.25), 0 8px 32px rgba(0,0,0,0.3);
  }

  @media (min-width: 640px) {
    .hero-logo {
      width: 200px;
      height: 200px;
    }
  }

  .hero-badge {
    display: inline-block;
    background: rgba(255,255,255,0.25);
    backdrop-filter: blur(8px);
    color: #fff;
    padding: 0.45rem 1.25rem;
    font-weight: 800;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 2.5px;
    border-radius: 50px;
    border: 1px solid rgba(255,255,255,0.4);
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 6vw, 3.75rem);
    font-weight: 900;
    color: #FFFFFF;
    line-height: 1.15;
    text-shadow: 0 2px 16px rgba(0,0,0,0.3);
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    color: rgba(255,255,255,0.95);
    max-width: 600px;
    line-height: 1.7;
    font-weight: 400;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #FFFFFF;
    color: #E8196C;
    font-weight: 800;
    font-size: 1rem;
    padding: 0.9rem 2.25rem;
    border-radius: var(--border-radius-md);
    box-shadow: 0 6px 24px rgba(0,0,0,0.2);
    transition: all var(--transition-fast);
    letter-spacing: 0.3px;
  }

  .hero-btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 32px rgba(0,0,0,0.3);
    background: #FFF8F0;
    color: #C2185B;
  }

  .hero-btn-secondary {
    background: transparent;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.9rem 2.25rem;
    border-radius: var(--border-radius-md);
    border: 2px solid rgba(255,255,255,0.7);
    transition: all var(--transition-fast);
  }

  .hero-btn-secondary:hover {
    background: rgba(255,255,255,0.15);
    border-color: #fff;
    transform: translateY(-2px);
  }

  /* ============================================================
     HERO — SVGs DECORATIVOS FLOTANTES
     ============================================================ */
  .hero-svgs {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-svg {
    position: absolute;
    opacity: 0.9;
  }

  /* Cake grande — arriba izquierda */
  .hero-svg--cake {
    width: 100px;
    top: 8%;
    left: 3%;
    animation: heroFloat 6s ease-in-out infinite;
  }

  /* Cupcake — abajo derecha */
  .hero-svg--cupcake {
    width: 75px;
    bottom: 12%;
    right: 4%;
    animation: heroFloat 5s ease-in-out infinite reverse;
  }

  /* Estrella grande — arriba derecha */
  .hero-svg--star1 {
    width: 44px;
    top: 15%;
    right: 10%;
    animation: heroSpin 10s linear infinite;
  }

  /* Estrella pequeña — abajo izquierda */
  .hero-svg--star2 {
    width: 28px;
    bottom: 20%;
    left: 8%;
    animation: heroSpin 8s linear infinite reverse;
  }

  /* Corazón — centro izquierda */
  .hero-svg--heart {
    width: 52px;
    top: 55%;
    left: 5%;
    animation: heroPulse 3s ease-in-out infinite;
  }

  /* Dona — centro derecha */
  .hero-svg--donut {
    width: 70px;
    top: 30%;
    right: 2%;
    animation: heroFloat 7s ease-in-out infinite 1s;
  }

  @keyframes heroFloat {
    0%, 100% { transform: translateY(0px) rotate(-3deg); }
    50%       { transform: translateY(-16px) rotate(3deg); }
  }

  @keyframes heroSpin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  @keyframes heroPulse {
    0%, 100% { transform: scale(1); opacity: 0.85; }
    50%       { transform: scale(1.18); opacity: 1; }
  }

  /* En móvil reducimos los SVGs para no tapar el contenido */
  @media (max-width: 640px) {
    .hero-svg--cake    { width: 60px; left: 1%; }
    .hero-svg--cupcake { width: 48px; right: 1%; }
    .hero-svg--donut   { display: none; }
    .hero-svg--heart   { width: 36px; }
    .hero-svg--star1   { width: 30px; }
    .hero-svg--star2   { width: 20px; }
  }

  /* ============================================================
     CART ITEM — NUEVO DISEÑO PREMIUM
     ============================================================ */

  /* Item wrapper con animación de entrada/salida */
  .cart-item {
    border: 1px solid rgba(232,25,108,0.2);
    border-radius: var(--border-radius-md);
    padding: 1rem;
    margin-bottom: 0.85rem;
    transition: border-color var(--transition-fast), opacity 0.28s ease, transform 0.28s ease;
  }

  .cart-item:nth-child(3n+1) {
    background-color: rgba(232, 25, 108, 0.08);
  }
  .cart-item:nth-child(3n+2) {
    background-color: rgba(255, 107, 53, 0.08);
  }
  .cart-item:nth-child(3n) {
    background-color: rgba(245, 230, 200, 0.08);
  }

  .cart-item:hover {
    border-color: rgba(232,25,108,0.45);
  }

  .cart-item.ci-removing {
    opacity: 0;
    transform: translateX(30px);
  }

  /* Fila principal: contenedor principal de fila */
  .ci-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 1rem;
  }

  /* Lado izquierdo: [Ícono] [Nombre + subtexto] */
  .ci-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 1;
    min-width: 0;
  }

  /* Badge de categoría circular */
  .ci-icon {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.25);
  }

  .ci-emoji {
    font-size: 1.35rem;
    line-height: 1;
  }

  /* Columna central — nombre y precio unitario */
  .ci-body {
    flex: 1;
    min-width: 0;
  }

  .ci-name {
    font-family: var(--font-sans);
    font-size: 0.93rem;
    font-weight: 700;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.3;
    margin: 0;
  }

  .ci-unit-price {
    font-size: 0.75rem;
    color: rgba(245,230,200,0.6);
    margin: 0;
    margin-top: 2px;
  }

  /* Lado derecho — precio total + botón eliminar */
  .ci-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .ci-total {
    font-size: 0.95rem;
    font-weight: 800;
    color: #FF8C42;
    white-space: nowrap;
  }

  /* Botón eliminar — círculo rojo con equis */
  .ci-remove {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(239, 68, 68, 0.15);
    border: 1.5px solid rgba(239, 68, 68, 0.5);
    color: #EF4444;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--transition-fast), transform var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
    padding: 0;
  }

  .ci-remove:hover {
    background: #EF4444;
    border-color: #EF4444;
    color: #ffffff;
    transform: scale(1.15) rotate(90deg);
  }

  .ci-remove:active {
    transform: scale(0.9);
  }

  /* Fila de cantidad y fila duplicar */
  .ci-qty-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(232,25,108,0.12);
  }

  .ci-duplicate-row {
    margin-top: 0.85rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(232,25,108,0.12);
    display: flex;
    justify-content: center;
  }

  .ci-qty-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(245,230,200,0.6);
    letter-spacing: 0.3px;
  }

  .ci-qty-control {
    display: flex;
    align-items: center;
    background: var(--bg-primary);
    border: 1.5px solid rgba(232,25,108,0.25);
    border-radius: var(--border-radius-sm);
    overflow: hidden;
  }

  .ci-qty-btn {
    width: 34px;
    height: 34px;
    background: transparent;
    border: none;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast);
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .ci-qty-btn:hover {
    background: rgba(232,25,108,0.2);
    color: #FF8C42;
  }

  .ci-qty-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ci-qty-btn:disabled:hover {
    background: transparent;
    color: var(--text-primary);
  }

  .ci-qty-val {
    min-width: 32px;
    text-align: center;
    font-size: 0.92rem;
    font-weight: 800;
    color: var(--text-primary);
    padding: 0 4px;
    border-left: 1px solid rgba(232,25,108,0.2);
    border-right: 1px solid rgba(232,25,108,0.2);
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Cart footer decoración SVG */
  .cart-sweet-deco {
    margin-bottom: 0.75rem;
    opacity: 0.85;
  }

  .cart-deco-svg {
    width: 100%;
    height: 48px;
    display: block;
  }

  /* Botón checkout con flecha */
  .cart-checkout-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1rem;
  }


  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 2rem;
    font-size: 0.95rem;
    font-weight: 700;
    border-radius: var(--border-radius-md);
    cursor: pointer;
    transition: all var(--transition-fast);
    border: none;
  }

  .btn-primary {
    background: var(--gradient-brand);
    color: #FFFFFF;
    box-shadow: var(--shadow-md);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
    background: linear-gradient(135deg, #C2185B, #E8196C);
  }

  .btn-outline {
    background-color: transparent;
    color: var(--text-white);
    border: 2px solid var(--text-white);
  }

  .btn-outline:hover {
    background-color: var(--text-white);
    color: var(--primary-dark);
  }

  .btn-block {
    width: 100%;
  }

  .btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
  }

  /* ============================================================
     SECCIONES — GENERAL
     ============================================================ */
  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-header .subtitle {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-weight: 800;
    display: block;
    margin-bottom: 0.5rem;
  }

  .section-header h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .divider {
    width: 60px;
    height: 3px;
    background: var(--gradient-brand);
    margin: 1rem auto 0;
    border-radius: 2px;
  }

  /* ============================================================
     INFO SECTION — CÓMO PEDIR (fondo crema claro)
     ============================================================ */
  .info-section {
    padding: 5.5rem 2rem;
    background-color: var(--bg-light);
  }

  .info-section .subtitle {
    color: var(--primary-deep);
  }

  .info-section h2 {
    color: var(--text-on-light);
  }

  .info-section .section-desc {
    color: rgba(42,10,20,0.75);
  }

  .steps-grid {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2.5rem;
  }

  .step-card {
    background-color: #FFFFFF;
    padding: 2.5rem 1.75rem;
    border-radius: var(--border-radius-lg);
    box-shadow: 0 4px 20px rgba(232,25,108,0.1);
    text-align: center;
    border: 1px solid rgba(232,25,108,0.12);
    position: relative;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .step-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 32px rgba(232,25,108,0.18);
  }

  .step-icon {
    width: 52px;
    height: 52px;
    background: var(--gradient-brand);
    color: #fff;
    font-size: 1.4rem;
    font-weight: 800;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    box-shadow: 0 4px 16px rgba(232,25,108,0.3);
  }

  .step-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.75rem;
    color: var(--primary-dark);
    font-family: var(--font-serif);
  }

  .step-card p {
    color: rgba(42,10,20,0.75);
    font-size: 0.93rem;
    line-height: 1.6;
  }

  /* ============================================================
     SVGs DECORATIVOS GLOBALES — Posicionados en toda la web
     ============================================================ */
  .section-deco {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }

  .sdeco {
    position: absolute;
    opacity: 0.85;
  }

  /* --- CATÁLOGO --- */
  .section-deco--catalog { position: absolute; inset: 0; }

  .sdeco--cupcake-l {
    width: 120px;
    bottom: 10%;
    left: 1%;
    animation: heroFloat 7s ease-in-out infinite;
  }

  .sdeco--star-r {
    width: 56px;
    top: 8%;
    right: 2%;
    animation: heroSpin 12s linear infinite;
  }

  .sdeco--heart-tl {
    width: 70px;
    top: 5%;
    left: 4%;
    animation: heroPulse 4s ease-in-out infinite;
  }

  /* --- INFO / CÓMO PEDIR --- */
  .section-deco--info { position: absolute; inset: 0; }

  .sdeco--cake-big {
    width: 140px;
    top: 50%;
    right: 0.5%;
    transform: translateY(-50%);
    animation: heroFloat 8s ease-in-out infinite 0.5s;
  }

  .sdeco--donut-r {
    width: 100px;
    bottom: 5%;
    left: 1%;
    animation: heroFloat 6s ease-in-out infinite reverse;
  }

  /* --- BUFFET --- */
  .section-deco--buffet { position: absolute; inset: 0; }
  .section-deco--decorations { position: absolute; inset: 0; }

  .sdeco--star-big {
    width: 80px;
    top: 8%;
    left: 1%;
    animation: heroSpin 14s linear infinite reverse;
  }

  .sdeco--cupcake-r2 {
    width: 130px;
    bottom: 8%;
    right: 1%;
    animation: heroFloat 9s ease-in-out infinite 1s;
  }

  /* Ensure parent sections have position: relative */
  .catalog-section,
  .info-section,
  .buffet-section,
  .decorations-section {
    position: relative;
    overflow: hidden;
  }

  /* ============================================================
     SELECTOR DE CANTIDAD — Ultra Premium (invita a aumentar)
     ============================================================ */

  /* Override ci-qty-row para hacerlo más prominente */
  .ci-qty-row {
    margin-top: 0.85rem !important;
    padding-top: 0.75rem !important;
    border-top: 1px solid rgba(232,25,108,0.15) !important;
    display: flex !important;
    align-items: center !important;
    gap: 0.75rem !important;
  }

  .ci-qty-label {
    font-size: 0.8rem !important;
    font-weight: 700 !important;
    color: rgba(245,230,200,0.7) !important;
    text-transform: uppercase !important;
    letter-spacing: 0.8px !important;
    flex-shrink: 0 !important;
  }

  /* Control completo: wrap para centrado y visual invitador */
  .ci-qty-control {
    display: flex !important;
    align-items: stretch !important;
    background: linear-gradient(135deg, rgba(42,10,20,0.8), rgba(74,32,48,0.8)) !important;
    border: 1.5px solid rgba(232,25,108,0.4) !important;
    border-radius: 50px !important;  /* pill shape — más premium */
    overflow: hidden !important;
    box-shadow: 0 2px 12px rgba(232,25,108,0.2), inset 0 1px 0 rgba(255,255,255,0.08) !important;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast) !important;
  }

  .ci-qty-control:hover {
    border-color: rgba(232,25,108,0.7) !important;
    box-shadow: 0 4px 18px rgba(232,25,108,0.35) !important;
  }

  .ci-qty-btn {
    width: 40px !important;
    height: 40px !important;
    font-size: 1.3rem !important;
    font-weight: 800 !important;
    color: #FF8C42 !important;
    cursor: pointer !important;
    background: transparent !important;
    border: none !important;
    transition: background var(--transition-fast), color var(--transition-fast), transform 0.1s !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .ci-qty-btn:hover:not(:disabled) {
    background: rgba(232,25,108,0.25) !important;
    color: #FFFFFF !important;
    transform: scale(1.1) !important;
  }

  .ci-qty-btn:active:not(:disabled) {
    transform: scale(0.92) !important;
    background: rgba(232,25,108,0.4) !important;
  }

  .ci-qty-btn:disabled {
    opacity: 0.25 !important;
    cursor: not-allowed !important;
    color: rgba(245,230,200,0.4) !important;
  }

  .ci-qty-val {
    min-width: 40px !important;
    height: 40px !important;
    font-size: 1rem !important;
    font-weight: 900 !important;
    color: #FFFFFF !important;
    background: rgba(232,25,108,0.18) !important;
    border-left: 1px solid rgba(232,25,108,0.25) !important;
    border-right: 1px solid rgba(232,25,108,0.25) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    letter-spacing: 0.5px !important;
  }

  /* Hint visual de que se puede añadir más */
  .ci-qty-hint {
    font-size: 0.7rem;
    color: rgba(255,140,66,0.7);
    font-style: italic;
    margin-left: auto;
    white-space: nowrap;
  }

  /* ============================================================
     CATALOG SECTION (fondo crema claro)
     ============================================================ */
  .catalog-section {
    padding: 5.5rem 2rem;
    max-width: 100%;
    background-color: var(--bg-light);
  }


  .catalog-section .section-header {
    max-width: var(--max-width);
    margin: 0 auto 3.5rem auto;
  }

  .catalog-section .subtitle {
    color: var(--primary-deep);
  }

  .catalog-section h2 {
    color: var(--text-on-light);
  }

  /* Products Grid */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2.5rem;
  }

  .product-card {
    background-color: #FFFFFF;
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(232,25,108,0.08);
    border: 1px solid rgba(232,25,108,0.1);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    display: flex;
    flex-direction: column;
  }

  .product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgba(232,25,108,0.18);
  }

  .product-image-container {
    height: 240px;
    position: relative;
    overflow: hidden;
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .product-card:hover .product-image {
    transform: scale(1.05);
  }

  .product-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: var(--gradient-brand);
    color: #fff;
    padding: 0.3rem 0.85rem;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    border-radius: 50px;
    letter-spacing: 0.5px;
  }

  .product-info {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-info h3 {
    font-size: 1.25rem;
    margin-bottom: 0.65rem;
    color: var(--text-on-light);
    font-family: var(--font-serif);
  }

  .product-description {
    font-size: 0.88rem;
    color: rgba(42,10,20,0.65);
    margin-bottom: 1.25rem;
    flex: 1;
    line-height: 1.55;
  }

  .product-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(232,25,108,0.1);
    padding-top: 1rem;
  }

  .product-price {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--primary);
  }

  .product-price .currency {
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(42,10,20,0.5);
  }

  .price-note {
    font-size: 0.73rem;
    font-weight: 400;
    color: rgba(42,10,20,0.5);
    display: block;
  }

  .add-to-cart-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--gradient-brand);
    border: none;
    color: #fff;
    padding: 0.6rem 1.4rem;
    border-radius: var(--border-radius-md);
    cursor: pointer;
    font-weight: 800;
    font-size: 0.85rem;
    transition: all var(--transition-fast);
    box-shadow: 0 3px 12px rgba(232,25,108,0.3);
  }

  .add-to-cart-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(232,25,108,0.45);
    background: linear-gradient(135deg, #C2185B, #E8196C);
  }

  /* ============================================================
     FLOATING CART BUTTON
     ============================================================ */
  .floating-cart {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background: var(--gradient-brand);
    color: #fff;
    width: 66px;
    height: 66px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 24px rgba(232,25,108,0.5);
    cursor: pointer;
    z-index: 99;
    border: 3px solid rgba(255,255,255,0.4);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .floating-cart:hover {
    transform: scale(1.08);
    box-shadow: 0 8px 32px rgba(232,25,108,0.65);
  }

  .cart-icon {
    font-size: 1.5rem;
  }

  .cart-count {
    position: absolute;
    top: -5px;
    right: -5px;
    background: #FFFFFF;
    color: var(--primary);
    width: 26px;
    height: 26px;
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--primary);
  }

  /* ============================================================
     CART DRAWER
     ============================================================ */
  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    visibility: hidden;
    transition: visibility var(--transition-normal);
  }

  .cart-drawer.open {
    visibility: visible;
  }

  .cart-drawer-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(42,10,20,0.55);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .cart-drawer.open .cart-drawer-overlay {
    opacity: 1;
  }

  .cart-drawer-content {
    position: absolute;
    top: 0;
    right: -100%;
    width: 100%;
    max-width: 480px;
    height: 100%;
    background-color: var(--bg-secondary);
    border-left: 3px solid transparent;
    border-image: linear-gradient(180deg, #E8196C, #FF6B35) 1;
    box-shadow: -10px 0 50px rgba(0, 0, 0, 0.4);
    transition: right var(--transition-normal);
    display: flex;
    flex-direction: column;
  }

  .cart-drawer.open .cart-drawer-content {
    right: 0;
  }

  .cart-header {
    padding: 1.35rem 1.5rem;
    border-bottom: 1px solid rgba(232,25,108,0.2);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(135deg, #A01050, #C2185B);
  }

  .cart-header h2 {
    font-size: 1.35rem;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: 0.5px;
  }

  .close-btn {
    background: rgba(255,255,255,0.15);
    border: none;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-normal);
  }

  .close-btn:hover {
    background: rgba(255,255,255,0.3);
    transform: rotate(90deg);
  }

  .cart-items-container {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
    scrollbar-width: thin;
    scrollbar-color: var(--primary) var(--bg-primary);
  }

