---
import Layout from '../layouts/Layout.astro';
import { PRODUCTS } from '../data/products';

const cakes = PRODUCTS.filter(p => p.category === 'cakes' || p.category === 'minicakes');
const buffetItems = PRODUCTS.filter(p => p.category === 'reposteria' || p.category === 'salados');
---

<Layout title="Inicio - Dulcería por Encargo">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <span class="hero-badge">Artesanal & Premium</span>
      <h1>El Arte de la Dulcería Fina</h1>
      <p>Cakes exclusivos y dulces de alta calidad elaborados totalmente por encargo para hacer de tu celebración un momento inolvidable.</p>
      <div class="hero-actions">
        <a href="#catalogo" class="btn btn-primary">Ver la Carta</a>
        <a href="#como-pedir" class="btn btn-outline">¿Cómo pedir?</a>
      </div>
    </div>
  </section>

  <!-- Info Section / Como Pedir -->
  <section id="como-pedir" class="info-section">
    <div class="section-header">
      <span class="subtitle">Paso a Paso</span>
      <h2>¿Cómo funciona nuestro servicio por encargo?</h2>
      <div class="divider"></div>
    </div>
    
    <div class="steps-grid">
      <div class="step-card">
        <div class="step-icon">1</div>
        <h3>Selecciona tus Dulces</h3>
        <p>Explora nuestra carta exclusiva y elige tus cakes o bocaditos favoritos agregándolos al carrito de compras.</p>
      </div>
      <div class="step-card">
        <div class="step-icon">2</div>
        <h3>Personaliza tu Cake</h3>
        <p>En el carrito, define los colores, la temática o añade una <strong>Impresión Comestible (+650 CUP)</strong> subiendo tu propia imagen.</p>
      </div>
      <div class="step-card">
        <div class="step-icon">3</div>
        <h3>Envía por WhatsApp</h3>
        <p>Tu pedido se procesará automáticamente en un mensaje detallado para finalizar la cotización y agendar la fecha por WhatsApp.</p>
      </div>
    </div>
  </section>

  <!-- Interactive Customizer Section -->
  <section id="personalizador" class="customizer-section">
    <div class="section-header">
      <span class="subtitle">Creación a Medida</span>
      <h2>🎂 Diseña tu Cake Personalizado</h2>
      <div class="divider"></div>
      <p class="section-desc">Visualiza y configura el pastel ideal para tu celebración en tiempo real. Cambios de masa e impresiones se detallan abajo.</p>
    </div>

    <div class="customizer-grid">
      <!-- Visualizer Canvas -->
      <div class="customizer-visualizer">
        <canvas id="cake-canvas" width="360" height="360"></canvas>
      </div>

      <!-- Controls Panel -->
      <div class="customizer-controls">
        <div class="control-group">
          <label for="custom-size">📏 Selecciona el Tamaño / Modelo:</label>
          <select id="custom-size" class="customizer-select">
            <option value="minicake-15" data-price="2500" data-type="1piso" selected>MiniCake (15 cm) — $2500 CUP</option>
            <option value="cake-22-harina" data-price="3500" data-type="1piso">Cake Estándar (22 cm) — $3500 CUP</option>
            <option value="cake-redondo-25" data-price="5000" data-type="1piso">Cake Mediano (25 cm) — $5000 CUP</option>
            <option value="cake-redondo-30" data-price="10700" data-type="1piso">Cake Grande (30 cm) — $10700 CUP</option>
            <option value="cake-redondo-36" data-price="15000" data-type="1piso">Cake Gigante (36 cm) — $15000 CUP</option>
            <option value="cake-2-pisos" data-price="16500" data-type="2pisos">Cake de 2 Pisos — $16500 CUP</option>
            <option value="cake-bandeja-harina" data-price="10700" data-type="bandeja">Cake de Bandeja — $10700 CUP</option>
            <option value="medio-cake-bandeja-harina" data-price="5300" data-type="bandeja">Medio Cake de Bandeja — $5300 CUP</option>
            <option value="cake-20x8-maicena" data-price="3600" data-type="1piso">Cake 20x8 cm (Maicena) — $3600 CUP</option>
            <option value="cake-20x15-maicena" data-price="5500" data-type="1piso">Cake 20x15 cm (Maicena) — $5500 CUP</option>
            <option value="cake-capuchino-22" data-price="5700" data-type="1piso">Cake de Capuchino (22 cm) — $5700 CUP</option>
          </select>
        </div>

        <div class="control-group" id="custom-dough-wrapper">
          <label for="custom-dough">🌾 Tipo de Masa:</label>
          <select id="custom-dough" class="customizer-select">
            <option value="trigo" selected>Harina de Trigo (Por defecto)</option>
            <option value="maicena">Maicena (Almidón de maíz)</option>
            <option value="capuchino">Capuchino</option>
          </select>
          <div class="dough-warning-banner" id="customizer-dough-warning" style="display: none;">
            ⚠️ Cambiar el tipo de masa a Maicena o Capuchino incrementa el precio final del cake. El ajuste se acordará por WhatsApp.
          </div>
        </div>

        <div class="control-group">
          <label>🎨 Color de Cobertura:</label>
          <div class="color-swatches">
            <button class="color-swatch active" data-color="#FDFBF7" data-name="Blanco Crema" style="background-color: #FDFBF7;"></button>
            <button class="color-swatch" data-color="#FBCFE8" data-name="Rosa Pastel" style="background-color: #FBCFE8;"></button>
            <button class="color-swatch" data-color="#BAE6FD" data-name="Azul Celeste" style="background-color: #BAE6FD;"></button>
            <button class="color-swatch" data-color="#FEF08A" data-name="Amarillo Sol" style="background-color: #FEF08A;"></button>
            <button class="color-swatch" data-color="#A7F3D0" data-name="Verde Menta" style="background-color: #A7F3D0;"></button>
            <button class="color-swatch" data-color="#E9D5FF" data-name="Lila" style="background-color: #E9D5FF;"></button>
            <button class="color-swatch" data-color="#D97706" data-name="Dorado Oro" style="background-color: #D97706;"></button>
            <button class="color-swatch" data-color="#78350F" data-name="Chocolate" style="background-color: #78350F;"></button>
          </div>
          <span class="selected-color-label">Color: <strong id="color-name-display">Blanco Crema</strong></span>
        </div>

        <div class="control-group">
          <label for="custom-theme">✍️ Temática / Decoración (Opcional):</label>
          <input type="text" id="custom-theme" class="customizer-input" placeholder="Ej: Cumpleaños infantil, dinosaurios, feliz 30..." />
        </div>

        <div class="control-group">
          <label class="edible-print-option">
            <input type="checkbox" id="custom-print" />
            Añadir Impresión Comestible (+650 CUP)
          </label>
        </div>

        <div class="price-display-box">
          <span>Precio Estimado:</span>
          <span id="customizer-price-display" class="price-value">$2500 CUP</span>
        </div>

        <button id="add-custom-cake-btn" class="btn btn-primary btn-block">
          🛒 Añadir Cake Diseñado al Carrito
        </button>
      </div>
    </div>
  </section>

  <!-- Catalog / Products Section -->
  <section id="catalogo" class="catalog-section">
    <div class="catalog-main-layout">
      <!-- Left side: Cakes Carousel -->
      <div class="cakes-catalog">
        <div class="section-header align-left">
          <span class="subtitle">Exquisiteces</span>
          <h2>¿Qué tipo de cake deseas para tu celebración?</h2>
          <div class="divider"></div>
        </div>

        <!-- Carousel Outer Wrapper -->
        <div class="carousel-outer-wrapper">
          <button class="carousel-control prev" id="carousel-prev-btn" aria-label="Anterior">&lt;</button>
          <div class="carousel-viewport" id="carousel-viewport">
            <div class="carousel-track" id="carousel-track">
              {cakes.map(product => (
                <div class="product-card carousel-slide" data-category={product.category}>
                  <div class="product-image-container">
                    <img src={product.image} alt={product.name} class="product-image" loading="lazy" />
                    <span class="product-badge">{product.category === 'minicakes' ? 'MiniCake' : 'Cake'}</span>
                  </div>
                  <div class="product-info">
                    <h3>{product.name}</h3>
                    <p class="product-description">{product.description}</p>
                    <div class="product-meta">
                      <span class="product-price">
                        ${product.price} <span class="currency">CUP</span>
                        {product.priceNote && <span class="price-note">({product.priceNote})</span>}
                      </span>
                      <button 
                        class="add-to-cart-btn" 
                        data-id={product.id}
                        data-name={product.name}
                        data-price={product.price}
                        data-category={product.category}
                        data-customizable={product.customizable ? "true" : "false"}
                      >
                        + Agregar
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <button class="carousel-control next" id="carousel-next-btn" aria-label="Siguiente">&gt;</button>
        </div>
      </div>

      <!-- Right side: Buffet & Extras -->
      <div class="buffet-sidebar">
        <div class="sidebar-header">
          <span class="subtitle">Oferta Adicional</span>
          <h3>Acompaña tu Fiesta</h3>
          <div class="divider"></div>
          <p class="sidebar-desc">Buffet, marquesitas, cupcakes y saladitos complementarios para tus invitados.</p>
        </div>
        
        <div class="buffet-list">
          {buffetItems.map(product => (
            <div class="buffet-item-card">
              <img src={product.image} alt={product.name} class="buffet-item-image" loading="lazy" />
              <div class="buffet-item-info">
                <h4>{product.name}</h4>
                <p class="buffet-item-desc">{product.description}</p>
                <div class="buffet-item-meta">
                  <span class="buffet-item-price">${product.price} CUP c/u</span>
                  <button 
                    class="add-to-cart-btn btn-sm-add" 
                    data-id={product.id}
                    data-name={product.name}
                    data-price={product.price}
                    data-category={product.category}
                    data-customizable={product.customizable ? "true" : "false"}
                  >
                    + Añadir
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Floating Cart Button -->
  <button id="floating-cart-btn" class="floating-cart">
    <span class="cart-icon">🛒</span>
    <span class="cart-count">0</span>
  </button>

  <!-- Cart Drawer/Sidebar -->
  <div id="cart-drawer" class="cart-drawer">
    <div class="cart-drawer-overlay"></div>
    <div class="cart-drawer-content">
      <div class="cart-header">
        <h2>Tu Encargo</h2>
        <button id="close-cart-btn" class="close-btn">&times;</button>
      </div>
      
      <div id="cart-items-container" class="cart-items-container">
        <!-- Rendered dynamically by JS -->
        <div class="empty-cart-message">
          <p>Tu carrito está vacío</p>
          <a href="#catalogo" id="explore-btn" class="btn btn-outline btn-sm">Explorar la Carta</a>
        </div>
      </div>

      <div class="cart-footer">
        <div class="cart-date-picker">
          <label for="order-date">📅 Fecha requerida para el encargo:</label>
          <input type="date" id="order-date" name="order-date" required />
          
          <label for="order-time" style="margin-top: 0.5rem; display: block;">🕒 Hora sugerida (Opcional):</label>
          <input type="time" id="order-time" name="order-time" />
        </div>
        <div class="cart-summary-row">
          <span>Subtotal</span>
          <span id="cart-subtotal">$0 CUP</span>
        </div>
        <div class="cart-summary-row">
          <span>Adicionales (Impresiones)</span>
          <span id="cart-addons">$0 CUP</span>
        </div>
        <div class="cart-summary-row total-row">
          <span>Total Estimado</span>
          <span id="cart-total">$0 CUP</span>
        </div>
        <div class="cart-note-warning">
          ⚠️ Nota: La decoración final y precio de cakes personalizados se acordará por WhatsApp. Decoraciones complejas pueden variar el precio.
        </div>
        <button id="checkout-whatsapp-btn" class="btn btn-primary btn-block">
          Confirmar Pedido vía WhatsApp 💬
        </button>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Hero Section */
  .hero {
    height: 80vh;
    min-height: 500px;
    background-image: url('https://images.unsplash.com/photo-1578985545062-69928b1d9587?q=80&w=1600&auto=format&fit=crop');
    background-size: cover;
    background-position: center;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-white);
    text-align: center;
    padding: 0 2rem;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(88, 0, 10, 0.75), rgba(12, 12, 12, 0.6));
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px;
  }

  .hero-badge {
    background-color: var(--accent-color);
    color: var(--primary-dark);
    padding: 0.4rem 1.2rem;
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-radius: 50px;
    display: inline-block;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .hero h1 {
    font-size: 3.5rem;
    color: var(--text-white);
    margin-bottom: 1.5rem;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  }

  .hero p {
    font-size: 1.25rem;
    font-weight: 300;
    margin-bottom: 2.5rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .hero-actions {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
  }

  /* General Components */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 2rem;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: var(--border-radius-md);
    cursor: pointer;
    transition: all var(--transition-fast);
    border: none;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--accent-color), var(--accent-dark));
    color: var(--text-primary);
    box-shadow: var(--shadow-md);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-gold);
    background: linear-gradient(135deg, #f7d25b, var(--accent-color));
  }

  .btn-outline {
    background-color: transparent;
    color: var(--text-white);
    border: 2px solid var(--text-white);
  }

  .btn-outline:hover {
    background-color: var(--text-white);
    color: var(--primary-dark);
  }

  .btn-block {
    width: 100%;
  }

  .btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
  }

  /* Sections general */
  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-header .subtitle {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--accent-dark);
    font-weight: 700;
    display: block;
    margin-bottom: 0.5rem;
  }

  .section-header h2 {
    font-size: 2.5rem;
    color: var(--primary-dark);
  }

  .divider {
    width: 60px;
    height: 3px;
    background-color: var(--accent-color);
    margin: 1rem auto 0;
  }

  /* Info Section / Cómo Pedir */
  .info-section {
    padding: 6rem 2rem;
    background-color: var(--bg-secondary);
  }

  .steps-grid {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 3rem;
  }

  .step-card {
    background-color: var(--bg-card);
    padding: 3rem 2rem;
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-sm);
    text-align: center;
    border: 1px solid var(--border-color);
    position: relative;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .step-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent-color);
  }

  .step-icon {
    width: 50px;
    height: 50px;
    background-color: var(--primary-color);
    color: var(--text-white);
    font-size: 1.5rem;
    font-weight: 700;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    border: 2px solid var(--accent-color);
  }

  .step-card h3 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    color: var(--primary-dark);
  }

  .step-card p {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  /* Catalog / Products Section */
  .catalog-section {
    padding: 6rem 2rem;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .category-filters {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    padding: 0.6rem 1.5rem;
    border-radius: 50px;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }

  .filter-btn:hover, .filter-btn.active {
    background-color: var(--primary-color);
    color: var(--text-white);
    border-color: var(--primary-color);
    box-shadow: var(--shadow-sm);
  }

  /* Products Grid */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2.5rem;
  }

  .product-card {
    background-color: var(--bg-card);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-color);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    display: flex;
    flex-direction: column;
  }

  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }

  .product-image-container {
    height: 240px;
    position: relative;
    overflow: hidden;
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .product-card:hover .product-image {
    transform: scale(1.05);
  }

  .product-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background-color: rgba(140, 13, 27, 0.9);
    color: var(--text-white);
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    border-radius: 50px;
    border: 1px solid var(--accent-color);
  }

  .product-info {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-info h3 {
    font-size: 1.35rem;
    margin-bottom: 0.75rem;
    color: var(--primary-dark);
  }

  .product-description {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .product-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
  }

  .product-price {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--primary-color);
  }

  .product-price .currency {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .price-note {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-light);
    display: block;
  }

  .add-to-cart-btn {
    background-color: var(--bg-secondary);
    border: 1px solid var(--primary-color);
    color: var(--primary-color);
    padding: 0.5rem 1.2rem;
    border-radius: var(--border-radius-md);
    cursor: pointer;
    font-weight: 700;
    font-size: 0.85rem;
    transition: all var(--transition-fast);
  }

  .add-to-cart-btn:hover {
    background-color: var(--primary-color);
    color: var(--text-white);
  }

  /* Floating Cart Button */
  .floating-cart {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
    color: var(--text-white);
    width: 65px;
    height: 65px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(140, 13, 27, 0.4);
    cursor: pointer;
    z-index: 99;
    border: 2px solid var(--accent-color);
    transition: transform var(--transition-fast);
  }

  .floating-cart:hover {
    transform: scale(1.05);
  }

  .cart-icon {
    font-size: 1.5rem;
  }

  .cart-count {
    position: absolute;
    top: -5px;
    right: -5px;
    background-color: var(--accent-color);
    color: var(--text-primary);
    width: 25px;
    height: 25px;
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--primary-dark);
  }

  /* Cart Drawer/Sidebar */
  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    visibility: hidden;
    transition: visibility var(--transition-normal);
  }

  .cart-drawer.open {
    visibility: visible;
  }

  .cart-drawer-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .cart-drawer.open .cart-drawer-overlay {
    opacity: 1;
  }

  .cart-drawer-content {
    position: absolute;
    top: 0;
    right: -100%;
    width: 100%;
    max-width: 480px;
    height: 100%;
    background-color: var(--bg-primary);
    box-shadow: -4px 0 30px rgba(0, 0, 0, 0.15);
    transition: right var(--transition-normal);
    display: flex;
    flex-direction: column;
  }

  .cart-drawer.open .cart-drawer-content {
    right: 0;
  }

  .cart-header {
    padding: 1.5rem;
    border-bottom: 1px solid var(--border-color);
    display: flex;
