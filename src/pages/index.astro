    box-shadow: 0 4px 18px rgba(232,25,108,0.35) !important;
  }

  .ci-qty-btn {
    width: 40px !important;
    height: 40px !important;
    font-size: 1.3rem !important;
    font-weight: 800 !important;
    color: #FF8C42 !important;
    cursor: pointer !important;
    background: transparent !important;
    border: none !important;
    transition: background var(--transition-fast), color var(--transition-fast), transform 0.1s !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .ci-qty-btn:hover:not(:disabled) {
    background: rgba(232,25,108,0.25) !important;
    color: #FFFFFF !important;
    transform: scale(1.1) !important;
  }

  .ci-qty-btn:active:not(:disabled) {
    transform: scale(0.92) !important;
    background: rgba(232,25,108,0.4) !important;
  }

  .ci-qty-btn:disabled {
    opacity: 0.25 !important;
    cursor: not-allowed !important;
    color: rgba(245,230,200,0.4) !important;
  }

  .ci-qty-val {
    min-width: 40px !important;
    height: 40px !important;
    font-size: 1rem !important;
    font-weight: 900 !important;
    color: #FFFFFF !important;
    background: rgba(232,25,108,0.18) !important;
    border-left: 1px solid rgba(232,25,108,0.25) !important;
    border-right: 1px solid rgba(232,25,108,0.25) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    letter-spacing: 0.5px !important;
  }

  /* Hint visual de que se puede añadir más */
  .ci-qty-hint {
    font-size: 0.7rem;
    color: rgba(255,140,66,0.7);
    font-style: italic;
    margin-left: auto;
    white-space: nowrap;
  }

  /* ============================================================
     CATALOG SECTION (fondo crema claro)
     ============================================================ */
  .catalog-section {
    padding: 5.5rem 2rem;
    max-width: 100%;
    background-color: var(--bg-light);
  }


  .catalog-section .section-header {
    max-width: var(--max-width);
    margin: 0 auto 3.5rem auto;
  }

  .catalog-section .subtitle {
    color: var(--primary-deep);
  }

  .catalog-section h2 {
    color: var(--text-on-light);
  }

  /* Products Grid */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2.5rem;
  }

  .product-card {
    background-color: #FFFFFF;
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(232,25,108,0.08);
    border: 1px solid rgba(232,25,108,0.1);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    display: flex;
    flex-direction: column;
  }

  .product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgba(232,25,108,0.18);
  }

  .product-image-container {
    height: 240px;
    position: relative;
    overflow: hidden;
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .product-card:hover .product-image {
    transform: scale(1.05);
  }

  .product-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: var(--gradient-brand);
    color: #fff;
    padding: 0.3rem 0.85rem;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    border-radius: 50px;
    letter-spacing: 0.5px;
  }

  .product-info {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-info h3 {
    font-size: 1.25rem;
    margin-bottom: 0.65rem;
    color: var(--text-on-light);
    font-family: var(--font-serif);
  }

  .product-description {
    font-size: 0.88rem;
    color: rgba(42,10,20,0.65);
    margin-bottom: 1.25rem;
    flex: 1;
    line-height: 1.55;
  }

  .product-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(232,25,108,0.1);
    padding-top: 1rem;
  }

  .product-price {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--primary);
  }

  .product-price .currency {
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(42,10,20,0.5);
  }

  .price-note {
    font-size: 0.73rem;
    font-weight: 400;
    color: rgba(42,10,20,0.5);
    display: block;
  }

  .add-to-cart-btn {
    background: var(--gradient-brand);
    border: none;
    color: #fff;
    padding: 0.6rem 1.4rem;
    border-radius: var(--border-radius-md);
    cursor: pointer;
    font-weight: 800;
    font-size: 0.85rem;
    transition: all var(--transition-fast);
    box-shadow: 0 3px 12px rgba(232,25,108,0.3);
  }

  .add-to-cart-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(232,25,108,0.45);
    background: linear-gradient(135deg, #C2185B, #E8196C);
  }

  /* ============================================================
     FLOATING CART BUTTON
     ============================================================ */
  .floating-cart {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background: var(--gradient-brand);
    color: #fff;
    width: 66px;
    height: 66px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 24px rgba(232,25,108,0.5);
    cursor: pointer;
    z-index: 99;
    border: 3px solid rgba(255,255,255,0.4);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .floating-cart:hover {
    transform: scale(1.08);
    box-shadow: 0 8px 32px rgba(232,25,108,0.65);
  }

  .cart-icon {
    font-size: 1.5rem;
  }

  .cart-count {
    position: absolute;
    top: -5px;
    right: -5px;
    background: #FFFFFF;
    color: var(--primary);
    width: 26px;
    height: 26px;
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--primary);
  }

  /* ============================================================
     CART DRAWER
     ============================================================ */
  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    visibility: hidden;
    transition: visibility var(--transition-normal);
  }

  .cart-drawer.open {
    visibility: visible;
  }

  .cart-drawer-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(42,10,20,0.55);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .cart-drawer.open .cart-drawer-overlay {
    opacity: 1;
  }

  .cart-drawer-content {
    position: absolute;
    top: 0;
    right: -100%;
    width: 100%;
    max-width: 480px;
    height: 100%;
    background-color: var(--bg-secondary);
    border-left: 3px solid transparent;
    border-image: linear-gradient(180deg, #E8196C, #FF6B35) 1;
    box-shadow: -10px 0 50px rgba(0, 0, 0, 0.4);
    transition: right var(--transition-normal);
    display: flex;
    flex-direction: column;
  }

  .cart-drawer.open .cart-drawer-content {
    right: 0;
  }

  .cart-header {
    padding: 1.35rem 1.5rem;
    border-bottom: 1px solid rgba(232,25,108,0.2);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(135deg, #A01050, #C2185B);
  }

  .cart-header h2 {
    font-size: 1.35rem;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: 0.5px;
  }

  .close-btn {
    background: rgba(255,255,255,0.15);
    border: none;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-normal);
  }

  .close-btn:hover {
    background: rgba(255,255,255,0.3);
    transform: rotate(90deg);
  }

  .cart-items-container {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
    scrollbar-width: thin;
    scrollbar-color: var(--primary) var(--bg-primary);
  }

  .empty-cart-message {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--neutral-cream);
  }

  .empty-cart-message p {
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
  }



  /* Customization block inside cart item */
  .cart-item-customization {
    background-color: var(--bg-primary);
    padding: 0.85rem;
    border-radius: var(--border-radius-sm);
    border-left: 3px solid var(--primary);
    margin-top: 0.75rem;
  }

  .customization-title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
    display: block;
  }

  .custom-note-textarea {
    width: 100%;
    height: 60px;
    padding: 0.5rem;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    resize: none;
    margin-bottom: 0.75rem;
  }

  .custom-note-textarea::placeholder {
    color: var(--text-light);
  }

  .edible-print-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    margin-bottom: 0.5rem;
  }

  .edible-print-option input {
    accent-color: var(--primary-color);
    width: 16px;
    height: 16px;
  }

  .upload-area {
    margin-top: 0.5rem;
    border: 1px dashed var(--accent-dark);
    padding: 0.5rem;
    border-radius: var(--border-radius-sm);
    text-align: center;
    background-color: var(--bg-card);
    position: relative;
    cursor: pointer;
  }

  .upload-label {
    font-size: 0.75rem;
    color: var(--text-secondary);
    display: block;
  }

  .upload-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  .file-preview {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    color: var(--accent-light);
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
  }

  .file-preview img {
    width: 30px;
    height: 30px;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid var(--border-color);
  }

  /* Cart Footer */
  .cart-footer {
    background-color: var(--bg-primary);
    border-top: 1px solid rgba(232,25,108,0.2);
    padding: 1.5rem;
  }

  .cart-date-picker {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .cart-date-picker label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .cart-date-picker input[type="date"],
  .cart-date-picker input[type="time"] {
    padding: 0.6rem;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    outline: none;
    color: var(--text-primary);
    background-color: var(--bg-primary);
  }

  .cart-date-picker input[type="date"]:focus,
  .cart-date-picker input[type="time"]:focus {
    border-color: var(--accent-color);
    box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.2);
  }

  .dough-selector-container {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .dough-select {
    padding: 0.4rem;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    font-size: 0.85rem;
    background-color: var(--bg-primary);
    color: var(--text-primary);
    outline: none;
  }

  .dough-select:focus {
    border-color: var(--accent-color);
  }

  .dough-warning-banner {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--accent-color);
    padding: 0.5rem;
    font-size: 0.75rem;
    border-radius: var(--border-radius-sm);
    margin-top: 0.25rem;
    line-height: 1.3;
  }

  .cart-summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
    color: var(--neutral-cream);
  }

  .total-row {
    font-size: 1.25rem;
    font-weight: 800;
    color: #FF8C42;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 2px solid rgba(255,140,66,0.4);
  }

  .cart-note-warning {
    background-color: rgba(255,248,240,0.08);
    border: 1px solid rgba(255,140,66,0.3);
    color: var(--neutral-cream);
    padding: 0.75rem;
    font-size: 0.8rem;
    border-radius: var(--border-radius-sm);
    margin: 1rem 0;
    line-height: 1.4;
  }

  /* ============================================================
     INTERACTIVE CUSTOMIZER (fondo oscuro profundo)
     ============================================================ */
  .customizer-section {
    padding: 5rem 1.5rem;
    background-color: var(--bg-secondary);
  }

  .customizer-section .subtitle {
    color: var(--accent-light);
  }

  .customizer-section h2 {
    color: var(--neutral-cream);
  }

  .customizer-section .section-desc {
    color: rgba(245,230,200,0.8);
  }

  .customizer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto;
    background-color: var(--bg-primary);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 1.5rem;
    border: 1px solid rgba(232,25,108,0.2);
  }

  @media (min-width: 768px) {
    .customizer-grid {
      grid-template-columns: 1fr 1.2fr;
      padding: 2.5rem;
      gap: 3rem;
    }
  }

  .customizer-visualizer {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle, #3D1A24, #1A060C);
    border-radius: var(--border-radius-md);
    border: 2px solid rgba(232,25,108,0.4);
    box-shadow: inset 0 0 24px rgba(0,0,0,0.4);
    padding: 1rem;
    min-height: 320px;
  }

  #cake-canvas {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .customizer-controls {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .control-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .control-group label {
    font-size: 0.93rem;
    font-weight: 700;
    color: var(--neutral-cream);
  }

  .customizer-select,
  .customizer-input {
    padding: 0.7rem;
    border: 1.5px solid rgba(232,25,108,0.25);
    border-radius: var(--border-radius-sm);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    outline: none;
    width: 100%;
  }

  .customizer-select:focus,
  .customizer-input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(232,25,108,0.15);
  }

  .color-picker-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .native-color-picker {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    width: 56px;
    height: 56px;
    border: 3px solid var(--primary);
    border-radius: 50%;
    background: none;
    cursor: pointer;
    padding: 0;
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-fast);
  }

  .native-color-picker:hover {
    transform: scale(1.08);
  }

  .native-color-picker::-webkit-color-swatch-wrapper {
    padding: 0;
  }

  .native-color-picker::-webkit-color-swatch {
    border: none;
    border-radius: 50%;
  }

  .color-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    flex: 1;
  }

  .color-swatch-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid var(--border-color);
    cursor: pointer;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .color-swatch-btn:hover {
    transform: scale(1.1);
  }

  .color-swatch-btn.active {
    border-color: var(--primary);
    transform: scale(1.15);
    box-shadow: 0 0 0 2px var(--bg-secondary), 0 0 0 4px var(--primary);
  }

  .selected-color-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .price-display-box {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--bg-primary);
    padding: 0.9rem;
    border-radius: var(--border-radius-sm);
    border-left: 4px solid var(--primary);
  }

  .price-display-box span {
    font-weight: 700;
    color: var(--neutral-cream);
  }

  .price-display-box .price-value {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--accent-light);
  }

  /* ============================================================
     CAROUSEL — Pills y controles
     ============================================================ */
  .carousel-subcategories {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    padding-bottom: 0.75rem;
    margin-top: 1.5rem;
    justify-content: flex-start;
    scrollbar-width: none;
  }

  .carousel-subcategories::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 768px) {
    .carousel-subcategories {
      justify-content: center;
    }
  }

  .subcategory-pill {
    padding: 0.5rem 1.35rem;
    background-color: rgba(42,10,20,0.08);
    border: 1.5px solid rgba(42,10,20,0.15);
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-on-light);
    cursor: pointer;
    white-space: nowrap;
    transition: all var(--transition-fast);
  }

  .subcategory-pill:hover,
  .subcategory-pill.active {
    background: var(--gradient-brand);
    color: #fff;
    border-color: transparent;
    box-shadow: 0 4px 16px rgba(232,25,108,0.35);
  }

  .carousel-outer-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 1200px;
    margin: 2rem auto 0 auto;
    padding: 0 0.5rem;
  }

  .carousel-viewport {
    overflow: hidden;
    width: 100%;
  }

  .carousel-track {
    display: flex;
    gap: 1.5rem;
    transition: transform 0.4s ease-in-out;
  }

  .carousel-slide {
    flex: 0 0 100%;
    max-width: 100%;
    box-sizing: border-box;
    transition: opacity 0.3s ease;
  }

  /* Large Card Sizes */
  @media (min-width: 600px) {
    .carousel-slide {
      flex: 0 0 calc(50% - 0.75rem);
      max-width: calc(50% - 0.75rem);
    }
  }

  @media (min-width: 992px) {
    .carousel-slide {
      flex: 0 0 calc(33.333% - 1rem);
      max-width: calc(33.333% - 1rem);
    }
  }

  .carousel-control {
    background: var(--gradient-brand);
    color: #fff;
    border: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-size: 1.2rem;
    font-weight: bold;
    cursor: pointer;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(232,25,108,0.4);
    transition: all var(--transition-fast);
  }

  .carousel-control:hover {
    transform: translateY(-50%) scale(1.12);
    box-shadow: 0 6px 24px rgba(232,25,108,0.6);
  }

  .carousel-control.prev {
    left: -22px;
  }

  .carousel-control.next {
    right: -22px;
  }

  @media (max-width: 600px) {
    .carousel-control {
      width: 38px;
      height: 38px;
      font-size: 1rem;
    }
    .carousel-control.prev {
      left: 8px;
    }
    .carousel-control.next {
      right: 8px;
    }
  }

  .product-card {
    min-height: 460px;
    display: flex;
    flex-direction: column;
  }

  .product-image-container {
    height: 250px;
  }

  .product-image {
    height: 100%;
  }

  /* ============================================================
     BUFFET SECTION (fondo oscuro secundario)
     ============================================================ */
  .buffet-section {
    padding: 5rem 1.5rem;
    background-color: var(--bg-secondary);
    border-top: 1px solid rgba(232,25,108,0.15);
    border-bottom: 1px solid rgba(232,25,108,0.15);
  }

  .buffet-section .subtitle {
    color: var(--accent-light);
  }

  .buffet-section h2 {
    color: var(--neutral-cream);
  }

  .buffet-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 2.5rem auto 0 auto;
  }

  .buffet-card {
    background-color: var(--bg-card);
    border: 1px solid rgba(232,25,108,0.15);
    border-radius: var(--border-radius-md);
