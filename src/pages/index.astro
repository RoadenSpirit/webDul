---
import Layout from '../layouts/Layout.astro';
import { PRODUCTS } from '../data/products';
import initialCatalog from '../../data/catalog.json';

const cakes = PRODUCTS.filter(p => p.type === 'cakes');
const buffetItems = PRODUCTS.filter(p => p.type === 'buffet');

// Los 3 Pilares Maestros de Decoraciones
const pillars = [
  {
    id: 'infantiles',
    title: 'Infantiles y Temáticos',
    desc: 'Personajes favoritos, colores vivos y diseños divertidos para los más pequeños.',
    image: '/images/products/cakes/mini-1.webp',
    colorTheme: 'cyan',
    accentColor: '#4DEEEA'
  },
  {
    id: 'clasicos',
    title: 'Diseños Clásicos',
    desc: 'El diseño clásico de merengue con rosetones que siempre gusta. Simple, elegante y al mejor precio.',
    image: '/images/products/cakes/cake-22-1.webp',
    colorTheme: 'cream',
    accentColor: '#FFE494'
  },
  {
    id: 'sociales',
    title: 'Bodas y Quince Años',
    desc: 'Cakes con acabados impecables y diseños memorables para tus eventos importantes.',
    image: '/images/decoraciones/eventos-sociales-15.webp',
    colorTheme: 'fuchsia',
    accentColor: '#FF53A5'
  }
];
---

<Layout title="Dulcería El Líder — Cakes y Dulces por Encargo">
  <!-- 1. HERO MINIMALISTA & PROTAGONISTA -->
  <section class="hero-section">
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <div class="hero-logo-wrap">
        <img src="/logo-correcto.png" alt="Dulcería El Líder Logo" class="hero-logo" />
      </div>
      <h1 class="hero-title" aria-label="Los Mejores Cakes de Camagüey">
        <span class="hero-line hero-line-top">Los Mejores</span>
        <span class="hero-line hero-line-bottom">Cakes de Camagüey</span>
      </h1>
      <p class="hero-subtitle">
        Variedad en cakes por encargo y buffet para que tu cumpleaños o fiesta tenga exactamente lo que buscas, a <a href="#catalogo" id="hero-quick-star-cake" class="hero-highlight-link" title="Encargar nuestro cake más popular de 22 cm">un solo clic</a> de distancia.
      </p>
      
      <!-- Flecha de scroll indicador con animación suave -->
      <a href="#catalogo" id="hero-scroll-btn" class="hero-scroll-indicator" aria-label="Explorar la carta de precios">
        <span class="scroll-label">Ver carta de precios</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="scroll-arrow">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </a>
    </div>
  </section>

  <!-- 2. OFERTAS DE CAKES (Grid Directo) -->
  <section id="catalogo" class="section-container bg-cream">
    <div class="section-inner">
      <div class="section-header">
        <span class="section-badge">Nuestra Carta</span>
        <h2 class="section-title">Cakes por Encargo</h2>
        <div class="section-divider"></div>
        <p class="section-desc">Desde $2500 CUP. Escoge el tamaño que necesitas y personaliza los detalles a tu gusto en el siguiente paso.</p>
      </div>

      <div class="cakes-grid">
        {cakes.map(product => (
          <article class="cake-card" data-id={product.id}>
            <div class="cake-image-wrap carousel-container" data-images={JSON.stringify(product.images || [product.image])}>
              <img src={product.image} alt={product.name} class="cake-image carousel-img active-img" loading="lazy" />
              <img src={product.image} alt="" class="cake-image carousel-img next-img" aria-hidden="true" />
            </div>
            <div class="cake-content">
              <div class="cake-head">
                <h3 class="cake-name" title={product.name}>{product.name}</h3>
                <span class="price-amount">${product.base_price} <small class="currency">CUP</small></span>
              </div>
              <div class="card-action-btns">
                <button
                  class="btn-buy-now buy-now-btn"
                  data-id={product.id}
                  data-name={product.name}
                  data-price={product.base_price}
                  data-type={product.type}
                  data-customizable="true"
                >
                  Encargar Ahora
                </button>
                <button
                  class="btn-icon-cart add-to-cart-btn"
                  data-id={product.id}
                  data-name={product.name}
                  data-price={product.base_price}
                  data-type={product.type}
                  data-customizable="true"
                  title="Añadir al carrito"
                  aria-label={`Añadir ${product.name} al carrito`}
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                    <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                    <line x1="12" y1="9" x2="16" y2="9"/>
                    <line x1="14" y1="7" x2="14" y2="11"/>
                  </svg>
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. BUFFET Y POSTRES (Grid de Acompañamiento) -->
  <section id="buffet" class="section-container bg-dark">
    <div class="section-inner">
      <div class="section-header">
        <span class="section-badge-light">Ofertas de Buffet</span>
        <h2 class="section-title text-white">Buffet y Bocaditos por Encargo</h2>
        <div class="section-divider"></div>
        <p class="section-desc text-cream">Bandejas de marquesitas, minidonas, cupcakes, croqueticas y bocaditos para armar la mesa de tu fiesta.</p>
      </div>
      
      <div class="buffet-grid">
        {buffetItems.map(product => (
          <article class="buffet-card">
            <div class="buffet-image-wrap carousel-container" data-images={JSON.stringify(product.images || [product.image])}>
              <img src={product.image} alt={product.name} class="buffet-image carousel-img active-img" loading="lazy" />
              <img src={product.image} alt="" class="buffet-image carousel-img next-img" aria-hidden="true" />
            </div>
            <div class="buffet-content">
              <div class="buffet-head">
                <h3 class="buffet-name" title={product.name}>{product.name}</h3>
                <span class="buffet-price">${product.base_price} <small class="currency">CUP</small></span>
              </div>
              <div class="card-action-btns">
                <button
                  class="btn-buy-now-buffet buy-now-btn"
                  data-id={product.id}
                  data-name={product.name}
                  data-price={product.base_price}
                  data-type={product.type}
                  data-customizable="false"
                >
                  Encargar Ahora
                </button>
                <button
                  class="btn-icon-cart-buffet add-to-cart-btn"
                  data-id={product.id}
                  data-name={product.name}
                  data-price={product.base_price}
                  data-type={product.type}
                  data-customizable="false"
                  title="Añadir al carrito"
                  aria-label={`Añadir ${product.name} al carrito`}
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                    <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                    <line x1="12" y1="9" x2="16" y2="9"/>
                    <line x1="14" y1="7" x2="14" y2="11"/>
                  </svg>
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. LOS 3 PILARES DE NUESTRAS DECORACIONES (Gran Formato) -->
  <section id="decoraciones" class="section-container bg-cream decor-pillars-section">
    <div class="section-inner">
      <div class="section-header">
        <h2 class="section-title">Nuestras Decoraciones</h2>
        <div class="section-divider"></div>
        <p class="section-subtitle">Desde infantiles con personajes hasta diseños clásicos y eventos especiales. Cada cake se personaliza según la temática que necesitas.</p>
      </div>

      <div class="pillars-showcase-grid">
        {pillars.map((item, index) => (
          <article class={`pillar-card theme-${item.colorTheme}`} data-pillar-index={index}>
            <div class="pillar-image-container">
              <img src={item.image} alt={item.title} class="pillar-photo" loading="lazy" />
              <div class="pillar-vignette"></div>
            </div>

            <div class="pillar-glass-panel">
              <!-- Título decorativo con efecto de escritura pastelera -->
              <h3 
                class="pillar-handwriting-title" 
                data-full-text={item.title}
                style={`--icing-accent: ${item.accentColor};`}
              >
                <span class="typewriter-text">{item.title}</span>
                <span class="icing-cursor"></span>
              </h3>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. FLUJO DE ENCARGO (3 Pasos Icónicos) -->
  <section id="como-pedir" class="section-container bg-dark">
    <div class="section-inner">
      <div class="section-header">
        <span class="section-badge-light">Así Funciona</span>
        <h2 class="section-title text-white">¿Cómo encargar tu cake?</h2>
        <div class="section-divider"></div>
      </div>

      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h3 class="step-title">Elige en la carta</h3>
          <p class="step-text">Abre la carta, elige los cakes y bocaditos que necesites y agréguelos al carrito.</p>
        </div>

        <div class="step-card">
          <div class="step-num">2</div>
          <h3 class="step-title">Personaliza a tu gusto</h3>
          <p class="step-text">Configura la masa, la altura deseada, escribe tu dedicatoria y sube una foto si la tienes.</p>
        </div>

        <div class="step-card">
          <div class="step-num">3</div>
          <h3 class="step-title">Confirma por WhatsApp</h3>
          <p class="step-text">Recibirás un resumen de tu encargo y confirmamos todo directamente por WhatsApp.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Botón flotante circular del Carrito (Siempre accesible) -->
  <button id="floating-cart-btn" class="floating-cart" aria-label="Ver encargo">
    <span class="cart-icon">🛒</span>
    <span class="cart-count" id="floating-cart-count">0</span>
  </button>

  <!-- Drawer Lateral del Carrito -->
  <div id="cart-drawer" class="cart-drawer">
    <div class="cart-drawer-overlay" id="cart-drawer-overlay"></div>
    <div class="cart-drawer-content">
      <div class="cart-header">
        <h2>Tu Encargo</h2>
        <button id="close-cart-btn" class="close-btn" aria-label="Cerrar encargo">&times;</button>
      </div>
      
      <div id="cart-items-container" class="cart-items-container">
        <!-- Generado dinámicamente -->
        <div class="empty-cart-message">
          <p>Tu encargo está vacío</p>
          <a href="#catalogo" id="explore-btn" class="btn-explore">Explorar Carta</a>
        </div>
      </div>

      <div class="cart-footer">
        <div class="cart-total-row">
          <span>Total Estimado:</span>
          <span id="cart-total-display" class="cart-total-amount">$0 CUP</span>
        </div>
        <a href="/pedido" id="checkout-btn" class="btn-checkout">
           Continúa y Personaliza tu Encargo →
        </a>
        <button type="button" id="cart-continue-shopping-btn" class="btn-continue-shopping">
           ← Volver a la carta
        </button>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* ============================================================
     HERO MINIMALISTA (100vw x 100vh)
     ============================================================ */
  .hero-section {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    height: 100vh;
    height: 100dvh;
    max-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: clamp(0.75rem, 2.5vh, 1.75rem) 1.25rem;
    background: radial-gradient(circle at center, #3D1A24 0%, #2A0A14 70%);
    overflow: hidden;
    scroll-behavior: smooth;
    box-sizing: border-box;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(232,25,108,0.18) 0%, rgba(42,10,20,0.85) 80%);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 680px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.6rem, 1.8vh, 1.1rem);
  }

  .hero-logo-wrap {
    width: clamp(140px, 20vh, 190px);
    height: clamp(140px, 20vh, 190px);
    border-radius: 50%;
    padding: 6px;
    background: linear-gradient(135deg, #FF1376, #FF6B35, #FFAA33);
    box-shadow: 0 10px 36px rgba(255, 19, 118, 0.5), 0 0 20px rgba(255, 107, 53, 0.4);
    flex-shrink: 0;
    animation: gentlePulse 3.8s ease-in-out infinite;
    will-change: transform, box-shadow;
  }

  @keyframes gentlePulse {
    0%, 100% {
      transform: scale(1);
      box-shadow: 0 10px 36px rgba(255, 19, 118, 0.45), 0 0 16px rgba(255, 107, 53, 0.35);
    }
    50% {
      transform: scale(1.05);
      box-shadow: 0 16px 48px rgba(255, 19, 118, 0.65), 0 0 32px rgba(255, 107, 53, 0.55);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-logo-wrap {
      animation: none;
    }
  }

  .hero-logo {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #FFFFFF;
  }

  /* Titular del Hero: Tipografía estilizada y curva (Pacifico) con degradado Candy vibrante */
  .hero-title {
    font-family: 'Pacifico', 'Fredoka', cursive, sans-serif;
    font-size: clamp(2rem, 5.2vw, 3.8rem);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0.01em;
    text-wrap: balance;
    text-align: center;
    margin: 0.15rem 0 0.35rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
  }

  .hero-line {
    display: inline-block;
    background: linear-gradient(
      135deg,
      #FFF6EB 0%,
      #FFE3C2 15%,
      #FFA96C 35%,
      #FF5E98 62%,
      #FF1A75 85%,
      #D4145A 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.7))
            drop-shadow(0 8px 24px rgba(232, 25, 108, 0.5));
  }

  .hero-line-top {
    font-size: 0.88em;
  }

  .hero-line-bottom {
    font-size: 1.05em;
  }

  .hero-subtitle {
    font-size: clamp(0.88rem, 1.6vh, 1.05rem);
    color: var(--neutral-cream);
    line-height: 1.45;
    max-width: 520px;
    opacity: 0.95;
    margin: 0;
  }

  .hero-highlight-link {
    color: var(--accent-light);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    transition: color var(--transition-fast), text-shadow var(--transition-fast);
  }

  .hero-highlight-link:hover {
    color: #FFFFFF;
    text-shadow: 0 0 8px rgba(255, 140, 66, 0.6);
  }

  /* Flecha interactiva de scroll */
  .hero-scroll-indicator {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    color: var(--accent-light);
    text-decoration: none;
    margin-top: 1.5rem;
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .hero-scroll-indicator:hover {
    transform: translateY(4px);
    color: #FFFFFF;
  }

  .scroll-label {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .scroll-arrow {
    width: 24px;
    height: 24px;
    animation: scrollGlide 2.4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  @keyframes scrollGlide {
    0%, 100% { transform: translateY(0); opacity: 0.75; }
    50% { transform: translateY(6px); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-arrow {
      animation: none;
    }
  }

  /* ============================================================
     SECCIONES GENERALES
     ============================================================ */
  .section-container {
    padding: 2.25rem 0.75rem;
  }

  .section-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .bg-cream {
    background-color: var(--bg-light);
  }

  .bg-dark {
    background-color: var(--bg-primary);
  }

  .text-white { color: #FFFFFF !important; }
  .text-cream { color: var(--neutral-cream) !important; }

  .section-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .section-badge {
    background: rgba(232, 25, 108, 0.1);
    color: var(--primary);
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.3rem 0.9rem;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .section-badge-light {
    background: rgba(255, 107, 53, 0.15);
    color: var(--accent-light);
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.3rem 0.9rem;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 700;
    color: var(--text-on-light);
    line-height: 1.2;
  }

  .section-divider {
    width: 50px;
    height: 3px;
    background: var(--gradient-brand);
    border-radius: 2px;
  }

  .section-desc {
    font-size: 1rem;
    color: var(--text-on-light-soft);
    line-height: 1.6;
  }

  /* ============================================================
     CAKES GRID DIRECTO (max 4 columnas, tarjetas grandes)
     ============================================================ */
  .cakes-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }

  @media (min-width: 640px) {
    .cakes-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.7rem;
    }
  }

  @media (min-width: 1024px) {
    .cakes-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 0.9rem;
    }
  }

  .cake-card {
    background: #FFFFFF;
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(42, 10, 20, 0.08);
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(42, 10, 20, 0.06);
  }

  .cake-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #F4E9E0;
  }

  .carousel-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: opacity;
  }

  .carousel-img.active-img {
    opacity: 1;
    z-index: 2;
    transition: opacity 800ms ease-in-out;
  }

  .carousel-img.next-img {
    opacity: 0;
    z-index: 3;
    transition: opacity 800ms ease-in-out;
  }

  .carousel-img.brightness-pulse {
    animation: lightPulse 450ms ease-in-out;
  }

  @keyframes lightPulse {
    0% { filter: brightness(1); transform: scale(1); }
    50% { filter: brightness(1.15) contrast(1.05); transform: scale(1.05); }
    100% { filter: brightness(1); transform: scale(1); }
  }

  .carousel-img.fade-out {
    opacity: 0;
    transition: opacity 800ms ease-in-out;
  }

  .carousel-img.fade-in {
    opacity: 1;
    z-index: 3;
    transition: opacity 800ms ease-in-out;
  }



  .cake-content {
    padding: 0.6rem 0.65rem 0.65rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.5rem;
  }

  .cake-head,
  .buffet-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    min-width: 0;
  }

  .cake-name {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-on-light);
    flex: 1 1 auto;
    min-width: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: break-word;
    min-height: 2.6em;
  }

  .cake-desc {
    font-size: 0.9rem;
    color: var(--text-on-light-soft);
    line-height: 1.5;
    flex: 1;
  }

  .cake-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid rgba(42, 10, 20, 0.08);
  }

  .price-wrap {
    display: flex;
    flex-direction: column;
  }

  .price-label {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--text-on-light-soft);
    letter-spacing: 0.5px;
  }

  .price-amount {
    flex: 0 0 auto;
    white-space: nowrap;
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--primary);
  }

  .currency {
    font-size: 0.8rem;
    font-weight: 700;
  }

  .card-action-btns {
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
    margin-top: auto;
    width: 100%;
  }

  .btn-icon-cart {
    background: #FFFFFF;
    color: var(--primary);
    border: 1.5px solid var(--primary);
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    border-radius: var(--border-radius-md);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(232, 25, 108, 0.12);
    transition: all var(--transition-fast);
  }

  .btn-icon-cart:hover {
    background: var(--primary);
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(232, 25, 108, 0.25);
  }

  .btn-buy-now {
    background: var(--gradient-brand);
    color: #FFFFFF;
    border: 1.5px solid transparent;
    flex: 1;
    min-width: 0;
    height: 36px;
    padding: 0 0.6rem;
    border-radius: var(--border-radius-md);
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 0.8rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    box-shadow: 0 4px 14px rgba(232, 25, 108, 0.35);
  }

  .btn-buy-now:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(232, 25, 108, 0.5);
  }

  .btn-icon-cart-buffet {
    background: #FFFFFF;
    color: var(--accent);
    border: 1.5px solid var(--accent);
    flex: 0 0 34px;
    width: 34px;
    height: 34px;
    border-radius: var(--border-radius-sm);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(255, 107, 53, 0.15);
    transition: all var(--transition-fast);
  }

  .btn-icon-cart-buffet:hover {
    background: var(--accent);
    color: #FFFFFF;
    transform: translateY(-1px);
  }

  .btn-buy-now-buffet {
    background: var(--gradient-brand);
    color: #FFFFFF;
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    flex: 1;
    min-width: 0;
    height: 34px;
    padding: 0 0.6rem;
    border-radius: var(--border-radius-sm);
    font-weight: 800;
    font-size: 0.82rem;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(255, 107, 53, 0.3);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .btn-buy-now-buffet:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(255, 107, 53, 0.5);
  }

  /* ============================================================
     BUFFET GRID (max 4 columnas, tarjetas grandes)
     ============================================================ */
  .buffet-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }

  @media (min-width: 640px) {
    .buffet-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.7rem;
    }
  }

  @media (min-width: 1024px) {
    .buffet-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 0.9rem;
    }
  }

  .buffet-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .buffet-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .buffet-image {
    object-fit: cover;
  }

  .buffet-content {
    padding: 0.6rem 0.65rem 0.65rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.5rem;
  }

  .buffet-name {
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.3;
    color: #FFFFFF;
    flex: 1 1 auto;
    min-width: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: break-word;
    min-height: 2.6em;
  }

  .buffet-desc {
    font-size: 0.85rem;
    color: var(--neutral-cream);
    line-height: 1.45;
    flex: 1;
    opacity: 0.85;
  }

  .buffet-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-color);
  }

  .buffet-price {
    flex: 0 0 auto;
    white-space: nowrap;
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--accent-light);
  }

  .btn-add-buffet {
    background: rgba(255, 107, 53, 0.18);
    border: 1.5px solid var(--accent);
    color: #FFFFFF;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.4rem 0.9rem;
    border-radius: var(--border-radius-sm);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .btn-add-buffet:hover {
    background: var(--accent);
  }

  /* ============================================================
     LOS 3 PILARES DE DECORACIONES (GRAN FORMATO Y EFECTO ESCRITURA)
     ============================================================ */
  .decor-pillars-section {
    position: relative;
    overflow: hidden;
  }

  /* Encabezado Artístico y Vibrante para Decoraciones */
  .decor-pillars-section .section-header {
    margin-bottom: 2.25rem;
  }

  .decor-pillars-section .section-badge {
    background: linear-gradient(135deg, rgba(232, 25, 108, 0.25), rgba(255, 107, 53, 0.25));
    border: 1px solid rgba(232, 25, 108, 0.5);
    color: #E8196C;
    box-shadow: 0 0 15px rgba(232, 25, 108, 0.2);
  }

  .decor-pillars-section .section-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 800;
    line-height: 1.15;
    background: linear-gradient(135deg, #E8196C 0%, #FF6B35 50%, #FFA07A 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 3px 12px rgba(232, 25, 108, 0.35));
    letter-spacing: -0.5px;
    margin: 0;
  }

  .decor-pillars-section .section-divider {
    width: 70px;
    height: 4px;
    background: linear-gradient(90deg, #4DEEEA, #E8196C, #FF6B35, #FFE494);
    border-radius: 4px;
    box-shadow: 0 0 12px rgba(232, 25, 108, 0.5);
  }

  .decor-pillars-section .section-subtitle {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--text-on-light-soft);
    text-align: center;
    max-width: 720px;
    margin: 0.8rem auto 0;
    line-height: 1.5;
    opacity: 0.9;
  }

  .pillars-showcase-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1rem;
    margin-top: 1rem;
  }

  @media (min-width: 768px) {
    .pillars-showcase-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  .pillar-card {
    position: relative;
    height: 320px;
    border-radius: var(--border-radius-xl);
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(42, 10, 20, 0.12);
    border: 1px solid rgba(42, 10, 20, 0.08);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: #200810;
  }

  @media (min-width: 768px) {
    .pillar-card {
      height: 520px;
    }
  }

  .pillar-image-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .pillar-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .pillar-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(20, 4, 10, 0) 0%,
      rgba(20, 4, 10, 0) 55%,
      rgba(20, 4, 10, 0.4) 80%,
      rgba(20, 4, 10, 0.75) 100%
    );
    pointer-events: none;
  }

  .pillar-glass-panel {
    position: relative;
    z-index: 2;
    padding: 1.5rem 1.4rem 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  /* Subtítulos llamativos estilo manga pastelera / glaseado */
  .pillar-handwriting-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--icing-accent);
    margin: 0;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.85);
    display: inline;
    letter-spacing: 0.2px;
  }

  .typewriter-text {
    display: inline;
  }

  /* Cursor de manga pastelera */
  .icing-cursor {
    display: inline-block;
    width: 2px;
    height: 1.15em;
    vertical-align: middle;
    background-color: var(--icing-accent);
    margin-left: 2px;
    animation: cursorBlink 0.8s infinite;
  }

  .icing-cursor.done {
    display: none;
  }

  @keyframes cursorBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Temas de Color Exclusivos por Pilar */
  .theme-cyan .pillar-handwriting-title {
    color: #4DEEEA;
    text-shadow: 0 0 16px rgba(77, 238, 234, 0.5), 0 2px 8px rgba(0, 0, 0, 0.9);
  }

  .theme-cream .pillar-handwriting-title {
    color: #FFE494;
    text-shadow: 0 0 16px rgba(255, 228, 148, 0.5), 0 2px 8px rgba(0, 0, 0, 0.9);
  }

  .theme-fuchsia .pillar-handwriting-title {
    color: #FF53A5;
    text-shadow: 0 0 16px rgba(255, 83, 165, 0.6), 0 2px 8px rgba(0, 0, 0, 0.9);
  }

  @media (max-width: 900px) {
    .pillars-showcase-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .pillar-card {
      height: 440px;
    }
    .pillar-handwriting-title {
      font-size: 1.25rem;
    }
  }

  /* ============================================================
     FLUJO EN 3 PASOS
     ============================================================ */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
  }

  .step-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    padding: 2.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    position: relative;
  }

  .step-num {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: var(--gradient-brand);
    color: #FFFFFF;
    font-size: 1.4rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 15px rgba(232, 25, 108, 0.4);
  }

  .step-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: #FFFFFF;
  }

  .step-text {
    font-size: 0.92rem;
    color: var(--neutral-cream);
    line-height: 1.55;
    opacity: 0.9;
  }

