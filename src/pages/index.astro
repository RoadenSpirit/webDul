  /* ============================================================
     BOTÓN FLOTANTE Y CART DRAWER
     ============================================================ */
  .floating-cart {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 99;
    width: 62px;
    height: 62px;
    border-radius: 50%;
    background: var(--gradient-brand);
    color: #FFFFFF;
    border: 2px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 8px 24px rgba(232, 25, 108, 0.5);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .floating-cart:hover {
    transform: scale(1.08);
    box-shadow: 0 10px 28px rgba(232, 25, 108, 0.65);
  }

  .cart-icon {
    font-size: 1.6rem;
  }

  .cart-count {
    position: absolute;
    top: -4px;
    right: -4px;
    background: #FFFFFF;
    color: var(--primary);
    font-size: 0.75rem;
    font-weight: 800;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }

  .cart-drawer {
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;
    visibility: hidden;
    transition: visibility 0.3s ease;
  }

  .cart-drawer.open {
    pointer-events: auto;
    visibility: visible;
  }

  .cart-drawer-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .cart-drawer.open .cart-drawer-overlay {
    opacity: 1;
  }

  .cart-drawer-content {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 420px;
    height: 100%;
    background: var(--bg-primary);
    border-left: 2px solid var(--border-color);
    box-shadow: -8px 0 30px rgba(0, 0, 0, 0.7);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .cart-drawer.open .cart-drawer-content {
    transform: translateX(0);
  }

  .cart-header {
    padding: 1.15rem 1.25rem;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-header h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0;
  }

  .close-btn {
    background: none;
    border: none;
    color: var(--neutral-cream);
    font-size: 1.8rem;
    cursor: pointer;
    line-height: 1;
    transition: color var(--transition-fast);
    padding: 0 4px;
  }

  .close-btn:hover {
    color: #FFFFFF;
  }

  .cart-items-container {
    flex: 1;
    overflow-y: auto;
    padding: 0.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .empty-cart-message {
    margin: auto;
    text-align: center;
    color: var(--neutral-cream);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .btn-explore {
    background: rgba(232, 25, 108, 0.15);
    border: 1px solid var(--primary);
    color: #FFFFFF;
    padding: 0.5rem 1.2rem;
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.85rem;
  }

  /* ============================================================
     LISTA ESTRUCTURADA DE PEDIDO (GRID DE 4 COLUMNAS CON LÍNEAS)
     ============================================================ */
  :global(.cart-item-row) {
    display: grid !important;
    grid-template-columns: 46px 1fr auto auto !important;
    align-items: center !important;
    gap: 0.75rem !important;
    padding: 0.75rem 0.4rem !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
    background: transparent !important;
    transition: background var(--transition-fast) !important;
  }

  :global(.cart-item-row:hover) {
    background: rgba(255, 255, 255, 0.03) !important;
  }

  /* Columna 1: Miniatura Enmarcada */
  :global(.ci-col-thumb) {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  :global(.ci-thumb-box) {
    width: 44px !important;
    height: 44px !important;
    border-radius: 6px !important;
    overflow: hidden !important;
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
    background: #18040a !important;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.4) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  :global(.ci-thumb-img) {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
  }

  :global(.ci-thumb-box-fallback) {
    font-size: 1.3rem !important;
  }

  /* Columna 2: Detalle del Producto */
  :global(.ci-col-details) {
    min-width: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 0.2rem !important;
  }

  :global(.ci-item-title) {
    font-family: var(--font-body) !important;
    font-size: 0.88rem !important;
    font-weight: 700 !important;
    color: #FFFFFF !important;
    display: -webkit-box !important;
    -webkit-line-clamp: 2 !important;
    -webkit-box-orient: vertical !important;
    overflow: hidden !important;
    word-break: break-word !important;
    line-height: 1.25 !important;
    margin: 0 !important;
  }

  :global(.ci-item-unit-tag) {
    font-size: 0.75rem !important;
    color: var(--neutral-cream) !important;
    opacity: 0.75 !important;
    line-height: 1 !important;
  }

  /* Columna 3: Selector Numérico Estructurado con líneas divisorias */
  :global(.ci-col-qty) {
    display: flex !important;
    align-items: center !important;
  }

  :global(.ci-stepper-box) {
    display: inline-flex !important;
    align-items: center !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
    border-radius: 6px !important;
    background: rgba(0, 0, 0, 0.45) !important;
    overflow: hidden !important;
    height: 26px !important;
  }

  :global(.ci-step-btn) {
    width: 24px !important;
    height: 100% !important;
    border: none !important;
    background: transparent !important;
    color: var(--neutral-cream) !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: all var(--transition-fast) !important;
  }

  :global(.ci-step-btn.ci-minus) {
    border-right: 1px solid rgba(255, 255, 255, 0.15) !important;
  }

  :global(.ci-step-btn.ci-plus) {
    border-left: 1px solid rgba(255, 255, 255, 0.15) !important;
  }

  :global(.ci-step-btn:hover) {
    background: var(--primary) !important;
    color: #FFFFFF !important;
  }

  :global(.ci-step-value) {
    min-width: 22px !important;
    padding: 0 4px !important;
    font-size: 0.8rem !important;
    font-weight: 800 !important;
    color: #FFFFFF !important;
    text-align: center !important;
  }

  /* Columna 4: Subtotal y Papelera Alineados */
  :global(.ci-col-total) {
    display: flex !important;
    align-items: center !important;
    gap: 0.5rem !important;
    padding-left: 0.5rem !important;
    border-left: 1px solid rgba(255, 255, 255, 0.1) !important;
  }

  :global(.ci-subtotal-val) {
    font-size: 0.88rem !important;
    font-weight: 800 !important;
    color: var(--accent-light) !important;
    white-space: nowrap !important;
    min-width: 65px !important;
    text-align: right !important;
  }

  :global(.ci-trash-btn) {
    background: transparent !important;
    border: none !important;
    color: rgba(255, 255, 255, 0.4) !important;
    cursor: pointer !important;
    padding: 5px !important;
    border-radius: 4px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: all var(--transition-fast) !important;
  }

  :global(.ci-trash-btn:hover) {
    color: #FF5A5A !important;
    background: rgba(255, 90, 90, 0.15) !important;
  }

  .cart-footer {
    padding: 1.15rem 1.25rem 1.25rem;
    border-top: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: rgba(20, 4, 10, 0.95);
    backdrop-filter: blur(10px);
  }

  .cart-total-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-weight: 700;
    font-size: 1rem;
    color: var(--neutral-cream);
  }

  .cart-total-amount {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--accent-light);
  }

  .btn-checkout {
    background: var(--gradient-brand);
    color: #FFFFFF;
    text-align: center;
    padding: 0.95rem;
    border-radius: var(--border-radius-md);
    font-weight: 800;
    font-size: 0.98rem;
    box-shadow: 0 4px 15px rgba(232, 25, 108, 0.35);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    text-decoration: none;
    display: block;
  }

  .btn-checkout:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(232, 25, 108, 0.5);
  }

  .btn-continue-shopping {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: var(--neutral-cream);
    text-align: center;
    padding: 0.75rem;
    border-radius: var(--border-radius-md);
    font-weight: 600;
    font-size: 0.88rem;
    cursor: pointer;
    transition: all var(--transition-fast);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
  }

  .btn-continue-shopping:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.35);
  }

  /* Responsive Mobile */
  @media (max-width: 480px) {
    .floating-cart {
      bottom: 1.25rem;
      right: 1.25rem;
      width: 56px;
      height: 56px;
    }
    .cart-drawer-content {
      max-width: 100%;
    }
  }
</style>

<script define:vars={{ initialCatalog }}>
  let cart = [];

  const floatingCartBtn = document.getElementById('floating-cart-btn');
  const floatingCartCount = document.getElementById('floating-cart-count');
  const cartDrawer = document.getElementById('cart-drawer');
  const closeCartBtn = document.getElementById('close-cart-btn');
  const cartOverlay = document.getElementById('cart-drawer-overlay');
  const cartItemsContainer = document.getElementById('cart-items-container');
  const cartTotalDisplay = document.getElementById('cart-total-display');
  const addToCartButtons = document.querySelectorAll('.add-to-cart-btn');
  const continueShoppingBtn = document.getElementById('cart-continue-shopping-btn');

  const loadCart = () => {
    try {
      cart = JSON.parse(localStorage.getItem('el_lider_cart') || '[]');
    } catch {
      cart = [];
    }
  };

  const saveCart = () => {
    localStorage.setItem('el_lider_cart', JSON.stringify(cart));
    updateCartUI();
  };

  const openCart = () => {
    cartDrawer?.classList.add('open');
    document.body.style.overflow = 'hidden';
  };

  const closeCart = () => {
    cartDrawer?.classList.remove('open');
    document.body.style.overflow = '';
  };

  // Cerrar drawer y seguir comprando
  const continueShopping = () => {
    closeCart();
    const catalogo = document.getElementById('catalogo');
    if (catalogo && typeof catalogo.scrollIntoView === 'function') {
      catalogo.scrollIntoView({ behavior: 'smooth' });
    }
  };

  floatingCartBtn?.addEventListener('click', openCart);
  closeCartBtn?.addEventListener('click', closeCart);
  cartOverlay?.addEventListener('click', closeCart);
  continueShoppingBtn?.addEventListener('click', continueShopping);

  const updateCartUI = () => {
    const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
    if (floatingCartCount) floatingCartCount.textContent = totalItems.toString();

    if (!cartItemsContainer || !cartTotalDisplay) return;

    if (cart.length === 0) {
      cartItemsContainer.innerHTML = `
        <div class="empty-cart-message">
          <p>Tu encargo está vacío</p>
          <a href="#catalogo" id="explore-btn" class="btn-explore">Explorar Carta</a>
        </div>
      `;
      cartTotalDisplay.textContent = '$0 CUP';
      const exploreBtn = document.getElementById('explore-btn');
      exploreBtn?.addEventListener('click', closeCart);
      return;
    }

    let total = 0;
    let html = '';

    cart.forEach((item, index) => {
      const subtotal = item.price * item.quantity;
      total += subtotal;

      // Buscar imagen y tipo en el catálogo
      let itemImg = item.image || '';
      let isCake = item.type === 'cakes' || item.category === 'cakes';
      if (!itemImg && initialCatalog && initialCatalog.products) {
        const prod = initialCatalog.products.find(p => p.id === item.id);
        if (prod) {
          itemImg = prod.image || (prod.images && prod.images[0]) || '';
          if (prod.type) isCake = prod.type === 'cakes';
        }
      }

      html += `
        <div class="cart-item-row" data-index="${index}">
          <!-- Columna 1: Miniatura Enmarcada -->
          <div class="ci-col-thumb">
            ${itemImg ? `
              <div class="ci-thumb-box">
                <img src="${itemImg}" alt="${item.name}" class="ci-thumb-img" loading="lazy" />
              </div>
            ` : `
              <div class="ci-thumb-box ci-thumb-box-fallback">
                <span>${isCake ? '🎂' : '🧁'}</span>
              </div>
            `}
          </div>

          <!-- Columna 2: Detalle del Producto -->
          <div class="ci-col-details">
            <h4 class="ci-item-title" title="${item.name}">${item.name}</h4>
            <div class="ci-item-unit-tag">$${item.price.toLocaleString()} CUP c/u</div>
          </div>

          <!-- Columna 3: Selector Numérico Estructurado con líneas divisorias -->
          <div class="ci-col-qty">
            <div class="ci-stepper-box">
              <button class="ci-step-btn ci-minus" data-index="${index}" aria-label="Restar uno" title="Restar uno">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </button>
              <div class="ci-step-value">${item.quantity}</div>
              <button class="ci-step-btn ci-plus" data-index="${index}" aria-label="Sumar uno" title="Sumar uno">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </button>
            </div>
          </div>

          <!-- Columna 4: Subtotal y Papelera Alineados -->
          <div class="ci-col-total">
            <div class="ci-subtotal-val">$${subtotal.toLocaleString()}</div>
            <button class="ci-trash-btn ci-remove" data-index="${index}" title="Eliminar del encargo" aria-label="Eliminar del encargo">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 6h18"></path>
                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                <line x1="10" y1="11" x2="10" y2="17"></line>
                <line x1="14" y1="11" x2="14" y2="17"></line>
              </svg>
            </button>
          </div>
        </div>
      `;
    });

    cartItemsContainer.innerHTML = html;
    cartTotalDisplay.textContent = `$${total} CUP`;

    // Bind event listeners
    cartItemsContainer.querySelectorAll('.ci-minus').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt(e.currentTarget.getAttribute('data-index') || '0');
        if (cart[idx].quantity > 1) {
          cart[idx].quantity--;
        } else {
          cart.splice(idx, 1);
        }
        saveCart();
      });
    });

    cartItemsContainer.querySelectorAll('.ci-plus').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt(e.currentTarget.getAttribute('data-index') || '0');
        cart[idx].quantity++;
        saveCart();
      });
    });

    cartItemsContainer.querySelectorAll('.ci-remove').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt(e.currentTarget.getAttribute('data-index') || '0');
        cart.splice(idx, 1);
        saveCart();
      });
    });
  };

  const heroScrollBtn = document.getElementById('hero-scroll-btn');
  heroScrollBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    const target = document.getElementById('catalogo');
    if (target) {
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  // Enlace interactivo en el Hero para encargo rápido del Cake de 22 cm
  const heroQuickStarCake = document.getElementById('hero-quick-star-cake');
  heroQuickStarCake?.addEventListener('click', (e) => {
    e.preventDefault();
    const cake22Btn = document.querySelector('.buy-now-btn[data-id="cake-22"]');
    if (cake22Btn) {
      cake22Btn.click();
    } else {
      const target = document.getElementById('catalogo');
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  // Helper para obtener las opciones por defecto de un producto según el catálogo
  const CATALOG_VERSION = 'v4_masa_harina_sin_subtitulos';

  const getDefaultOptionsForProduct = (productId) => {
    let activeCat = initialCatalog;
    try {
      const savedVer = localStorage.getItem('el_lider_catalog_version');
      const saved = localStorage.getItem('el_lider_admin_catalog');
      if (saved && savedVer === CATALOG_VERSION) activeCat = JSON.parse(saved);
    } catch (e) {}

    const options = {};
    if (activeCat && activeCat.product_options) {
      const prodOpts = activeCat.product_options.filter((po) => po.product_id === productId && po.is_enabled);
      // Prioridad 1: Si hay opción de masa, siempre forzar Harina como base si existe
      const masaHarina = prodOpts.find(po => po.option_id === 'masa' && po.option_value_id === 'masa-harina');
      if (masaHarina) {
        options['masa'] = 'masa-harina';
      }
      // Prioridad 2: Preseleccionar opciones marcadas como is_base (excepto altura que es booleana opcional)
      prodOpts.forEach((po) => {
        if (po.is_base && po.option_id !== 'altura' && !options[po.option_id]) {
          options[po.option_id] = po.option_value_id;
        }
      });
    }
    return options;
  };

  const buyNowButtons = document.querySelectorAll('.buy-now-btn');
  buyNowButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      // Feedback visual inmediato
      btn.style.opacity = '0.85';
      btn.style.pointerEvents = 'none';
      btn.innerHTML = `<span style="display:inline-block;animation:spin 0.8s linear infinite;margin-right:6px;">⏳</span> Abriendo...`;

      const id = btn.getAttribute('data-id') || '';
      const name = btn.getAttribute('data-name') || '';
      const price = parseFloat(btn.getAttribute('data-price') || '0');
      const type = btn.getAttribute('data-type') || 'cakes';

      const isCake = type === 'cakes';
      const defaultOptions = isCake ? getDefaultOptionsForProduct(id) : {};

      cart = [{
        uniqueId: (Date.now() + Math.random()).toString(),
        id,
        name,
        price,
        quantity: 1,
        customizable: isCake,
        type,
        category: isCake ? 'cakes' : 'buffet',
        dough: 'trigo',
        options: defaultOptions,
        size: '',
        doubleHeight: false
      }];

      localStorage.setItem('el_lider_cart', JSON.stringify(cart));
      window.location.href = '/pedido';
    });
  });

  // Restaurar botones al volver atrás desde /pedido
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) {
      buyNowButtons.forEach(btn => {
        btn.style.opacity = '1';
        btn.style.pointerEvents = 'auto';
        btn.innerHTML = 'Encargar Ahora';
      });
    }
  });

  // Sincronizar catálogo dinámico si el administrador guardó cambios en /admin
  try {
    const savedVer = localStorage.getItem('el_lider_catalog_version');
    const saved = localStorage.getItem('el_lider_admin_catalog');
    if (saved && savedVer === CATALOG_VERSION) {
      const cat = JSON.parse(saved);
      if (cat.products && Array.isArray(cat.products)) {
        cat.products.forEach((p) => {
          // Actualizar cards de cakes y buffet con nombre y precio base
          document.querySelectorAll(`[data-id="${p.id}"]`).forEach(card => {
            const nameEl = card.querySelector('.cake-name, .buffet-name');
            if (nameEl) nameEl.textContent = p.name;
            const priceEl = card.querySelector('.price-amount, .buffet-price');
            if (priceEl) priceEl.innerHTML = `$${p.base_price} <small class="currency">CUP</small>`;
            card.querySelectorAll('.add-to-cart-btn, .buy-now-btn').forEach(b => {
              b.setAttribute('data-name', p.name);
              b.setAttribute('data-price', p.base_price.toString());
            });
          });
        });
      }
    }
  } catch (e) {}

  addToCartButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-id') || '';
      const name = btn.getAttribute('data-name') || '';
      const price = parseFloat(btn.getAttribute('data-price') || '0');
      const type = btn.getAttribute('data-type') || 'cakes';
      const customizable = btn.getAttribute('data-customizable') === 'true';

      const isCake = type === 'cakes';

      if (isCake) {
        const defaultOptions = getDefaultOptionsForProduct(id);
        cart.push({
          uniqueId: (Date.now() + Math.random()).toString(),
          id,
          name,
          price,
          quantity: 1,
          customizable: true,
          type,
          category: 'cakes',
          dough: 'trigo',
          options: defaultOptions,
          size: id === 'cake-redondo' ? '20' : (id === 'cake-bandeja' ? 'media' : ''),
          doubleHeight: false
        });
      } else {
        const existing = cart.find(item => item.id === id);
        if (existing) {
          existing.quantity++;
        } else {
          cart.push({
            uniqueId: (Date.now() + Math.random()).toString(),
            id,
            name,
            price,
            quantity: 1,
            customizable: false,
            type,
            category: 'buffet'
          });
        }
      }

      saveCart();
      openCart();
    });
  });

  loadCart();
  updateCartUI();

  // ============================================================
  // ORQUESTADOR GLOBAL: UNA SOLA IMAGEN A LA VEZ
  // ============================================================
  const rawCarousels = document.querySelectorAll('.carousel-container');
  const carouselRegistry = [];

  rawCarousels.forEach(container => {
    let images = [];
    try {
      images = JSON.parse(container.getAttribute('data-images') || '[]');
    } catch {
      images = [];
    }
    if (!Array.isArray(images) || images.length <= 1) return;

    const activeImg = container.querySelector('.active-img');
    const nextImg = container.querySelector('.next-img');
    if (!activeImg || !nextImg) return;

    const item = {
      container: container,
      images,
      currentIndex: 0,
      activeImg,
      nextImg,
      isVisible: false
    };

    carouselRegistry.push(item);

    // Precargar de inmediato en memoria del navegador todas las imágenes del carrusel
    images.forEach(src => {
      const imgPreload = new Image();
      imgPreload.src = src;
    });
  });

  // Un solo observer para saber cuáles están visibles en el viewport
  const visibilityObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      const match = carouselRegistry.find(c => c.container === entry.target);
      if (match) {
        match.isVisible = entry.isIntersecting;
      }
    });
  }, { threshold: 0.1 });

  carouselRegistry.forEach(c => visibilityObserver.observe(c.container));

  // COLA GLOBAL: Un solo bucle central
  let isGlobalAnimating = false;
  let lastAnimatedIndex = -1;

  function runGlobalOrchestrator() {
    if (isGlobalAnimating) return;

    // Solo candidatos visibles en pantalla
    const visibleCandidates = carouselRegistry.filter(c => c.isVisible);

    if (visibleCandidates.length === 0) {
      setTimeout(runGlobalOrchestrator, 1000);
      return;
    }

    // Elegir uno aleatoriamente que no sea el mismo que acaba de cambiar
    let chosen;
    if (visibleCandidates.length === 1) {
      chosen = visibleCandidates[0];
    } else {
      const filtered = visibleCandidates.filter((_, idx) => idx !== lastAnimatedIndex);
      chosen = filtered[Math.floor(Math.random() * filtered.length)];
      lastAnimatedIndex = visibleCandidates.indexOf(chosen);
    }

    isGlobalAnimating = true;

    // Ejecutar la animación en esa única card
    chosen.currentIndex = (chosen.currentIndex + 1) % chosen.images.length;
    const nextSrc = chosen.images[chosen.currentIndex];

    // Asegurar que la imagen entrante ya esté cargada y lista antes de iniciar la transición
    const tempLoader = new Image();
    tempLoader.src = nextSrc;
    const onReady = () => {
      chosen.nextImg.src = nextSrc;

      // 1. Destello óptico suave (450ms) sobre la imagen activa
      chosen.activeImg.classList.add('brightness-pulse');

      setTimeout(() => {
        chosen.activeImg.classList.remove('brightness-pulse');
        // 2. Cross-fade suave: nextImg aparece al 100% por encima de activeImg
        chosen.nextImg.classList.add('fade-in');
        chosen.activeImg.classList.add('fade-out');

        setTimeout(async () => {
          // 3. Con nextImg cubriendo la vista por completo (z-index 3),
          // actualizamos activeImg en silencio
          chosen.activeImg.style.transition = 'none';
          chosen.activeImg.src = nextSrc;
          chosen.activeImg.classList.remove('fade-out');

          if ('decode' in chosen.activeImg) {
            try { await chosen.activeImg.decode(); } catch (e) {}
          }

          // Forzar reflujo para fijar la imagen en el render tree
          void chosen.activeImg.offsetWidth;
          chosen.activeImg.style.transition = '';

          // 4. Ahora que activeImg es 100% visible con la nueva foto,
          // reseteamos nextImg en silencio sin que se note ningún salto
          chosen.nextImg.style.transition = 'none';
          chosen.nextImg.classList.remove('fade-in');
          void chosen.nextImg.offsetWidth;
          chosen.nextImg.style.transition = '';

          isGlobalAnimating = false;

          // 5. Catálogo en reposo durante 1.5 segundos antes del siguiente cambio
          setTimeout(runGlobalOrchestrator, 1500);
        }, 500);
      }, 350);
    };

    if (tempLoader.complete) {
      onReady();
    } else {
      tempLoader.onload = onReady;
      tempLoader.onerror = () => {
        isGlobalAnimating = false;
        setTimeout(runGlobalOrchestrator, 1000);
      };
    }
  }

  // Arrancar el orquestador central tras 1.5 segundos iniciales de reposo
  setTimeout(runGlobalOrchestrator, 1500);

  // ============================================================
  // EFECTO DE ESCRITURA PASTELERA PARA LOS 3 PILARES
  // ============================================================
  const pillarTitles = document.querySelectorAll('.pillar-handwriting-title');
  if (pillarTitles.length > 0) {
    const typeWriterEffect = (titleEl) => {
      const fullText = titleEl.getAttribute('data-full-text') || '';
      const textSpan = titleEl.querySelector('.typewriter-text');
      const cursorSpan = titleEl.querySelector('.icing-cursor');
      if (!textSpan) return;

      textSpan.textContent = '';
      let charIdx = 0;

      const typeNextChar = () => {
        if (charIdx < fullText.length) {
          textSpan.textContent += fullText.charAt(charIdx);
          charIdx++;
          // Velocidad irregular orgánica emulando pulso de manga pastelera (40ms - 75ms)
          const delay = Math.floor(Math.random() * 35) + 40;
          setTimeout(typeNextChar, delay);
        } else {
          // Mantener el cursor parpadeando un segundo y ocultarlo suavemente
          setTimeout(() => {
            cursorSpan?.classList.add('done');
          }, 1500);
        }
      };

      typeNextChar();
    };

    let pillarsTriggered = false;
    const decorSection = document.getElementById('decoraciones');
    if (decorSection && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && !pillarsTriggered) {
            pillarsTriggered = true;
            pillarTitles.forEach((t, i) => {
              // Tipeo escalonado (cada pilar empieza con 280ms de retraso respecto al anterior)
              setTimeout(() => {
                typeWriterEffect(t);
              }, i * 280);
            });
            observer.disconnect();
          }
        });
      }, { threshold: 0.25 });
      observer.observe(decorSection);
    }
  }
</script>
