---
import Layout from '../layouts/Layout.astro';
import { PRODUCTS } from '../data/products';

const cakes = PRODUCTS.filter(p => p.type === 'cakes');
const buffetItems = PRODUCTS.filter(p => p.type === 'buffet');

// Galería curada de decoraciones artesanales
const decorations = [
  {
    title: 'Temática Infantil / Cumpleaños',
    desc: 'Modelado artístico y colores vibrantes en merengue fino.',
    image: 'https://images.unsplash.com/photo-1535254973040-607b474cb50d?q=80&w=800&auto=format&fit=crop'
  },
  {
    title: 'Elegancia Floral & Bodas',
    desc: 'Detalles sobrios y delicados para momentos inolvidables.',
    image: 'https://images.unsplash.com/photo-1557925923-cd4648e21187?q=80&w=800&auto=format&fit=crop'
  },
  {
    title: 'Chocolate Gourmet & Drips',
    desc: 'Bañados en chocolate brillante, trufas y texturas crocantes.',
    image: 'https://images.unsplash.com/photo-1519869325930-281384150729?q=80&w=800&auto=format&fit=crop'
  },
  {
    title: 'Fantasía Rosa & Sprinkles',
    desc: 'Tonos pasteles alegres para aniversarios y agasajos íntimos.',
    image: 'https://images.unsplash.com/photo-1588195538326-c5b1e9f80a1b?q=80&w=800&auto=format&fit=crop'
  }
];
---

<Layout title="Dulcería El Líder — Cakes y Dulces por Encargo">
  <!-- 1. HERO MINIMALISTA & PROTAGONISTA -->
  <section class="hero-section">
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <div class="hero-logo-wrap">
        <img src="/logo-correcto.png" alt="Dulcería El Líder Logo" class="hero-logo" />
      </div>
      <span class="hero-badge">✨ Dulcería Fina Artesanal</span>
      <h1 class="hero-title">El Arte de la Dulcería Fina</h1>
      <p class="hero-subtitle">Cakes exclusivos y dulces artesanales elaborados por encargo para hacer de tu fiesta una ocasión única.</p>
      
      <!-- Flecha de scroll indicador con animación suave -->
      <a href="#catalogo" id="hero-scroll-btn" class="hero-scroll-indicator" aria-label="Explorar la carta">
        <span class="scroll-label">Ver catálogo</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="scroll-arrow">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </a>
    </div>
  </section>

  <!-- 2. OFERTAS DE CAKES (Grid Directo) -->
  <section id="catalogo" class="section-container bg-cream">
    <div class="section-inner">
      <div class="section-header">
        <span class="section-badge">Nuestra Carta</span>
        <h2 class="section-title">Cakes por Encargo</h2>
        <div class="section-divider"></div>
        <p class="section-desc">Selecciona la base ideal para tu celebración. Podrás personalizar masa, tamaño y temática en el siguiente paso.</p>
      </div>

      <div class="cakes-grid">
        {cakes.map(product => (
          <article class="cake-card" data-id={product.id}>
            <div class="cake-image-wrap carousel-container" data-images={JSON.stringify(product.images || [product.image])}>
              <img src={product.image} alt={product.name} class="cake-image carousel-img active-img" loading="lazy" />
              <img src={product.image} alt="" class="cake-image carousel-img next-img" aria-hidden="true" />
            </div>
            <div class="cake-content">
              <div class="cake-head">
                <h3 class="cake-name" title={product.name}>{product.name}</h3>
                <span class="price-amount">${product.base_price} <small class="currency">CUP</small></span>
              </div>
              <div class="card-action-btns">
                <button
                  class="btn-buy-now buy-now-btn"
                  data-id={product.id}
                  data-name={product.name}
                  data-price={product.base_price}
                  data-type={product.type}
                  data-customizable="true"
                >
                  Comprar Ahora
                </button>
                <button
                  class="btn-icon-cart add-to-cart-btn"
                  data-id={product.id}
                  data-name={product.name}
                  data-price={product.base_price}
                  data-type={product.type}
                  data-customizable="true"
                  title="Añadir al carrito"
                  aria-label={`Añadir ${product.name} al carrito`}
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                    <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                    <line x1="12" y1="9" x2="16" y2="9"/>
                    <line x1="14" y1="7" x2="14" y2="11"/>
                  </svg>
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. BUFFET Y POSTRES (Grid de Acompañamiento) -->
  <section id="buffet" class="section-container bg-dark">
    <div class="section-inner">
      <div class="section-header">
        <span class="section-badge-light">Acompañamientos</span>
        <h2 class="section-title text-white">Buffet &amp; Postres Finos</h2>
        <div class="section-divider"></div>
        <p class="section-desc text-cream">Deliciosos salados artesanales y bocaditos tradicionales para consentir a tus invitados.</p>
      </div>
      
      <div class="buffet-grid">
        {buffetItems.map(product => (
          <article class="buffet-card">
            <div class="buffet-image-wrap carousel-container" data-images={JSON.stringify(product.images || [product.image])}>
              <img src={product.image} alt={product.name} class="buffet-image carousel-img active-img" loading="lazy" />
              <img src={product.image} alt="" class="buffet-image carousel-img next-img" aria-hidden="true" />
            </div>
            <div class="buffet-content">
              <div class="buffet-head">
                <h3 class="buffet-name" title={product.name}>{product.name}</h3>
                <span class="buffet-price">${product.base_price} <small class="currency">CUP</small></span>
              </div>
              <div class="card-action-btns">
                <button
                  class="btn-buy-now-buffet buy-now-btn"
                  data-id={product.id}
                  data-name={product.name}
                  data-price={product.base_price}
                  data-type={product.type}
                  data-customizable="false"
                >
                  Comprar
                </button>
                <button
                  class="btn-icon-cart-buffet add-to-cart-btn"
                  data-id={product.id}
                  data-name={product.name}
                  data-price={product.base_price}
                  data-type={product.type}
                  data-customizable="false"
                  title="Añadir al carrito"
                  aria-label={`Añadir ${product.name} al carrito`}
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                    <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                    <line x1="12" y1="9" x2="16" y2="9"/>
                    <line x1="14" y1="7" x2="14" y2="11"/>
                  </svg>
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. DECORACIONES TEMÁTICAS Y PERSONALIZADAS (Galería Visual) -->
  <section id="decoraciones" class="section-container bg-cream">
    <div class="section-inner">
      <div class="section-header">
        <span class="section-badge">Inspiración</span>
        <h2 class="section-title">Decoraciones Personalizadas</h2>
        <div class="section-divider"></div>
        <p class="section-desc">Acabados artísticos elaborados a mano según el tema o motivo de tu fiesta.</p>
      </div>

      <div class="gallery-grid">
        {decorations.map(item => (
          <div class="gallery-card">
            <div class="gallery-image-wrap">
              <img src={item.image} alt={item.title} class="gallery-image" loading="lazy" />
              <div class="gallery-overlay">
                <h4 class="gallery-title">{item.title}</h4>
                <p class="gallery-desc">{item.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. FLUJO DE ENCARGO (3 Pasos Icónicos) -->
  <section id="como-pedir" class="section-container bg-dark">
    <div class="section-inner">
      <div class="section-header">
        <span class="section-badge-light">Sencillo &amp; Rápido</span>
        <h2 class="section-title text-white">¿Cómo es el flujo de encargo?</h2>
        <div class="section-divider"></div>
      </div>
      
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h3 class="step-title">Elige tus dulces</h3>
          <p class="step-text">Explora nuestra carta y agrega los cakes y postres favoritos a tu pedido.</p>
        </div>

        <div class="step-card">
          <div class="step-num">2</div>
          <h3 class="step-title">Personaliza a tu gusto</h3>
          <p class="step-text">En el formulario defines masa, tamaño, colores, temática o foto de referencia.</p>
        </div>

        <div class="step-card">
          <div class="step-num">3</div>
          <h3 class="step-title">Coordinamos por WhatsApp</h3>
          <p class="step-text">Recibes tu ticket automático y acordamos los detalles finales de forma directa.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Botón flotante circular del Carrito (Siempre accesible) -->
  <button id="floating-cart-btn" class="floating-cart" aria-label="Ver pedido">
    <span class="cart-icon">🛒</span>
    <span class="cart-count" id="floating-cart-count">0</span>
  </button>

  <!-- Drawer Lateral del Carrito -->
  <div id="cart-drawer" class="cart-drawer">
    <div class="cart-drawer-overlay" id="cart-drawer-overlay"></div>
    <div class="cart-drawer-content">
      <div class="cart-header">
        <h2>Tu Pedido</h2>
        <button id="close-cart-btn" class="close-btn" aria-label="Cerrar pedido">&times;</button>
      </div>
      
      <div id="cart-items-container" class="cart-items-container">
        <!-- Generado dinámicamente -->
        <div class="empty-cart-message">
          <p>Tu pedido está vacío</p>
          <a href="#catalogo" id="explore-btn" class="btn-explore">Explorar Carta</a>
        </div>
      </div>

      <div class="cart-footer">
        <div class="cart-total-row">
          <span>Total Estimado:</span>
          <span id="cart-total-display" class="cart-total-amount">$0 CUP</span>
        </div>
        <a href="/pedido" id="checkout-btn" class="btn-checkout">
          Continuar y Personalizar Pedido →
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* ============================================================
     HERO MINIMALISTA (100vw x 100vh)
     ============================================================ */
  .hero-section {
    position: relative;
    width: 100%;
    min-height: 100vh;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 1.5rem;
    background: radial-gradient(circle at center, #3D1A24 0%, #2A0A14 70%);
    overflow: hidden;
    scroll-behavior: smooth;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(232,25,108,0.18) 0%, rgba(42,10,20,0.85) 80%);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .hero-logo-wrap {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    padding: 6px;
    background: linear-gradient(135deg, #E8196C, #FF6B35);
    box-shadow: 0 10px 40px rgba(232, 25, 108, 0.5);
    transition: transform var(--transition-fast);
  }

  .hero-logo-wrap:hover {
    transform: scale(1.05);
  }

  .hero-logo {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #FFFFFF;
  }

  .hero-badge {
    background: rgba(255, 107, 53, 0.15);
    border: 1px solid rgba(255, 140, 66, 0.4);
    color: var(--accent-light);
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.4rem 1.1rem;
    border-radius: 50px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5.5vw, 3.8rem);
    font-weight: 700;
    line-height: 1.15;
    color: #FFFFFF;
    letter-spacing: -0.5px;
    text-wrap: balance;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: var(--neutral-cream);
    line-height: 1.6;
    max-width: 540px;
    opacity: 0.95;
  }

  /* Flecha interactiva de scroll */
  .hero-scroll-indicator {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    color: var(--accent-light);
    text-decoration: none;
    margin-top: 1.5rem;
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .hero-scroll-indicator:hover {
    transform: translateY(4px);
    color: #FFFFFF;
  }

  .scroll-label {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .scroll-arrow {
    width: 24px;
    height: 24px;
    animation: scrollGlide 2.4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  @keyframes scrollGlide {
    0%, 100% { transform: translateY(0); opacity: 0.75; }
    50% { transform: translateY(6px); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-arrow {
      animation: none;
    }
  }

  /* ============================================================
     SECCIONES GENERALES
     ============================================================ */
  .section-container {
    padding: 2.25rem 0.75rem;
  }

  .section-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .bg-cream {
    background-color: var(--bg-light);
  }

  .bg-dark {
    background-color: var(--bg-primary);
  }

  .text-white { color: #FFFFFF !important; }
  .text-cream { color: var(--neutral-cream) !important; }

  .section-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .section-badge {
    background: rgba(232, 25, 108, 0.1);
    color: var(--primary);
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.3rem 0.9rem;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .section-badge-light {
    background: rgba(255, 107, 53, 0.15);
    color: var(--accent-light);
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.3rem 0.9rem;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 700;
    color: var(--text-on-light);
    line-height: 1.2;
  }

  .section-divider {
    width: 50px;
    height: 3px;
    background: var(--gradient-brand);
    border-radius: 2px;
  }

  .section-desc {
    font-size: 1rem;
    color: var(--text-on-light-soft);
    line-height: 1.6;
  }

  /* ============================================================
     CAKES GRID DIRECTO (4 Categorías limpias)
     ============================================================ */
  .cakes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem;
  }

  .cake-card {
    background: #FFFFFF;
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(42, 10, 20, 0.08);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    border: 1px solid rgba(42, 10, 20, 0.06);
  }

  .cake-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 30px rgba(232, 25, 108, 0.15);
  }

  .cake-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #F4E9E0;
  }

  .carousel-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .carousel-img.active-img {
    opacity: 1;
    z-index: 2;
    transition: opacity 500ms ease-in-out;
  }

  .carousel-img.next-img {
    opacity: 0;
    z-index: 1;
    transition: opacity 500ms ease-in-out;
  }

  .carousel-img.brightness-pulse {
    animation: lightPulse 450ms ease-in-out;
  }

  @keyframes lightPulse {
    0% { filter: brightness(1); transform: scale(1); }
    50% { filter: brightness(1.15) contrast(1.05); transform: scale(1.05); }
    100% { filter: brightness(1); transform: scale(1); }
  }

  .carousel-img.fade-out {
    opacity: 0;
    transition: opacity 600ms ease-in-out;
  }

  .carousel-img.fade-in {
    opacity: 1;
    z-index: 3;
    transition: opacity 600ms ease-in-out;
  }

  .carousel-img.fade-out {
    opacity: 0;
  }

  .carousel-img.fade-in {
    opacity: 1;
    z-index: 3;
  }



  .cake-content {
    padding: 0.6rem 0.65rem 0.65rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.5rem;
  }

  .cake-head,
  .buffet-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem;
    min-width: 0;
  }

  .cake-name {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--text-on-light);
    flex: 1 1 auto;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cake-desc {
    font-size: 0.9rem;
    color: var(--text-on-light-soft);
    line-height: 1.5;
    flex: 1;
  }

  .cake-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid rgba(42, 10, 20, 0.08);
  }

  .price-wrap {
    display: flex;
    flex-direction: column;
  }

  .price-label {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--text-on-light-soft);
    letter-spacing: 0.5px;
  }

  .price-amount {
    flex: 0 0 auto;
    white-space: nowrap;
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--primary);
  }

  .currency {
    font-size: 0.8rem;
    font-weight: 700;
  }

  .card-action-btns {
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
    margin-top: auto;
    width: 100%;
  }

  .btn-icon-cart {
    background: #FFFFFF;
    color: var(--primary);
    border: 1.5px solid var(--primary);
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    border-radius: var(--border-radius-md);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(232, 25, 108, 0.12);
    transition: all var(--transition-fast);
  }

  .btn-icon-cart:hover {
    background: var(--primary);
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(232, 25, 108, 0.25);
  }

  .btn-buy-now {
    background: var(--gradient-brand);
    color: #FFFFFF;
    border: 1.5px solid transparent;
    flex: 1;
    min-width: 0;
    height: 36px;
    padding: 0 0.6rem;
    border-radius: var(--border-radius-md);
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 0.8rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    box-shadow: 0 4px 14px rgba(232, 25, 108, 0.35);
  }

  .btn-buy-now:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(232, 25, 108, 0.5);
  }

  .btn-icon-cart-buffet {
    background: #FFFFFF;
    color: var(--accent);
    border: 1.5px solid var(--accent);
    flex: 0 0 34px;
    width: 34px;
    height: 34px;
    border-radius: var(--border-radius-sm);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(255, 107, 53, 0.15);
    transition: all var(--transition-fast);
  }

  .btn-icon-cart-buffet:hover {
    background: var(--accent);
    color: #FFFFFF;
    transform: translateY(-1px);
  }

  .btn-buy-now-buffet {
    background: var(--gradient-brand);
    color: #FFFFFF;
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    flex: 1;
    min-width: 0;
    height: 34px;
    padding: 0 0.6rem;
    border-radius: var(--border-radius-sm);
    font-weight: 800;
    font-size: 0.82rem;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(255, 107, 53, 0.3);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .btn-buy-now-buffet:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(255, 107, 53, 0.5);
  }

  /* ============================================================
     BUFFET GRID
     ============================================================ */
  .buffet-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 0.75rem;
  }

  .buffet-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-md);
