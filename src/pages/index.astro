---
import Layout from '../layouts/Layout.astro';
import { PRODUCTS } from '../data/products';

const cakes = PRODUCTS.filter(p => p.category === 'cakes' || p.category === 'minicakes');
const buffetItems = PRODUCTS.filter(p => p.category === 'reposteria' || p.category === 'salados');
---

<Layout title="Inicio - Dulcería por Encargo">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-overlay"></div>

    <!-- SVG Decorativos flotantes -->
    <div class="hero-svgs" aria-hidden="true">
      <!-- Cake de 1 piso -->
      <svg class="hero-svg hero-svg--cake" viewBox="0 0 80 90" fill="none" xmlns="http://www.w3.org/2000/svg">
        <ellipse cx="40" cy="72" rx="36" ry="8" fill="rgba(255,255,255,0.12)"/>
        <rect x="10" y="38" width="60" height="32" rx="8" fill="rgba(255,255,255,0.18)"/>
        <ellipse cx="40" cy="38" rx="30" ry="8" fill="rgba(255,255,255,0.22)"/>
        <path d="M10 46 Q40 55 70 46" stroke="rgba(255,140,66,0.7)" stroke-width="3" fill="none"/>
        <rect x="22" y="20" width="36" height="20" rx="6" fill="rgba(255,255,255,0.15)"/>
        <ellipse cx="40" cy="20" rx="18" ry="5" fill="rgba(255,255,255,0.2)"/>
        <line x1="40" y1="8" x2="40" y2="18" stroke="rgba(255,200,100,0.9)" stroke-width="2.5" stroke-linecap="round"/>
        <ellipse cx="40" cy="7" rx="3" ry="4" fill="rgba(255,107,53,0.9)"/>
        <circle cx="25" cy="55" r="3" fill="rgba(255,200,100,0.6)"/>
        <circle cx="40" cy="58" r="2.5" fill="rgba(255,140,66,0.6)"/>
        <circle cx="55" cy="54" r="3" fill="rgba(255,200,100,0.6)"/>
      </svg>

      <!-- Cupcake -->
      <svg class="hero-svg hero-svg--cupcake" viewBox="0 0 60 70" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 40 L18 62 H42 L48 40 Z" fill="rgba(255,255,255,0.15)" rx="4"/>
        <path d="M8 38 Q30 20 52 38" fill="rgba(255,255,255,0.22)" stroke="none"/>
        <path d="M8 38 Q20 48 30 42 Q40 36 52 38 Q45 56 15 56 Z" fill="rgba(255,255,255,0.18)"/>
        <path d="M15 38 Q30 10 45 38" fill="rgba(255,200,180,0.25)"/>
        <path d="M20 30 Q30 12 40 30" stroke="rgba(255,140,66,0.5)" stroke-width="2" fill="none"/>
        <circle cx="30" cy="14" r="4" fill="rgba(232,25,108,0.8)"/>
        <circle cx="22" cy="32" r="2" fill="rgba(255,200,100,0.6)"/>
        <circle cx="38" cy="32" r="2" fill="rgba(255,200,100,0.6)"/>
        <circle cx="30" cy="36" r="1.5" fill="rgba(255,107,53,0.7)"/>
      </svg>

      <!-- Estrella / sprinkle 1 -->
      <svg class="hero-svg hero-svg--star1" viewBox="0 0 30 30" fill="none">
        <polygon points="15,2 18,11 28,11 20,17 23,27 15,21 7,27 10,17 2,11 12,11" fill="rgba(255,200,100,0.55)"/>
      </svg>

      <!-- Estrella / sprinkle 2 -->
      <svg class="hero-svg hero-svg--star2" viewBox="0 0 20 20" fill="none">
        <polygon points="10,1 12,7 19,7 13,11 15,18 10,14 5,18 7,11 1,7 8,7" fill="rgba(255,255,255,0.5)"/>
      </svg>

      <!-- Corazón -->
      <svg class="hero-svg hero-svg--heart" viewBox="0 0 40 36" fill="none">
        <path d="M20 34 C20 34 2 22 2 11 C2 5.5 6.5 2 11 2 C14.5 2 17.5 4 20 7 C22.5 4 25.5 2 29 2 C33.5 2 38 5.5 38 11 C38 22 20 34 20 34Z" fill="rgba(232,25,108,0.45)"/>
      </svg>

      <!-- Dona -->
      <svg class="hero-svg hero-svg--donut" viewBox="0 0 60 60" fill="none">
        <circle cx="30" cy="30" r="26" fill="rgba(255,255,255,0.14)"/>
        <circle cx="30" cy="30" r="14" fill="rgba(42,10,20,0.4)"/>
        <path d="M7 25 Q20 10 53 28" stroke="rgba(255,140,66,0.5)" stroke-width="3" fill="none" stroke-linecap="round"/>
        <circle cx="20" cy="18" r="2.5" fill="rgba(232,25,108,0.6)"/>
        <circle cx="42" cy="15" r="2" fill="rgba(255,200,100,0.6)"/>
        <circle cx="50" cy="30" r="2.5" fill="rgba(255,107,53,0.5)"/>
      </svg>
    </div>

    <div class="hero-content">
      <div class="hero-logo-wrap">
        <img src="/logo-correcto.png" alt="Dulcería El Líder Logo" class="hero-logo" />
      </div>
      <span class="hero-badge">✨ Artesanal &amp; Premium</span>
      <h1 class="hero-title">El Arte de la Dulcería Fina</h1>
      <p class="hero-subtitle">Cakes exclusivos y dulces de alta calidad elaborados totalmente por encargo para hacer de tu celebración un momento inolvidable.</p>
      <div class="hero-actions">
        <a href="#catalogo" class="hero-btn-primary">🎂 Ver la Carta</a>
        <a href="#como-pedir" class="hero-btn-secondary">¿Cómo pedir?</a>
      </div>
    </div>
  </section>

  <!-- Cakes Catalog Section -->
  <section id="catalogo" class="catalog-section">
    <div class="section-deco section-deco--catalog" aria-hidden="true">
      <svg class="sdeco sdeco--cupcake-l" viewBox="0 0 70 80" fill="none">
        <path d="M14 46 L20 72 H50 L56 46 Z" fill="rgba(232,25,108,0.18)"/>
        <path d="M8 44 Q35 22 62 44" fill="rgba(255,200,180,0.22)"/>
        <path d="M8 44 Q22 56 35 49 Q48 42 62 44 Q53 66 17 66 Z" fill="rgba(232,25,108,0.15)"/>
        <circle cx="35" cy="16" r="6" fill="rgba(255,107,53,0.7)"/>
        <circle cx="24" cy="38" r="3" fill="rgba(255,200,100,0.5)"/>
        <circle cx="46" cy="36" r="2.5" fill="rgba(255,200,100,0.5)"/>
      </svg>
      <svg class="sdeco sdeco--star-r" viewBox="0 0 40 40" fill="none">
        <polygon points="20,2 24,15 38,15 27,23 31,37 20,29 9,37 13,23 2,15 16,15" fill="rgba(255,200,100,0.4)"/>
      </svg>
      <svg class="sdeco sdeco--heart-tl" viewBox="0 0 50 46" fill="none">
        <path d="M25 43 C25 43 3 28 3 14 C3 7 8 3 14 3 C18 3 22 5.5 25 9 C28 5.5 32 3 36 3 C42 3 47 7 47 14 C47 28 25 43 25 43Z" fill="rgba(232,25,108,0.3)"/>
      </svg>
    </div>
    <div class="section-header">
      <span class="subtitle">Exquisiteces</span>
      <h2>¿Qué tipo de cake deseas para tu celebración?</h2>
      <div class="divider"></div>
      
      <!-- Subcategory filters (Pills) -->
      <div class="carousel-subcategories">
        <button class="subcategory-pill active" data-filter="all">Todos los Cakes</button>
        <button class="subcategory-pill" data-filter="minicakes">Mini Cakes</button>
        <button class="subcategory-pill" data-filter="redondos">Cakes Redondos</button>
        <button class="subcategory-pill" data-filter="bandeja">Cakes de Bandeja</button>
        <button class="subcategory-pill" data-filter="pisos">Cakes de Varios Pisos</button>
      </div>
    </div>

    <!-- Carousel Container (Large Cards) -->
    <div class="carousel-outer-wrapper">
      <button class="carousel-control prev" id="carousel-prev-btn" aria-label="Anterior">&lt;</button>
      <div class="carousel-viewport" id="carousel-viewport">
        <div class="carousel-track" id="carousel-track">
          {cakes.map(product => {
            // Determine subcategory filter type
            let filterType = 'all';
            if (product.id === 'minicake') filterType = 'minicakes';
            else if (product.id === 'cake-redondo') filterType = 'redondos';
            else if (product.id === 'cake-bandeja') filterType = 'bandeja';
            else if (product.id === 'cake-varios-pisos') filterType = 'pisos';

            return (
              <div class="product-card carousel-slide" data-filter-type={filterType} data-id={product.id}>
                <div class="product-image-container">
                  <img src={product.image} alt={product.name} class="product-image" loading="lazy" />
                  <span class="product-badge">{product.category === 'minicakes' ? 'MiniCake' : 'Cake'}</span>
                </div>
                <div class="product-info">
                  <h3>{product.name}</h3>
                  <p class="product-description">{product.description}</p>
                  <div class="product-meta">
                    <span class="product-price">
                      ${product.price} <span class="currency">CUP</span>
                      {product.priceNote && <span class="price-note">({product.priceNote})</span>}
                    </span>
                    <button 
                      class="add-to-cart-btn" 
                      data-id={product.id}
                      data-name={product.name}
                      data-price={product.price}
                      data-category={product.category}
                      data-customizable={product.customizable ? "true" : "false"}
                    >
                      + Agregar
                    </button>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
      <button class="carousel-control next" id="carousel-next-btn" aria-label="Siguiente">&gt;</button>
    </div>
  </section>

  <!-- Buffet & Dessert Offers Section -->
  <section id="buffet" class="buffet-section">
    <div class="section-deco section-deco--buffet" aria-hidden="true">
      <svg class="sdeco sdeco--star-big" viewBox="0 0 60 60" fill="none">
        <polygon points="30,3 36,21 55,21 41,32 47,51 30,40 13,51 19,32 5,21 24,21" fill="rgba(255,200,100,0.35)"/>
      </svg>
      <svg class="sdeco sdeco--cupcake-r2" viewBox="0 0 80 90" fill="none">
        <path d="M16 52 L24 80 H56 L64 52 Z" fill="rgba(255,255,255,0.1)"/>
        <path d="M10 50 Q40 26 70 50" fill="rgba(255,200,180,0.18)"/>
        <path d="M10 50 Q26 62 40 55 Q54 48 70 50 Q60 74 20 74 Z" fill="rgba(255,255,255,0.12)"/>
        <circle cx="40" cy="18" r="8" fill="rgba(232,25,108,0.55)"/>
        <path d="M28 44 Q40 28 52 44" stroke="rgba(255,140,66,0.4)" stroke-width="2" fill="none"/>
        <circle cx="28" cy="62" r="3" fill="rgba(255,200,100,0.4)"/>
        <circle cx="52" cy="60" r="2.5" fill="rgba(255,200,100,0.4)"/>
      </svg>
    </div>
    <div class="section-header">
      <span class="subtitle">Ofertas Adicionales</span>
      <h2>Acompaña tu Fiesta (Buffet y Postres)</h2>
      <div class="divider"></div>
      <p class="section-desc">Exquisitos salados y dulces tradicionales para complementar tu celebración de manera perfecta.</p>
    </div>
    
    <div class="buffet-grid">
      {buffetItems.map(product => (
        <div class="buffet-card">
          <div class="buffet-image-container">
            <img src={product.image} alt={product.name} class="buffet-image" loading="lazy" />
          </div>
          <div class="buffet-info">
            <h3>{product.name}</h3>
            <p class="buffet-description">{product.description}</p>
            <div class="buffet-meta">
              <span class="buffet-price">${product.price} CUP c/u</span>
              <button 
                class="add-to-cart-btn" 
                data-id={product.id}
                data-name={product.name}
                data-price={product.price}
                data-category={product.category}
                data-customizable={product.customizable ? "true" : "false"}
              >
                + Añadir
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Gallery of Custom Decorations Section -->
  <section id="decoraciones" class="decorations-section">
    <div class="section-deco section-deco--decorations" aria-hidden="true">
      <svg class="sdeco sdeco--heart-r" viewBox="0 0 50 46" fill="none" style="width: 60px; right: 2%; bottom: 15%; animation: heroPulse 4s ease-in-out infinite;">
        <path d="M25 43 C25 43 3 28 3 14 C3 7 8 3 14 3 C18 3 22 5.5 25 9 C28 5.5 32 3 36 3 C42 3 47 7 47 14 C47 28 25 43 25 43Z" fill="rgba(232,25,108,0.2)"/>
      </svg>
      <svg class="sdeco sdeco--star-l" viewBox="0 0 40 40" fill="none" style="width: 50px; left: 2%; top: 12%; animation: heroSpin 10s linear infinite;">
        <polygon points="20,2 24,15 38,15 27,23 31,37 20,29 9,37 13,23 2,15 16,15" fill="rgba(255,200,100,0.3)"/>
      </svg>
    </div>
    <div class="section-header">
      <span class="subtitle">Inspiración</span>
      <h2>Nuestras Decoraciones Personalizadas</h2>
      <div class="divider"></div>
      <p class="section-desc">Diseños artísticos elaborados a mano. Cada pastel es personalizado a tu gusto y temática de celebración.</p>
    </div>

    <div class="decorations-carousel-container">
      <button class="dec-carousel-control prev" id="dec-prev-btn" aria-label="Anterior">&lt;</button>
      <div class="decorations-viewport" id="dec-viewport">
        <div class="decorations-track" id="dec-track">
          <div class="decoration-slide">
            <img src="https://images.unsplash.com/photo-1535254973040-607b474cb50d?q=80&w=600&auto=format&fit=crop" alt="Decoración Infantil Dinosaurios" />
            <div class="decoration-overlay-info">
              <h4>Temática Infantil / Dinosaurios</h4>
              <p>Modelado artístico 2D y 3D en merengue fino.</p>
            </div>
          </div>
          <div class="decoration-slide">
            <img src="https://images.unsplash.com/photo-1557925923-cd4648e21187?q=80&w=600&auto=format&fit=crop" alt="Decoración Elegante Floral" />
            <div class="decoration-overlay-info">
              <h4>Diseño Elegante Floral</h4>
              <p>Detalles florales perfectos para bodas y aniversarios.</p>
            </div>
          </div>
          <div class="decoration-slide">
            <img src="https://images.unsplash.com/photo-1519869325930-281384150729?q=80&w=600&auto=format&fit=crop" alt="Decoración de Chocolate Premium" />
            <div class="decoration-overlay-info">
              <h4>Glaseado de Chocolate y Drips</h4>
              <p>Drips de chocolate gourmet y trufas seleccionadas.</p>
            </div>
          </div>
          <div class="decoration-slide">
            <img src="https://images.unsplash.com/photo-1588195538326-c5b1e9f80a1b?q=80&w=600&auto=format&fit=crop" alt="Fantasía Rosa y Sprinkles" />
            <div class="decoration-overlay-info">
              <h4>Fantasía en Rosa y Merengue</h4>
              <p>Tonos pasteles y chispas de colores para cumpleaños alegres.</p>
            </div>
          </div>
        </div>
      </div>
      <button class="dec-carousel-control next" id="dec-next-btn" aria-label="Siguiente">&gt;</button>
    </div>


  </section>

  <!-- Info Section / Como Pedir -->
  <section id="como-pedir" class="info-section">
    <div class="section-deco section-deco--info" aria-hidden="true">
      <svg class="sdeco sdeco--cake-big" viewBox="0 0 100 110" fill="none">
        <!-- Piso 1 -->
        <ellipse cx="50" cy="88" rx="44" ry="10" fill="rgba(232,25,108,0.12)"/>
        <rect x="12" y="54" width="76" height="36" rx="10" fill="rgba(255,255,255,0.1)"/>
        <ellipse cx="50" cy="54" rx="38" ry="10" fill="rgba(255,255,255,0.15)"/>
        <path d="M12 64 Q50 76 88 64" stroke="rgba(255,140,66,0.5)" stroke-width="3" fill="none"/>
        <!-- Piso 2 -->
        <rect x="26" y="28" width="48" height="28" rx="8" fill="rgba(255,255,255,0.1)"/>
        <ellipse cx="50" cy="28" rx="24" ry="7" fill="rgba(255,255,255,0.15)"/>
        <path d="M26 36 Q50 44 74 36" stroke="rgba(255,140,66,0.4)" stroke-width="2" fill="none"/>
        <!-- Vela -->
        <line x1="50" y1="10" x2="50" y2="26" stroke="rgba(255,200,100,0.9)" stroke-width="3" stroke-linecap="round"/>
        <ellipse cx="50" cy="9" rx="4" ry="5" fill="rgba(255,107,53,0.9)"/>
        <!-- Sprinkles -->
        <circle cx="28" cy="72" r="3.5" fill="rgba(255,200,100,0.5)"/>
        <circle cx="50" cy="76" r="3" fill="rgba(255,140,66,0.5)"/>
        <circle cx="72" cy="70" r="3.5" fill="rgba(255,200,100,0.5)"/>
      </svg>
      <svg class="sdeco sdeco--donut-r" viewBox="0 0 80 80" fill="none">
        <circle cx="40" cy="40" r="34" fill="rgba(255,107,53,0.12)"/>
        <circle cx="40" cy="40" r="18" fill="rgba(42,10,20,0.3)"/>
        <path d="M10 33 Q24 12 70 36" stroke="rgba(255,140,66,0.4)" stroke-width="3.5" fill="none" stroke-linecap="round"/>
        <circle cx="26" cy="22" r="3" fill="rgba(232,25,108,0.45)"/>
        <circle cx="55" cy="18" r="2.5" fill="rgba(255,200,100,0.5)"/>
        <circle cx="68" cy="40" r="3" fill="rgba(255,107,53,0.4)"/>
      </svg>
    </div>
    <div class="section-header">
      <span class="subtitle">Paso a Paso</span>
      <h2>¿Cómo funciona nuestro servicio por encargo?</h2>
      <div class="divider"></div>
    </div>
    
    <div class="steps-grid">
      <div class="step-card">
        <div class="step-icon">1</div>
        <h3>Selecciona tus Dulces</h3>
        <p>Explora nuestra carta exclusiva y elige tus dulces favoritos agregándolos al carrito de compras.</p>
      </div>
      <div class="step-card">
        <div class="step-icon">2</div>
        <h3>Personaliza tu Cake</h3>
        <p>En el carrito, define los colores, la temática o añade una <strong>Impresión Comestible</strong> subiendo tu propia imagen.</p>
      </div>
      <div class="step-card">
        <div class="step-icon">3</div>
        <h3>Envía por WhatsApp</h3>
        <p>Tu pedido se procesará automáticamente en un mensaje detallado para finalizar la cotización y agendar la fecha por WhatsApp.</p>
      </div>
    </div>
  </section>

  <!-- Interactive Customizer Section -->
  <section id="personalizador" class="customizer-section">
    <div class="section-deco section-deco--customizer" aria-hidden="true">
      <svg class="sdeco sdeco--donut-l" viewBox="0 0 80 80" fill="none" style="width: 80px; left: 1%; bottom: 10%; animation: heroFloat 6s ease-in-out infinite alternate;">
        <circle cx="40" cy="40" r="34" fill="rgba(255,107,53,0.1)"/>
        <circle cx="40" cy="40" r="18" fill="rgba(42,10,20,0.25)"/>
        <path d="M10 33 Q24 12 70 36" stroke="rgba(255,140,66,0.35)" stroke-width="3" fill="none" stroke-linecap="round"/>
      </svg>
      <svg class="sdeco sdeco--cupcake-r" viewBox="0 0 70 80" fill="none" style="width: 90px; right: 1%; top: 15%; animation: heroFloat 8s ease-in-out infinite reverse;">
        <path d="M14 46 L20 72 H50 L56 46 Z" fill="rgba(232,25,108,0.12)"/>
        <path d="M8 44 Q35 22 62 44" fill="rgba(255,200,180,0.15)"/>
        <circle cx="35" cy="16" r="6" fill="rgba(255,107,53,0.5)"/>
      </svg>
    </div>
    <div class="section-header">
      <span class="subtitle">Creación a Medida</span>
      <h2>🎂 Diseña tu Cake Personalizado</h2>
      <div class="divider"></div>
      <p class="section-desc">Crea el pastel perfecto para tu fiesta y míralo dibujado al instante con nuestro ilustrador interactivo.</p>
    </div>

    <div class="customizer-grid">
      <!-- Visualizer Canvas -->
      <div class="customizer-visualizer">
        <canvas id="cake-canvas" width="300" height="300"></canvas>
      </div>

      <!-- Controls Panel -->
      <div class="customizer-controls">
        <div class="control-group">
          <label for="custom-size">📏 Selecciona la Categoría de Cake:</label>
          <select id="custom-size" class="customizer-select">
            <option value="minicake" data-price="2500" selected>Mini Cakes — $2500 CUP</option>
            <option value="cake-redondo" data-price="3500">Cakes Redondos (Base 20 cm) — $3500 CUP</option>
            <option value="cake-bandeja" data-price="5300">Cakes de Bandeja (Base Media Bandeja) — $5300 CUP</option>
            <option value="cake-varios-pisos" data-price="16500">Cakes de Varios Pisos — $16500 CUP</option>
          </select>
        </div>

        <div class="control-group" id="custom-dough-wrapper">
          <label for="custom-dough">🌾 Tipo de Masa:</label>
          <select id="custom-dough" class="customizer-select">
            <option value="trigo" selected>Harina de Trigo (Por defecto)</option>
            <option value="maicena">Maicena (Almidón de maíz)</option>
            <option value="capuchino">Capuchino</option>
          </select>
        </div>

        <div class="control-group">
          <label>🎨 Color de Cobertura:</label>
          <div class="color-picker-row">
            <input type="color" id="custom-color-picker" value="#FDFBF7" class="native-color-picker" title="Elige cualquier color personalizado" />
            <div class="color-swatches">
              <button class="color-swatch-btn active" data-color="#FDFBF7" data-name="Blanco Crema" style="background-color: #FDFBF7;"></button>
              <button class="color-swatch-btn" data-color="#FBCFE8" data-name="Rosa Pastel" style="background-color: #FBCFE8;"></button>
              <button class="color-swatch-btn" data-color="#BAE6FD" data-name="Azul Celeste" style="background-color: #BAE6FD;"></button>
              <button class="color-swatch-btn" data-color="#FEF08A" data-name="Amarillo Sol" style="background-color: #FEF08A;"></button>
              <button class="color-swatch-btn" data-color="#A7F3D0" data-name="Verde Menta" style="background-color: #A7F3D0;"></button>
              <button class="color-swatch-btn" data-color="#E9D5FF" data-name="Lila" style="background-color: #E9D5FF;"></button>
              <button class="color-swatch-btn" data-color="#D97706" data-name="Dorado Oro" style="background-color: #D97706;"></button>
              <button class="color-swatch-btn" data-color="#78350F" data-name="Chocolate" style="background-color: #78350F;"></button>
            </div>
          </div>
          <span class="selected-color-label">Color seleccionado: <strong id="color-name-display">Blanco Crema</strong></span>
        </div>

        <div class="control-group">
          <label for="custom-theme">✍️ Temática / Decoración (Opcional):</label>
          <input type="text" id="custom-theme" class="customizer-input" placeholder="Ej: Cumpleaños infantil, dinosaurios, feliz 30..." />
        </div>

        <div class="control-group">
          <label class="edible-print-option">
            <input type="checkbox" id="custom-print" />
            Añadir Impresión Comestible
          </label>
        </div>

