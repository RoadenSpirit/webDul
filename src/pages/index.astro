    color: #FFFFFF;
  }

  .close-btn {
    background: none;
    border: none;
    color: var(--neutral-cream);
    font-size: 2rem;
    cursor: pointer;
    line-height: 1;
    transition: color var(--transition-fast);
  }

  .close-btn:hover {
    color: #FFFFFF;
  }

  .cart-items-container {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
