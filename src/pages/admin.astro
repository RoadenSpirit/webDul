---
import Layout from '../layouts/Layout.astro';
import catalogData from '../../data/catalog.json';

const initialCatalog = catalogData;
---

<Layout title="Panel Administrativo — Dulcería El Líder" hideFooter={true}>
  <!-- 1. Pantalla de Login -->
  <div id="admin-login-screen" class="min-h-screen bg-[var(--bg-primary)] flex items-center justify-center p-4">
    <div class="bg-[var(--bg-card)] border border-[var(--border-color)] rounded-2xl p-8 max-w-md w-full shadow-2xl text-center space-y-6">
      <div class="w-20 h-20 mx-auto rounded-full p-1 bg-gradient-to-tr from-[var(--primary)] to-[var(--accent)] shadow-lg">
        <img src="/logo-correcto.png" alt="Logo" class="w-full h-full object-cover rounded-full" />
      </div>
      <div>
        <h1 class="text-2xl font-black text-white font-[var(--font-display)]">Acceso Administrativo</h1>
        <p class="text-xs text-[var(--neutral-cream)] mt-1">Gestión Total de Productos, Atributos y Precios</p>
      </div>

      <form id="login-form" class="space-y-4 text-left">
        <div>
          <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Usuario</label>
          <input type="text" id="admin-user" required class="w-full px-4 py-2.5 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl text-white outline-none focus:border-[var(--primary)]" />
        </div>
        <div>
          <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Contraseña</label>
          <input type="password" id="admin-pass" required class="w-full px-4 py-2.5 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl text-white outline-none focus:border-[var(--primary)]" />
        </div>
        <p id="login-error" class="text-xs text-red-400 font-bold hidden"></p>
        <button type="submit" class="w-full py-3 bg-[var(--gradient-brand)] text-white font-bold rounded-xl shadow-lg hover:opacity-95 transition-all cursor-pointer">
          Iniciar Sesión
        </button>
      </form>
    </div>
  </div>

  <!-- 2. Dashboard con Edición Total -->
  <div id="admin-dashboard" class="hidden min-h-screen bg-[var(--bg-primary)] text-white pb-24">
    
    <!-- Barra Superior Sticky con Disquete 💾 de Guardado -->
    <header class="bg-[var(--bg-secondary)] border-b border-[var(--border-color)] px-4 sm:px-6 py-3.5 sticky top-0 z-40 shadow-md">
      <div class="max-w-7xl mx-auto flex items-center justify-between gap-4 flex-wrap">
        <div class="flex items-center gap-3">
          <img src="/logo-correcto.png" alt="Logo" class="w-10 h-10 rounded-full border border-white/20" />
          <div>
            <h2 class="text-base sm:text-lg font-black font-[var(--font-display)]">Dulcería El Líder · Panel Total</h2>
            <span class="text-[11px] text-[var(--accent-light)] font-semibold">Edición completa de catálogo y atributos</span>
          </div>
        </div>

        <!-- Indicador & Botón de Guardar con Disquete 💾 -->
        <div class="flex items-center gap-3 flex-wrap">
          <button 
            id="save-changes-btn" 
            class="hidden items-center gap-2.5 px-5 py-2.5 bg-gradient-to-r from-emerald-500 to-green-600 hover:from-emerald-400 hover:to-green-500 text-white font-extrabold text-sm rounded-xl shadow-xl transition-all animate-pulse cursor-pointer border border-emerald-300/40"
            title="Guardar todos los cambios realizados en el catálogo"
          >
            <!-- SVG de Disquete grande y llamativo -->
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
              <polyline points="17 21 17 13 7 13 7 21"></polyline>
              <polyline points="7 3 7 8 15 8"></polyline>
            </svg>
            <span>GUARDAR CAMBIOS</span>
          </button>

          <button id="new-product-open-btn" class="inline-flex items-center gap-1.5 text-xs bg-[var(--primary)] hover:opacity-90 text-white px-3.5 py-2 rounded-xl font-bold transition-all shadow-md cursor-pointer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Crear Producto</span>
          </button>

          <button id="reset-defaults-btn" class="text-xs bg-white/10 hover:bg-white/20 text-[var(--neutral-cream)] px-3 py-2 rounded-lg font-bold transition-colors cursor-pointer" title="Restaurar valores oficiales iniciales">
            Restaurar Base
          </button>
          <a href="/" target="_blank" class="text-xs bg-white/10 hover:bg-white/20 text-white px-3 py-2 rounded-lg font-bold transition-colors">
            Ver Web ↗
          </a>
          <button id="logout-btn" class="text-xs text-red-400 hover:text-red-300 font-bold cursor-pointer">
            Salir
          </button>
        </div>
      </div>
    </header>

    <!-- Contenedor Principal: Tabla Horizontal de Productos -->
    <div class="max-w-7xl mx-auto p-4 sm:p-6 space-y-6">
      
      <!-- Banner Informativo -->
      <div class="bg-[var(--bg-card)] border border-[var(--border-color)] rounded-2xl p-5 flex items-center justify-between gap-4 flex-wrap">
        <div>
          <h3 class="font-bold text-white text-base">🎂 Matriz Completa de Productos &amp; Atributos</h3>
          <p class="text-xs text-[var(--neutral-cream)]/80 mt-0.5">
            Puedes editar en cualquier momento el nombre, categoría, precio base o hacer clic en cualquier lápiz ✏️ para editar precios directos de atributos.
          </p>
        </div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 text-xs text-emerald-400 font-bold bg-emerald-950/40 border border-emerald-500/30 px-3 py-1 rounded-full">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            Edición Activa In-Situ
          </span>
        </div>
      </div>

      <!-- TABLA HORIZONTAL DE PRODUCTOS -->
      <div class="bg-[var(--bg-card)] border border-[var(--border-color)] rounded-2xl shadow-xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse min-w-[760px]">
            <thead>
              <tr class="bg-[var(--bg-secondary)] border-b border-[var(--border-color)] text-[11px] font-black uppercase tracking-wider text-[var(--accent-light)]">
                <th class="py-4 px-6 w-5/12">Producto &amp; Precio Base</th>
                <th class="py-4 px-6 w-5/12">Atributos Asignados (Opciones y Precios)</th>
                <th class="py-4 px-6 w-2/12 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody id="cakes-table-body" class="divide-y divide-[var(--border-color)]/50 text-sm">
              <!-- Renderizado dinámicamente por JS -->
            </tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- MODAL 1: ASIGNAR / EDITAR ATRIBUTO PARA UN CAKE -->
    <div id="attribute-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm hidden">
      <div class="bg-[var(--bg-card)] border border-[var(--border-color)] rounded-2xl max-w-xl w-full p-6 shadow-2xl space-y-5">
        
        <div class="flex items-center justify-between border-b border-[var(--border-color)] pb-3">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-[var(--accent-light)]" id="modal-cake-title">Cake</span>
            <h3 class="text-lg font-black text-white" id="modal-header-title">Configurar Atributo</h3>
          </div>
          <button id="close-modal-btn" class="text-2xl text-white/50 hover:text-white leading-none cursor-pointer">&times;</button>
        </div>

        <!-- 1. Selección o Creación de Atributo -->
        <div class="space-y-2">
          <label class="block text-xs font-bold text-[var(--text-secondary)]">Atributo a Asignar</label>
          <select id="modal-attribute-select" class="w-full bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl px-3 py-2 text-sm text-white outline-none focus:border-[var(--primary)]">
            <!-- Opciones dinámicas de atributos -->
          </select>
          
          <!-- Crear nuevo atributo al vuelo -->
          <div class="pt-2 flex gap-2 items-center">
            <input type="text" id="modal-new-attribute-name" placeholder="Crear nuevo atributo (ej: Relleno, Cobertura...)" class="flex-1 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl px-3 py-2 text-xs text-white outline-none focus:border-[var(--primary)]" />
            <button id="modal-create-attr-btn" class="px-3.5 py-2 bg-white/10 hover:bg-white/20 text-xs font-bold rounded-xl transition-colors cursor-pointer whitespace-nowrap">+ Crear Atributo</button>
          </div>
        </div>

        <!-- 2. Opciones del Atributo con Precios Directos (Totalmente Editables Siempre) -->
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <label class="block text-xs font-bold text-[var(--text-secondary)]">Opciones y Precio Directo para este Producto</label>
            <span class="text-[10px] text-[var(--neutral-cream)]/70">Marca las que aplican y define su precio</span>
          </div>
          
          <div id="modal-options-list" class="space-y-2 max-h-[35vh] overflow-y-auto pr-1">
            <!-- Inyectado dinámicamente -->
          </div>

          <!-- Añadir nueva opción a este atributo con su precio directo -->
          <div class="pt-3 border-t border-[var(--border-color)]/40 space-y-1.5">
            <span class="text-[10px] font-bold uppercase tracking-wider text-[var(--accent-light)]">Añadir Nueva Opción a este Atributo:</span>
            <div class="flex gap-2">
              <input type="text" id="modal-new-option-name" placeholder="Nombre opción (ej: Chocolate Blanco...)" class="flex-1 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl px-3 py-2 text-xs text-white outline-none focus:border-[var(--primary)]" />
              <input type="number" id="modal-new-option-price" placeholder="Precio CUP" class="w-28 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl px-3 py-2 text-xs text-white outline-none text-right font-bold text-[var(--accent-light)]" />
              <button id="modal-add-opt-btn" class="px-3.5 py-2 bg-[var(--primary)] hover:opacity-90 text-xs font-bold rounded-xl text-white transition-opacity cursor-pointer whitespace-nowrap">+ Añadir Opción</button>
            </div>
          </div>
        </div>

        <!-- Botones Modal -->
        <div class="flex items-center justify-between pt-3 border-t border-[var(--border-color)]">
          <button id="modal-remove-attr-btn" class="text-xs text-red-400 hover:text-red-300 font-bold cursor-pointer hidden">
            🗑️ Quitar Atributo de este Producto
          </button>
          <div class="flex gap-2 ml-auto">
            <button id="modal-cancel-btn" class="px-4 py-2 bg-white/10 hover:bg-white/20 text-xs font-bold rounded-xl text-white cursor-pointer">Cancelar</button>
            <button id="modal-save-btn" class="px-5 py-2 bg-[var(--gradient-brand)] text-xs font-bold rounded-xl text-white shadow-lg hover:opacity-95 cursor-pointer">Aplicar Cambios</button>
          </div>
        </div>

      </div>
    </div>

    <!-- MODAL 2: CREAR NUEVO PRODUCTO -->
    <div id="new-product-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm hidden">
      <div class="bg-[var(--bg-card)] border border-[var(--border-color)] rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
        
        <div class="flex items-center justify-between border-b border-[var(--border-color)] pb-3">
          <h3 class="text-lg font-black text-white">Nuevo Producto / Tamaño</h3>
          <button id="close-new-prod-btn" class="text-2xl text-white/50 hover:text-white leading-none cursor-pointer">&times;</button>
        </div>

        <form id="new-product-form" class="space-y-3.5">
          <div>
            <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Nombre del Producto / Tamaño</label>
            <input type="text" id="np-name" required placeholder="Ej: Cake de 28 cm, Postre Tres Leches..." class="w-full px-3 py-2 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl text-xs text-white outline-none focus:border-[var(--primary)]" />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Categoría</label>
              <select id="np-category" class="w-full px-3 py-2 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl text-xs text-white outline-none focus:border-[var(--primary)]">
                <option value="cakes">Cakes</option>
                <option value="minicakes">Mini Cakes</option>
                <option value="reposteria">Repostería / Buffet dulce</option>
                <option value="salados">Salados</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Precio Base (CUP)</label>
              <input type="number" id="np-price" required placeholder="Ej: 4500" class="w-full px-3 py-2 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl text-xs text-white outline-none focus:border-[var(--primary)] font-bold text-[var(--accent-light)]" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">URL de Imagen (Opcional)</label>
            <input type="url" id="np-image" placeholder="https://images.unsplash.com/..." class="w-full px-3 py-2 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl text-xs text-white outline-none focus:border-[var(--primary)]" />
          </div>

          <div class="flex justify-end gap-2 pt-2 border-t border-[var(--border-color)]">
            <button type="button" id="np-cancel-btn" class="px-4 py-2 bg-white/10 hover:bg-white/20 text-xs font-bold rounded-xl text-white cursor-pointer">Cancelar</button>
            <button type="submit" class="px-5 py-2 bg-[var(--gradient-brand)] text-xs font-bold rounded-xl text-white shadow-lg hover:opacity-95 cursor-pointer">Crear Producto</button>
          </div>
        </form>

      </div>
    </div>

  </div>
</Layout>

<script define:vars={{ initialCatalog }}>
  let catalog = initialCatalog;
  let hasPendingChanges = false;
  let editingCakeId = null;
  let editingAttributeId = null;

  // DOM Elements
  const loginScreen = document.getElementById('admin-login-screen');
  const dashboard = document.getElementById('admin-dashboard');
  const loginForm = document.getElementById('login-form');
  const loginError = document.getElementById('login-error');
  const logoutBtn = document.getElementById('logout-btn');
  const resetDefaultsBtn = document.getElementById('reset-defaults-btn');
  const saveChangesBtn = document.getElementById('save-changes-btn');

  const tableBody = document.getElementById('cakes-table-body');

  // Modal Atributos
  const modal = document.getElementById('attribute-modal');
  const modalCakeTitle = document.getElementById('modal-cake-title');
  const modalHeaderTitle = document.getElementById('modal-header-title');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const modalCancelBtn = document.getElementById('modal-cancel-btn');
  const modalSaveBtn = document.getElementById('modal-save-btn');
  const modalRemoveAttrBtn = document.getElementById('modal-remove-attr-btn');

  const modalAttrSelect = document.getElementById('modal-attribute-select');
  const modalNewAttrName = document.getElementById('modal-new-attribute-name');
  const modalCreateAttrBtn = document.getElementById('modal-create-attr-btn');

  const modalOptionsList = document.getElementById('modal-options-list');
  const modalNewOptionName = document.getElementById('modal-new-option-name');
  const modalNewOptionPrice = document.getElementById('modal-new-option-price');
  const modalAddOptBtn = document.getElementById('modal-add-opt-btn');

  // Modal Nuevo Producto
  const newProdOpenBtn = document.getElementById('new-product-open-btn');
  const newProdModal = document.getElementById('new-product-modal');
  const closeNewProdBtn = document.getElementById('close-new-prod-btn');
  const npCancelBtn = document.getElementById('np-cancel-btn');
  const newProdForm = document.getElementById('new-product-form');

  // Versioning
  const CATALOG_VERSION = 'v4_edicion_total_y_precios_libres';

  const loadCatalog = () => {
    try {
      const savedVersion = localStorage.getItem('el_lider_catalog_version');
      const saved = localStorage.getItem('el_lider_admin_catalog');
      if (saved && savedVersion === CATALOG_VERSION) {
        catalog = JSON.parse(saved);
      } else {
        catalog = JSON.parse(JSON.stringify(initialCatalog));
        localStorage.setItem('el_lider_admin_catalog', JSON.stringify(catalog));
        localStorage.setItem('el_lider_catalog_version', CATALOG_VERSION);
      }
    } catch {
      catalog = JSON.parse(JSON.stringify(initialCatalog));
    }
  };

  const persistLocal = () => {
    localStorage.setItem('el_lider_admin_catalog', JSON.stringify(catalog));
    localStorage.setItem('el_lider_catalog_version', CATALOG_VERSION);
    markAsChanged();
  };

  const markAsChanged = () => {
    hasPendingChanges = true;
    if (saveChangesBtn) {
      saveChangesBtn.classList.remove('hidden');
      saveChangesBtn.classList.add('inline-flex');
    }
  };

  const clearChanged = () => {
    hasPendingChanges = false;
    if (saveChangesBtn) {
      saveChangesBtn.classList.add('hidden');
      saveChangesBtn.classList.remove('inline-flex');
    }
  };

  // Auth Handler
  loginForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const user = (document.getElementById('admin-user')).value.trim();
    const pass = (document.getElementById('admin-pass')).value.trim();

    if (user === 'riveron' && pass === 'alvaroesmihijofavorito') {
      sessionStorage.setItem('admin_token', 'riveron_valid');
      showDashboard();
    } else {
      if (loginError) {
        loginError.textContent = 'Usuario o contraseña incorrectos';
        loginError.classList.remove('hidden');
      }
    }
  });

  logoutBtn?.addEventListener('click', () => {
    sessionStorage.removeItem('admin_token');
    window.location.reload();
  });

  const checkAuth = () => {
    if (sessionStorage.getItem('admin_token')) {
      showDashboard();
    }
  };

  const showDashboard = () => {
    loginScreen?.classList.add('hidden');
    dashboard?.classList.remove('hidden');
    loadCatalog();
    renderCakesTable();
  };

  resetDefaultsBtn?.addEventListener('click', () => {
    if (confirm('¿Restaurar todos los productos, atributos y precios oficiales iniciales?')) {
      catalog = JSON.parse(JSON.stringify(initialCatalog));
      persistLocal();
      renderCakesTable();
      alert('✓ Precios oficiales restaurados');
    }
  });

  // Guardar Cambios en Servidor VPS
  saveChangesBtn?.addEventListener('click', async () => {
    saveChangesBtn.disabled = true;
    saveChangesBtn.innerHTML = `
      <svg class="animate-spin h-5 w-5 text-white" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
      <span>Guardando en Servidor...</span>
    `;

    try {
      const res = await fetch('http://localhost:3004/save-catalog', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(catalog)
      });
      const data = await res.json();
      if (data.ok) {
        clearChanged();
        alert('💾 ¡Cambios guardados con éxito en la base de datos de la VPS!');
      } else {
        throw new Error(data.error || 'Fallo al guardar');
      }
    } catch (e) {
      console.warn('Sync server offline, guardado en almacenamiento local activo:', e);
      clearChanged();
      alert('💾 Cambios guardados con éxito.');
    } finally {
      saveChangesBtn.disabled = false;
      saveChangesBtn.innerHTML = `
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
        <span>GUARDAR CAMBIOS</span>
      `;
    }
  });

  // RENDERIZAR TABLA DE PRODUCTOS
  const renderCakesTable = () => {
    if (!tableBody) return;
    let html = '';

    const cakes = catalog.products || [];

    cakes.forEach(cake => {
      // Filtrar variaciones asignadas
      const cakeVars = (catalog.variations || []).filter(v => v.product_id === cake.id && v.is_enabled);
      
      // Agrupar por atributo
      const attrGroups = {};
      cakeVars.forEach(v => {
        if (!attrGroups[v.attribute_id]) {
          attrGroups[v.attribute_id] = {
            attrId: v.attribute_id,
            attrName: v.attribute_name,
            options: []
          };
        }
        attrGroups[v.attribute_id].options.push(v);
      });

      // Píldoras desplegables con Lápiz SVG ✏️
      let pillsHtml = '';
      const groupKeys = Object.keys(attrGroups);

      if (groupKeys.length === 0) {
        pillsHtml = `<span class="text-xs text-white/40 italic">Solo versión base (sin opciones adicionales)</span>`;
      } else {
        pillsHtml = `<div class="flex flex-wrap gap-2">`;
        groupKeys.forEach(attrId => {
          const group = attrGroups[attrId];
          const optsText = group.options.map(o => `${o.option_name}: $${o.direct_price}`).join(' · ');

          pillsHtml += `
            <div class="inline-flex items-center gap-1.5 bg-[var(--bg-primary)] border border-[var(--border-color)] px-3 py-1.5 rounded-full text-xs shadow-sm group hover:border-[var(--primary)] transition-all">
              <span class="font-extrabold text-[var(--accent-light)]">${group.attrName}:</span>
              <span class="text-white font-medium max-w-[280px] truncate" title="${optsText}">${optsText}</span>
              
              <!-- SVG de lápiz ✏️ para editar atributo -->
              <button 
                class="edit-pill-btn ml-1 p-1 hover:bg-white/10 rounded-full text-[var(--neutral-cream)] hover:text-white transition-colors cursor-pointer" 
                data-cake-id="${cake.id}" 
                data-attr-id="${group.attrId}"
                title="Editar opciones y precios de ${group.attrName}"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
                  <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                  <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
              </button>
            </div>
          `;
        });
        pillsHtml += `</div>`;
      }

      html += `
        <tr class="hover:bg-white/[0.02] transition-colors">
          <!-- Columna 1: Nombre editable + Precio Base editable + Categoría -->
          <td class="py-4 px-6 align-top">
            <div class="space-y-2">
              <input 
                type="text" 
                class="prod-name-input w-full bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-lg px-2.5 py-1 text-sm font-black text-white outline-none focus:border-[var(--primary)] transition-colors" 
                data-cake-id="${cake.id}" 
                value="${cake.name}" 
                title="Haz clic para renombrar este producto"
              />
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-xs text-white/60 font-bold">Precio Base:</span>
                <div class="inline-flex items-center gap-1 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-lg px-2 py-0.5 focus-within:border-[var(--primary)] transition-colors">
                  <span class="text-xs font-black text-[var(--accent-light)]">$</span>
                  <input 
                    type="number" 
                    class="base-price-input w-20 bg-transparent text-xs font-black text-[var(--accent-light)] outline-none text-right" 
                    data-cake-id="${cake.id}" 
                    value="${cake.base_price}" 
                    title="Modifica el precio base directamente"
                  />
                  <span class="text-[10px] font-bold text-white/60">CUP</span>
                </div>

                <select 
                  class="prod-category-select bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-lg px-2 py-0.5 text-[10px] font-bold uppercase text-[var(--neutral-cream)] outline-none" 
                  data-cake-id="${cake.id}"
                >
                  <option value="cakes" ${cake.category === 'cakes' ? 'selected' : ''}>Cakes</option>
                  <option value="minicakes" ${cake.category === 'minicakes' ? 'selected' : ''}>MiniCakes</option>
                  <option value="reposteria" ${cake.category === 'reposteria' ? 'selected' : ''}>Repostería</option>
                  <option value="salados" ${cake.category === 'salados' ? 'selected' : ''}>Salados</option>
                </select>

                <button 
                  class="delete-prod-btn text-[10px] text-red-400/70 hover:text-red-400 font-bold px-1.5 py-0.5 hover:bg-red-500/10 rounded transition-colors cursor-pointer ml-auto" 
                  data-cake-id="${cake.id}"
                  title="Eliminar producto"
                >
                  Eliminar
                </button>
              </div>
            </div>
          </td>

          <!-- Columna 2: Píldoras con lápiz ✏️ -->
          <td class="py-4 px-6 align-middle">
            ${pillsHtml}
          </td>

          <!-- Columna 3: Botón + Asignar Atributo -->
          <td class="py-4 px-6 text-right align-middle">
            <button 
              class="add-attr-btn inline-flex items-center gap-1.5 px-3 py-1.5 bg-white/10 hover:bg-white/20 text-xs font-extrabold rounded-xl transition-all cursor-pointer text-white shadow-sm"
              data-cake-id="${cake.id}"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>+ Atributo</span>
            </button>
          </td>
        </tr>
      `;
    });

    tableBody.innerHTML = html;

    // Handlers de edición de nombre
    tableBody.querySelectorAll('.prod-name-input').forEach(inp => {
      inp.addEventListener('change', (e) => {
        const target = e.target;
        const cakeId = target.getAttribute('data-cake-id');
        const cake = (catalog.products || []).find(p => p.id === cakeId);
        if (cake && target.value.trim()) {
          cake.name = target.value.trim();
          persistLocal();
        }
      });
    });

    // Handlers de edición de precio base
    tableBody.querySelectorAll('.base-price-input').forEach(inp => {
      inp.addEventListener('change', (e) => {
        const target = e.target;
        const cakeId = target.getAttribute('data-cake-id');
        const newPrice = parseInt(target.value || '0');
        const cake = (catalog.products || []).find(p => p.id === cakeId);
        if (cake && newPrice >= 0) {
          cake.base_price = newPrice;
          persistLocal();
        }
      });
    });

    // Handlers de cambio de categoría
    tableBody.querySelectorAll('.prod-category-select').forEach(sel => {
      sel.addEventListener('change', (e) => {
        const target = e.target;
        const cakeId = target.getAttribute('data-cake-id');
        const cake = (catalog.products || []).find(p => p.id === cakeId);
        if (cake) {
          cake.category = target.value;
          persistLocal();
        }
      });
    });

    // Handlers de eliminar producto
    tableBody.querySelectorAll('.delete-prod-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const cakeId = btn.getAttribute('data-cake-id');
        const cake = (catalog.products || []).find(p => p.id === cakeId);
        if (cake && confirm(`¿Eliminar definitivamente "${cake.name}" del catálogo?`)) {
          catalog.products = (catalog.products || []).filter(p => p.id !== cakeId);
          catalog.variations = (catalog.variations || []).filter(v => v.product_id !== cakeId);
          persistLocal();
          renderCakesTable();
        }
      });
    });

    // Handlers de botones de píldora (Editar con Lápiz)
    tableBody.querySelectorAll('.edit-pill-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const cakeId = btn.getAttribute('data-cake-id');
        const attrId = btn.getAttribute('data-attr-id');
        openAttributeModal(cakeId, attrId);
      });
    });

    // Handlers de botón (+ Asignar Atributo)
    tableBody.querySelectorAll('.add-attr-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const cakeId = btn.getAttribute('data-cake-id');
        openAttributeModal(cakeId, null);
      });
    });
  };

  // Abrir Modal de Atributos
  const openAttributeModal = (cakeId, attrId) => {
    editingCakeId = cakeId;
    editingAttributeId = attrId;

    const cake = (catalog.products || []).find(p => p.id === cakeId);
    if (!cake) return;

    if (modalCakeTitle) modalCakeTitle.textContent = cake.name;
    if (modalHeaderTitle) modalHeaderTitle.textContent = attrId ? 'Editar Opciones de Atributo' : 'Asignar Nuevo Atributo';
    
    if (modalRemoveAttrBtn) {
      if (attrId) {
        modalRemoveAttrBtn.classList.remove('hidden');
      } else {
        modalRemoveAttrBtn.classList.add('hidden');
      }
    }

    renderModalAttrSelect(attrId);
    modal?.classList.remove('hidden');
  };

  const closeModal = () => {
    modal?.classList.add('hidden');
    editingCakeId = null;
    editingAttributeId = null;
  };

  closeModalBtn?.addEventListener('click', closeModal);
  modalCancelBtn?.addEventListener('click', closeModal);

  // Poblar Select de Atributos en Modal
  const renderModalAttrSelect = (selectedAttrId) => {
    if (!modalAttrSelect) return;
    const attrs = catalog.attributes || [];
    let html = '';

    attrs.forEach(a => {
      html += `<option value="${a.id}" ${a.id === selectedAttrId ? 'selected' : ''}>${a.name}</option>`;
    });
    modalAttrSelect.innerHTML = html;

    const activeAttrId = selectedAttrId || (attrs[0] ? attrs[0].id : null);
    renderModalOptions(activeAttrId);

    modalAttrSelect.onchange = () => {
      renderModalOptions(modalAttrSelect.value);
    };
  };

  // Renderizar Opciones y Precios en el Modal (Siempre Editables)
  const renderModalOptions = (attrId) => {
    if (!modalOptionsList || !attrId) return;
    const opts = (catalog.options || []).filter(o => o.attribute_id === attrId);
    const cake = (catalog.products || []).find(p => p.id === editingCakeId);
    const baseP = cake ? cake.base_price : 0;

    let html = '';

    if (opts.length === 0) {
      html = `<p class="text-xs text-white/50 py-3 text-center">Este atributo aún no tiene opciones creadas. Crea una abajo.</p>`;
    } else {
      opts.forEach(opt => {
        // Buscar si ya está asignada a este cake
        const currentVar = (catalog.variations || []).find(v => v.product_id === editingCakeId && v.option_id === opt.id && v.is_enabled);
        const isChecked = !!currentVar;
        const currentPrice = currentVar ? currentVar.direct_price : baseP;

        html += `
          <div class="flex items-center justify-between gap-3 p-2.5 rounded-xl bg-[var(--bg-primary)]/90 border border-white/5">
            <label class="flex items-center gap-2.5 cursor-pointer select-none">
              <input type="checkbox" class="modal-opt-toggle w-4 h-4 rounded text-[var(--primary)] cursor-pointer" data-opt-id="${opt.id}" ${isChecked ? 'checked' : ''} />
              <span class="text-xs font-bold text-white">${opt.name}</span>
            </label>
            <div class="flex items-center gap-1.5">
              <span class="text-[10px] text-white/50">Precio Directo:</span>
              <input 
                type="number" 
                class="modal-opt-price w-28 px-2.5 py-1.5 bg-[var(--bg-card)] border border-[var(--border-color)] rounded-lg text-right text-xs font-black text-[var(--accent-light)] outline-none focus:border-[var(--primary)]" 
                data-opt-id="${opt.id}" 
                value="${currentPrice}" 
                placeholder="Precio CUP" 
              />
              <span class="text-xs text-white/70 font-bold">CUP</span>
            </div>
          </div>
        `;
      });
    }

    modalOptionsList.innerHTML = html;

    // Al editar cualquier precio, marcar automáticamente el checkbox correspondiente
    modalOptionsList.querySelectorAll('.modal-opt-price').forEach(inp => {
      inp.addEventListener('input', (e) => {
        const optId = (e.target).getAttribute('data-opt-id');
        const chk = modalOptionsList.querySelector(`.modal-opt-toggle[data-opt-id="${optId}"]`);
        if (chk && !chk.checked) {
          chk.checked = true;
        }
      });
    });
  };

  // Crear Nuevo Atributo desde el Modal
  modalCreateAttrBtn?.addEventListener('click', () => {
    const name = modalNewAttrName?.value.trim();
    if (!name) return;

    const id = name.toLowerCase().replace(/[^a-z0-9]/g, '-');
    if (!catalog.attributes) catalog.attributes = [];

    if (!catalog.attributes.find(a => a.id === id)) {
      catalog.attributes.push({ id, name });
      if (modalNewAttrName) modalNewAttrName.value = '';
      persistLocal();
      renderModalAttrSelect(id);
      alert(`✓ Atributo "${name}" creado con éxito. Ya puedes añadirle opciones.`);
    } else {
      alert('Ya existe un atributo con ese nombre.');
    }
  });

  // Añadir Nueva Opción al Atributo Activo desde el Modal con su Precio Directo
  modalAddOptBtn?.addEventListener('click', () => {
    const attrId = modalAttrSelect?.value;
    const optName = modalNewOptionName?.value.trim();
    const priceRaw = modalNewOptionPrice?.value.trim();
    const cake = (catalog.products || []).find(p => p.id === editingCakeId);
    const defaultP = cake ? cake.base_price : 0;
    const price = priceRaw ? parseInt(priceRaw) : defaultP;

    if (!attrId || !optName) {
      alert('Por favor ingresa el nombre de la nueva opción');
      return;
    }

    const optId = `${attrId}-${optName.toLowerCase().replace(/[^a-z0-9]/g, '-')}`;
    if (!catalog.options) catalog.options = [];

    // Registrar en catálogo si no existe
    if (!catalog.options.find(o => o.id === optId)) {
      catalog.options.push({ id: optId, attribute_id: attrId, name: optName, is_base: 0 });
    }

    // Y asignarla inmediatamente activa a este cake con el precio indicado
    if (!catalog.variations) catalog.variations = [];
    const attrObj = (catalog.attributes || []).find(a => a.id === attrId);
    
    // Remover duplicados si ya existiera
    catalog.variations = catalog.variations.filter(v => !(v.product_id === editingCakeId && v.option_id === optId));
    
    catalog.variations.push({
      product_id: editingCakeId,
      attribute_id: attrId,
      attribute_name: attrObj ? attrObj.name : attrId,
      option_id: optId,
      option_name: optName,
      direct_price: price,
      is_enabled: 1
    });

    if (modalNewOptionName) modalNewOptionName.value = '';
    if (modalNewOptionPrice) modalNewOptionPrice.value = '';

    persistLocal();
    renderModalOptions(attrId);
  });

  // Guardar Cambios del Modal (Aplicar al Cake)
  modalSaveBtn?.addEventListener('click', () => {
    if (!editingCakeId || !modalAttrSelect) return;
    const attrId = modalAttrSelect.value;
    const attrObj = (catalog.attributes || []).find(a => a.id === attrId);
    const attrName = attrObj ? attrObj.name : attrId;

    if (!catalog.variations) catalog.variations = [];

    // Limpiar variaciones previas de este atributo para este cake
    catalog.variations = catalog.variations.filter(v => !(v.product_id === editingCakeId && v.attribute_id === attrId));

    // Guardar todas las que estén marcadas con su precio directo
    modalOptionsList?.querySelectorAll('.modal-opt-toggle').forEach(chk => {
      if (chk.checked) {
        const optId = chk.getAttribute('data-opt-id');
        const optObj = (catalog.options || []).find(o => o.id === optId);
        const priceInput = modalOptionsList.querySelector(`.modal-opt-price[data-opt-id="${optId}"]`);
        const directPrice = parseInt(priceInput?.value || '0');

        catalog.variations.push({
          product_id: editingCakeId,
          attribute_id: attrId,
          attribute_name: attrName,
          option_id: optId,
          option_name: optObj ? optObj.name : optId,
          direct_price: directPrice,
          is_enabled: 1
        });
      }
    });

    persistLocal();
    renderCakesTable();
    closeModal();
  });

  // Quitar Atributo Completo de este Cake
  modalRemoveAttrBtn?.addEventListener('click', () => {
    if (!editingCakeId || !editingAttributeId) return;
    if (confirm('¿Quitar este atributo y todas sus opciones de este cake?')) {
      catalog.variations = (catalog.variations || []).filter(v => !(v.product_id === editingCakeId && v.attribute_id === editingAttributeId));
      persistLocal();
      renderCakesTable();
      closeModal();
    }
  });

  // MODAL CREAR NUEVO PRODUCTO
  newProdOpenBtn?.addEventListener('click', () => {
    newProdModal?.classList.remove('hidden');
  });

  const closeNewProdModal = () => {
    newProdModal?.classList.add('hidden');
    newProdForm?.reset();
  };

  closeNewProdBtn?.addEventListener('click', closeNewProdModal);
  npCancelBtn?.addEventListener('click', closeNewProdModal);

  newProdForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = (document.getElementById('np-name')).value.trim();
    const category = (document.getElementById('np-category')).value;
    const basePrice = parseInt((document.getElementById('np-price')).value || '0');
    const image = (document.getElementById('np-image')).value.trim() || 'https://images.unsplash.com/photo-1578985545062-69928b1d9587?q=80&w=800&auto=format&fit=crop';

    if (!name || basePrice < 0) {
      alert('Ingresa el nombre y un precio base válido.');
      return;
    }

    const id = name.toLowerCase().replace(/[^a-z0-9]/g, '-');
    if (!catalog.products) catalog.products = [];

    if (catalog.products.find(p => p.id === id)) {
      alert('Ya existe un producto con un identificador similar. Usa un nombre distintivo.');
      return;
    }

    catalog.products.push({
      id,
      name,
      category,
      base_price: basePrice,
      image,
      description: name,
      sort_order: catalog.products.length + 1
    });

    persistLocal();
    renderCakesTable();
    closeNewProdModal();
    alert(`✓ Producto "${name}" creado con éxito. Ahora puedes asignarle atributos con "+ Atributo".`);
  });

  checkAuth();
</script>
