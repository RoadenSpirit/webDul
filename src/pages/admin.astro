---
import Layout from '../layouts/Layout.astro';
import { PRODUCTS } from '../data/products';
import { PRODUCT_RULES } from '../data/rules';

const initialProducts = PRODUCTS;
const initialRules = PRODUCT_RULES;
---

<Layout title="Panel Administrativo — Dulcería El Líder">
  <!-- Pantalla de Login -->
  <div id="admin-login-screen" class="min-h-screen bg-[var(--bg-primary)] flex items-center justify-center p-4">
    <div class="bg-[var(--bg-card)] border border-[var(--border-color)] rounded-2xl p-8 max-w-md w-full shadow-xl text-center space-y-6">
      <div class="w-20 h-20 mx-auto rounded-full p-1 bg-gradient-to-tr from-[var(--primary)] to-[var(--accent)]">
        <img src="/logo-correcto.png" alt="Logo" class="w-full h-full object-cover rounded-full" />
      </div>
      <div>
        <h1 class="text-2xl font-black text-white font-[var(--font-display)]">Acceso Administrativo</h1>
        <p class="text-xs text-[var(--neutral-cream)] mt-1">Gestión de Catálogo y Matriz de Precios</p>
      </div>

      <form id="login-form" class="space-y-4 text-left">
        <div>
          <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Usuario</label>
          <input type="text" id="admin-user" required class="w-full px-4 py-2.5 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl text-white outline-none focus:border-[var(--primary)]" />
        </div>
        <div>
          <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Contraseña</label>
          <input type="password" id="admin-pass" required class="w-full px-4 py-2.5 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl text-white outline-none focus:border-[var(--primary)]" />
        </div>
        <p id="login-error" class="text-xs text-red-400 font-bold hidden"></p>
        <button type="submit" class="w-full py-3 bg-[var(--gradient-brand)] text-white font-bold rounded-xl shadow-lg hover:opacity-95 transition-all cursor-pointer">
          Iniciar Sesión
        </button>
      </form>
    </div>
  </div>

  <!-- Panel Principal (2 Columnas) -->
  <div id="admin-dashboard" class="hidden min-h-screen bg-[var(--bg-primary)] text-white">
    <!-- Header Admin -->
    <header class="bg-[var(--bg-secondary)] border-b border-[var(--border-color)] px-6 py-4 flex items-center justify-between sticky top-0 z-30">
      <div class="flex items-center gap-3">
        <img src="/logo-correcto.png" alt="Logo" class="w-10 h-10 rounded-full border border-white/20" />
        <div>
          <h2 class="text-lg font-black font-[var(--font-display)]">Dulcería El Líder · Admin</h2>
          <span class="text-xs text-[var(--accent-light)] font-semibold">Matriz Interactiva de Precios</span>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <button id="reset-defaults-btn" class="text-xs bg-red-500/20 text-red-300 hover:bg-red-500/30 px-3 py-1.5 rounded-lg font-bold transition-colors cursor-pointer" title="Restaura la lista de precios oficial inicial">Restaurar Precios Oficiales</button>
        <a href="/" target="_blank" class="text-xs bg-white/10 hover:bg-white/20 px-3 py-1.5 rounded-lg font-bold transition-colors">Ver Web Pública ↗</a>
        <button id="logout-btn" class="text-xs text-red-400 hover:text-red-300 font-bold cursor-pointer">Cerrar Sesión</button>
      </div>
    </header>

    <!-- Contenido en 2 Columnas -->
    <div class="max-w-7xl mx-auto p-6 grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Columna Izquierda: Lista de Productos y Tamaños (4 cols) -->
      <aside class="lg:col-span-4 space-y-4">
        <div class="bg-[var(--bg-card)] border border-[var(--border-color)] rounded-2xl p-5 shadow-sm">
          <h3 class="text-sm font-black uppercase tracking-wider text-[var(--accent-light)] mb-3">1. Productos &amp; Tamaños</h3>
          <div id="product-list" class="space-y-2 max-h-[70vh] overflow-y-auto pr-1">
            <!-- Inyectado por JS -->
          </div>
        </div>
      </aside>

      <!-- Columna Derecha: Matriz Interactiva de Atributos del Producto (8 cols) -->
      <main class="lg:col-span-8 space-y-6">
        <div class="bg-[var(--bg-card)] border border-[var(--border-color)] rounded-2xl p-6 shadow-sm space-y-6">
          <div class="flex items-start justify-between border-b border-[var(--border-color)] pb-4 flex-wrap gap-4">
            <div>
              <span id="selected-product-category" class="text-xs font-bold uppercase tracking-wider text-[var(--accent-light)]">Categoría</span>
              <h2 id="selected-product-name" class="text-2xl font-black text-white mt-0.5">Selecciona un producto</h2>
            </div>
            <div class="text-right">
              <label class="block text-xs text-[var(--text-secondary)] font-bold">Precio Base (CUP)</label>
              <div class="flex items-center gap-2 mt-1">
                <input type="number" id="selected-product-base-price" class="w-28 px-3 py-1.5 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-lg text-right font-black text-lg text-[var(--accent-light)] outline-none" />
                <button id="save-base-price-btn" class="px-3 py-1.5 bg-[var(--primary)] hover:opacity-90 text-xs font-bold rounded-lg transition-all cursor-pointer">Guardar</button>
              </div>
            </div>
          </div>

          <!-- Matriz de Variaciones Habilitadas -->
          <div>
            <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
              <h3 class="text-base font-bold text-white flex items-center gap-2">
                <span>⚙️ Opciones &amp; Atributos Asignables</span>
              </h3>
              <span class="text-xs text-[var(--neutral-cream)]/70">Solo las opciones activas se habilitarán al cliente en el encargo</span>
            </div>

            <div id="variations-matrix" class="space-y-4">
              <!-- Inyectado por JS -->
            </div>
          </div>

          <!-- Añadir nueva opción personalizada -->
          <div class="border-t border-[var(--border-color)] pt-4">
            <h4 class="text-xs font-bold uppercase tracking-wider text-[var(--accent-light)] mb-3">➕ Añadir Nueva Opción de Masa para este Cake</h4>
            <div class="flex gap-2 flex-wrap sm:flex-nowrap">
              <input type="text" id="new-dough-label" placeholder="Nombre de la opción (ej: Masa Marmoleada, Chocolate...)" class="flex-1 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl px-3 py-2 text-xs text-white outline-none" />
              <input type="number" id="new-dough-price" placeholder="Precio CUP" class="w-28 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl px-3 py-2 text-xs text-white outline-none text-right" />
              <button id="add-dough-btn" class="px-4 py-2 bg-[var(--gradient-brand)] text-xs font-bold rounded-xl text-white shadow-md cursor-pointer whitespace-nowrap">Añadir Opción</button>
            </div>
          </div>

        </div>
      </main>

    </div>
  </div>
</Layout>

<script define:vars={{ initialProducts, initialRules }}>
  let products = [];
  let rules = {};
  let currentProduct = null;

  const loginScreen = document.getElementById('admin-login-screen');
  const dashboard = document.getElementById('admin-dashboard');
  const loginForm = document.getElementById('login-form');
  const loginError = document.getElementById('login-error');
  const logoutBtn = document.getElementById('logout-btn');
  const resetDefaultsBtn = document.getElementById('reset-defaults-btn');

  const productList = document.getElementById('product-list');
  const selectedName = document.getElementById('selected-product-name');
  const selectedCategory = document.getElementById('selected-product-category');
  const selectedBasePrice = document.getElementById('selected-product-base-price');
  const saveBasePriceBtn = document.getElementById('save-base-price-btn');
  const variationsMatrix = document.getElementById('variations-matrix');

  const newDoughLabel = document.getElementById('new-dough-label');
  const newDoughPrice = document.getElementById('new-dough-price');
  const addDoughBtn = document.getElementById('add-dough-btn');

  // Inicializar almacenamiento local
  const loadData = () => {
    try {
      const savedProducts = localStorage.getItem('el_lider_admin_products');
      products = savedProducts ? JSON.parse(savedProducts) : initialProducts;
      
      const savedRules = localStorage.getItem('el_lider_admin_rules');
      rules = savedRules ? JSON.parse(savedRules) : initialRules;
    } catch (e) {
      products = initialProducts;
      rules = initialRules;
    }
  };

  const saveData = () => {
    localStorage.setItem('el_lider_admin_products', JSON.stringify(products));
    localStorage.setItem('el_lider_admin_rules', JSON.stringify(rules));
  };

  // Login handler
  loginForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const username = document.getElementById('admin-user')?.value.trim();
    const password = document.getElementById('admin-pass')?.value.trim();

    if (username === 'riveron' && password === 'alvaroesmihijofavorito') {
      sessionStorage.setItem('admin_token', 'auth_riveron_session_token');
      showDashboard();
    } else {
      if (loginError) {
        loginError.textContent = 'Usuario o contraseña incorrectos';
        loginError.classList.remove('hidden');
      }
    }
  });

  logoutBtn?.addEventListener('click', () => {
    sessionStorage.removeItem('admin_token');
    window.location.reload();
  });

  resetDefaultsBtn?.addEventListener('click', () => {
    if (confirm('¿Deseas restaurar todos los precios oficiales exactos iniciales?')) {
      products = initialProducts;
      rules = initialRules;
      saveData();
      renderProductList();
      if (currentProduct) {
        selectProduct(products.find(p => p.id === currentProduct.id) || products[0]);
      }
      alert('✓ Precios oficiales restaurados');
    }
  });

  const checkAuth = () => {
    if (sessionStorage.getItem('admin_token')) {
      showDashboard();
    }
  };

  const showDashboard = () => {
    loginScreen?.classList.add('hidden');
    dashboard?.classList.remove('hidden');
    loadData();
    renderProductList();
    if (products.length > 0) {
      selectProduct(products[0]);
    }
  };

  const renderProductList = () => {
    if (!productList) return;
    let html = '';
    products.forEach(p => {
      const isSelected = currentProduct && currentProduct.id === p.id;
      const rule = rules[p.id];
      const doughCount = rule?.allowedDoughs?.length || 0;
      html += `
        <div class="p-3 rounded-xl cursor-pointer transition-all border ${isSelected ? 'bg-[var(--bg-secondary)] border-[var(--primary)] shadow-md' : 'bg-[var(--bg-primary)]/60 border-transparent hover:border-white/10'}" data-id="${p.id}">
          <div class="flex justify-between items-start">
            <h4 class="font-bold text-sm text-white">${p.name}</h4>
            <span class="text-xs font-black text-[var(--accent-light)]">$${p.price} CUP</span>
          </div>
          <div class="flex items-center gap-2 mt-2 text-[10px] text-white/60">
            <span class="uppercase font-bold tracking-wider">${p.category}</span>
            <span>•</span>
            <span class="text-[var(--primary)] font-semibold">${doughCount > 0 ? doughCount + ' masas activas' : 'Precio fijo unitario'}</span>
          </div>
        </div>
      `;
    });
    productList.innerHTML = html;

    productList.querySelectorAll('[data-id]').forEach(el => {
      el.addEventListener('click', () => {
        const id = el.getAttribute('data-id');
        const found = products.find(p => p.id === id);
        if (found) selectProduct(found);
      });
    });
  };

  const selectProduct = (prod) => {
    currentProduct = prod;
    renderProductList();

    if (selectedName) selectedName.textContent = prod.name;
    if (selectedCategory) selectedCategory.textContent = prod.category;
    if (selectedBasePrice) selectedBasePrice.value = prod.price;

    renderVariationsMatrix();
  };

  saveBasePriceBtn?.addEventListener('click', () => {
    if (!currentProduct || !selectedBasePrice) return;
    const basePrice = parseInt(selectedBasePrice.value || '0');
    currentProduct.price = basePrice;
    
    if (rules[currentProduct.id]) {
      rules[currentProduct.id].basePrice = basePrice;
    }
    
    saveData();
    renderProductList();
    alert('✓ Precio base guardado');
  });

  const renderVariationsMatrix = () => {
    if (!variationsMatrix || !currentProduct) return;
    
    const rule = rules[currentProduct.id];
    let html = '';

    if (!rule) {
      html = `
        <div class="bg-[var(--bg-primary)] border border-[var(--border-color)]/60 rounded-xl p-5 text-center text-xs text-[var(--neutral-cream)]/70">
          Este producto es un buffet o postre unitario sin variaciones de masa. Su valor se gestiona directamente desde el precio base superior ($${currentProduct.price} CUP).
        </div>
      `;
      variationsMatrix.innerHTML = html;
      return;
    }

    // 1. Masas
    html += `
      <div class="bg-[var(--bg-primary)] border border-[var(--border-color)]/60 rounded-xl p-4 space-y-3">
        <h4 class="text-xs font-black uppercase tracking-wider text-[var(--accent-light)]">1. Masas Permitidas para este Cake</h4>
        <div class="space-y-2">
    `;

    const commonDoughs = [
      { id: 'trigo', label: 'Harina de trigo' },
      { id: 'maicena', label: 'Masa de Maicena' },
      { id: 'capuchino', label: 'Masa Capuchino' }
    ];

    commonDoughs.forEach(d => {
      const activeObj = rule.allowedDoughs?.find(item => item.id === d.id);
      const isEnabled = !!activeObj;
      const currentPrice = activeObj ? activeObj.price : currentProduct.price;

      html += `
        <div class="flex items-center justify-between gap-4 p-2.5 rounded-lg bg-[var(--bg-card)]/50 border border-white/5">
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" class="dough-toggle w-4 h-4 rounded text-[var(--primary)] focus:ring-[var(--primary)]" data-dough-id="${d.id}" ${isEnabled ? 'checked' : ''} />
            <span class="text-sm font-semibold text-white">${d.label}</span>
          </label>
          <div class="flex items-center gap-2">
            <span class="text-xs text-white/50">Precio total:</span>
            <input type="number" class="dough-price-input w-24 px-2 py-1 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded text-right text-xs font-bold text-white outline-none" data-dough-id="${d.id}" value="${currentPrice}" ${!isEnabled ? 'disabled' : ''} />
            <span class="text-xs text-[var(--accent-light)] font-bold">CUP</span>
            <button class="save-dough-btn px-2.5 py-1 bg-white/10 hover:bg-white/20 text-[10px] font-bold rounded transition-colors cursor-pointer" data-dough-id="${d.id}" data-dough-label="${d.label}">Guardar</button>
          </div>
        </div>
      `;
    });

    html += `</div></div>`;

    // 2. Altura / Doble
    const hasDouble = rule.hasDouble !== undefined ? rule.hasDouble : (rule.allowedHeights && rule.allowedHeights.length > 1);
    const doublePrice = rule.doublePrice || (rule.allowedHeights?.find(h => h.id === 'doble')?.price || 2700);

    html += `
      <div class="bg-[var(--bg-primary)] border border-[var(--border-color)]/60 rounded-xl p-4 space-y-3">
        <h4 class="text-xs font-black uppercase tracking-wider text-[var(--accent-light)]">2. Altura y Doble Masa</h4>
        <div class="flex items-center justify-between gap-4 p-2.5 rounded-lg bg-[var(--bg-card)]/50 border border-white/5">
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" id="double-toggle" class="w-4 h-4 rounded text-[var(--primary)] focus:ring-[var(--primary)]" ${hasDouble ? 'checked' : ''} />
            <span class="text-sm font-semibold text-white">Habilitar Opción Cake Doble</span>
          </label>
          <div class="flex items-center gap-2">
            <span class="text-xs text-white/50">Recargo Doble:</span>
            <input type="number" id="double-price-input" class="w-24 px-2 py-1 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded text-right text-xs font-bold text-white outline-none" value="${doublePrice}" ${!hasDouble ? 'disabled' : ''} />
            <span class="text-xs text-[var(--accent-light)] font-bold">CUP</span>
            <button id="save-double-btn" class="px-2.5 py-1 bg-white/10 hover:bg-white/20 text-[10px] font-bold rounded transition-colors cursor-pointer">Guardar</button>
          </div>
        </div>
      </div>
    `;

    variationsMatrix.innerHTML = html;

    // Handlers
    variationsMatrix.querySelectorAll('.dough-toggle').forEach(chk => {
      chk.addEventListener('change', (e) => {
        const target = e.target;
        const doughId = target.getAttribute('data-dough-id');
        const priceInput = variationsMatrix.querySelector(`.dough-price-input[data-dough-id="${doughId}"]`);
        if (priceInput) priceInput.disabled = !target.checked;
      });
    });

    variationsMatrix.querySelectorAll('.save-dough-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const doughId = btn.getAttribute('data-dough-id');
        const doughLabel = btn.getAttribute('data-dough-label');
        const chk = variationsMatrix.querySelector(`.dough-toggle[data-dough-id="${doughId}"]`);
        const priceInput = variationsMatrix.querySelector(`.dough-price-input[data-dough-id="${doughId}"]`);
        
        if (!rule.allowedDoughs) rule.allowedDoughs = [];

        if (chk?.checked) {
          const price = parseInt(priceInput?.value || currentProduct.price.toString());
          const existing = rule.allowedDoughs.find(d => d.id === doughId);
          if (existing) {
            existing.price = price;
            existing.label = `${doughLabel} ($${price} CUP)`;
          } else {
            rule.allowedDoughs.push({ id: doughId, label: `${doughLabel} ($${price} CUP)`, price });
          }
        } else {
          rule.allowedDoughs = rule.allowedDoughs.filter(d => d.id !== doughId);
        }

        saveData();
        renderProductList();
        alert('✓ Configuración de masa guardada');
      });
    });

    const doubleToggle = document.getElementById('double-toggle');
    const doublePriceInput = document.getElementById('double-price-input');
    const saveDoubleBtn = document.getElementById('save-double-btn');

    doubleToggle?.addEventListener('change', () => {
      if (doublePriceInput) doublePriceInput.disabled = !doubleToggle.checked;
    });

    saveDoubleBtn?.addEventListener('click', () => {
      rule.hasDouble = doubleToggle?.checked || false;
      rule.doublePrice = parseInt(doublePriceInput?.value || '2700');
      saveData();
      alert('✓ Configuración de altura guardada');
    });
  };

  addDoughBtn?.addEventListener('click', () => {
    if (!currentProduct || !rules[currentProduct.id]) {
      alert('Selecciona un cake primero');
      return;
    }
    const label = newDoughLabel?.value.trim();
    const price = parseInt(newDoughPrice?.value || '0');

    if (!label || !price) {
      alert('Por favor ingresa nombre y precio para la nueva masa');
      return;
    }

    const newId = label.toLowerCase().replace(/[^a-z0-9]/g, '-');
    const rule = rules[currentProduct.id];
    if (!rule.allowedDoughs) rule.allowedDoughs = [];

    rule.allowedDoughs.push({
      id: newId,
      label: `${label} ($${price} CUP)`,
      price
    });

    saveData();
    if (newDoughLabel) newDoughLabel.value = '';
    if (newDoughPrice) newDoughPrice.value = '';
    renderVariationsMatrix();
    alert('✓ Nueva opción añadida al cake con éxito');
  });

  checkAuth();
</script>
