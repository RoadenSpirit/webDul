---
import Layout from '../layouts/Layout.astro';
import catalogData from '../../data/catalog.json';

const initialCatalog = catalogData;
---

.Layout title="Panel Administrativo — Dulcería El Líder" hideFooter={true}>
  <!-- 1. Pantalla de Login -->
  <div id="admin-login-screen" class="min-h-screen bg-[var(--bg-primary)] flex items-center justify-center p-4">
    <div class="bg-[var(--bg-card)] border border-[var(--border-color)] rounded-2xl p-8 max-w-md w-full shadow-2xl text-center space-y-6">
      <div class="w-20 h-20 mx-auto rounded-full p-1 bg-gradient-to-tr from-[var(--primary)] to-[var(--accent)] shadow-lg">
        <img src="/logo-correcto.png" alt="Logo" class="w-full h-full object-cover rounded-full" />
      </div>
      <div>
        <h1 class="text-2xl font-black text-white font-[var(--font-display)]">Acceso Administrativo</h1>
        <p class="text-xs text-[var(--neutral-cream)] mt-1">Gestión Total de Productos y Opciones</p>
      </div>

      <form id="login-form" class="space-y-4 text-left">
        <div>
          <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Usuario</label>
          <input type="text" id="admin-user" required class="w-full px-4 py-2.5 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl text-white outline-none focus:border-[var(--primary)]" />
        </div>
        <div>
          <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Contraseña</label>
          <input type="password" id="admin-pass" required class="w-full px-4 py-2.5 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl text-white outline-none focus:border-[var(--primary)]" />
        </div>
        <p id="login-error" class="text-xs text-red-400 font-bold hidden"></p>
        <button type="submit" class="w-full py-3 bg-[var(--gradient-brand)] text-white font-bold rounded-xl shadow-lg hover:opacity-95 transition-all cursor-pointer">
          Iniciar Sesión
        </button>
      </form>
    </div>
  </div>

  <!-- 2. Dashboard con Edición Total -->
  <div id="admin-dashboard" class="hidden min-h-screen bg-[var(--bg-primary)] text-white pb-24">
    
    <!-- Barra Superior Sticky con Disquete 💾 de Guardado -->
    <header class="bg-[var(--bg-secondary)] border-b border-[var(--border-color)] px-4 sm:px-6 py-3.5 sticky top-0 z-40 shadow-md">
      <div class="max-w-7xl mx-auto flex items-center justify-between gap-4 flex-wrap">
        <div class="flex items-center gap-3">
          <img src="/logo-correcto.png" alt="Logo" class="w-10 h-10 rounded-full border border-white/20" />
          <div>
            <h2 class="text-base sm:text-lg font-black font-[var(--font-display)]">Dulcería El Líder · Panel Total</h2>
            <span class="text-[11px] text-[var(--accent-light)] font-semibold">Edición completa de productos y opciones</span>
          </div>
        </div>

        <!-- Indicador & Botón de Guardar con Disquete 💾 -->
        <div class="flex items-center gap-3 flex-wrap">
          <button 
            id="save-changes-btn" 
            class="hidden items-center gap-2.5 px-5 py-2.5 bg-gradient-to-r from-emerald-500 to-green-600 hover:from-emerald-400 hover:to-green-500 text-white font-extrabold text-sm rounded-xl shadow-xl transition-all animate-pulse cursor-pointer border border-emerald-300/40"
            title="Guardar todos los cambios realizados en el catálogo"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
              <polyline points="17 21 17 13 7 13 7 21"></polyline>
              <polyline points="7 3 7 8 15 8"></polyline>
            </svg>
            <span>GUARDAR CAMBIOS</span>
          </button>

          <button id="new-product-open-btn" class="inline-flex items-center gap-1.5 text-xs bg-[var(--primary)] hover:opacity-90 text-white px-3.5 py-2 rounded-xl font-bold transition-all shadow-md cursor-pointer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Crear Producto</span>
          </button>

          <button id="reset-defaults-btn" class="text-xs bg-white/10 hover:bg-white/20 text-[var(--neutral-cream)] px-3 py-2 rounded-lg font-bold transition-colors cursor-pointer" title="Restaurar valores oficiales iniciales">
            Restaurar Base
          </button>
          <a href="/" target="_blank" class="text-xs bg-white/10 hover:bg-white/20 text-white px-3 py-2 rounded-lg font-bold transition-colors">
            Ver Web ↗
          </a>
          <button id="logout-btn" class="text-xs text-red-400 hover:text-red-300 font-bold cursor-pointer">
            Salir
          </button>
        </div>
      </div>
    </header>

    <!-- Contenedor Principal: Tabla Horizontal de Productos -->
    <div class="max-w-7xl mx-auto p-4 sm:p-6 space-y-6">
      
      <!-- Banner Informativo -->
      <div class="bg-[var(--bg-card)] border border-[var(--border-color)] rounded-2xl p-5 flex items-center justify-between gap-4 flex-wrap">
        <div>
          <h3 class="font-bold text-white text-base">🎂 Matriz Completa de Productos &amp; Opciones</h3>
          <p class="text-xs text-[var(--neutral-cream)]/80 mt-0.5">
            Puedes editar en cualquier momento el nombre, tipo, precio base o hacer clic en cualquier lápiz ✏️ para editar opciones.
          </p>
        </div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 text-xs text-emerald-400 font-bold bg-emerald-950/40 border border-emerald-500/30 px-3 py-1 rounded-full">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            Edición Activa In-Situ
          </span>
        </div>
      </div>

      <!-- TABLA HORIZONTAL DE PRODUCTOS -->
      <div class="bg-[var(--bg-card)] border border-[var(--border-color)] rounded-2xl shadow-xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse min-w-[760px]">
            <thead>
              <tr class="bg-[var(--bg-secondary)] border-b border-[var(--border-color)] text-[11px] font-black uppercase tracking-wider text-[var(--accent-light)]">
                <th class="py-4 px-3 w-1/12 text-center">#</th>
                <th class="py-4 px-6 w-5/12">Producto &amp; Precio Base</th>
                <th class="py-4 px-6 w-4/12">Opciones Asignadas (Valores y Precios)</th>
                <th class="py-4 px-6 w-2/12 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody id="products-table-body" class="divide-y divide-[var(--border-color)]/50 text-sm">
              <!-- Renderizado dinámicamente por JS -->
            </tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- MODAL 1: ASIGNAR / EDITAR OPCIÓN PARA UN PRODUCTO -->
    <div id="option-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm hidden">
      <div class="bg-[var(--bg-card)] border border-[var(--border-color)] rounded-2xl max-w-xl w-full p-6 shadow-2xl space-y-5">
        
        <div class="flex items-center justify-between border-b border-[var(--border-color)] pb-3">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-[var(--accent-light)]" id="modal-product-title">Producto</span>
            <h3 class="text-lg font-black text-white" id="modal-header-title">Configurar Opción</h3>
          </div>
          <button id="close-modal-btn" class="text-2xl text-white/50 hover:text-white leading-none cursor-pointer">&times;</button>
        </div>

        <!-- 1. Selección o Creación de Opción -->
        <div class="space-y-2">
          <label class="block text-xs font-bold text-[var(--text-secondary)]">Opción a Asignar</label>
          <select id="modal-option-select" class="w-full bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl px-3 py-2 text-sm text-white outline-none focus:border-[var(--primary)]">
            <!-- Opciones dinámicas -->
          </select>
          
          <!-- Crear nueva opción al vuelo -->
          <div class="pt-2 flex gap-2 items-center">
            <input type="text" id="modal-new-option-name" placeholder="Crear nueva opción (ej: Relleno, Cobertura...)" class="flex-1 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl px-3 py-2 text-xs text-white outline-none focus:border-[var(--primary)]" />
            <button id="modal-create-opt-btn" class="px-3.5 py-2 bg-white/10 hover:bg-white/20 text-xs font-bold rounded-xl transition-colors cursor-pointer whitespace-nowrap">+ Crear Opción</button>
          </div>
        </div>

        <!-- 2. Valores de la Opción con Precios Directos -->
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <label class="block text-xs font-bold text-[var(--text-secondary)]">Valores y Precio Directo para este Producto</label>
            <span class="text-[10px] text-[var(--neutral-cream)]/70">Marca las que aplican y define su precio</span>
          </div>
          
          <div id="modal-values-list" class="space-y-2 max-h-[35vh] overflow-y-auto pr-1">
            <!-- Inyectado dinámicamente -->
          </div>

          <!-- Añadir nuevo valor a esta opción -->
          <div class="pt-3 border-t border-[var(--border-color)]/40 space-y-1.5">
            <span class="text-[10px] font-bold uppercase tracking-wider text-[var(--accent-light)]">Añadir Nuevo Valor a esta Opción:</span>
            <div class="flex gap-2">
              <input type="text" id="modal-new-value-name" placeholder="Nombre valor (ej: Chocolate Blanco...)" class="flex-1 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl px-3 py-2 text-xs text-white outline-none focus:border-[var(--primary)]" />
              <input type="number" id="modal-new-value-price" placeholder="Precio CUP" class="w-28 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl px-3 py-2 text-xs text-white outline-none text-right font-bold text-[var(--accent-light)]" />
              <button id="modal-add-val-btn" class="px-3.5 py-2 bg-[var(--primary)] hover:opacity-90 text-xs font-bold rounded-xl text-white transition-opacity cursor-pointer whitespace-nowrap">+ Añadir Valor</button>
            </div>
          </div>
        </div>

        <!-- Botones Modal -->
        <div class="flex items-center justify-between pt-3 border-t border-[var(--border-color)]">
          <button id="modal-remove-opt-btn" class="text-xs text-red-400 hover:text-red-300 font-bold cursor-pointer hidden">
            🗑️ Quitar Opción de este Producto
          </button>
          <div class="flex gap-2 ml-auto">
            <button id="modal-cancel-btn" class="px-4 py-2 bg-white/10 hover:bg-white/20 text-xs font-bold rounded-xl text-white cursor-pointer">Cancelar</button>
            <button id="modal-save-btn" class="px-5 py-2 bg-[var(--gradient-brand)] text-xs font-bold rounded-xl text-white shadow-lg hover:opacity-95 cursor-pointer">Aplicar Cambios</button>
          </div>
        </div>

      </div>
    </div>

    <!-- MODAL 2: CREAR NUEVO PRODUCTO -->
    <div id="new-product-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm hidden">
      <div class="bg-[var(--bg-card)] border border-[var(--border-color)] rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
        
        <div class="flex items-center justify-between border-b border-[var(--border-color)] pb-3">
          <h3 class="text-lg font-black text-white">Nuevo Producto / Tamaño</h3>
          <button id="close-new-prod-btn" class="text-2xl text-white/50 hover:text-white leading-none cursor-pointer">&times;</button>
        </div>

        <form id="new-product-form" class="space-y-3.5">
          <div>
            <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Nombre del Producto / Tamaño</label>
            <input type="text" id="np-name" required placeholder="Ej: Cake de 28 cm, Postre Tres Leches..." class="w-full px-3 py-2 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl text-xs text-white outline-none focus:border-[var(--primary)]" />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Tipo</label>
              <select id="np-type" class="w-full px-3 py-2 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl text-xs text-white outline-none focus:border-[var(--primary)]">
                <option value="cakes">Cakes</option>
                <option value="buffet">Buffet</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">Precio Base (CUP)</label>
              <input type="number" id="np-price" required placeholder="Ej: 4500" class="w-full px-3 py-2 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl text-xs text-white outline-none focus:border-[var(--primary)] font-bold text-[var(--accent-light)]" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1">URL de Imagen (Opcional)</label>
            <input type="url" id="np-image" placeholder="https://images.unsplash.com/..." class="w-full px-3 py-2 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl text-xs text-white outline-none focus:border-[var(--primary)]" />
          </div>

          <div class="flex justify-end gap-2 pt-2 border-t border-[var(--border-color)]">
            <button type="button" id="np-cancel-btn" class="px-4 py-2 bg-white/10 hover:bg-white/20 text-xs font-bold rounded-xl text-white cursor-pointer">Cancelar</button>
            <button type="submit" class="px-5 py-2 bg-[var(--gradient-brand)] text-xs font-bold rounded-xl text-white shadow-lg hover:opacity-95 cursor-pointer">Crear Producto</button>
          </div>
        </form>

      </div>
    </div>

    <!-- MODAL 3: CONFIRMACIÓN PERSONALIZADA (REEMPLAZA CONFIRM) -->
    <div id="custom-confirm-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm hidden">
      <div class="bg-[var(--bg-card)] border border-[var(--border-color)] rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
        <div class="flex items-center justify-between border-b border-[var(--border-color)] pb-3">
          <h3 class="text-lg font-black text-white" id="custom-confirm-title">Confirmar Acción</h3>
          <button id="custom-confirm-close-btn" class="text-2xl text-white/50 hover:text-white leading-none cursor-pointer">&times;</button>
        </div>
        <p class="text-sm text-[var(--text-secondary)] leading-relaxed" id="custom-confirm-message">
          ¿Estás seguro de realizar esta acción?
        </p>
        <div class="flex justify-end gap-2 pt-2 border-t border-[var(--border-color)]">
          <button type="button" id="custom-confirm-cancel-btn" class="px-4 py-2 bg-white/10 hover:bg-white/20 text-xs font-bold rounded-xl text-white cursor-pointer">
            Cancelar
          </button>
          <button type="button" id="custom-confirm-ok-btn" class="px-5 py-2 bg-red-600 hover:bg-red-500 text-xs font-bold rounded-xl text-white shadow-lg cursor-pointer">
            Sí, continuar
          </button>
        </div>
      </div>
    </div>

  </div>
</Layout>

<script define:vars={{ initialCatalog }}>
  let catalog = initialCatalog;
  let hasPendingChanges = false;
  let editingProductId = null;
  let editingOptionId = null;

  // DOM Elements
  const loginScreen = document.getElementById('admin-login-screen');
  const dashboard = document.getElementById('admin-dashboard');
  const loginForm = document.getElementById('login-form');
  const loginError = document.getElementById('login-error');
  const logoutBtn = document.getElementById('logout-btn');
  const resetDefaultsBtn = document.getElementById('reset-defaults-btn');
  const saveChangesBtn = document.getElementById('save-changes-btn');

  const tableBody = document.getElementById('products-table-body');

  // Modal Opciones
  const modal = document.getElementById('option-modal');
  const modalProductTitle = document.getElementById('modal-product-title');
  const modalHeaderTitle = document.getElementById('modal-header-title');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const modalCancelBtn = document.getElementById('modal-cancel-btn');
  const modalSaveBtn = document.getElementById('modal-save-btn');
  const modalRemoveOptBtn = document.getElementById('modal-remove-opt-btn');

  const modalOptionSelect = document.getElementById('modal-option-select');
  const modalNewOptName = document.getElementById('modal-new-option-name');
  const modalCreateOptBtn = document.getElementById('modal-create-opt-btn');

  const modalValuesList = document.getElementById('modal-values-list');
  const modalNewValueName = document.getElementById('modal-new-value-name');
  const modalNewValuePrice = document.getElementById('modal-new-value-price');
  const modalAddValBtn = document.getElementById('modal-add-val-btn');

  // Modal Nuevo Producto
  const newProdOpenBtn = document.getElementById('new-product-open-btn');
  const newProdModal = document.getElementById('new-product-modal');
  const closeNewProdBtn = document.getElementById('close-new-prod-btn');
  const npCancelBtn = document.getElementById('np-cancel-btn');
  const newProdForm = document.getElementById('new-product-form');

  // Versioning
  const CATALOG_VERSION = 'v1_opciones_unicas';

  const loadCatalog = () => {
    try {
      const savedVersion = localStorage.getItem('el_lider_catalog_version');
      const saved = localStorage.getItem('el_lider_admin_catalog');
      if (saved && savedVersion === CATALOG_VERSION) {
        catalog = JSON.parse(saved);
      } else {
        catalog = JSON.parse(JSON.stringify(initialCatalog));
        localStorage.setItem('el_lider_admin_catalog', JSON.stringify(catalog));
        localStorage.setItem('el_lider_catalog_version', CATALOG_VERSION);
      }
    } catch {
      catalog = JSON.parse(JSON.stringify(initialCatalog));
    }
  };

  const persistLocal = () => {
    localStorage.setItem('el_lider_admin_catalog', JSON.stringify(catalog));
    localStorage.setItem('el_lider_catalog_version', CATALOG_VERSION);
    markAsChanged();
  };

  const markAsChanged = () => {
    hasPendingChanges = true;
    if (saveChangesBtn) {
      saveChangesBtn.classList.remove('hidden');
      saveChangesBtn.classList.add('inline-flex');
    }
  };

   const clearChanged = () => {
     hasPendingChanges = false;
     if (saveChangesBtn) {
       saveChangesBtn.classList.add('hidden');
       saveChangesBtn.classList.remove('inline-flex');
     }
   };

   // Toast and Confirm System
   const showToast = (message, type = 'info') => {
     // Remove any existing toast
     const existingToast = document.querySelector('.toast-container');
     if (existingToast) {
       existingToast.remove();
     }

     const toast = document.createElement('div');
     toast.className = `toast-container fixed bottom-4 right-4 z-50 flex items-center w-max rounded-xl border border-[var(--border-color)] px-4 py-3 text-xs font-medium transition-opacity duration-300`;
     toast.setAttribute('role', 'alert');
     
     let bgColor = 'bg-[var(--bg-secondary)]/90';
     let textColor = 'text-[var(--text-primary)]';
     let borderColor = 'border-[var(--border-color)]';
     
     if (type === 'success') {
       bgColor = 'bg-[var(--primary)]/90';
       textColor = 'text-white';
       borderColor = 'border-[var(--primary)]/30';
     } else if (type === 'error') {
       bgColor = 'bg-red-600/90';
       textColor = 'text-white';
       borderColor = 'border-red-500/30';
     } else if (type === 'warning') {
       bgColor = 'bg-amber-600/90';
       textColor = 'text-white';
       borderColor = 'border-amber-500/30';
     }

     toast.innerHTML = `
       <span class="mr-2">${type === 'success' ? '✅' : type === 'error' ? '❌' : 'ℹ️'}</span>
       <span class="${textColor}">${message}</span>
     `;
     
     toast.style.cssText = `${bgColor}; ${textColor}; ${borderColor};`;
     
     document.body.appendChild(toast);
     
     // Auto remove after 3 seconds
     setTimeout(() => {
       toast.style.opacity = '0';
       toast.addEventListener('transitionend', () => {
         if (toast.parentNode) {
           toast.parentNode.removeChild(toast);
         }
       });
     }, 3000);
   };

   const askConfirm = (message, title = 'Confirmar Acción') => {
     return new Promise((resolve) => {
       const confirmModal = document.getElementById('custom-confirm-modal');
       const confirmTitle = document.getElementById('custom-confirm-title');
       const confirmMsg = document.getElementById('custom-confirm-message');
       const okBtn = document.getElementById('custom-confirm-ok-btn');
       const cancelBtn = document.getElementById('custom-confirm-cancel-btn');
       const closeBtn = document.getElementById('custom-confirm-close-btn');

       if (!confirmModal || !okBtn || !cancelBtn) {
         resolve(window.confirm(message));
         return;
       }

       if (confirmTitle) confirmTitle.textContent = title;
       if (confirmMsg) confirmMsg.textContent = message;

       confirmModal.classList.remove('hidden');

       const cleanup = () => {
         confirmModal.classList.add('hidden');
         okBtn.removeEventListener('click', onOk);
         cancelBtn.removeEventListener('click', onCancel);
         closeBtn?.removeEventListener('click', onCancel);
       };

       const onOk = () => {
         cleanup();
         resolve(true);
       };

       const onCancel = () => {
         cleanup();
         resolve(false);
       };

       okBtn.addEventListener('click', onOk);
       cancelBtn.addEventListener('click', onCancel);
       closeBtn?.addEventListener('click', onCancel);
     });
   };

   // Auth Handler
  loginForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const user = (document.getElementById('admin-user')).value.trim();
    const pass = (document.getElementById('admin-pass')).value.trim();

    if (user === 'riveron' && pass === 'alvaroesmihijofavorito') {
      sessionStorage.setItem('admin_token', 'riveron_valid');
      showDashboard();
    } else {
      if (loginError) {
        loginError.textContent = 'Usuario o contraseña incorrectos';
        loginError.classList.remove('hidden');
      }
    }
  });

  logoutBtn?.addEventListener('click', () => {
    sessionStorage.removeItem('admin_token');
    window.location.reload();
  });

  const checkAuth = () => {
    if (sessionStorage.getItem('admin_token')) {
      showDashboard();
    }
  };

  const showDashboard = () => {
    loginScreen?.classList.add('hidden');
    dashboard?.classList.remove('hidden');
    loadCatalog();
    renderProductsTable();
  };

  resetDefaultsBtn?.addEventListener('click', async () => {
    const ok = await askConfirm('¿Restaurar todos los productos, opciones y precios oficiales iniciales?');
    if (ok) {
      catalog = JSON.parse(JSON.stringify(initialCatalog));
      persistLocal();
      renderProductsTable();
      showToast('✓ Precios oficiales restaurados', 'success');
    }
  });

  // Guardar Cambios en Servidor VPS
  saveChangesBtn?.addEventListener('click', async () => {
    saveChangesBtn.disabled = true;
    saveChangesBtn.innerHTML = `
      <svg class="animate-spin h-5 w-5 text-white" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
      <span>Guardando en Servidor...</span>
    `;

    try {
      const res = await fetch('http://localhost:3004/save-catalog', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(catalog)
      });
      const data = await res.json();
      if (data.ok) {
        clearChanged();
        showToast('💾 ¡Cambios guardados con éxito en la base de datos de la VPS!', 'success');
      } else {
        throw new Error(data.error || 'Fallo al guardar');
      }
    } catch (e) {
      console.warn('Sync server offline, guardado en almacenamiento local activo:', e);
      clearChanged();
      showToast('💾 Cambios guardados con éxito en almacenamiento local.', 'info');
    } finally {
      saveChangesBtn.disabled = false;
      saveChangesBtn.innerHTML = `
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
        <span>GUARDAR CAMBIOS</span>
      `;
    }
  });

  // RENDERIZAR TABLA DE PRODUCTOS
  const renderProductsTable = () => {
    if (!tableBody) return;
    let html = '';
    let rowIndex = 1;

    const products = catalog.products || [];

    products.forEach(product => {
      // Filtrar valores asignados
      const prodValues = (catalog.product_options || []).filter(v => v.product_id === product.id && v.is_enabled);
      
      // Agrupar por opción
      const optGroups = {};
      prodValues.forEach(v => {
        const opt = (catalog.options || []).find(o => o.id === v.option_id);
        const val = (catalog.option_values || []).find(ov => ov.id === v.option_value_id);
        if (!opt) return;
        
        if (!optGroups[opt.id]) {
          optGroups[opt.id] = {
            optId: opt.id,
            optName: opt.name,
            values: []
          };
        }
        optGroups[opt.id].values.push({
          valueId: v.option_value_id,
          valueName: val?.name || v.option_value_id,
          directPrice: v.direct_price,
          isBase: v.is_base
        });
      });

      // Píldoras desplegables con Lápiz SVG ✏️
      let pillsHtml = '';
      const groupKeys = Object.keys(optGroups);

      if (groupKeys.length === 0) {
        pillsHtml = `<span class="text-xs text-white/40 italic">Sin opciones adicionales (solo precio base)</span>`;
      } else {
        pillsHtml = `<div class="flex flex-wrap gap-2">`;
        groupKeys.forEach(optId => {
          const group = optGroups[optId];
          const valsText = group.values.map(v => `${v.valueName}: $${v.directPrice}`).join(' · ');

          pillsHtml += `
            <div class="inline-flex items-center gap-1.5 bg-[var(--bg-primary)] border border-[var(--border-color)] px-3 py-1.5 rounded-full text-xs shadow-sm group hover:border-[var(--primary)] transition-all">
              <span class="font-extrabold text-[var(--accent-light)]">${group.optName}:</span>
              <span class="text-white font-medium max-w-[280px] truncate" title="${valsText}">${valsText}</span>
              
              <button 
                class="edit-pill-btn ml-1 p-1 hover:bg-white/10 rounded-full text-[var(--neutral-cream)] hover:text-white transition-colors cursor-pointer" 
                data-product-id="${product.id}" 
                data-opt-id="${group.optId}"
                title="Editar valores de ${group.optName}"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
                  <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                  <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
              </button>
            </div>
          `;
        });
        pillsHtml += `</div>`;
      }

      const isEven = rowIndex % 2 === 0;
      const rowClass = `hover:bg-white/[0.02] transition-colors ${isEven ? 'bg-[var(--bg-secondary)]/50' : ''}`;

      html += `
        <tr class="${rowClass}">
          <!-- Columna 0: Número Secuencial -->
          <td class="py-4 px-3 text-center align-top">
            <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-[var(--primary)]/20 border border-[var(--primary)]/40 text-xs font-mono font-bold text-white shadow-sm">
              ${rowIndex.toString().padStart(2, '0')}
            </span>
          </td>
          
          <!-- Columna 1: Nombre editable + Precio Base editable + Tipo (SIN BOTÓN ELIMINAR DUPLICADO) -->
          <td class="py-4 px-6 align-top">
            <div class="space-y-2">
              <input 
                type="text" 
                class="prod-name-input w-full bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-lg px-2.5 py-1 text-sm font-black text-white outline-none focus:border-[var(--primary)] transition-colors" 
                data-product-id="${product.id}" 
                value="${product.name}" 
                title="Haz clic para renombrar este producto"
              />
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-xs text-white/60 font-bold">Precio Base:</span>
                <div class="inline-flex items-center gap-1 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-lg px-2 py-0.5 focus-within:border-[var(--primary)] transition-colors">
                  <span class="text-xs font-black text-[var(--accent-light)]">$</span>
                  <input 
                    type="number" 
                    class="base-price-input w-20 bg-transparent text-xs font-black text-[var(--accent-light)] outline-none text-right" 
                    data-product-id="${product.id}" 
                    value="${product.base_price}" 
                    title="Modifica el precio base directamente"
                  />
                  <span class="text-[10px] font-bold text-white/60">CUP</span>
                </div>

                <select 
                  class="prod-type-select bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-lg px-2 py-0.5 text-[10px] font-bold uppercase text-[var(--neutral-cream)] outline-none" 
                  data-product-id="${product.id}"
                >
                  <option value="cakes" ${product.type === 'cakes' ? 'selected' : ''}>Cakes</option>
                  <option value="buffet" ${product.type === 'buffet' ? 'selected' : ''}>Buffet</option>
                </select>
              </div>
            </div>
          </td>

          <!-- Columna 2: Píldoras con lápiz ✏️ -->
          <td class="py-4 px-6 align-middle">
            ${pillsHtml}
          </td>

          <!-- Columna 3: Botones de Acción (Opción + Eliminar debajo) -->
          <td class="py-4 px-6 text-right align-middle">
            <div class="flex flex-col items-end gap-2">
              <button 
                class="add-opt-btn inline-flex items-center gap-1.5 px-3 py-1.5 bg-white/10 hover:bg-white/20 text-xs font-extrabold rounded-xl transition-all cursor-pointer text-white shadow-sm"
                data-product-id="${product.id}"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>Opción</span>
              </button>
              
              <button 
                class="delete-prod-btn inline-flex items-center gap-1 text-[11px] text-red-400 hover:text-red-300 font-bold px-2.5 py-1 bg-red-950/30 hover:bg-red-900/40 border border-red-500/20 rounded-lg transition-colors cursor-pointer"
                data-product-id="${product.id}"
                title="Eliminar este producto"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
                <span>Eliminar</span>
              </button>
            </div>
          </td>
        </tr>
      `;
      rowIndex++;
    });

    tableBody.innerHTML = html;

    // Handlers de edición de nombre
    tableBody.querySelectorAll('.prod-name-input').forEach(inp => {
      inp.addEventListener('change', (e) => {
        const target = e.target;
        const productId = target.getAttribute('data-product-id');
        const product = (catalog.products || []).find(p => p.id === productId);
        if (product && target.value.trim()) {
          product.name = target.value.trim();
          persistLocal();
        }
      });
    });

    // Handlers de edición de precio base
    tableBody.querySelectorAll('.base-price-input').forEach(inp => {
      inp.addEventListener('change', (e) => {
        const target = e.target;
        const productId = target.getAttribute('data-product-id');
        const newPrice = parseInt(target.value || '0');
        const product = (catalog.products || []).find(p => p.id === productId);
        if (product && newPrice >= 0) {
          product.base_price = newPrice;
          persistLocal();
        }
      });
    });

    // Handlers de cambio de tipo
    tableBody.querySelectorAll('.prod-type-select').forEach(sel => {
      sel.addEventListener('change', (e) => {
        const target = e.target;
        const productId = target.getAttribute('data-product-id');
        const product = (catalog.products || []).find(p => p.id === productId);
        if (product) {
          product.type = target.value;
          persistLocal();
        }
      });
    });

    // Handlers de eliminar producto
    tableBody.querySelectorAll('.delete-prod-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const productId = btn.getAttribute('data-product-id');
        const product = (catalog.products || []).find(p => p.id === productId);
        if (product) {
          const ok = await askConfirm(`¿Eliminar definitivamente "${product.name}" del catálogo?`);
          if (ok) {
            catalog.products = (catalog.products || []).filter(p => p.id !== productId);
            catalog.product_options = (catalog.product_options || []).filter(v => v.product_id !== productId);
            if (catalog.product_combinations) {
              catalog.product_combinations = catalog.product_combinations.filter(c => c.product_id !== productId);
            }
            persistLocal();
            renderProductsTable();
            showToast(`Producto "${product.name}" eliminado`, 'success');
          }
        }
      });
    });

    // Handlers de botones de píldora (Editar con Lápiz)
    tableBody.querySelectorAll('.edit-pill-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const productId = btn.getAttribute('data-product-id');
        const optId = btn.getAttribute('data-opt-id');
        openOptionModal(productId, optId);
      });
    });

    // Handlers de botón (+ Asignar Opción)
    tableBody.querySelectorAll('.add-opt-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const productId = btn.getAttribute('data-product-id');
        openOptionModal(productId, null);
      });
    });
  };

  // Abrir Modal de Opciones
  const openOptionModal = (productId, optId) => {
    editingProductId = productId;
    editingOptionId = optId;

    const product = (catalog.products || []).find(p => p.id === productId);
    if (!product) return;

    if (modalProductTitle) modalProductTitle.textContent = product.name;
    if (modalHeaderTitle) modalHeaderTitle.textContent = optId ? 'Editar Opción' : 'Asignar Nueva Opción';
    
    if (modalRemoveOptBtn) {
      if (optId) {
        modalRemoveOptBtn.classList.remove('hidden');
      } else {
        modalRemoveOptBtn.classList.add('hidden');
      }
    }

    renderModalOptionSelect(optId);
    modal?.classList.remove('hidden');
  };

  const closeModal = () => {
    modal?.classList.add('hidden');
    editingProductId = null;
    editingOptionId = null;
  };

  closeModalBtn?.addEventListener('click', closeModal);
  modalCancelBtn?.addEventListener('click', closeModal);

  // Poblar Select de Opciones en Modal
  const renderModalOptionSelect = (selectedOptId) => {
    if (!modalOptionSelect) return;
    const options = catalog.options || [];
    let html = '';

    options.forEach(o => {
      html += `<option value="${o.id}" ${o.id === selectedOptId ? 'selected' : ''}>${o.name}</option>`;
    });
    modalOptionSelect.innerHTML = html;

    const activeOptId = selectedOptId || (options[0] ? options[0].id : null);
    renderModalValues(activeOptId);

    modalOptionSelect.onchange = () => {
      renderModalValues(modalOptionSelect.value);
    };
  };

  // Renderizar Valores y Precios en el Modal (Siempre Editables)
  const renderModalValues = (optId) => {
    if (!modalValuesList || !optId) return;
    const vals = (catalog.option_values || []).filter(v => v.option_id === optId);
    const product = (catalog.products || []).find(p => p.id === editingProductId);
    const baseP = product ? product.base_price : 0;

    let html = '';

    if (vals.length === 0) {
      html = `<p class="text-xs text-white/50 py-3 text-center">Esta opción aún no tiene valores creados. Crea uno abajo.</p>`;
    } else {
      vals.forEach(val => {
        // Buscar si ya está asignado a este producto
        const currentPO = (catalog.product_options || []).find(
          po => po.product_id === editingProductId && po.option_id === optId && po.option_value_id === val.id
        );
        const isChecked = !!currentPO;
        const currentPrice = currentPO ? currentPO.direct_price : baseP;

        html += `
          <div class="flex items-center justify-between gap-3 p-2.5 rounded-xl bg-[var(--bg-primary)]/90 border border-white/5">
            <label class="flex items-center gap-2.5 cursor-pointer select-none">
              <input type="checkbox" class="modal-val-toggle w-4 h-4 rounded text-[var(--primary)] cursor-pointer" data-val-id="${val.id}" ${isChecked ? 'checked' : ''} />
              <span class="text-xs font-bold text-white">${val.name}</span>
            </label>
            <div class="flex items-center gap-1.5">
              <span class="text-[10px] text-white/50">Precio Directo:</span>
              <input 
                type="number" 
                class="modal-val-price w-28 px-2.5 py-1.5 bg-[var(--bg-card)] border border-[var(--border-color)] rounded-lg text-right text-xs font-black text-[var(--accent-light)] outline-none focus:border-[var(--primary)]" 
                data-val-id="${val.id}" 
                value="${currentPrice}" 
                placeholder="Precio CUP" 
              />
              <span class="text-xs text-white/70 font-bold">CUP</span>
            </div>
          </div>
        `;
      });
    }

    modalValuesList.innerHTML = html;

    // Al editar cualquier precio, marcar automáticamente el checkbox correspondiente
    modalValuesList.querySelectorAll('.modal-val-price').forEach(inp => {
      inp.addEventListener('input', (e) => {
        const valId = (e.target).getAttribute('data-val-id');
        const chk = modalValuesList.querySelector(`.modal-val-toggle[data-val-id="${valId}"]`);
        if (chk && !chk.checked) {
          chk.checked = true;
        }
      });
    });
  };

  // Crear Nueva Opción desde el Modal
  modalCreateOptBtn?.addEventListener('click', () => {
    const name = modalNewOptName?.value.trim();
    if (!name) return;

    const id = name.toLowerCase().replace(/[^a-z0-9]/g, '-');
    if (!catalog.options) catalog.options = [];

    if (!catalog.options.find(o => o.id === id)) {
      catalog.options.push({ id, name });
      if (modalNewOptName) modalNewOptName.value = '';
      persistLocal();
      renderModalOptionSelect(id);
      showToast(`✓ Opción "${name}" creada con éxito`, 'success');
    } else {
      showToast('Ya existe una opción con ese nombre.', 'warning');
    }
  });

  // Añadir Nuevo Valor a la Opción Activa desde el Modal con su Precio Directo
  modalAddValBtn?.addEventListener('click', () => {
    const optId = modalOptionSelect?.value;
    const valName = modalNewValueName?.value.trim();
    const priceRaw = modalNewValuePrice?.value.trim();
    const product = (catalog.products || []).find(p => p.id === editingProductId);
    const defaultP = product ? product.base_price : 0;
    const price = priceRaw ? parseInt(priceRaw) : defaultP;

    if (!optId || !valName) {
      showToast('Por favor ingresa el nombre del nuevo valor', 'warning');
      return;
    }

    const valId = `${optId}-${valName.toLowerCase().replace(/[^a-z0-9]/g, '-')}`;
    if (!catalog.option_values) catalog.option_values = [];

    // Registrar en catálogo si no existe
    if (!catalog.option_values.find(v => v.id === valId)) {
      catalog.option_values.push({ id: valId, option_id: optId, name: valName, is_base: false });
    }

    // Y asignarla inmediatamente activa a este producto con el precio indicado
    if (!catalog.product_options) catalog.product_options = [];
    const optObj = (catalog.options || []).find(o => o.id === optId);
    
    // Remover duplicados si ya existiera
    catalog.product_options = catalog.product_options.filter(po => !(po.product_id === editingProductId && po.option_id === optId && po.option_value_id === valId));
    
    catalog.product_options.push({
      product_id: editingProductId,
      option_id: optId,
      option_value_id: valId,
      option_name: optObj ? optObj.name : optId,
      option_value_name: valName,
      direct_price: price,
      is_enabled: true,
      is_base: false
    });

    if (modalNewValueName) modalNewValueName.value = '';
    if (modalNewValuePrice) modalNewValuePrice.value = '';

    persistLocal();
    renderModalValues(optId);
  });

  // Guardar Cambios del Modal (Aplicar al Producto)
  modalSaveBtn?.addEventListener('click', () => {
    if (!editingProductId || !modalOptionSelect) return;
    const optId = modalOptionSelect.value;
    const optObj = (catalog.options || []).find(o => o.id === optId);
    const optName = optObj ? optObj.name : optId;

    if (!catalog.product_options) catalog.product_options = [];

    // Limpiar valores previos de esta opción para este producto
    catalog.product_options = catalog.product_options.filter(po => !(po.product_id === editingProductId && po.option_id === optId));

    // Guardar todos los que estén marcados con su precio directo
    modalValuesList?.querySelectorAll('.modal-val-toggle').forEach(chk => {
      if (chk.checked) {
        const valId = chk.getAttribute('data-val-id');
        const valObj = (catalog.option_values || []).find(v => v.id === valId);
        const priceInput = modalValuesList.querySelector(`.modal-val-price[data-val-id="${valId}"]`);
        const directPrice = parseInt(priceInput?.value || '0');
        const isBase = valObj?.is_base || false;

        catalog.product_options.push({
          product_id: editingProductId,
          option_id: optId,
          option_value_id: valId,
          option_name: optName,
          option_value_name: valObj ? valObj.name : valId,
          direct_price: directPrice,
          is_enabled: true,
          is_base: isBase
        });
      }
    });

    persistLocal();
    renderProductsTable();
    closeModal();
  });

  // Quitar Opción Completa de este Producto
  modalRemoveOptBtn?.addEventListener('click', async () => {
    if (!editingProductId || !editingOptionId) return;
    const ok = await askConfirm('¿Quitar esta opción y todos sus valores de este producto?');
    if (ok) {
      catalog.product_options = (catalog.product_options || []).filter(
        po => !(po.product_id === editingProductId && po.option_id === editingOptionId)
      );
      persistLocal();
      renderProductsTable();
      closeModal();
      showToast('Opción eliminada del producto', 'info');
    }
  });

  // MODAL CREAR NUEVO PRODUCTO
  newProdOpenBtn?.addEventListener('click', () => {
    newProdModal?.classList.remove('hidden');
  });

  const closeNewProdModal = () => {
    newProdModal?.classList.add('hidden');
    newProdForm?.reset();
  };

  closeNewProdBtn?.addEventListener('click', closeNewProdModal);
  npCancelBtn?.addEventListener('click', closeNewProdModal);

  newProdForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = (document.getElementById('np-name')).value.trim();
    const type = (document.getElementById('np-type')).value;
    const basePrice = parseInt((document.getElementById('np-price')).value || '0');
    const image = (document.getElementById('np-image')).value.trim() || 'https://images.unsplash.com/photo-1578985545062-69928b1d9587?q=80&w=800&auto=format&fit=crop';

    if (!name || basePrice < 0) {
      showToast('Ingresa el nombre y un precio base válido.', 'warning');
      return;
    }

    const id = name.toLowerCase().replace(/[^a-z0-9]/g, '-');
    if (!catalog.products) catalog.products = [];

    if (catalog.products.find(p => p.id === id)) {
      showToast('Ya existe un producto con un identificador similar.', 'warning');
      return;
    }

    catalog.products.push({
      id,
      name,
      type,
      base_price: basePrice,
      image,
      description: ''
    });

    if (!catalog.product_options) catalog.product_options = [];

    persistLocal();
    renderProductsTable();
    closeNewProdModal();
    showToast(`✓ Producto "${name}" creado con éxito.`, 'success');
  });

  // Inicialización
  checkAuth();
</script>

<style>
  :root {
    --bg-primary: #1A0A10;
    --bg-secondary: #2A1520;
    --bg-card: #241018;
    --primary: #E8196C;
    --accent: #FF6B35;
    --accent-light: #FFB088;
    --text-primary: #FFFFFF;
    --text-secondary: #E8D5E0;
    --text-light: #C4A8B8;
    --neutral-cream: #F5E6D3;
    --border-color: rgba(232, 25, 108, 0.2);
    --gradient-brand: linear-gradient(135deg, #E8196C, #FF6B35);
    --font-sans: 'Inter', system-ui, sans-serif;
    --font-display: 'Playfair Display', Georgia, serif;
    --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>
