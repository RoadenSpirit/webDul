          </div>
          <h4 class="text-lg sm:text-xl font-black text-white leading-snug px-2">${fullTitle}</h4>
          <div class="flex items-center justify-center gap-3 text-sm font-semibold text-[var(--neutral-cream)] pt-2 border-t border-[var(--border-color)]/40 mt-1">
            <span>Cantidad: <strong class="text-white text-base">${item.quantity}</strong></span>
            <span>•</span>
            <span class="text-[var(--accent-light)] font-black text-lg">$${customizedUnitPrice * item.quantity} CUP</span>
          </div>
        </div>
      `;
    });
    summaryItemsList.innerHTML = html;
  };

  const renderCakesCustomizers = () => {
    if (!cakesCustomizersContainer) return;
    
    const customizableCakes = cart.filter(item => item.customizable);

    if (customizableCakes.length === 0) {
      if (cakesCustomizationSection) cakesCustomizationSection.style.display = 'none';
      return;
    }

    if (cakesCustomizationSection) cakesCustomizationSection.style.display = 'block';
    
    let html = '';
    customizableCakes.forEach((item, idx) => {
      const globalIdx = cart.indexOf(item);
      let dynamicAttributesHtml = '';

      // Obtener opciones asignadas dinámicamente desde el catálogo activo
      if (activeCatalog && activeCatalog.product_options) {
        const prodOpts = activeCatalog.product_options.filter(po => po.product_id === item.id && po.is_enabled);
        
        // Agrupar por opción
        const optGroups = {};
        prodOpts.forEach(po => {
          if (!optGroups[po.option_id]) {
            optGroups[po.option_id] = {
              optId: po.option_id,
              optName: po.option_name,
              values: []
            };
          }
          optGroups[po.option_id].values.push(po);
        });

        // Renderizar selector para cada opción asignada
        Object.keys(optGroups).forEach(optId => {
          const group = optGroups[optId];
          const currentSelected = item.options ? item.options[optId] : (group.values[0]?.option_value_id);

          dynamicAttributesHtml += `
            <div class="flex flex-col gap-2">
              <label for="opt-${optId}-${globalIdx}" class="block text-sm font-bold text-[var(--text-primary)]">✨ ${group.optName}:</label>
              <select class="dynamic-attr-field w-full px-4 py-3 bg-[var(--bg-primary)] border-2 border-[var(--border-color)] rounded-xl text-sm text-[var(--text-primary)] focus:border-[var(--accent-color)] focus:ring-4 focus:ring-[var(--accent-color)]/10 transition-all outline-none cursor-pointer appearance-none font-bold" data-index="${globalIdx}" data-opt-id="${optId}" id="opt-${optId}-${globalIdx}">
                ${group.values.map(po => `
                  <option value="${po.option_value_id}" ${currentSelected === po.option_value_id ? 'selected' : ''}>
                    ${po.option_value_name} ($${po.direct_price} CUP)
                  </option>
                `).join('')}
              </select>
            </div>
          `;
        });
      } else {
        // Fallback a reglas fijas si no hubiese catálogo activo
        const rule = RULES[item.id];
        if (rule && rule.doughs && rule.doughs.length > 0) {
          dynamicAttributesHtml += `
            <div class="flex flex-col gap-2">
              <label for="cake-dough-${globalIdx}" class="block text-sm font-bold text-[var(--text-primary)]">🌾 Selección de Masa / Sabor:</label>
              <select class="dough-select-field w-full px-4 py-3 bg-[var(--bg-primary)] border-2 border-[var(--border-color)] rounded-xl text-sm text-[var(--text-primary)] focus:border-[var(--accent-color)] focus:ring-4 focus:ring-[var(--accent-color)]/10 transition-all outline-none cursor-pointer appearance-none font-bold" data-index="${globalIdx}" id="cake-dough-${globalIdx}">
                ${rule.doughs.map(d => `<option value="${d.id}" ${item.dough === d.id ? 'selected' : ''}>${d.label}</option>`).join('')}
              </select>
            </div>
          `;
        }
      }

      html += `
        <div class="bg-[var(--bg-secondary)] border border-[var(--border-color)] rounded-xl p-5 mb-6 space-y-4 shadow-sm" data-cart-index="${globalIdx}">
          <div class="text-center pb-2 border-b border-[var(--border-color)]">
            <span class="text-xs uppercase tracking-wider font-extrabold text-[var(--accent-light)]">Personalización</span>
            <h4 class="text-lg sm:text-xl font-black text-white mt-0.5">${item.name}</h4>
          </div>
          
          ${dynamicAttributesHtml}

          <div class="flex flex-col gap-2">
            <label for="cake-theme-${globalIdx}" class="block text-sm font-bold text-[var(--text-primary)]">✍️ Temática / Decoración y Colores:</label>
            <textarea 
              class="cake-note-field w-full px-4 py-3 bg-[var(--bg-primary)] border-2 border-[var(--border-color)] rounded-xl text-sm text-[var(--text-primary)] focus:border-[var(--accent-color)] focus:ring-4 focus:ring-[var(--accent-color)]/10 transition-all outline-none placeholder:text-[var(--text-light)]" 
              id="cake-theme-${globalIdx}"
              data-index="${globalIdx}" 
              rows="2" 
              placeholder="Ej: Cobertura azul con detalles en crema blanca. Texto: 'Felicidades Mamá'. Temática de flores..."
            >${item.note || ''}</textarea>
          </div>

          <div class="flex flex-col gap-2">
            <label class="block text-sm font-bold text-[var(--text-primary)]">🖼️ Foto de Referencia para Decoración (Opcional):</label>
            <div class="relative w-full border-2 border-dashed border-[var(--accent-color)] rounded-xl p-4 text-center cursor-pointer bg-[var(--bg-primary)] hover:bg-[var(--accent-color)]/5 transition-colors">
              <span class="text-xs font-semibold text-[var(--text-primary)]" id="ref-photo-label-${globalIdx}">
                ${item.refPhotoName ? `✓ ${item.refPhotoName}` : 'Haga clic para subir imagen de referencia'}
              </span>
              <input type="file" class="decorations-ref-upload-input" data-index="${globalIdx}" accept="image/*" />
            </div>
            <div class="flex items-center justify-center" id="ref-preview-${globalIdx}">
              ${uploadedImages['ref-' + item.id] ? `<img src="${uploadedImages['ref-' + item.id]}" alt="preview" class="w-12 h-12 object-cover rounded-lg border border-[var(--border-color)] mt-2"/>` : ''}
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <label class="inline-flex items-center gap-3 w-full bg-[var(--bg-primary)] border-2 border-[var(--border-color)] hover:border-[var(--accent-color)] p-3 rounded-xl cursor-pointer transition-colors">
              <input 
                type="checkbox" 
                class="edible-print-checkbox-field w-4 h-4 text-[var(--accent-color)] border-[var(--border-color)] rounded focus:ring-[var(--accent-color)] cursor-pointer" 
                data-index="${globalIdx}" 
                id="cake-print-${globalIdx}"
                ${item.ediblePrint ? 'checked' : ''}
              />
              <span class="text-sm font-bold text-[var(--text-primary)] flex-grow flex items-center justify-between">
                <span>¿Deseas añadir Impresión Comestible?</span>
                <span class="text-xs text-[var(--accent-light)] font-black">+900 CUP</span>
              </span>
            </label>
            
            <div class="print-upload-wrapper" id="print-upload-wrapper-${globalIdx}" style="display: ${item.ediblePrint ? 'block' : 'none'};">
              <div class="relative w-full border-2 border-dashed border-[var(--accent-color)] rounded-xl p-4 text-center cursor-pointer bg-[var(--bg-primary)] hover:bg-[var(--accent-color)]/5 transition-colors">
                <span class="text-xs font-semibold text-[var(--text-primary)]" id="upload-label-${globalIdx}">
                  ${item.fileName ? `✓ ${item.fileName}` : 'Haga clic para subir la imagen para impresión'}
                </span>
                <input type="file" class="customizer-upload-input" data-index="${globalIdx}" accept="image/*" />
              </div>
              <div class="flex items-center justify-center mt-2" id="preview-${globalIdx}">
                ${uploadedImages[item.id] ? `<img src="${uploadedImages[item.id]}" alt="preview" class="w-12 h-12 object-cover rounded-lg border border-[var(--border-color)]"/>` : ''}
              </div>
            </div>
          </div>
        </div>
      `;
    });

    cakesCustomizersContainer.innerHTML = html;
    attachCustomizerEvents();
  };

  const attachCustomizerEvents = () => {
    // Dynamic option selects
    document.querySelectorAll('.dynamic-attr-field').forEach(select => {
      select.addEventListener('change', (e) => {
        const target = e.target;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        const optId = target.getAttribute('data-opt-id') || '';
        
        if (!cart[idx].options) cart[idx].options = {};
        cart[idx].options[optId] = target.value;
        
        // Mantener compatibilidad con masa
        if (optId === 'masa') {
          cart[idx].dough = target.value;
        }
        updateTotals();
      });
    });

    // Dough selects fallback
    document.querySelectorAll('.dough-select-field').forEach(select => {
      select.addEventListener('change', (e) => {
        const target = e.target;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        
        cart[idx].dough = target.value;
        updateTotals();
      });
    });

    // Size selects
    document.querySelectorAll('.size-select-field').forEach(select => {
      select.addEventListener('change', (e) => {
        const target = e.target;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        
        cart[idx].size = target.value;
        updateTotals();
      });
    });

    // Double height check
    document.querySelectorAll('.double-height-checkbox-field').forEach(checkbox => {
      checkbox.addEventListener('change', (e) => {
        const target = e.target;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        
        cart[idx].doubleHeight = target.checked;
        updateTotals();
      });
    });

    // Notes/Theme textarea
    document.querySelectorAll('.cake-note-field').forEach(textarea => {
      textarea.addEventListener('input', (e) => {
        const target = e.target;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        cart[idx].note = target.value;
        saveCartToStorage();
      });
    });

    // Print check
    document.querySelectorAll('.edible-print-checkbox-field').forEach(checkbox => {
      checkbox.addEventListener('change', (e) => {
        const target = e.target;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        const uploadWrapper = document.getElementById(`print-upload-wrapper-${idx}`);
        
        cart[idx].ediblePrint = target.checked;
        if (uploadWrapper) {
          uploadWrapper.style.display = target.checked ? 'block' : 'none';
        }
        updateTotals();
      });
    });

    // File upload preview
    document.querySelectorAll('.customizer-upload-input').forEach(input => {
      input.addEventListener('change', (e) => {
        const target = e.target;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        const file = target.files?.[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = (event) => {
            const dataUrl = event.target?.result;
            uploadedImages[cart[idx].id] = dataUrl;
            cart[idx].customPhotoData = dataUrl;
            cart[idx].customPhotoName = file.name;
            saveCartToStorage();
            
            const previewContainer = document.getElementById(`preview-${idx}`);
            if (previewContainer) {
              previewContainer.innerHTML = `<img src="${dataUrl}" alt="preview" class="w-12 h-12 object-cover rounded-lg border border-[var(--border-color)]"/>`;
            }
          };
          reader.readAsDataURL(file);
        }
      });
    });

    // Reference photo upload for general decorations
    document.querySelectorAll('.decorations-ref-upload-input').forEach(input => {
      input.addEventListener('change', (e) => {
        const target = e.target;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        const file = target.files?.[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = (event) => {
            const dataUrl = event.target?.result;
            uploadedImages['ref-' + cart[idx].id] = dataUrl;
            cart[idx].refPhotoData = dataUrl;
            cart[idx].refPhotoName = file.name;
            saveCartToStorage();

            const refLabel = document.getElementById(`ref-photo-label-${idx}`);
            if (refLabel) {
              refLabel.textContent = `✓ ${file.name}`;
            }

            const previewContainer = document.getElementById(`ref-preview-${idx}`);
            if (previewContainer) {
              previewContainer.innerHTML = `<img src="${dataUrl}" alt="preview" class="w-12 h-12 object-cover rounded-lg border border-[var(--border-color)] mt-2"/>`;
            }
          };
          reader.readAsDataURL(file);
        }
      });
    });
  };

  const saveCartToStorage = () => {
    const cleanCart = cart.map(({ fileData, ...rest }) => rest);
    localStorage.setItem('el_lider_cart', JSON.stringify(cleanCart));
  };

  const updateTotals = () => {
    let grandTotal = 0;

    cart.forEach(item => {
      const unit = calculateItemUnitPrice(item);
      grandTotal += unit * item.quantity;
    });

    if (summaryTotal) summaryTotal.textContent = `$${grandTotal} CUP`;

    saveCartToStorage();
    renderSummaryItems();
  };

  // ---- MVP: Envío automático vía Baileys (NÚMERO DE PRUEBAS) ----
  const BAILEYS_URL = 'https://ia.carmayn8n.cloud/api/wa/send';
  const BAILEYS_API_KEY = 'REDACTED_BAILEYS_KEY';
  // Número de pruebas del desarrollador
  const TEST_PHONE = '5350000000';
  // Número oficial de la dulcería (fallback)
  const CLIENT_SUPPORT_PHONE = '5351394921';
  const SHOP_CHAT_ID = `${TEST_PHONE}@s.whatsapp.net`;

  const normalizePhone = (raw) => {
    let digits = (raw || '').replace(/\D/g, '');
    if (digits.startsWith('53') && digits.length >= 10) return digits;
    if (digits.length === 8) return '53' + digits;
    return digits;
  };

  // WhatsApp checkout final message composition
  confirmWhatsappCheckoutBtn?.addEventListener('click', async () => {
    const customerNameInput = document.getElementById('customer-name');
    const customerPhoneInput = document.getElementById('customer-phone');
    const deliveryDateInput = document.getElementById('delivery-date');
    const deliveryTimeInput = document.getElementById('delivery-time');
    const orderStatus = document.getElementById('order-status');

    const customerName = customerNameInput?.value.trim();
    const customerPhoneRaw = customerPhoneInput?.value.trim();
    const deliveryDate = deliveryDateInput?.value;
    const deliveryTime = deliveryTimeInput?.value;

    if (!customerName || !customerPhoneRaw || !deliveryDate || !deliveryTime) {
      alert('Por favor, rellene todos los campos obligatorios (Nombre, WhatsApp, Fecha y Hora).');
      return;
    }

    const customerPhone = normalizePhone(customerPhoneRaw);
    if (customerPhone.length < 10) {
      alert('Por favor, revise su número de WhatsApp (ej: 5351234567).');
      return;
    }

    if (cart.length === 0) {
      alert('Su pedido está vacío. Añada productos del catálogo primero.');
      return;
    }

    const setStatus = (msg, ok) => {
      if (!orderStatus) return;
      orderStatus.textContent = msg;
      orderStatus.style.color = ok === true ? '#25D366' : ok === false ? '#FF6B6B' : '';
    };

    const phoneNumber = SHOP_PHONE;
    const dateParts = deliveryDate.split('-');
    const formattedDate = `${dateParts[2]}/${dateParts[1]}/${dateParts[0]}`;

    let message = `🍰 *NUEVO ENCARGO \u2014 DULCERÍA EL LÍDER* 🍰\n\n`;
    message += `👤 *CLIENTE:* ${customerName}\n`;
    message += `📱 *WHATSAPP CLIENTE:* +${customerPhone}\n`;
    message += `📅 *FECHA DE ENTREGA:* ${formattedDate}\n`;
    message += `🕒 *HORA DE ENTREGA:* ${deliveryTime}\n\n`;
    message += '━━━━━━━━━━━━━━━━━━━━━━━━━\n';
    message += '*DETALLE DEL PEDIDO:*\n\n';

    let total = 0;
    sortCart();
    cart.forEach((item, index) => {
      const unit = calculateItemUnitPrice(item);
      const sub = unit * item.quantity;
      total += sub;
      const title = getItemFullTitle(item);

      message += `*${index + 1}. ${title}* (x${item.quantity})\n`;
      message += `   • Importe: *$${sub} CUP*\n`;

      if (item.customizable) {
        if (item.note && item.note.trim()) {
          message += `   • Decoración: "${item.note.trim()}"\n`;
        }
        if (item.refPhotoName) {
          message += `   • Foto de Referencia: [Se adjunta en este chat] (${item.refPhotoName})\n`;
        }
      }
      message += '\n';
    });

    message += '━━━━━━━━━━━━━━━━━━━━━━━━━\n';
    message += `💵 *TOTAL ESTIMADO: $${total} CUP*\n\n`;
    message += `⚠️ _Las temáticas y decoraciones personalizadas se cobran adicional al valor del cake y se concertarán en este chat._\n`;
    message += `📍 Por favor, confírmenme disponibilidad para agendar. ¡Gracias!`;

    // 1) Notificación automática a la dulcería vía Baileys
    setStatus('⏳ Enviando su pedido a la dulcería…');
    if (confirmWhatsappCheckoutBtn) {
      confirmWhatsappCheckoutBtn.disabled = true;
    }
    try {
      const res = await fetch(BAILEYS_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-api-key': BAILEYS_API_KEY
        },
        body: JSON.stringify({ chatId: SHOP_CHAT_ID, message })
      });
      if (!res.ok) throw new Error(`Baileys respondió ${res.status}`);
      setStatus('✅ ¡Pedido enviado! La dulcería le confirmará por WhatsApp.', true);
    } catch (err) {
      console.error('Baileys send failed:', err);
      setStatus('⚠️ No se pudo avisar automáticamente. Se abrirá WhatsApp para completar su pedido.', false);
    } finally {
      if (confirmWhatsappCheckoutBtn) {
        confirmWhatsappCheckoutBtn.disabled = false;
      }
    }

    // 2) Respaldo: abrir el chat de WhatsApp de atención al cliente
    const encodedMessage = encodeURIComponent(message);
    const whatsappUrl = `https://wa.me/${CLIENT_SUPPORT_PHONE}?text=${encodedMessage}`;
    window.open(whatsappUrl, '_blank');
  });

  // Initialization
  loadCart();
  renderSummaryItems();
  renderCakesCustomizers();
  updateTotals();
</script>
