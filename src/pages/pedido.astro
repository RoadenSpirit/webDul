                <input type="file" class="customizer-upload-input" data-index="${globalIdx}" accept="image/*" />
              </div>
              <div class="flex items-center justify-center mt-2" id="preview-${globalIdx}">
                ${uploadedImages[item.id] ? `<img src="${uploadedImages[item.id]}" alt="preview" class="w-12 h-12 object-cover rounded-lg border border-[var(--border-color)]"/>` : ''}
              </div>
            </div>
          </div>
        </div>
      `;
    });

    cakesCustomizersContainer.innerHTML = html;
    attachCustomizerEvents();
  };

  const attachCustomizerEvents = () => {
    // Dynamic option selects (Masa y otros desplegables)
    document.querySelectorAll('.dynamic-attr-field').forEach(select => {
      select.addEventListener('change', (e) => {
        const target = e.target;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        const optId = target.getAttribute('data-opt-id') || '';
        
        if (!cart[idx].options) cart[idx].options = {};
        cart[idx].options[optId] = target.value;
        
        // Mantener compatibilidad con masa
        if (optId === 'masa') {
          cart[idx].dough = target.value;
        }
        updateTotals();
      });
    });

    // Dynamic attribute checkboxes (Altura Doble booleana)
    document.querySelectorAll('.dynamic-attr-checkbox').forEach(checkbox => {
      checkbox.addEventListener('change', (e) => {
        const target = e.target;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        const optId = target.getAttribute('data-opt-id') || '';
        const valId = target.getAttribute('data-val-id') || '';
        
        if (!cart[idx].options) cart[idx].options = {};
        if (target.checked) {
          cart[idx].options[optId] = valId;
          cart[idx].doubleHeight = true;
        } else {
          delete cart[idx].options[optId];
          cart[idx].doubleHeight = false;
        }
        updateTotals();
      });
    });

    // Dough selects fallback
    document.querySelectorAll('.dough-select-field').forEach(select => {
      select.addEventListener('change', (e) => {
        const target = e.target;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        
        cart[idx].dough = target.value;
        updateTotals();
      });
    });

    // Size selects
    document.querySelectorAll('.size-select-field').forEach(select => {
      select.addEventListener('change', (e) => {
        const target = e.target;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        
        cart[idx].size = target.value;
        updateTotals();
      });
    });

    // Double height check
    document.querySelectorAll('.double-height-checkbox-field').forEach(checkbox => {
      checkbox.addEventListener('change', (e) => {
        const target = e.target;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        
        cart[idx].doubleHeight = target.checked;
        updateTotals();
      });
    });

    // Notes/Theme textarea
    document.querySelectorAll('.cake-note-field').forEach(textarea => {
      textarea.addEventListener('input', (e) => {
        const target = e.target;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        cart[idx].note = target.value;
        saveCartToStorage();
      });
    });

    // Print check
    document.querySelectorAll('.edible-print-checkbox-field').forEach(checkbox => {
      checkbox.addEventListener('change', (e) => {
        const target = e.target;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        const uploadWrapper = document.getElementById(`print-upload-wrapper-${idx}`);
        
        cart[idx].ediblePrint = target.checked;
        if (uploadWrapper) {
          uploadWrapper.style.display = target.checked ? 'block' : 'none';
        }
        updateTotals();
      });
    });

    // File upload preview
    document.querySelectorAll('.customizer-upload-input').forEach(input => {
      input.addEventListener('change', (e) => {
        const target = e.target;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        const file = target.files?.[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = (event) => {
            const dataUrl = event.target?.result;
            uploadedImages[cart[idx].id] = dataUrl;
            cart[idx].customPhotoData = dataUrl;
            cart[idx].customPhotoName = file.name;
            saveCartToStorage();
            
            const previewContainer = document.getElementById(`preview-${idx}`);
            if (previewContainer) {
              previewContainer.innerHTML = `<img src="${dataUrl}" alt="preview" class="w-12 h-12 object-cover rounded-lg border border-[var(--border-color)]"/>`;
            }
          };
          reader.readAsDataURL(file);
        }
      });
    });

    // Reference photo upload for general decorations
    document.querySelectorAll('.decorations-ref-upload-input').forEach(input => {
      input.addEventListener('change', (e) => {
        const target = e.target;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        const file = target.files?.[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = (event) => {
            const dataUrl = event.target?.result;
            uploadedImages['ref-' + cart[idx].id] = dataUrl;
            cart[idx].refPhotoData = dataUrl;
            cart[idx].refPhotoName = file.name;
            saveCartToStorage();

            const refLabel = document.getElementById(`ref-photo-label-${idx}`);
            if (refLabel) {
              refLabel.textContent = `✓ ${file.name}`;
            }

            const previewContainer = document.getElementById(`ref-preview-${idx}`);
            if (previewContainer) {
              previewContainer.innerHTML = `<img src="${dataUrl}" alt="preview" class="w-12 h-12 object-cover rounded-lg border border-[var(--border-color)] mt-2"/>`;
            }
          };
          reader.readAsDataURL(file);
        }
      });
    });
  };

  const saveCartToStorage = () => {
    const cleanCart = cart.map(({ fileData, ...rest }) => rest);
    localStorage.setItem('el_lider_cart', JSON.stringify(cleanCart));
  };

  const updateTotals = () => {
    let grandTotal = 0;

    cart.forEach(item => {
      const unit = calculateItemUnitPrice(item);
      grandTotal += unit * item.quantity;
    });

    if (summaryTotal) summaryTotal.textContent = `$${formatMiles(grandTotal)} CUP`;

    saveCartToStorage();
    renderSummaryItems();
  };

  // ---- Envío Seguro Dedicado a Baileys (Sin exponer API Key) ----
  const ORDER_ENDPOINT = 'https://ia.carmayn8n.cloud/api/wa/order/dulceria';
  const CLIENT_SUPPORT_PHONE = '5353721945';

  const normalizePhone = (raw) => {
    let digits = (raw || '').replace(/\D/g, '');
    if (digits.startsWith('53') && digits.length >= 10) return digits;
    if (digits.length === 8) return '53' + digits;
    return digits;
  };

  // Referencias del Modal de Estado
  const orderModalOverlay = document.getElementById('order-modal-overlay');
  const orderModalCard = document.getElementById('order-modal-card');
  const modalLoadingState = document.getElementById('modal-loading-state');
  const modalSuccessState = document.getElementById('modal-success-state');
  const modalErrorState = document.getElementById('modal-error-state');
  const modalErrorMessage = document.getElementById('modal-error-message');
  const modalCountdown = document.getElementById('modal-countdown');
  const modalCloseBtn = document.getElementById('modal-close-btn');

  const openOrderModal = (state = 'loading') => {
    if (!orderModalOverlay || !orderModalCard) return;
    orderModalOverlay.classList.remove('hidden');
    orderModalOverlay.classList.add('flex');
    setTimeout(() => {
      orderModalCard.classList.remove('scale-95', 'opacity-0');
      orderModalCard.classList.add('scale-100', 'opacity-100');
    }, 10);
    setOrderModalState(state);
  };

  const setOrderModalState = (state, errMsg = '') => {
    if (modalLoadingState) modalLoadingState.classList.add('hidden');
    if (modalSuccessState) modalSuccessState.classList.add('hidden');
    if (modalErrorState) modalErrorState.classList.add('hidden');

    if (state === 'loading') {
      if (modalLoadingState) {
        modalLoadingState.classList.remove('hidden');
        modalLoadingState.classList.add('flex');
      }
    } else if (state === 'success') {
      if (modalSuccessState) {
        modalSuccessState.classList.remove('hidden');
        modalSuccessState.classList.add('flex');
      }
    } else if (state === 'error') {
      if (modalErrorState) {
        modalErrorState.classList.remove('hidden');
        modalErrorState.classList.add('flex');
      }
      if (modalErrorMessage) {
        modalErrorMessage.textContent = errMsg || 'No se pudo completar el encargo en este momento.';
      }
    }
  };

  const closeOrderModal = () => {
    if (!orderModalOverlay || !orderModalCard) return;
    orderModalCard.classList.remove('scale-100', 'opacity-100');
    orderModalCard.classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
      orderModalOverlay.classList.add('hidden');
      orderModalOverlay.classList.remove('flex');
    }, 200);
  };

  modalCloseBtn?.addEventListener('click', closeOrderModal);

  // WhatsApp checkout final message composition
  confirmWhatsappCheckoutBtn?.addEventListener('click', async () => {
    const customerNameInput = document.getElementById('customer-name');
    const customerPhoneInput = document.getElementById('customer-phone');
    const deliveryDateInput = document.getElementById('delivery-date');
    const deliveryTimeInput = document.getElementById('delivery-time');
    const orderStatus = document.getElementById('order-status');

    const customerName = customerNameInput?.value.trim();
    const customerPhoneRaw = customerPhoneInput?.value.trim();
    const deliveryDate = deliveryDateInput?.value;
    const deliveryTime = deliveryTimeInput?.value;

    if (!customerName || !customerPhoneRaw || !deliveryDate || !deliveryTime) {
      alert('Por favor, rellene todos los campos obligatorios (Nombre, WhatsApp, Fecha y Hora).');
      return;
    }

    const customerPhone = normalizePhone(customerPhoneRaw);
    if (customerPhone.length < 10) {
      alert('Por favor, revise su número de WhatsApp (ej: 5351234567).');
      return;
    }

    if (cart.length === 0) {
      alert('Su encargo está vacío. Añada productos del catálogo primero.');
      return;
    }

    const setStatus = (msg, ok) => {
      if (!orderStatus) return;
      orderStatus.textContent = msg;
      orderStatus.style.color = ok === true ? '#25D366' : ok === false ? '#FF6B6B' : '';
    };

    const dateParts = deliveryDate.split('-');
    const formattedDate = `${dateParts[2]}/${dateParts[1]}/${dateParts[0]}`;

    // Construir mensaje legible para respaldo directo por WhatsApp
    let message = `🍰 *NUEVO ENCARGO \u2014 DULCERÍA EL LÍDER* 🍰\n\n`;
    message += `👤 *CLIENTE:* ${customerName}\n`;
    message += `📱 *WHATSAPP CLIENTE:* +${customerPhone}\n`;
    message += `📅 *FECHA DE ENTREGA:* ${formattedDate}\n`;
    message += `🕒 *HORA DE ENTREGA:* ${deliveryTime}\n\n`;
    message += '━━━━━━━━━━━━━━━━━━━━━━━━━\n';
    message += '*DETALLE DEL ENCARGO:*\n\n';

    let total = 0;
    sortCart();
    cart.forEach((item, index) => {
      const unit = calculateItemUnitPrice(item);
      const sub = unit * item.quantity;
      total += sub;
      const title = getItemFullTitle(item);

      message += `*${index + 1}. ${title}* (x${item.quantity})\n`;
      message += `   • Importe: *$${sub} CUP*\n`;

      if (item.customizable) {
        if (item.note && item.note.trim()) {
          message += `   • Decoración: "${item.note.trim()}"\n`;
        }
        if (item.refPhotoName) {
          message += `   • Foto de Referencia: [Se adjunta en este chat] (${item.refPhotoName})\n`;
        }
      }
      message += '\n';
    });

    message += '━━━━━━━━━━━━━━━━━━━━━━━━━\n';
    message += `💵 *TOTAL ESTIMADO: $${total} CUP*\n\n`;
    message += `⚠️ _Las temáticas y decoraciones personalizadas se cobran adicional al valor del cake y se concertarán en este chat._\n`;
    message += `📍 Por favor, confírmenme disponibilidad para agendar. ¡Gracias!`;

    // 1) Abrir Modal y Notificación automática vía el endpoint blindado de Dulcería
    setStatus('⏳ Procesando y registrando su encargo…');
    if (confirmWhatsappCheckoutBtn) {
      confirmWhatsappCheckoutBtn.disabled = true;
    }
    openOrderModal('loading');

    // Payload tipado y validado contra el backend
    const payload = {
      customerName,
      customerPhone,
      deliveryDate,
      deliveryTime,
      items: cart.map(item => ({
        id: item.id,
        quantity: item.quantity,
        options: item.options || {},
        doubleHeight: item.doubleHeight || false,
        ediblePrint: item.ediblePrint || false,
        note: item.note || '',
        refPhotoName: item.refPhotoName || '',
        refPhotoData: item.refPhotoData || '',
        customPhotoName: item.customPhotoName || '',
        customPhotoData: item.customPhotoData || ''
      }))
    };

    try {
      const res = await fetch(ORDER_ENDPOINT, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload)
      });
      if (!res.ok) {
        const errData = await res.json().catch(() => ({}));
        throw new Error(errData.error || `Error HTTP ${res.status}`);
      }
      const data = await res.json();
      
      // Limpiar carrito tras encargo exitoso
      localStorage.removeItem('el_lider_cart');
      cart = [];
      updateTotals();

      setStatus('✅ ¡Encargo registrado con éxito! En breve le contactaremos para agendar su pedido.', true);
      confirmWhatsappCheckoutBtn.textContent = '✓ Encargo Enviado';
      confirmWhatsappCheckoutBtn.style.backgroundColor = '#16a34a';

      // Mostrar estado de éxito en el Modal y arrancar cronómetro de 4s
      setOrderModalState('success');
      let countdown = 4;
      if (modalCountdown) modalCountdown.textContent = countdown.toString();

      const timer = setInterval(() => {
        countdown--;
        if (modalCountdown) modalCountdown.textContent = countdown.toString();
        if (countdown <= 0) {
          clearInterval(timer);
          window.location.href = '/';
        }
      }, 1000);

    } catch (err) {
      console.error('Error al procesar pedido:', err);
      const msg = err.message || 'Inténtelo de nuevo más tarde.';
      setStatus(`❌ Error al registrar su encargo: ${msg}`, false);
      setOrderModalState('error', msg);
    } finally {
      if (confirmWhatsappCheckoutBtn) {
        confirmWhatsappCheckoutBtn.disabled = false;
      }
    }
  });

  // Initialization
  loadCart();
  renderSummaryItems();
  renderCakesCustomizers();
  updateTotals();
</script>
