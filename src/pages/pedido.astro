                <span class="block text-xs font-semibold text-[var(--text-primary)] truncate max-w-full px-1" id="upload-label-${globalIdx}">
                  ${item.fileName ? `✓ ${item.fileName}` : 'Haga clic para subir la imagen para impresión'}
