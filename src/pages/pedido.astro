---
import Layout from '../layouts/Layout.astro';
import catalogData from '../../data/catalog.json';

const initialCatalog = catalogData;
---

<Layout title="Completar Encargo">
  <div class="min-h-screen bg-gradient-to-b from-[var(--bg-primary)] via-[var(--bg-secondary)] to-[var(--bg-primary)] py-8 sm:py-12 text-[var(--text-primary)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8 sm:mb-10">
        <a href="/" class="inline-flex items-center text-sm font-semibold text-[var(--accent-light)] hover:text-white transition-colors mb-5 gap-1">← Volver al Catálogo</a>

        <h1 style="font-family: var(--font-display); font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 700; color: #FFFFFF; margin-bottom: 0.5rem; line-height: 1.2;">¡Casi listo! Personaliza tu encargo</h1>
        <p class="text-[var(--neutral-cream)] text-base sm:text-lg leading-relaxed" style="max-width: 560px;">
          Define los detalles de tu cake y coordinamos la entrega directamente por WhatsApp.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Columna Izquierda: Formulario (58% aprox / 7 cols) -->
        <div class="lg:col-span-7">
          <form id="checkout-form" class="space-y-8">
            
            <!-- Bloque 1: Personalización de los Cakes -->
            <div class="bg-[var(--bg-card)] border border-[var(--border-color)] rounded-2xl p-6 sm:p-8 shadow-md hover:shadow-lg transition-shadow space-y-6" id="cakes-customization-section">
              <h3 class="text-lg sm:text-xl font-bold text-[var(--accent-light)] border-b border-[var(--border-color)] pb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-[var(--accent-light)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                </svg>
                1. Personalización de tus Cakes
              </h3>
              <div id="cakes-customizers-container" class="space-y-6">
                <!-- Se inyecta dinámicamente con JS para cada cake del carrito -->
              </div>
            </div>

            <!-- Bloque 2: Detalles de Entrega -->
            <div class="bg-[var(--bg-card)] border border-[var(--border-color)] rounded-2xl p-6 sm:p-8 shadow-md hover:shadow-lg transition-shadow space-y-6">
              <h3 class="text-lg sm:text-xl font-bold text-[var(--accent-light)] border-b border-[var(--border-color)] pb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-[var(--accent-light)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                2. Datos de Contacto y Fecha
              </h3>

              <!-- Banner de entrega coordinada -->
              <div class="flex items-start gap-3 bg-gradient-to-r from-[rgba(255,107,53,0.15)] to-[rgba(232,25,108,0.1)] border border-[rgba(255,140,66,0.35)] rounded-xl p-4">
                <div class="p-1 rounded-lg bg-[var(--accent-color)]/20 text-[var(--accent-light)]">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                </div>
                <div>
                  <p class="font-bold text-[var(--accent-light)] text-sm">Entrega coordinada directamente</p>
                  <p class="text-[var(--neutral-cream)] text-xs leading-relaxed mt-0.5">Acordaremos los detalles de recogida o entrega directamente a través de WhatsApp al confirmar tu encargo.</p>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div class="flex flex-col gap-2">
                  <label for="customer-name" class="block text-sm font-bold text-[var(--text-primary)]">Tu Nombre <span class="text-[#FF6B6B] font-bold">*</span></label>
                  <input type="text" id="customer-name" required placeholder="Ej: María Pérez" class="w-full px-4 py-3 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl text-base text-[var(--text-primary)] focus:border-[var(--primary)] focus:ring-4 focus:ring-[rgba(232,25,108,0.12)] transition-all outline-none font-medium placeholder:text-[var(--text-light)]/60" />
                </div>
                <div class="flex flex-col gap-2">
                  <label for="customer-phone" class="block text-sm font-bold text-[var(--text-primary)]">Tu WhatsApp <span class="text-[#FF6B6B] font-bold">*</span></label>
                  <input type="tel" id="customer-phone" required placeholder="Ej: 5351234567" pattern="[0-9+ ]{8,16}" class="w-full px-4 py-3 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl text-base text-[var(--text-primary)] focus:border-[var(--primary)] focus:ring-4 focus:ring-[rgba(232,25,108,0.12)] transition-all outline-none font-medium placeholder:text-[var(--text-light)]/60" />
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div class="flex flex-col gap-2">
                  <label for="delivery-date" class="block text-sm font-bold text-[var(--text-primary)]">Fecha Requerida <span class="text-[#FF6B6B] font-bold">*</span></label>
                  <input type="date" id="delivery-date" required class="w-full px-4 py-3 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl text-base text-[var(--text-primary)] focus:border-[var(--primary)] focus:ring-4 focus:ring-[rgba(232,25,108,0.12)] transition-all outline-none cursor-pointer font-medium" />
                </div>
                <div class="flex flex-col gap-2">
                  <label for="delivery-time" class="block text-sm font-bold text-[var(--text-primary)]">Hora Sugerida <span class="text-[#FF6B6B] font-bold">*</span></label>
                  <input type="time" id="delivery-time" required class="w-full px-4 py-3 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl text-base text-[var(--text-primary)] focus:border-[var(--primary)] focus:ring-4 focus:ring-[rgba(232,25,108,0.12)] transition-all outline-none cursor-pointer font-medium" />
                </div>
              </div>
              <p class="text-[var(--accent-light)] text-xs sm:text-sm font-medium">✓ Agendaremos tu encargo al momento de confirmar por WhatsApp.</p>
            </div>

          </form>
        </div>

      <!-- Columna Derecha: Resumen del Encargo (42% aprox / 5 cols) -->
      <div class="lg:col-span-5">
        <div class="bg-[var(--bg-card)] border border-[var(--border-color)] rounded-2xl p-5 sm:p-7 shadow-sm space-y-6 sticky top-8">
          <h3 class="text-lg sm:text-xl font-bold text-[var(--accent-color)] border-b border-[var(--border-color)] pb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-[var(--accent-color)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            Resumen del Encargo
          </h3>
          
          <div id="summary-items-list" class="space-y-4">
            <!-- Inyectado dinámicamente por JS sin límite de altura ni scroll interno -->
          </div>

          <div class="border-t border-[var(--border-color)] pt-4 space-y-2 text-sm text-[var(--text-secondary)]">
            <div class="flex justify-between text-base font-bold text-[var(--accent-color)] pt-1">
              <span>Total Estimado</span>
              <span id="summary-total" class="text-[var(--accent-color)] text-lg">$0 CUP</span>
            </div>
          </div>

          <div class="space-y-4">
            <div class="bg-[var(--bg-secondary)] border border-[var(--border-color)] text-[var(--text-secondary)] text-xs p-3 rounded-xl leading-relaxed space-y-1">
              <p class="flex items-start gap-1.5">
                <svg class="w-4 h-4 text-amber-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <span><strong>Nota importante:</strong> Las temáticas y decoraciones complejas se cobran adicional al valor del cake y se concertarán por WhatsApp.</span>
              </p>
            </div>
  <button type="button" id="confirm-whatsapp-checkout-btn" class="w-full py-4 bg-[#1EB853] hover:bg-[#1A9F4A] active:scale-[0.98] text-[#072412] font-black text-base rounded-xl transition-all shadow-md flex items-center justify-center gap-2.5">
    <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm4.59-12.42L10 14.17l-2.59-2.58L6 13l4 4 8-8z"/>
    </svg>
    Confirmar Encargo
  </button>
            <p id="order-status" class="text-xs text-center font-semibold text-[var(--text-secondary)] leading-relaxed" role="status"></p>
          </div>
        </div>
      </div>
    </div>
  </div>
  </div>

  <!-- Modal / Pop-up de Estado del Encargo y Redirección -->
  <div id="order-modal-overlay" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4 transition-opacity duration-300">
    <div id="order-modal-card" class="bg-[var(--bg-card)] border-2 border-[var(--border-color)] rounded-2xl max-w-md w-full p-6 text-center shadow-2xl relative transform transition-all scale-95 opacity-0">
      <!-- Estado: Cargando / Procesando -->
      <div id="modal-loading-state" class="flex flex-col items-center justify-center py-6 space-y-4">
        <div class="relative w-16 h-16 flex items-center justify-center">
          <div class="w-16 h-16 rounded-full border-4 border-[var(--border-color)] border-t-[var(--accent-color)] animate-spin"></div>
          <span class="absolute text-2xl">🍰</span>
        </div>
        <h3 class="text-xl font-black text-white">Registrando su Encargo</h3>
        <p class="text-sm text-[var(--neutral-cream)] max-w-xs leading-relaxed">
          Estamos procesando los detalles y notificando a la dulcería vía WhatsApp…
        </p>
      </div>

      <!-- Estado: Éxito -->
      <div id="modal-success-state" class="hidden flex-col items-center justify-center py-4 space-y-4">
        <div class="w-16 h-16 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center justify-center text-3xl shadow-lg">
          ✓
        </div>
        <h3 class="text-2xl font-black text-white">¡Encargo Recibido!</h3>
        <p class="text-sm text-[var(--neutral-cream)] leading-relaxed px-2">
          Su encargo ha sido registrado con éxito. En breve nos comunicaremos con usted por WhatsApp para coordinar los detalles.
        </p>
        <div class="w-full bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl p-3 text-xs text-[var(--text-secondary)] flex items-center justify-center gap-2">
          <span>Redirigiendo al inicio en</span>
          <span id="modal-countdown" class="font-black text-base text-[var(--accent-light)]">4</span>
          <span>segundos…</span>
        </div>
        <a href="/" class="inline-block mt-2 text-xs font-bold text-[var(--accent-light)] hover:underline">
          Volver a la tienda ahora →
        </a>
      </div>

      <!-- Estado: Error -->
      <div id="modal-error-state" class="hidden flex-col items-center justify-center py-4 space-y-4">
        <div class="w-16 h-16 rounded-full bg-rose-500/20 text-rose-400 border border-rose-500/40 flex items-center justify-center text-3xl shadow-lg">
          ✕
        </div>
        <h3 class="text-xl font-black text-white">Hubo un Inconveniente</h3>
        <p id="modal-error-message" class="text-sm text-rose-300 leading-relaxed px-2">
          No se pudo completar el encargo en este momento.
        </p>
        <button type="button" id="modal-close-btn" class="w-full py-3 bg-[var(--bg-secondary)] hover:bg-[var(--border-color)] text-white font-bold text-sm rounded-xl transition-colors border border-[var(--border-color)]">
          Cerrar y Revisar
        </button>
      </div>
    </div>
  </div>
</Layout>

<style>
  .checkout-page-container {
    max-width: 1200px;
    margin: 2rem auto 4rem auto;
    padding: 0 1.5rem;
    color: var(--text-primary);
  }

  .checkout-header {
    margin-bottom: 2.5rem;
  }

  .back-link {
    color: var(--accent-color);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    display: inline-block;
    margin-bottom: 1rem;
    transition: transform var(--transition-fast);
  }

  .back-link:hover {
    transform: translateX(-4px);
  }

  .checkout-header h1 {
    font-size: 2.2rem;
    font-family: var(--font-display);
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .checkout-header p {
    color: var(--text-secondary);
    font-size: 1.05rem;
  }

  .checkout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 992px) {
    .checkout-grid {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  /* Form Styles */
  .premium-form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .form-section {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-md);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
  }

  .form-section h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-light);
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .form-group-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 600px) {
    .form-group-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .form-group label {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.85rem;
    border: 1.5px solid var(--border-color);
    border-radius: var(--border-radius-md);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    background-color: var(--bg-primary);
    color: var(--text-primary);
    outline: none;
    transition: all var(--transition-fast);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--primary);
    background-color: var(--bg-card);
    box-shadow: 0 0 0 3px rgba(232, 25, 108, 0.18);
  }

  .required {
    color: #ef4444;
    font-weight: bold;
  }

  .section-hint {
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin-top: 0.5rem;
  }

  /* Customizer Sub-Blocks */
  .cake-customizer-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-md);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .cake-customizer-card h4 {
    font-size: 1.05rem;
    color: var(--accent-light);
    font-weight: 700;
    margin-bottom: 1rem;
  }

  /* Summary Card */
  .summary-card {
    background-color: var(--bg-card);
    border: 2px solid var(--accent-color);
    border-radius: var(--border-radius-md);
    padding: 2rem;
    box-shadow: var(--shadow-md);
    position: sticky;
    top: 100px;
  }

  .summary-card h3 {
    font-size: 1.4rem;
    color: var(--accent-color);
    margin-bottom: 1.5rem;
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .summary-items-list {
    max-height: 350px;
    overflow-y: auto;
    margin-bottom: 1.5rem;
  }

  /* Premium Checkout Item Card */
  .summary-item-card {
    display: flex;
    gap: 1rem;
    padding: 0.85rem;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    margin-bottom: 1rem;
    align-items: center;
  }

  .summary-thumbnail-container {
    width: 60px;
    height: 60px;
    border-radius: var(--border-radius-sm);
    overflow: hidden;
    border: 1.5px solid var(--border-color);
    flex-shrink: 0;
  }

  .summary-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .summary-info {
    flex: 1;
    min-width: 0;
  }

  .summary-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .summary-info h4 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    word-break: break-word;
  }

  .summary-price {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--accent-light);
    margin-left: 0.5rem;
  }

  .summary-meta {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Color-coded Icon Styling */
  .category-icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    font-size: 0.85rem;
  }

  /* Breakdown Prices */
  .price-breakdown {
    border-top: 1px dashed var(--border-color);
    padding-top: 1rem;
    margin-bottom: 1.5rem;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.92rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .total-row {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--accent-light);
    border-top: 2px double var(--border-color);
    padding-top: 0.75rem;
    margin-top: 0.75rem;
  }

  .checkout-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cart-note-warning {
    font-size: 0.8rem;
    color: #b45309;
    background-color: #fffbeb;
    border: 1px solid #fef3c7;
    padding: 0.75rem;
    border-radius: var(--border-radius-sm);
    line-height: 1.3;
  }

  /* Checkout Button with Pulse */
  .btn-checkout-whatsapp {
    background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
    border: none;
    color: #FFFFFF;
    font-weight: bold;
    padding: 1.1rem;
    border-radius: var(--border-radius-md);
    cursor: pointer;
    text-align: center;
    font-size: 1.1rem;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3);
    animation: whatsappCheckoutPulse 2.5s infinite;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .btn-checkout-whatsapp:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.45);
    background: linear-gradient(135deg, #2ae772 0%, #16a090 100%);
  }

  @keyframes whatsappCheckoutPulse {
    0% {
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.6);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(37, 211, 102, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0);
    }
  }

  /* File Uploader within form */
  .customizer-upload-area {
    margin-top: 0.75rem;
    border: 2px dashed var(--accent-color);
    padding: 1.25rem;
    border-radius: var(--border-radius-md);
    text-align: center;
    background-color: var(--bg-card);
    position: relative;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .customizer-upload-area:hover {
    background-color: rgba(255, 107, 53, 0.1);
    border-color: var(--accent-light);
  }

  .customizer-upload-label {
    font-size: 0.9rem;
    color: var(--text-primary);
    font-weight: 600;
    display: block;
    cursor: pointer;
  }

  .edible-print-option {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-primary);
    cursor: pointer;
    background-color: var(--bg-primary);
    padding: 0.85rem 1rem;
    border-radius: var(--border-radius-md);
    border: 1.5px solid var(--border-color);
    width: 100%;
    transition: all var(--transition-fast);
  }

  .edible-print-option:hover {
    background-color: rgba(255, 107, 53, 0.1);
    border-color: var(--accent-light);
  }

  .edible-print-option input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: var(--primary-color);
    cursor: pointer;
    margin: 0;
  }

  .customizer-upload-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  .customizer-file-preview {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--primary-color);
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .customizer-file-preview img {
    width: 50px;
    height: 50px;
    object-fit: cover;
    border-radius: var(--border-radius-sm);
    border: 1px solid var(--border-color);
  }

  .dough-warning-banner {
    background-color: #FFFbeb;
    border: 1px solid #fef3c7;
    color: #b45309;
    padding: 0.6rem;
    font-size: 0.78rem;
    border-radius: var(--border-radius-sm);
    margin-top: 0.5rem;
    line-height: 1.3;
  }

  /* Custom styled date/time pickers */
  input[type="date"], input[type="time"] {
    position: relative;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23FF8C42' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3crect x='3' y='4' width='18' height='18' rx='2' ry='2'%3e%3c/rect%3e%3cline x1='16' y1='2' x2='16' y2='6'%3e%3c/line%3e%3cline x1='8' y1='2' x2='8' y2='6'%3e%3c/line%3e%3cline x1='3' y1='10' x2='21' y2='10'%3e%3c/line%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 1rem center;
    background-size: 1.25rem;
    padding-right: 2.75rem;
    cursor: pointer;
  }
  
  input[type="time"] {
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23FF8C42' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3ccircle cx='12' cy='12' r='10'%3e%3c/circle%3e%3cpolyline points='12 6 12 12 16 14'%3e%3c/polyline%3e%3c/svg%3e");
  }
  
  input[type="date"]::-webkit-calendar-picker-indicator,
  input[type="time"]::-webkit-calendar-picker-indicator {
    background: transparent;
    bottom: 0;
    color: transparent;
    cursor: pointer;
    height: auto;
    left: 0;
    position: absolute;
    right: 0;
    top: 0;
    width: auto;
  }

  /* Custom dropdown arrow for selects */
  select.dough-select-field {
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23FF8C42' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 1rem center;
    background-size: 1.2rem;
    padding-right: 2.75rem;
  }

  /* Custom styling for file upload area overlap: invisible pero interactuable al 100% */
  .decorations-ref-upload-input,
  .customizer-upload-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0 !important;
    cursor: pointer;
    font-size: 0;
    overflow: hidden;
    z-index: 5;
  }

  /* Evitar que cualquier texto desborde su contenedor en móviles estrechos */
  .upload-box-wrapper {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }

  @media (max-width: 991px) {
    .summary-card {
      position: relative;
      top: auto;
    }
  }
</style>

<script define:vars={{ initialCatalog }}>
  let cart = [];
  const uploadedImages = {};

  // DOM Elements
  const summaryItemsList = document.getElementById('summary-items-list');
  const summarySubtotal = document.getElementById('summary-subtotal');
  const summaryDoughExtra = document.getElementById('summary-dough-extra');
  const summaryAddonsExtra = document.getElementById('summary-addons-extra');
  const summaryTotal = document.getElementById('summary-total');
  const confirmWhatsappCheckoutBtn = document.getElementById('confirm-whatsapp-checkout-btn');
  const cakesCustomizersContainer = document.getElementById('cakes-customizers-container');
  const cakesCustomizationSection = document.getElementById('cakes-customization-section');

  // Load Cart
  const loadCart = () => {
    const savedCart = localStorage.getItem('el_lider_cart');
    if (savedCart) {
      try {
        cart = JSON.parse(savedCart);
      } catch (e) {
        cart = [];
      }
    }
    // Initialize properties if missing
    cart.forEach(item => {
      item.uniqueId = item.uniqueId || (Date.now() + Math.random()).toString();
      if (item.customizable) {
        // Garantizar que item.options tenga las opciones base del catálogo si no viniesen definidas
        if (!item.options || Object.keys(item.options).length === 0) {
          item.options = {};
          if (activeCatalog && activeCatalog.product_options) {
            const prodOpts = activeCatalog.product_options.filter(po => po.product_id === item.id && po.is_enabled);
            // Regla mandatoria: Si tiene Tipo de Masa, forzar siempre Harina como base
            const masaHarina = prodOpts.find(po => po.option_id === 'masa' && po.option_value_id === 'masa-harina');
            if (masaHarina) {
              item.options['masa'] = 'masa-harina';
            }
            prodOpts.forEach(po => {
              if (po.is_base && po.option_id !== 'altura' && !item.options[po.option_id]) {
                item.options[po.option_id] = po.option_value_id;
              }
            });
          }
        }
        // Altura doble es estrictamente booleana y opcional: si no fue activada explícitamente, se remueve de options
        if (item.options && item.options['altura'] && item.doubleHeight !== true) {
          delete item.options['altura'];
        }
      }
    });

    if (cart.length === 0) {
      // Mock items for layout preview and screenshots
      cart = [
        { id: 'cake-redondo', name: 'Cakes Redondos', price: 3500, quantity: 1, customizable: true, category: 'cakes', dough: 'trigo', size: '25', doubleHeight: true, note: 'Decoración de chocolate blanco', ediblePrint: false },
        { id: 'minicake', name: 'Mini Cakes', price: 2500, quantity: 1, customizable: true, category: 'minicakes', dough: 'maicena', doubleHeight: false }
      ];
      console.log('Test Mode: Empty cart filled with mockup items.');
    }
  };

  // Sort cart: cakes first, then buffet items
  const sortCart = () => {
    cart.sort((a, b) => {
      const typeA = a.type || 'cakes';
      const typeB = b.type || 'cakes';
      if (typeA === 'cakes' && typeB === 'buffet') return -1;
      if (typeA === 'buffet' && typeB === 'cakes') return 1;
      return (b.price || 0) - (a.price || 0);
    });
  };

  // Helper to build cohesive item title without fragmented surcharges
  const getItemFullTitle = (item) => {
    let name = item.name;
    let parts = [];

    if (activeCatalog && activeCatalog.product_options && item.options) {
      // Nueva estructura: options es un map de option_id -> option_value_id
      Object.keys(item.options).forEach(optId => {
        const valId = item.options[optId];
        const poObj = activeCatalog.product_options.find(
          po => po.product_id === item.id && po.option_id === optId && po.option_value_id === valId
        );
        if (poObj && !poObj.is_base) {
          parts.push(`${poObj.option_name}: ${poObj.option_value_name}`);
        }
      });
    } else {
      // Fallback para compatibilidad con estructura anterior
      if (item.attributes) {
        Object.keys(item.attributes).forEach(attrId => {
          const optId = item.attributes[attrId];
          const vObj = activeCatalog?.variations?.find(v => v.product_id === item.id && v.option_id === optId);
          if (vObj && vObj.is_base !== 1) {
            parts.push(`${vObj.attribute_name}: ${vObj.option_name}`);
          }
        });
      }
    }

    if (item.ediblePrint) {
      parts.push('con impresión comestible');
    }

    if (parts.length > 0) {
      return `${name} (${parts.join(', ')})`;
    }
    return name;
  };

  // Icon classification based on product type with SVG markup
  const getProductIcon = (item) => {
    const id = item.id;
    if (id === 'minicake' || id.includes('cupcake')) {
      return { 
        svg: `<svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" /></svg>`, 
        color: '#E8196C', 
        label: 'Mini Cake / Cupcake' 
      };
    }
    if (id === 'cake-bandeja') {
      return { 
        svg: `<svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" /></svg>`, 
        color: '#FF6B35', 
        label: 'Bandeja' 
      };
    }
    if (id === 'cake-varios-pisos' || id.includes('2pisos')) {
      return { 
        svg: `<svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>`, 
        color: '#FFA07A', 
        label: 'Varios Pisos' 
      };
    }
    if (id === 'cake-redondo' || id.includes('cake-') || id === 'minicake-15' || id.includes('medio-cake')) {
      return { 
        svg: `<svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 15.546c-.523 0-1.046.151-1.5.454a2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0 2.701 2.701 0 00-1.5-.454M9 6v2m3-2v2m3-2v2M9 3h.01M12 3h.01M15 3h.01M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" /></svg>`, 
        color: '#FF8C42', 
        label: 'Cake por Encargo' 
      };
    }
    return { 
      svg: `<svg class="w-4 h-4 text-[#2D2A26]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke-linecap="round" stroke-linejoin="round"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 16h.01M16 12h.01M12 8h.01" /></svg>`, 
      color: '#F5E6C8', 
      label: 'Buffet/Postre' 
    };
  };

  const RULES = {
    'minicake-15': {
      basePrice: 2500,
      doughs: [{ id: 'trigo', label: 'Harina de trigo ($2500 CUP)', price: 2500 }],
      hasDouble: false
    },
    'cake-22': {
      basePrice: 3800,
      doughs: [
        { id: 'trigo', label: 'Harina de trigo ($3800 CUP)', price: 3800 },
        { id: 'capuchino', label: 'Capuchino ($6900 CUP)', price: 6900 }
      ],
      hasDouble: true,
      doublePrice: 2700 // harina doble = 6500, capuchino doble = 9700
    },
    'cake-20': {
      basePrice: 3900,
      doughs: [{ id: 'maicena', label: 'Masa de Maicena ($3900 CUP)', price: 3900 }],
      hasDouble: true,
      doublePrice: 2800 // altura 15cm = 6700
    },
    'cupcake': {
      basePrice: 160,
      doughs: [
        { id: 'vainilla', label: 'Sabor Vainilla ($160 CUP)', price: 160 },
        { id: 'chocolate', label: 'Sabor Chocolate ($165 CUP)', price: 165 }
      ],
      hasDouble: false
    },
    'cake-25': {
      basePrice: 6500,
      doughs: [
        { id: 'trigo', label: 'Harina de trigo ($6500 CUP)', price: 6500 },
        { id: 'capuchino', label: 'Capuchino ($12500 CUP)', price: 12500 }
      ],
      hasDouble: false
    },
    'cake-30': {
      basePrice: 14000,
      doughs: [{ id: 'trigo', label: 'Harina de trigo ($14000 CUP)', price: 14000 }],
      hasDouble: false
    },
    'cake-36': {
      basePrice: 18000,
      doughs: [{ id: 'trigo', label: 'Harina de trigo ($18000 CUP)', price: 18000 }],
      hasDouble: false
    },
    'medio-cake-bandeja': {
      basePrice: 6700,
      doughs: [{ id: 'trigo', label: 'Harina de trigo ($6700 CUP)', price: 6700 }],
      hasDouble: false
    },
    'cake-bandeja': {
      basePrice: 13500,
      doughs: [
        { id: 'trigo', label: 'Harina de trigo ($13500 CUP)', price: 13500 },
        { id: 'maicena', label: 'Masa de Maicena ($14000 CUP)', price: 14000 },
        { id: 'capuchino', label: 'Capuchino ($20000 CUP)', price: 20000 }
      ],
      hasDouble: false
    },
    'cake-2pisos-bandeja': {
      basePrice: 17000,
      doughs: [{ id: 'trigo', label: 'Masa de Harina ($17000 CUP)', price: 17000 }],
      hasDouble: false
    },
    'cake-2pisos-redondo': {
      basePrice: 18000,
      doughs: [{ id: 'trigo', label: 'Masa de Harina (Desde $18000 CUP)', price: 18000 }],
      hasDouble: false
    }
  };

  // Cargar catálogo dinámico con opciones asignadas desde localStorage o initial
  const CATALOG_VERSION = 'v5_cake_3pisos_unificado';
  let activeCatalog = initialCatalog;
  try {
    const savedVer = localStorage.getItem('el_lider_catalog_version');
    const saved = localStorage.getItem('el_lider_admin_catalog');
    if (saved && savedVer === CATALOG_VERSION) {
      activeCatalog = JSON.parse(saved);
    }
  } catch (e) {}

  // Formateador de precios en miles (ej: 1.000.000)
  const formatMiles = (val) => {
    const num = Math.round(Number(val) || 0);
    return num.toLocaleString('es-ES');
  };

  const calculateItemUnitPrice = (item) => {
    let unit = item.price || 0;

    // 1. Prioridad: Buscar en product_combinations explícitos (ej: capuchino + doble = 9700)
    if (activeCatalog && activeCatalog.product_combinations && item.options) {
      const combos = activeCatalog.product_combinations.filter(c => c.product_id === item.id);
      for (const combo of combos) {
        const matchesAll = Object.entries(combo.option_values).every(
          ([optId, valId]) => item.options[optId] === valId
        );
        if (matchesAll) {
          unit = combo.direct_price;
          if (item.ediblePrint) unit += (activeCatalog?.ediblePrintPrice || 900);
          return unit;
        }
      }
    }

    // 2. Si no hay combo multi-opción, buscar en product_options individuales
    if (activeCatalog && activeCatalog.product_options && item.options) {
      const optEntries = Object.entries(item.options);
      const prodOpts = activeCatalog.product_options.filter(
        po => po.product_id === item.id && po.is_enabled
      );

      // Si el cliente seleccionó alguna opción no-base, tomar su precio directo
      let foundDirectPrice = null;
      for (const [optId, valId] of optEntries) {
        const match = prodOpts.find(po => po.option_id === optId && po.option_value_id === valId);
        if (match && !match.is_base) {
          foundDirectPrice = match.direct_price;
          break;
        }
      }

      if (foundDirectPrice !== null) {
        unit = foundDirectPrice;
      } else {
        const baseOpt = prodOpts.find(po => po.is_base);
        if (baseOpt) unit = baseOpt.direct_price;
      }
    } else {
      // Fallback a reglas históricas
      const rule = RULES[item.id];
      if (rule) {
        const selectedDough = rule.doughs?.find(d => d.id === item.dough) || rule.doughs?.[0];
        unit = selectedDough ? selectedDough.price : rule.basePrice;
        if (item.doubleHeight && rule.hasDouble) {
          unit += (rule.doublePrice || 0);
        }
      }
    }

    if (item.ediblePrint) {
      unit += (activeCatalog?.ediblePrintPrice || 900);
    }

    return unit;
  };

  const renderSummaryItems = () => {
    if (!summaryItemsList) return;
    sortCart();
    
    if (cart.length === 0) {
      summaryItemsList.innerHTML = `
        <div class="text-center py-6 px-3 bg-[var(--bg-primary)] border border-dashed border-[var(--border-color)] rounded-xl">
          <p class="text-sm text-[var(--text-secondary)]">No hay productos en su encargo.</p>
          <a href="/#catalogo" class="inline-block mt-2 text-xs font-bold text-[var(--accent-light)] hover:underline">Ir al Catálogo →</a>
        </div>
      `;
      return;
    }

    let html = '';
    
    cart.forEach((item, index) => {
      const customizedUnitPrice = calculateItemUnitPrice(item);
      const fullTitle = getItemFullTitle(item);
      const subtotal = customizedUnitPrice * item.quantity;

      // Obtener imagen del producto (prioridad: item.image o la imagen del catálogo)
      let itemImg = item.image || '';
      if (!itemImg && activeCatalog && activeCatalog.products) {
        const prod = activeCatalog.products.find(p => p.id === item.id);
        if (prod) {
          itemImg = prod.image || (prod.images && prod.images[0]) || '';
        }
      }

      html += `
        <div class="flex flex-col gap-3 bg-[var(--bg-primary)] border border-[var(--border-color)] p-3.5 sm:p-4 rounded-xl shadow-sm relative group">
          <!-- Bloque Superior: Miniatura + Título -->
          <div class="flex items-center gap-3">
            ${itemImg ? `
              <div class="w-14 h-14 sm:w-16 sm:h-16 flex-shrink-0 rounded-lg overflow-hidden border border-[var(--border-color)] bg-[var(--bg-secondary)] shadow-inner">
                <img src="${itemImg}" alt="${item.name || fullTitle}" class="w-full h-full object-cover" loading="lazy" />
              </div>
            ` : `
              <div class="w-14 h-14 sm:w-16 sm:h-16 flex-shrink-0 rounded-lg flex items-center justify-center border border-[var(--border-color)] bg-[var(--bg-secondary)] text-2xl">
                🎂
              </div>
            `}
            <h4 class="text-sm sm:text-base font-black text-white leading-snug flex-1">${fullTitle}</h4>
          </div>
          
          <!-- Bloque Inferior: Primero Precio (Subtotal) a la izquierda, y a la derecha el selector de cantidad + botón eliminar -->
          <div class="flex items-center justify-between pt-2.5 border-t border-[var(--border-color)]/50 mt-0.5">
            <div class="text-left">
              <span class="text-[11px] text-[var(--text-secondary)] block font-medium">Subtotal</span>
              <span class="text-[var(--accent-light)] font-black text-base sm:text-lg whitespace-nowrap">$${formatMiles(subtotal)} CUP</span>
            </div>

            <div class="flex items-center gap-2">
              <div class="inline-flex items-center bg-[var(--bg-secondary)] border border-[var(--border-color)] rounded-lg p-0.5">
                <button 
                  type="button" 
                  class="summary-qty-minus w-7 h-7 flex items-center justify-center text-white hover:bg-[var(--border-color)] rounded-md font-bold transition-colors select-none" 
                  data-index="${index}" 
                  title="Disminuir cantidad"
                >−</button>
                <span class="w-8 text-center text-sm font-black text-white select-none">${item.quantity}</span>
                <button 
                  type="button" 
                  class="summary-qty-plus w-7 h-7 flex items-center justify-center text-white hover:bg-[var(--border-color)] rounded-md font-bold transition-colors select-none" 
                  data-index="${index}" 
                  title="Aumentar cantidad"
                >+</button>
              </div>

              <!-- Botón Eliminar Producto al lado del selector -->
              <button 
                type="button" 
                class="summary-remove-btn text-zinc-400 hover:text-rose-400 p-1.5 rounded-lg hover:bg-rose-500/10 transition-colors border border-transparent hover:border-rose-500/30" 
                data-index="${index}" 
                title="Eliminar este producto del encargo"
              >
                <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      `;
    });
    summaryItemsList.innerHTML = html;

    // Vincular eventos de los botones de cantidad y eliminación
    summaryItemsList.querySelectorAll('.summary-qty-plus').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt(e.currentTarget.getAttribute('data-index') || '0', 10);
        if (cart[idx]) {
          cart[idx].quantity = (cart[idx].quantity || 1) + 1;
          updateTotals();
        }
      });
    });

    summaryItemsList.querySelectorAll('.summary-qty-minus').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt(e.currentTarget.getAttribute('data-index') || '0', 10);
        if (cart[idx]) {
          if (cart[idx].quantity > 1) {
            cart[idx].quantity -= 1;
          } else {
            // Si baja de 1, confirmar eliminación
            cart.splice(idx, 1);
            renderCakesCustomizers();
          }
          updateTotals();
        }
      });
    });

    summaryItemsList.querySelectorAll('.summary-remove-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt(e.currentTarget.getAttribute('data-index') || '0', 10);
        if (cart[idx]) {
          cart.splice(idx, 1);
          renderCakesCustomizers();
          updateTotals();
        }
      });
    });
  };

  const renderCakesCustomizers = () => {
    if (!cakesCustomizersContainer) return;
    
    const customizableCakes = cart.filter(item => item.customizable);

    if (customizableCakes.length === 0) {
      if (cakesCustomizationSection) cakesCustomizationSection.style.display = 'none';
      return;
    }

    if (cakesCustomizationSection) cakesCustomizationSection.style.display = 'block';
    
    let html = '';
    customizableCakes.forEach((item, idx) => {
      const globalIdx = cart.indexOf(item);
      let dynamicAttributesHtml = '';

      // Obtener opciones asignadas dinámicamente desde el catálogo activo
      if (activeCatalog && activeCatalog.product_options) {
        const prodOpts = activeCatalog.product_options.filter(po => po.product_id === item.id && po.is_enabled);
        
        // Agrupar por opción
        const optGroups = {};
        prodOpts.forEach(po => {
          if (!optGroups[po.option_id]) {
            optGroups[po.option_id] = {
              optId: po.option_id,
              optName: po.option_name,
              values: []
            };
          }
          optGroups[po.option_id].values.push(po);
        });

        // Renderizar opciones: Altura se renderiza como Checkbox booleano opcional; otras (como Masa) como select con Harina por defecto
        Object.keys(optGroups).forEach(optId => {
          const group = optGroups[optId];
          const isHeightOption = optId === 'altura' || optId.includes('doble') || optId.includes('altura');

