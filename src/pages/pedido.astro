---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Completar Encargo">
  <div class="min-h-screen bg-gradient-to-b from-[var(--bg-primary)] via-[var(--bg-secondary)] to-[var(--bg-primary)] py-8 sm:py-12 text-[var(--text-primary)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8 sm:mb-10">
        <a href="/" class="inline-flex items-center text-sm font-semibold text-[var(--accent-light)] hover:text-white transition-colors mb-5 gap-1">← Volver a la Dulcería</a>

        <!-- Badge de mensajería -->
        <div class="inline-flex items-center gap-2 bg-gradient-to-r from-[rgba(255,107,53,0.2)] to-[rgba(232,25,108,0.15)] border border-[rgba(255,140,66,0.4)] rounded-full px-4 py-1.5 mb-4">
          <span class="text-base">🛵</span>
          <span class="text-xs font-bold text-[var(--accent-light)] uppercase tracking-wide">Mensajería a domicilio disponible en toda Camagüey</span>
        </div>

        <h1 style="font-family: var(--font-display); font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 700; color: #FFFFFF; margin-bottom: 0.5rem; line-height: 1.2;">🧁 ¡Casi listo! Personaliza tu pedido</h1>
        <p class="text-[var(--neutral-cream)] text-base sm:text-lg leading-relaxed" style="max-width: 560px;">
          Define los detalles de tu cake soñado y te lo llevamos hasta tu puerta. Nuestro servicio de mensajería cubre <strong style="color: #FF8C42;">toda la provincia de Camagüey</strong>.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Columna Izquierda: Formulario -->
        <div class="lg:col-span-2">
          <form id="checkout-form" class="space-y-8">
            
            <!-- Bloque 1: Personalización de los Cakes -->
            <div class="bg-[var(--bg-card)] border border-[var(--border-color)] rounded-2xl p-6 sm:p-8 shadow-md hover:shadow-lg transition-shadow space-y-6" id="cakes-customization-section">
              <h3 class="text-lg sm:text-xl font-bold text-[var(--accent-light)] border-b border-[var(--border-color)] pb-4 flex items-center gap-2">🎨 1. Personalización de tus Cakes</h3>
              <div id="cakes-customizers-container" class="space-y-6">
                <!-- Se inyecta dinámicamente con JS para cada cake del carrito -->
              </div>
            </div>

            <!-- Bloque 2: Detalles de Entrega -->
            <div class="bg-[var(--bg-card)] border border-[var(--border-color)] rounded-2xl p-6 sm:p-8 shadow-md hover:shadow-lg transition-shadow space-y-6">
              <h3 class="text-lg sm:text-xl font-bold text-[var(--accent-light)] border-b border-[var(--border-color)] pb-4 flex items-center gap-2">📦 2. ¿Cómo prefieres recibirlo?</h3>

              <!-- Banner mensajería -->
              <div class="flex items-start gap-3 bg-gradient-to-r from-[rgba(255,107,53,0.15)] to-[rgba(232,25,108,0.1)] border border-[rgba(255,140,66,0.35)] rounded-xl p-4">
                <span class="text-2xl">🛵</span>
                <div>
                  <p class="font-bold text-[var(--accent-light)] text-sm">Entrega a domicilio disponible</p>
                  <p class="text-[var(--neutral-cream)] text-xs leading-relaxed mt-0.5">Llevamos tu pedido hasta donde estés en toda la provincia de Camagüey. Coordinaremos el costo de envío al confirmar por WhatsApp.</p>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div class="flex flex-col gap-2">
                  <label for="delivery-date" class="block text-sm font-bold text-[var(--text-primary)]">Fecha Requerida <span class="text-[#FF6B6B] font-bold">*</span></label>
                  <input type="date" id="delivery-date" required class="w-full px-4 py-3 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl text-base text-[var(--text-primary)] focus:border-[var(--primary)] focus:ring-4 focus:ring-[rgba(232,25,108,0.12)] transition-all outline-none cursor-pointer font-medium" />
                </div>
                <div class="flex flex-col gap-2">
                  <label for="delivery-time" class="block text-sm font-bold text-[var(--text-primary)]">Hora Sugerida <span class="text-[#FF6B6B] font-bold">*</span></label>
                  <input type="time" id="delivery-time" required class="w-full px-4 py-3 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-xl text-base text-[var(--text-primary)] focus:border-[var(--primary)] focus:ring-4 focus:ring-[rgba(232,25,108,0.12)] transition-all outline-none cursor-pointer font-medium" />
                </div>
              </div>
              <p class="text-[var(--accent-light)] text-xs sm:text-sm font-medium">✓ Agendaremos tu pedido al momento de confirmar por WhatsApp.</p>
            </div>

          </form>
        </div>

      <!-- Columna Derecha: Resumen de Pedido -->
      <div class="lg:col-span-1">
        <div class="bg-[var(--bg-card)] border border-[var(--border-color)] rounded-2xl p-6 sm:p-8 shadow-sm space-y-6 sticky top-8">
          <h3 class="text-lg sm:text-xl font-bold text-[var(--accent-color)] border-b border-[var(--border-color)] pb-4 flex items-center gap-2">🛒 Resumen del Encargo</h3>
          
          <div id="summary-items-list" class="space-y-4 max-h-[350px] overflow-y-auto pr-1">
            <!-- Inyectado dinámicamente por JS -->
          </div>

          <div class="border-t border-[var(--border-color)] pt-4 space-y-2 text-sm text-[var(--text-secondary)]">
            <div class="flex justify-between">
              <span>Subtotal dulces</span>
              <span id="summary-subtotal" class="font-semibold text-[var(--text-primary)]">$0 CUP</span>
            </div>
            <div class="flex justify-between">
              <span>Masa maicena/capuchino</span>
              <span id="summary-dough-extra" class="font-semibold text-[var(--text-primary)]">$0 CUP</span>
            </div>
            <div class="flex justify-between">
              <span>Impresión comestible</span>
              <span id="summary-addons-extra" class="font-semibold text-[var(--text-primary)]">$0 CUP</span>
            </div>
            <div class="flex justify-between text-base font-bold text-[var(--accent-color)] border-t border-[var(--border-color)] pt-3 mt-2">
              <span>Total Estimado</span>
              <span id="summary-total" class="text-[var(--accent-color)]">$0 CUP</span>
            </div>
          </div>

          <div class="space-y-4">
            <div class="bg-[var(--bg-secondary)] border border-[var(--border-color)] text-[var(--text-secondary)] text-xs p-3 rounded-xl leading-relaxed">
              ⚠️ La decoración final y precio de cakes personalizados se acordará por WhatsApp. Decoraciones complejas pueden variar el precio.
            </div>
            <button type="button" id="confirm-whatsapp-checkout-btn" class="w-full py-4 bg-[#25D366] hover:bg-[#20ba59] active:scale-[0.98] text-white font-bold text-base rounded-xl transition-all shadow-md flex items-center justify-center gap-2">
              Confirmar Pedido vía WhatsApp 💬
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .checkout-page-container {
    max-width: 1200px;
    margin: 2rem auto 4rem auto;
    padding: 0 1.5rem;
    color: var(--text-primary);
  }

  .checkout-header {
    margin-bottom: 2.5rem;
  }

  .back-link {
    color: var(--accent-color);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    display: inline-block;
    margin-bottom: 1rem;
    transition: transform var(--transition-fast);
  }

  .back-link:hover {
    transform: translateX(-4px);
  }

  .checkout-header h1 {
    font-size: 2.2rem;
    font-family: var(--font-serif);
    color: var(--primary-dark);
    margin-bottom: 0.5rem;
  }

  .checkout-header p {
    color: var(--text-secondary);
    font-size: 1.05rem;
  }

  .checkout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 992px) {
    .checkout-grid {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  /* Form Styles */
  .premium-form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .form-section {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-md);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
  }

  .form-section h3 {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--primary-dark);
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .form-group-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 600px) {
    .form-group-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .form-group label {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.85rem;
    border: 1.5px solid var(--border-color);
    border-radius: var(--border-radius-md);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    background-color: var(--bg-primary);
    color: var(--text-primary);
    outline: none;
    transition: all var(--transition-fast);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--accent-color);
    background-color: var(--bg-card);
    box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15);
  }

  .required {
    color: #ef4444;
    font-weight: bold;
  }

  .section-hint {
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin-top: 0.5rem;
  }

  /* Customizer Sub-Blocks */
  .cake-customizer-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-md);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    border-left: 4px solid var(--accent-color);
    box-shadow: var(--shadow-sm);
  }

  .cake-customizer-card h4 {
    font-size: 1.05rem;
    color: var(--primary-dark);
    font-weight: 800;
    margin-bottom: 1rem;
  }

  /* Summary Card */
  .summary-card {
    background-color: var(--bg-card);
    border: 2px solid var(--accent-color);
    border-radius: var(--border-radius-md);
    padding: 2rem;
    box-shadow: var(--shadow-md);
    position: sticky;
    top: 100px;
  }

  .summary-card h3 {
    font-size: 1.4rem;
    color: var(--accent-color);
    margin-bottom: 1.5rem;
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .summary-items-list {
    max-height: 350px;
    overflow-y: auto;
    margin-bottom: 1.5rem;
  }

  /* Premium Checkout Item Card */
  .summary-item-card {
    display: flex;
    gap: 1rem;
    padding: 0.85rem;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    margin-bottom: 1rem;
    align-items: center;
  }

  .summary-thumbnail-container {
    width: 60px;
    height: 60px;
    border-radius: var(--border-radius-sm);
    overflow: hidden;
    border: 1.5px solid var(--border-color);
    flex-shrink: 0;
  }

  .summary-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .summary-info {
    flex: 1;
    min-width: 0;
  }

  .summary-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .summary-info h4 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--primary-dark);
    margin: 0;
    word-break: break-word;
  }

  .summary-price {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--primary-color);
    margin-left: 0.5rem;
  }

  .summary-meta {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Color-coded Icon Styling */
  .category-icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    font-size: 0.85rem;
  }

  /* Breakdown Prices */
  .price-breakdown {
    border-top: 1px dashed var(--border-color);
    padding-top: 1rem;
    margin-bottom: 1.5rem;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.92rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .total-row {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--primary-dark);
    border-top: 2px double var(--border-color);
    padding-top: 0.75rem;
    margin-top: 0.75rem;
  }

  .checkout-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cart-note-warning {
    font-size: 0.8rem;
    color: #b45309;
    background-color: #fffbeb;
    border: 1px solid #fef3c7;
    padding: 0.75rem;
    border-radius: var(--border-radius-sm);
    line-height: 1.3;
  }

  /* Checkout Button with Pulse */
  .btn-checkout-whatsapp {
    background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
    border: none;
    color: #FFFFFF;
    font-weight: bold;
    padding: 1.1rem;
    border-radius: var(--border-radius-md);
    cursor: pointer;
    text-align: center;
    font-size: 1.1rem;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3);
    animation: whatsappCheckoutPulse 2.5s infinite;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .btn-checkout-whatsapp:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.45);
    background: linear-gradient(135deg, #2ae772 0%, #16a090 100%);
  }

  @keyframes whatsappCheckoutPulse {
    0% {
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.6);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(37, 211, 102, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0);
    }
  }

  /* File Uploader within form */
  .customizer-upload-area {
    margin-top: 0.75rem;
    border: 2px dashed var(--accent-color);
    padding: 1.25rem;
    border-radius: var(--border-radius-md);
    text-align: center;
    background-color: var(--bg-card);
    position: relative;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .customizer-upload-area:hover {
    background-color: rgba(212, 175, 55, 0.05);
    border-color: var(--accent-dark);
  }

  .customizer-upload-label {
    font-size: 0.9rem;
    color: var(--text-primary);
    font-weight: 600;
    display: block;
    cursor: pointer;
  }

  .edible-print-option {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-primary);
    cursor: pointer;
    background-color: var(--bg-primary);
    padding: 0.85rem 1rem;
    border-radius: var(--border-radius-md);
    border: 1.5px solid var(--border-color);
    width: 100%;
    transition: all var(--transition-fast);
  }

  .edible-print-option:hover {
    background-color: rgba(212, 175, 55, 0.05);
    border-color: var(--accent-color);
  }

  .edible-print-option input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: var(--primary-color);
    cursor: pointer;
    margin: 0;
  }

  .customizer-upload-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  .customizer-file-preview {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--primary-color);
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .customizer-file-preview img {
    width: 50px;
    height: 50px;
    object-fit: cover;
    border-radius: var(--border-radius-sm);
    border: 1px solid var(--border-color);
  }

  .dough-warning-banner {
    background-color: #FFFbeb;
    border: 1px solid #fef3c7;
    color: #b45309;
    padding: 0.6rem;
    font-size: 0.78rem;
    border-radius: var(--border-radius-sm);
    margin-top: 0.5rem;
    line-height: 1.3;
  }

  /* Custom styled date/time pickers */
  input[type="date"], input[type="time"] {
    position: relative;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%238C0D1B' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3crect x='3' y='4' width='18' height='18' rx='2' ry='2'%3e%3c/rect%3e%3cline x1='16' y1='2' x2='16' y2='6'%3e%3c/line%3e%3cline x1='8' y1='2' x2='8' y2='6'%3e%3c/line%3e%3cline x1='3' y1='10' x2='21' y2='10'%3e%3c/line%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 1rem center;
    background-size: 1.25rem;
    padding-right: 2.75rem;
    cursor: pointer;
  }
  
  input[type="time"] {
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%238C0D1B' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3ccircle cx='12' cy='12' r='10'%3e%3c/circle%3e%3cpolyline points='12 6 12 12 16 14'%3e%3c/polyline%3e%3c/svg%3e");
  }
  
  input[type="date"]::-webkit-calendar-picker-indicator,
  input[type="time"]::-webkit-calendar-picker-indicator {
    background: transparent;
    bottom: 0;
    color: transparent;
    cursor: pointer;
    height: auto;
    left: 0;
    position: absolute;
    right: 0;
    top: 0;
    width: auto;
  }

  /* Custom dropdown arrow for selects */
  select.dough-select-field {
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%238C0D1B' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 1rem center;
    background-size: 1.2rem;
    padding-right: 2.75rem;
  }

  /* Custom styling for file upload area overlap */
  .decorations-ref-upload-input,
  .customizer-upload-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  @media (max-width: 991px) {
    .summary-card {
      position: relative;
      top: auto;
    }
  }
</style>

<script>
  let cart = [];
  const uploadedImages = {};

  // DOM Elements
  const summaryItemsList = document.getElementById('summary-items-list');
  const summarySubtotal = document.getElementById('summary-subtotal');
  const summaryDoughExtra = document.getElementById('summary-dough-extra');
  const summaryAddonsExtra = document.getElementById('summary-addons-extra');
  const summaryTotal = document.getElementById('summary-total');
  const confirmWhatsappCheckoutBtn = document.getElementById('confirm-whatsapp-checkout-btn');
  const cakesCustomizersContainer = document.getElementById('cakes-customizers-container');
  const cakesCustomizationSection = document.getElementById('cakes-customization-section');

  // Load Cart
  const loadCart = () => {
    const savedCart = localStorage.getItem('el_lider_cart');
    if (savedCart) {
      try {
        cart = JSON.parse(savedCart);
      } catch (e) {
        cart = [];
      }
    }
    // Initialize properties if missing
    cart.forEach(item => {
      if (item.customizable) {
        if (item.id === 'cake-redondo') {
          item.size = item.size || '20';
          if (item.doubleHeight === undefined) item.doubleHeight = false;
        } else if (item.id === 'cake-bandeja') {
          item.size = item.size || 'media';
        } else if (item.id === 'minicake') {
          if (item.doubleHeight === undefined) item.doubleHeight = false;
        }
      }
    });

    if (cart.length === 0) {
      // Mock items for layout preview and screenshots
      cart = [
        { id: 'cake-redondo', name: 'Cakes Redondos', price: 3500, quantity: 1, customizable: true, category: 'cakes', dough: 'trigo', size: '25', doubleHeight: true, note: 'Decoración de chocolate blanco', ediblePrint: false },
        { id: 'minicake', name: 'Mini Cakes', price: 2500, quantity: 1, customizable: true, category: 'minicakes', dough: 'maicena', doubleHeight: false }
      ];
      console.log('Test Mode: Empty cart filled with mockup items.');
    }
  };

  // Icon classification based on product type
  const getProductIcon = (item) => {
    const id = item.id;
    if (id === 'minicake' || id.includes('cupcake')) {
      return { icon: '🧁', color: '#FBCFE8', label: 'Mini Cake / Cupcake' };
    }
    if (id === 'cake-bandeja') {
      return { icon: '🍰', color: '#EEDBCE', label: 'Bandeja' };
    }
    if (id === 'cake-varios-pisos') {
      return { icon: '🏢', color: '#DDD6FE', label: 'Varios Pisos' };
    }
    if (id === 'cake-redondo') {
      return { icon: '🎂', color: '#FEF08A', label: 'Cake Redondo' };
    }
    return { icon: '🍪', color: '#A7F3D0', label: 'Buffet/Postre' };
  };

  const renderSummaryItems = () => {
    if (!summaryItemsList) return;
    let html = '';
    
    cart.forEach((item, index) => {
      const metaInfo = getProductIcon(item);
      
      // Calculate customized item unit price
      let basePrice = item.price;
      let sizeExtra = 0;
      if (item.id === 'cake-redondo') {
        const size = item.size || '20';
        if (size === '25') sizeExtra = 1500;
        else if (size === '30') sizeExtra = 7200;
      } else if (item.id === 'cake-bandeja') {
        const size = item.size || 'media';
        if (size === 'completa') sizeExtra = 5400;
      }
      
      let customizedUnitPrice = basePrice + sizeExtra;
      if (item.doubleHeight && (item.id === 'cake-redondo' || item.id === 'minicake')) {
        customizedUnitPrice = Math.round(customizedUnitPrice * 1.80);
      }

      html += `
        <div class="flex gap-4 items-center bg-[var(--bg-primary)] border border-[var(--border-color)] p-3 rounded-xl shadow-sm">
          <div class="w-14 h-14 flex-shrink-0 rounded-lg overflow-hidden border border-[var(--border-color)]">
            <img src="${item.imageSrc || 'https://images.unsplash.com/photo-1578985545062-69928b1d9587?q=80&w=800&auto=format&fit=crop'}" alt="${item.name}" class="w-full h-full object-cover" />
          </div>
          <div class="flex-grow min-w-0">
            <div class="flex justify-between items-start gap-2">
              <h4 class="text-sm font-bold text-[var(--text-primary)] truncate">${item.name}</h4>
              <span class="text-sm font-bold text-[var(--accent-color)] whitespace-nowrap">$${customizedUnitPrice * item.quantity} CUP</span>
            </div>
            <div class="flex items-center gap-2 mt-1 text-xs text-[var(--text-light)]">
              <span class="inline-flex items-center justify-center w-6 h-6 rounded-full text-xs font-bold" style="background-color: ${metaInfo.color};" title="${metaInfo.label}">${metaInfo.icon}</span>
              <span>Cantidad: ${item.quantity}</span>
            </div>
          </div>
        </div>
      `;
    });
    summaryItemsList.innerHTML = html;
  };

  const renderCakesCustomizers = () => {
    if (!cakesCustomizersContainer) return;
    
    const customizableCakes = cart.filter(item => item.customizable);

    if (customizableCakes.length === 0) {
      if (cakesCustomizationSection) cakesCustomizationSection.style.display = 'none';
      return;
    }

    if (cakesCustomizationSection) cakesCustomizationSection.style.display = 'block';
    
    let html = '';
    customizableCakes.forEach((item, idx) => {
      const globalIdx = cart.findIndex(c => c.id === item.id);
      let sizeSelectorHtml = '';
      let doubleOptionHtml = '';
      
      if (item.id === 'cake-redondo') {
        sizeSelectorHtml = `
          <div class="flex flex-col gap-2">
            <label for="cake-size-${globalIdx}" class="block text-sm font-bold text-[var(--text-primary)] flex items-center justify-between">
              <span>📏 Tamaño del Cake:</span>
              <span class="text-xs text-[var(--accent-color)] bg-[var(--bg-primary)] border border-[var(--border-color)] px-2 py-0.5 rounded-full font-bold">Base: 20cm</span>
            </label>
            <select class="size-select-field w-full px-4 py-3 bg-[var(--bg-primary)] border-2 border-[var(--border-color)] rounded-xl text-sm text-[var(--text-primary)] focus:border-[var(--accent-color)] focus:ring-4 focus:ring-[var(--accent-color)]/10 transition-all outline-none cursor-pointer appearance-none" data-index="${globalIdx}" id="cake-size-${globalIdx}">
              <option value="20" ${item.size === '20' || !item.size ? 'selected' : ''}>20 cm (Incluido)</option>
              <option value="25" ${item.size === '25' ? 'selected' : ''}>25 cm (+1500 CUP)</option>
              <option value="30" ${item.size === '30' ? 'selected' : ''}>30 cm (+7200 CUP)</option>
            </select>
          </div>
        `;
        doubleOptionHtml = `
          <label class="inline-flex items-center gap-3 w-full bg-[var(--bg-primary)] border-2 border-[var(--border-color)] hover:border-[var(--accent-color)] p-3 rounded-xl cursor-pointer transition-colors mt-2">
            <input 
              type="checkbox" 
              class="double-height-checkbox-field w-4 h-4 text-[var(--accent-color)] border-[var(--border-color)] rounded focus:ring-[var(--accent-color)] cursor-pointer" 
              data-index="${globalIdx}" 
              id="cake-double-${globalIdx}"
              ${item.doubleHeight ? 'checked' : ''}
            />
            <span class="text-sm font-bold text-[var(--text-primary)] flex-grow flex items-center justify-between">
              <span>¿Deseas pedir el cake Doble? (Doble masa / altura)</span>
              <span class="text-xs text-[var(--accent-color)] bg-[var(--bg-primary)] border border-[var(--border-color)] px-2 py-0.5 rounded-full font-bold">+80% costo base</span>
            </span>
          </label>
        `;
      } else if (item.id === 'cake-bandeja') {
        sizeSelectorHtml = `
          <div class="flex flex-col gap-2">
            <label for="cake-size-${globalIdx}" class="block text-sm font-bold text-[var(--text-primary)] flex items-center justify-between">
              <span>📏 Tamaño de la Bandeja:</span>
              <span class="text-xs text-[var(--accent-color)] bg-[var(--bg-primary)] border border-[var(--border-color)] px-2 py-0.5 rounded-full font-bold">Base: Media</span>
            </label>
            <select class="size-select-field w-full px-4 py-3 bg-[var(--bg-primary)] border-2 border-[var(--border-color)] rounded-xl text-sm text-[var(--text-primary)] focus:border-[var(--accent-color)] focus:ring-4 focus:ring-[var(--accent-color)]/10 transition-all outline-none cursor-pointer appearance-none" data-index="${globalIdx}" id="cake-size-${globalIdx}">
              <option value="media" ${item.size === 'media' || !item.size ? 'selected' : ''}>Media Bandeja (Incluido)</option>
              <option value="completa" ${item.size === 'completa' ? 'selected' : ''}>Bandeja Completa (+5400 CUP)</option>
            </select>
          </div>
        `;
      } else if (item.id === 'minicake') {
        doubleOptionHtml = `
          <label class="inline-flex items-center gap-3 w-full bg-[var(--bg-primary)] border-2 border-[var(--border-color)] hover:border-[var(--accent-color)] p-3 rounded-xl cursor-pointer transition-colors mt-2">
            <input 
              type="checkbox" 
              class="double-height-checkbox-field w-4 h-4 text-[var(--accent-color)] border-[var(--border-color)] rounded focus:ring-[var(--accent-color)] cursor-pointer" 
              data-index="${globalIdx}" 
              id="cake-double-${globalIdx}"
              ${item.doubleHeight ? 'checked' : ''}
            />
            <span class="text-sm font-bold text-[var(--text-primary)] flex-grow flex items-center justify-between">
              <span>¿Deseas pedir el cake Doble? (Doble masa / altura)</span>
              <span class="text-xs text-[var(--accent-color)] bg-[var(--bg-primary)] border border-[var(--border-color)] px-2 py-0.5 rounded-full font-bold">+80% costo base</span>
            </span>
          </label>
        `;
      } else if (item.id === 'cake-varios-pisos') {
        sizeSelectorHtml = `
          <div class="bg-[var(--bg-primary)] border border-[var(--border-color)] text-[var(--text-secondary)] text-sm p-4 rounded-xl flex flex-col gap-1 leading-relaxed">
            <span class="font-bold flex items-center gap-1 text-[var(--accent-color)]">ℹ️ Nota sobre Cakes de Varios Pisos</span>
            <span>Al ser la opción más elaborada con muchas variables de diseño y montaje, el tamaño y precio final se concertarán directamente a través de WhatsApp. El precio inicial base estimado comienza desde $16500 CUP.</span>
          </div>
        `;
      }

      html += `
        <div class="bg-[var(--bg-secondary)] border border-[var(--border-color)] rounded-xl p-5 mb-6 border-l-4 border-l-[var(--accent-color)] space-y-4 shadow-sm" data-cart-index="${globalIdx}">
          <h4 class="text-base font-extrabold text-[var(--accent-color)] flex items-center gap-1.5">🎂 Personalización: ${item.name}</h4>
          
          ${sizeSelectorHtml}
          ${doubleOptionHtml}

          <div class="flex flex-col gap-2">
            <label for="cake-dough-${globalIdx}" class="block text-sm font-bold text-[var(--text-primary)]">🌾 Selección de Masa:</label>
            <select class="dough-select-field w-full px-4 py-3 bg-[var(--bg-primary)] border-2 border-[var(--border-color)] rounded-xl text-sm text-[var(--text-primary)] focus:border-[var(--accent-color)] focus:ring-4 focus:ring-[var(--accent-color)]/10 transition-all outline-none cursor-pointer appearance-none" data-index="${globalIdx}" id="cake-dough-${globalIdx}">
              <option value="trigo" ${item.dough === 'trigo' || !item.dough ? 'selected' : ''}>Harina de trigo (Incluido)</option>
              <option value="maicena" ${item.dough === 'maicena' ? 'selected' : ''}>Maicena (+150 CUP)</option>
              <option value="capuchino" ${item.dough === 'capuchino' ? 'selected' : ''}>Capuchino (+300 CUP)</option>
            </select>
          </div>

          <div class="flex flex-col gap-2">
            <label for="cake-theme-${globalIdx}" class="block text-sm font-bold text-[var(--text-primary)]">✍️ Temática / Decoración y Colores:</label>
            <textarea 
              class="cake-note-field w-full px-4 py-3 bg-[var(--bg-primary)] border-2 border-[var(--border-color)] rounded-xl text-sm text-[var(--text-primary)] focus:border-[var(--accent-color)] focus:ring-4 focus:ring-[var(--accent-color)]/10 transition-all outline-none placeholder:text-[var(--text-light)]" 
              id="cake-theme-${globalIdx}"
              data-index="${globalIdx}" 
              rows="3" 
              placeholder="Ej: Cobertura azul con detalles en crema blanca. Texto: 'Felicidades Mamá'. Temática de flores..."
            >${item.note || ''}</textarea>
          </div>

          <div class="flex flex-col gap-2">
            <label class="block text-sm font-bold text-[var(--text-primary)]">🖼️ Foto de Referencia para Decoración (Opcional):</label>
            <div class="relative w-full border-2 border-dashed border-[var(--accent-color)] rounded-xl p-4 text-center cursor-pointer bg-[var(--bg-primary)] hover:bg-[var(--accent-color)]/5 transition-colors">
              <span class="text-xs font-semibold text-[var(--text-primary)]" id="ref-photo-label-${globalIdx}">
                ${item.refPhotoName ? `✓ ${item.refPhotoName}` : 'Haga clic para subir imagen de referencia'}
              </span>
              <input type="file" class="decorations-ref-upload-input" data-index="${globalIdx}" accept="image/*" />
            </div>
            <div class="flex items-center justify-center" id="ref-preview-${globalIdx}">
              ${uploadedImages['ref-' + item.id] ? `<img src="${uploadedImages['ref-' + item.id]}" alt="preview" class="w-12 h-12 object-cover rounded-lg border border-[var(--border-color)] mt-2"/>` : ''}
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <label class="inline-flex items-center gap-3 w-full bg-[var(--bg-primary)] border-2 border-[var(--border-color)] hover:border-[var(--accent-color)] p-3 rounded-xl cursor-pointer transition-colors">
              <input 
                type="checkbox" 
                class="edible-print-checkbox-field w-4 h-4 text-[var(--accent-color)] border-[var(--border-color)] rounded focus:ring-[var(--accent-color)] cursor-pointer" 
                data-index="${globalIdx}" 
                id="cake-print-${globalIdx}"
                ${item.ediblePrint ? 'checked' : ''}
              />
              <span class="text-sm font-bold text-[var(--text-primary)] flex-grow flex items-center justify-between">
                <span>¿Deseas añadir Impresión Comestible?</span>
                <span class="text-xs text-[var(--accent-color)] bg-[var(--bg-primary)] border border-[var(--border-color)] px-2 py-0.5 rounded-full font-bold">+650 CUP</span>
              </span>
            </label>
            
            <div class="print-upload-wrapper" id="print-upload-wrapper-${globalIdx}" style="display: ${item.ediblePrint ? 'block' : 'none'};">
              <div class="relative w-full border-2 border-dashed border-[var(--accent-color)] rounded-xl p-4 text-center cursor-pointer bg-[var(--bg-primary)] hover:bg-[var(--accent-color)]/5 transition-colors">
                <span class="text-xs font-semibold text-[var(--text-primary)]" id="upload-label-${globalIdx}">
                  ${item.fileName ? `✓ ${item.fileName}` : 'Haga clic para subir la imagen para impresión'}
                </span>
                <input type="file" class="customizer-upload-input" data-index="${globalIdx}" accept="image/*" />
              </div>
              <div class="flex items-center justify-center mt-2" id="preview-${globalIdx}">
                ${uploadedImages[item.id] ? `<img src="${uploadedImages[item.id]}" alt="preview" class="w-12 h-12 object-cover rounded-lg border border-[var(--border-color)]"/>` : ''}
              </div>
            </div>
          </div>
        </div>
      `;
    });

    cakesCustomizersContainer.innerHTML = html;
    attachCustomizerEvents();
  };

  const attachCustomizerEvents = () => {
    // Dough selects
    document.querySelectorAll('.dough-select-field').forEach(select => {
      select.addEventListener('change', (e) => {
        const target = e.target as HTMLSelectElement;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        
        cart[idx].dough = target.value;
        updateTotals();
      });
    });

    // Size selects
    document.querySelectorAll('.size-select-field').forEach(select => {
      select.addEventListener('change', (e) => {
        const target = e.target as HTMLSelectElement;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        
        cart[idx].size = target.value;
        updateTotals();
      });
    });

    // Double height check
    document.querySelectorAll('.double-height-checkbox-field').forEach(checkbox => {
      checkbox.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        
        cart[idx].doubleHeight = target.checked;
        updateTotals();
      });
    });

    // Notes/Theme textarea
    document.querySelectorAll('.cake-note-field').forEach(textarea => {
      textarea.addEventListener('input', (e) => {
        const target = e.target as HTMLTextAreaElement;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        cart[idx].note = target.value;
        saveCartToStorage();
      });
    });

    // Print check
    document.querySelectorAll('.edible-print-checkbox-field').forEach(checkbox => {
      checkbox.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        const uploadWrapper = document.getElementById(`print-upload-wrapper-${idx}`);
        
        cart[idx].ediblePrint = target.checked;
        if (uploadWrapper) {
          uploadWrapper.style.display = target.checked ? 'block' : 'none';
        }
        updateTotals();
      });
    });

    // File upload preview
    document.querySelectorAll('.customizer-upload-input').forEach(input => {
      input.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        const file = target.files?.[0];
        
        if (file) {
          const reader = new FileReader();
          reader.onload = (event) => {
            const dataUrl = event.target?.result as string;
            const item = cart[idx];
            item.fileName = file.name;
            uploadedImages[item.id] = dataUrl;
            
            const label = document.getElementById(`upload-label-${idx}`);
            const preview = document.getElementById(`preview-${idx}`);
            
            if (label) label.textContent = `✓ ${file.name}`;
            if (preview) preview.innerHTML = `<img src="${dataUrl}" alt="Preview" />`;
            
            saveCartToStorage();
          };
          reader.readAsDataURL(file);
        }
      });
    });

    // Reference Photo upload preview
    document.querySelectorAll('.decorations-ref-upload-input').forEach(input => {
      input.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        const idx = parseInt(target.getAttribute('data-index') || '0');
        const file = target.files?.[0];
        
        if (file) {
          const reader = new FileReader();
          reader.onload = (event) => {
            const dataUrl = event.target?.result as string;
            const item = cart[idx];
            item.refPhotoName = file.name;
            uploadedImages['ref-' + item.id] = dataUrl;
            
            const label = document.getElementById(`ref-photo-label-${idx}`);
            const preview = document.getElementById(`ref-preview-${idx}`);
            
            if (label) label.textContent = `✓ ${file.name}`;
            if (preview) preview.innerHTML = `<img src="${dataUrl}" alt="Preview" style="width: 50px; height: 50px; object-fit: cover; border-radius: var(--border-radius-sm); border: 1px solid var(--border-color); margin-top: 0.5rem;"/>`;
            
            saveCartToStorage();
          };
          reader.readAsDataURL(file);
        }
      });
    });
  };

  const saveCartToStorage = () => {
    const cleanCart = cart.map(({ fileData, ...rest }) => rest);
    localStorage.setItem('el_lider_cart', JSON.stringify(cleanCart));
  };

  const updateTotals = () => {
    let subtotal = 0;
    let doughExtra = 0;
    let addonsExtra = 0;

    cart.forEach(item => {
      let basePrice = item.price;
      let sizeExtra = 0;
      if (item.id === 'cake-redondo') {
        const size = item.size || '20';
        if (size === '25') sizeExtra = 1500;
        else if (size === '30') sizeExtra = 7200;
      } else if (item.id === 'cake-bandeja') {
        const size = item.size || 'media';
        if (size === 'completa') sizeExtra = 5400;
      }
      
      let currentItemPrice = basePrice + sizeExtra;
      if (item.doubleHeight && (item.id === 'cake-redondo' || item.id === 'minicake')) {
        currentItemPrice = Math.round(currentItemPrice * 1.80);
      }

      subtotal += currentItemPrice * item.quantity;
      if (item.ediblePrint) {
        addonsExtra += 650 * item.quantity;
      }
      // Dough calculation
      if (item.dough === 'maicena') {
        doughExtra += 150 * item.quantity;
      } else if (item.dough === 'capuchino') {
        doughExtra += 300 * item.quantity;
      }
    });

    const total = subtotal + doughExtra + addonsExtra;

    if (summarySubtotal) summarySubtotal.textContent = `$${subtotal} CUP`;
    if (summaryDoughExtra) summaryDoughExtra.textContent = `$${doughExtra} CUP`;
    if (summaryAddonsExtra) summaryAddonsExtra.textContent = `$${addonsExtra} CUP`;
    if (summaryTotal) summaryTotal.textContent = `$${total} CUP`;

    saveCartToStorage();
    renderSummaryItems();
  };

  // WhatsApp checkout final message composition
  confirmWhatsappCheckoutBtn?.addEventListener('click', () => {
    const deliveryDateInput = document.getElementById('delivery-date') as HTMLInputElement | null;
    const deliveryTimeInput = document.getElementById('delivery-time') as HTMLInputElement | null;

    const deliveryDate = deliveryDateInput?.value;
    const deliveryTime = deliveryTimeInput?.value;

    if (!deliveryDate || !deliveryTime) {
      alert('Por favor, rellene todos los campos obligatorios del formulario (Fecha y Hora Requerida).');
      return;
    }

    const phoneNumber = '5350000000';
    const dateParts = deliveryDate.split('-');
    const formattedDate = `${dateParts[2]}/${dateParts[1]}/${dateParts[0]}`;

    let message = '🍰 *NUEVO ENCARGO - DULCERÍA EL LÍDER* 🍰\n\n';
    message += `📅 *FECHA DE ENTREGA:* ${formattedDate}\n`;
    message += `🕒 *HORA DE ENTREGA:* ${deliveryTime}\n\n`;
    message += '━━━━━━━━━━━━━━━━━━━━━━━━━\n';
    message += '*DETALLE DE LOS DULCES:*\n\n';

    let total = 0;
    cart.forEach((item, index) => {
      let basePrice = item.price;
      let sizeExtra = 0;
      let sizeLabel = '';
      if (item.id === 'cake-redondo') {
        const size = item.size || '20';
        sizeLabel = `${size} cm`;
        if (size === '25') sizeExtra = 1500;
        else if (size === '30') sizeExtra = 7200;
      } else if (item.id === 'cake-bandeja') {
        const size = item.size || 'media';
        sizeLabel = size === 'completa' ? 'Bandeja Completa' : 'Media Bandeja';
        if (size === 'completa') sizeExtra = 5400;
      } else if (item.id === 'minicake') {
        sizeLabel = '15 cm';
      } else if (item.id === 'cake-varios-pisos') {
        sizeLabel = 'Varios Pisos (A definir)';
      }

      let currentItemPrice = basePrice + sizeExtra;
      if (item.doubleHeight && (item.id === 'cake-redondo' || item.id === 'minicake')) {
        currentItemPrice = Math.round(currentItemPrice * 1.80);
      }

      let itemPriceTotal = currentItemPrice * item.quantity;
      let customizations = [];

      if (sizeLabel) {
        customizations.push(`Tamaño: ${sizeLabel}`);
      }

      if (item.doubleHeight && (item.id === 'cake-redondo' || item.id === 'minicake')) {
        customizations.push('Cake Doble (Doble masa / altura, +80%)');
      }

      if (item.dough && item.dough !== 'trigo') {
        const extra = item.dough === 'maicena' ? 150 : 300;
        itemPriceTotal += extra * item.quantity;
        customizations.push(`Masa: ${item.dough === 'maicena' ? 'Maicena (+150 CUP)' : 'Capuchino (+300 CUP)'}`);
      } else if (item.dough) {
        customizations.push('Masa: Harina de Trigo');
      }

      if (item.customizable) {
        const decorators = item.note ? `"${item.note.trim()}"` : 'Decoración sugerida por la casa';
        customizations.push(`Decoración: ${decorators}`);
      }

      if (item.refPhotoName) {
        customizations.push(`Foto de Referencia: [Se adjunta en este chat] (${item.refPhotoName})`);
      }

      if (item.ediblePrint) {
        itemPriceTotal += 650 * item.quantity;
        customizations.push('Impresión Comestible (+650 CUP) [Imágenes adjuntas]');
      }

      total += itemPriceTotal;

      message += `*${index + 1}. ${item.name}* (x${item.quantity})\n`;
      if (customizations.length > 0) {
        customizations.forEach(c => {
          message += `   • ${c}\n`;
        });
      }
      message += `   • Subtotal: *$${itemPriceTotal} CUP*\n\n`;
    });

    message += '━━━━━━━━━━━━━━━━━━━━━━━━━\n';
    message += `💵 *TOTAL ESTIMADO: $${total} CUP*\n\n`;
    message += `⚠️ _La decoración y cotización final se concertarán en este chat._\n`;
    message += `📍 Por favor, confírmenme disponibilidad para agendar. ¡Gracias!`;

    const encodedMessage = encodeURIComponent(message);
    const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodedMessage}`;
    window.open(whatsappUrl, '_blank');
  });

  // Initialization
  loadCart();
  renderSummaryItems();
  renderCakesCustomizers();
  updateTotals();
</script>
